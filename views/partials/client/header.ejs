<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
>
<header class="site-header">
  <div class="container header-row">
    
    <a href="/" class="tiop-brand">

        <span class="tiop-brand-portrait">
            <img
                src="/media/logo.png"
                alt="TiopTiop"
            >
        </span>

        <span class="tiop-brand-text">
            <strong>
                Tiop<span>Tiop</span>
            </strong>

            <small>
                LE GOUT QUI RASSEMBLE
            </small>
        </span>

    </a>

    <nav class="main-nav" aria-label="Navigation principale">
      <a href="/menu">🍽️ Menu</a>
      <a href="/offres">🎁 Offres</a>
      <a href="/tiopplus">⭐ Tiop+</a>
      <a href="/restaurants">📍 Restaurants</a>
      <a href="/carrieres">💼 Carrières</a>
    </nav>

    <div class="header-actions">
      <a href="/panier" class="cart-header-link">
            🛒 Panier

            <span
                id="cartCount"
                class="cart-count-badge"
            >
                0
            </span>
        </a>

        <% if (currentUser) { %>

            <a
                class="profile-chip"
                href="/compte"
            >

                <span class="avatar">

                    <% if (currentUser.avatarUrl) { %>

                        <img
                            src="<%= currentUser.avatarUrl %>"
                            alt=""
                        >

                    <% } else { %>

                        <%= (
                            currentUser.firstName
                            || "C"
                        ).charAt(0) %>

                    <% } %>

                </span>


                <span>

                    <%= currentUser.displayName
                        || currentUser.firstName
                        || "Mon compte" %>

                </span>

            </a>


            <form
                method="POST"
                action="/deconnexion"
                class="header-logout-form"
            >

                <button
                    type="submit"
                    class="header-logout-button"
                    aria-label="Se déconnecter"
                    title="Se déconnecter"
                >
                    ↪
                </button>

            </form>

        <% } else { %>

            <a
                class="button primary"
                href="/connexion"
            >
                🔐 Connexion
            </a>

        <% } %>
    </div>
    
  </div>
</header>

<style>
  /* portrait */

.tiop-brand-portrait{
    width:68px;
    height:68px;

    display:grid;
    place-items:center;

    position:relative;

    border-radius:50%;

    background:#fff8ee;

    border:2px solid #ff7900;

    overflow:hidden;

    box-shadow:
        0 5px 18px rgba(50,30,10,.10);
}


.tiop-brand-portrait::after{
    content:"";

    position:absolute;
    inset:4px;

    border-radius:50%;

    border:1px dashed rgba(255,121,0,.40);

    pointer-events:none;
}


.tiop-brand-portrait img{
    width:112%;
    height:112%;

    object-fit:contain;

    object-position:center;

    transition:
        transform .3s ease,
        filter .3s ease;
}


.tiop-brand:hover .tiop-brand-portrait img{
    transform:scale(1.06) rotate(-1deg);
}


/* =====================================================
   NOM
===================================================== */

.tiop-brand-text{
    display:flex;
    flex-direction:column;

    line-height:1;
}


.tiop-brand-text strong{
    font-size:32px;
    font-weight:950;
    letter-spacing:-1.8px;
}


.tiop-brand-text strong span{
    color:#ff7900;
}


.tiop-brand-text small{
    margin-top:7px;

    font-size:9px;
    font-weight:900;

    letter-spacing:1.8px;

    color:#756b62;
}

.header-logout-form {
    margin: 0;
}

.header-logout-button {

    width: 38px;
    height: 38px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid #eadfd3;
    border-radius: 50%;

    background: #fff;

    color: #17130f;

    font-size: 17px;

    cursor: pointer;
}

.header-logout-button:hover {

    border-color: #ff7900;

    color: #ff7900;
}

</style>