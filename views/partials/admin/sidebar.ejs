<style>
  .admin-logout {
    display: flex;
    align-items: center;
    gap: 10px;

    width: 100%;
    padding: 12px 16px;

    border-radius: 12px;

    color: #d9363e;
    text-decoration: none;
    font-weight: 800;

    transition: .2s ease;
}

.admin-logout:hover {
    background: #fff0f0;
}
.admin-notif-side-link{display:flex!important;align-items:center;gap:8px}.admin-notif-side-badge{margin-left:auto;min-width:20px;padding:2px 6px;border-radius:999px;background:#ff7900;color:#fff;font-size:10px;font-weight:900;text-align:center}
</style>
<script>window.addEventListener('tiop:notifications:summary',e=>{const b=document.getElementById('adminNotifSideBadge');if(!b)return;const n=Number(e.detail?.unread||0);b.textContent=n>99?'99+':n;b.hidden=!n;});</script>