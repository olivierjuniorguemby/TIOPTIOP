

<header class="admin-header">

    <div class="admin-header-inner">

        <!-- Navigation -->
        <nav class="admin-header-nav">
            <a href="/admin/commandes">Commandes</a>
            <a href="/admin/pos">POS</a>
            <a href="/admin/produits">Produits</a>
            <a href="/admin/support">Support</a> &nbsp;&nbsp;&nbsp;

            <a href="/admin/notifications">🔔 </a>
        </nav>

        <!-- Profil administrateur -->
        <a href="/admin/profil" class="admin-header-profile">

            <!--
                Si vous avez une vraie photo :
                remplacez le bloc .admin-header-avatar
                par une balise <img>.
            -->

            <div class="admin-header-avatar">
                
                <img
                      src="/uploads/profiles/avatar.jpg"
                      alt="Administrateur TiopTiop"
                      class="admin-header-avatar-img"
                  >
            </div>

            <span class="admin-header-name">
              <% if (currentAdmin) { %>
                <%= currentAdmin.name %>
              <% } %>
            </span>

        </a>

        <!-- Bouton menu mobile -->
        <button
            type="button"
            class="admin-mobile-menu-btn"
            id="adminMobileMenuBtn"
            aria-label="Ouvrir le menu"
        >
            ☰
        </button>

    </div>

</header>

<style>
    /* =========================================================
   HEADER ADMIN
========================================================= */

.admin-header {
    position: sticky;
    top: 0;
    z-index: 1000;

    width: 100%;
    height: 72px;

    box-sizing: border-box;

    padding: 0 24px;

    background: #1d1815;

    border-bottom: 1px solid rgba(255,255,255,.06);
}


/* =========================================================
   CONTENEUR
========================================================= */

.admin-header-inner {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 12px;

    margin: 0;
    padding: 0;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-header-nav {
    display: flex;
    align-items: center;

    gap: 4px;

    margin: 0;
    padding: 0;
}

.admin-header-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 38px;

    box-sizing: border-box;

    padding: 0 11px;

    border-radius: 10px;

    color: #fff;

    text-decoration: none;

    font-size: 13px;
    line-height: 1;

    font-weight: 800;

    white-space: nowrap;

    transition:
        background .15s ease,
        color .15s ease;
}

.admin-header-nav a:hover {
    background: rgba(255,255,255,.08);
    color: #ff8b21;
}


/* =========================================================
   VOIR LE SITE
========================================================= */

.admin-header-nav .admin-view-site {
    margin-left: 4px;

    color: #fff;
}

.admin-header-nav .admin-view-site:hover {
    color: #ff7900;
}


/* =========================================================
   NOTIFICATION
   = dernier lien de la navigation
========================================================= */

.admin-header-nav a:last-child {
    width: 38px;
    height: 38px;

    padding: 0;

    border-radius: 50%;

    font-size: 16px;

    background: rgba(255,255,255,.06);
}

.admin-header-nav a:last-child:hover {
    background: #fff0df;
}


/* =========================================================
   PROFIL
========================================================= */

.admin-header-profile {
    display: inline-flex;
    align-items: center;

    height: 48px;

    box-sizing: border-box;

    gap: 10px;

    padding: 4px 14px 4px 5px;

    margin: 0;

    border-radius: 999px;

    background: #332b26;

    color: #fff;

    text-decoration: none;

    white-space: nowrap;

    transition: background .15s ease;
}

.admin-header-profile:hover {
    background: #42372f;
}


/* =========================================================
   AVATAR
========================================================= */

.admin-header-avatar {
    flex: 0 0 auto;

    width: 38px;
    height: 38px;

    overflow: hidden;

    border-radius: 50%;

    background: #ff7900;

    border: 2px solid #ff7900;
}

.admin-header-avatar-img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    border-radius: 50%;
}


/* =========================================================
   NOM
========================================================= */

.admin-header-name {
    display: block;

    max-width: 160px;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 13px;
    line-height: 1;

    font-weight: 800;
}


/* =========================================================
   BOUTON MOBILE
========================================================= */

.admin-mobile-menu-btn {
    display: none;

    width: 40px;
    height: 40px;

    padding: 0;

    border: 0;
    border-radius: 10px;

    background: #ff7900;
    color: #fff;

    font-size: 19px;

    cursor: pointer;
}


/* =========================================================
   TABLETTE
========================================================= */

@media (max-width: 1400px) {

    .admin-header-nav a {
        padding: 0 8px;

        font-size: 12px;
    }

    .admin-header-name {
        max-width: 110px;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 900px) {

    .admin-header {
        height: 64px;

        padding: 0 15px;
    }

    .admin-header-inner {
        justify-content: flex-end;
    }

    .admin-header-nav {
        display: none;
    }

    .admin-header-name {
        display: none;
    }

    .admin-header-profile {
        width: 44px;
        height: 44px;

        padding: 3px;

        justify-content: center;
    }

    .admin-header-avatar {
        width: 36px;
        height: 36px;
    }

    .admin-mobile-menu-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

}


</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const menuButton = document.getElementById('adminMobileMenuBtn');
    const sidebar = document.querySelector('.admin-sidebar');

    if (!menuButton || !sidebar) {
        return;
    }


    /* OUVRIR / FERMER */

    menuButton.addEventListener('click', function (event) {

        event.stopPropagation();

        sidebar.classList.toggle('open');

    });


    /* FERMER APRÈS CLIC SUR UN LIEN */

    sidebar.querySelectorAll('a').forEach(function (link) {

        link.addEventListener('click', function () {

            if (window.innerWidth <= 1400) {
                sidebar.classList.remove('open');
            }

        });

    });


    /* FERMER EN CLIQUANT À L'EXTÉRIEUR */

    document.addEventListener('click', function (event) {

        if (window.innerWidth > 1400) {
            return;
        }

        if (
            sidebar.classList.contains('open') &&
            !sidebar.contains(event.target) &&
            !menuButton.contains(event.target)
        ) {
            sidebar.classList.remove('open');
        }

    });


    /* FERMER AVEC ECHAP */

    document.addEventListener('keydown', function (event) {

        if (event.key === 'Escape') {
            sidebar.classList.remove('open');
        }

    });


    /* RETOUR DESKTOP */

    window.addEventListener('resize', function () {

        if (window.innerWidth > 1400) {
            sidebar.classList.remove('open');
        }

    });

});
</script>