

<header class="admin-header">

    <div class="admin-header-inner">

        <!-- Navigation -->
        <nav class="admin-header-nav">
            <a href="/admin/commandes">Commandes</a>
            <a href="/admin/pos">POS</a>
            <a href="/admin/produits">Produits</a>
            <a href="/admin/support">Support</a>

            <a href="/" target="_blank" class="admin-view-site">
                Voir le site ↗
            </a>
        </nav>

        <!-- Profil administrateur -->
        <a href="/admin/profil" class="admin-header-profile">

            <!--
                Si vous avez une vraie photo :
                remplacez le bloc .admin-header-avatar
                par une balise <img>.
            -->

            <div class="admin-header-avatar">
                
                <img
                      src="/uploads/profiles/avatar.jpg"
                      alt="Administrateur TiopTiop"
                      class="admin-header-avatar-img"
                  >
            </div>

            <span class="admin-header-name">
              <% if (currentAdmin) { %>
                <%= currentAdmin.name %>
              <% } %>
            </span>

        </a>

        <!-- Bouton menu mobile -->
        <button
            type="button"
            class="admin-mobile-menu-btn"
            id="adminMobileMenuBtn"
            aria-label="Ouvrir le menu"
        >
            ☰
        </button>

    </div>

</header>

<style>
  /* =========================================================
   HEADER ADMIN TIOPTIOP
========================================================= */

.admin-header {
    width: 100%;
    height: 94px;

    display: flex;
    align-items: center;

    background: #17120e;

    position: relative;
    z-index: 1000;
}

.admin-header-inner {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 45px;

    padding: 0 48px;

    box-sizing: border-box;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-header-nav {
    display: flex;
    align-items: center;

    gap: 38px;
}

.admin-header-nav a {
    color: #fff;

    text-decoration: none;

    font-size: 17px;
    font-weight: 800;

    white-space: nowrap;

    transition:
        color .2s ease,
        transform .2s ease;
}

.admin-header-nav a:hover {
    color: #ff7900;

    transform: translateY(-1px);
}


/* VOIR LE SITE */

.admin-header-nav .admin-view-site {
    margin-left: 5px;
}


/* =========================================================
   PROFIL ADMIN
========================================================= */

.admin-header-profile {
    min-height: 72px;

    display: flex;
    align-items: center;

    gap: 16px;

    padding: 8px 22px 8px 9px;

    border-radius: 999px;

    background: #352e29;

    text-decoration: none;

    box-sizing: border-box;

    transition:
        background .2s ease,
        transform .2s ease;
}

.admin-header-profile:hover {
    background: #423934;

    transform: translateY(-1px);
}


/* =========================================================
   AVATAR
========================================================= */

.admin-header-avatar {
    width: 58px;
    height: 58px;

    flex: 0 0 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: linear-gradient(
        145deg,
        #ff7900,
        #ffbe3b
    );

    color: #fff;

    font-size: 21px;
    font-weight: 900;
}

.admin-header-name {
    color: #fff;

    font-size: 17px;
    font-weight: 800;

    white-space: nowrap;
}


/* =========================================================
   MENU MOBILE
========================================================= */

.admin-mobile-menu-btn {
    display: none;

    width: 48px;
    height: 48px;

    border: 0;
    border-radius: 14px;

    background: #352e29;
    color: white;

    font-size: 23px;

    cursor: pointer;
}


/* =========================================================
   TABLETTE
========================================================= */

@media (max-width: 1100px) {

    .admin-header-inner {
        padding: 0 25px;

        gap: 25px;
    }

    .admin-header-nav {
        gap: 20px;
    }

    .admin-header-nav a {
        font-size: 15px;
    }

    .admin-header-name {
        font-size: 15px;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 850px) {

    .admin-header {
        height: auto;

        min-height: 80px;
    }

    .admin-header-inner {
        min-height: 80px;

        padding: 10px 16px;

        justify-content: flex-end;
    }

    .admin-header-nav {
        display: none;

        position: absolute;

        top: 80px;
        left: 0;
        right: 0;

        padding: 20px;

        background: #17120e;

        flex-direction: column;
        align-items: stretch;

        gap: 5px;

        border-top: 1px solid rgba(255,255,255,.08);

        box-shadow:
            0 15px 30px rgba(0,0,0,.18);
    }

    .admin-header-nav.active {
        display: flex;
    }

    .admin-header-nav a {
        display: block;

        padding: 14px 15px;

        border-radius: 12px;

        font-size: 16px;
    }

    .admin-header-nav a:hover {
        background: #2d2722;

        transform: none;
    }

    .admin-mobile-menu-btn {
        display: flex;
        align-items: center;
        justify-content: center;
    }

}


/* =========================================================
   PETIT MOBILE
========================================================= */

@media (max-width: 520px) {

    .admin-header-profile {
        min-height: 56px;

        padding: 6px 12px 6px 6px;

        gap: 9px;
    }

    .admin-header-avatar {
        width: 44px;
        height: 44px;

        flex-basis: 44px;

        font-size: 17px;
    }

    .admin-header-name {
        max-width: 135px;

        overflow: hidden;

        text-overflow: ellipsis;

        font-size: 13px;
    }

}

.admin-header-avatar-img {
    width: 58px;
    height: 58px;

    flex: 0 0 58px;

    border-radius: 50%;

    object-fit: cover;

    display: block;
}

@media (max-width: 520px) {

    .admin-header-avatar-img {
        width: 44px;
        height: 44px;

        flex-basis: 44px;
    }

}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const button = document.getElementById('adminMobileMenuBtn');
    const nav = document.querySelector('.admin-header-nav');

    if (!button || !nav) return;

    button.addEventListener('click', function () {

        nav.classList.toggle('active');

        button.textContent =
            nav.classList.contains('active')
                ? '✕'
                : '☰';
    });

});
</script>