<% const notifAdmin = typeof notificationScope !== 'undefined' && notificationScope === 'ADMIN'; %>
<div class="tt-notif" data-feed="<%= notifAdmin ? '/admin/notifications/feed' : '/notifications/feed' %>" data-read-base="<%= notifAdmin ? '/admin/notifications' : '/notifications' %>" data-page="<%= notifAdmin ? '/admin/notifications' : '/compte/notifications' %>">
  <button type="button" class="tt-notif-bell" aria-label="Notifications" aria-expanded="false">🔔<span class="tt-notif-badge" hidden>0</span></button>
  <div class="tt-notif-menu" hidden>
    <div class="tt-notif-head"><div><small>TiopTiop</small><strong>Notifications</strong></div><button type="button" class="tt-notif-readall">Tout lire</button></div>
    <div class="tt-notif-list"><div class="tt-notif-empty">Chargement…</div></div>
    <a class="tt-notif-footer" href="<%= notifAdmin ? '/admin/notifications' : '/compte/notifications' %>">Voir toutes les notifications →</a>
  </div>
</div>
<style>
.tt-notif{position:relative;display:inline-flex}.tt-notif-bell{width:42px;height:42px;border:1px solid rgba(255,121,0,.18);border-radius:14px;background:<%= notifAdmin ? '#2b2521' : '#fff' %>;cursor:pointer;font-size:18px;position:relative;box-shadow:0 5px 18px rgba(30,20,10,.08)}
.tt-notif-bell:hover{transform:translateY(-1px);border-color:#ff7900}.tt-notif-badge{position:absolute;right:-6px;top:-7px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:#ff5a36;color:#fff;border:2px solid <%= notifAdmin ? '#1d1815' : '#fff' %>;font:800 10px/16px Arial;text-align:center}
.tt-notif-menu{position:absolute;right:0;top:52px;width:min(390px,calc(100vw - 24px));background:#fff;color:#211a15;border:1px solid #eee3d9;border-radius:22px;box-shadow:0 22px 65px rgba(39,27,18,.20);overflow:hidden;z-index:5000}.tt-notif-head{padding:18px 18px 14px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#fffaf4,#fff)}.tt-notif-head div{display:flex;flex-direction:column}.tt-notif-head small{font-size:10px;color:#ff7900;font-weight:900;text-transform:uppercase;letter-spacing:1px}.tt-notif-head strong{font-size:20px}.tt-notif-readall{border:0;background:#fff1e3;color:#d65d00;border-radius:999px;padding:8px 11px;font-weight:800;cursor:pointer}.tt-notif-list{max-height:410px;overflow:auto}.tt-notif-item{display:grid;grid-template-columns:42px 1fr auto;gap:11px;padding:13px 16px;border-top:1px solid #f3ede7;text-decoration:none;color:inherit;cursor:pointer}.tt-notif-item.unread{background:#fff9f2}.tt-notif-icon{width:40px;height:40px;border-radius:13px;background:#fff0df;display:grid;place-items:center}.tt-notif-copy strong{display:block;font-size:13px;margin-bottom:3px}.tt-notif-copy p{margin:0;color:#74685e;font-size:12px;line-height:1.35}.tt-notif-copy time{display:block;color:#a09489;font-size:10px;margin-top:5px}.tt-notif-dot{width:8px;height:8px;background:#ff7900;border-radius:50%;margin-top:8px}.tt-notif-empty{padding:34px 18px;text-align:center;color:#8c8178}.tt-notif-footer{display:block;padding:13px 16px;text-align:center;border-top:1px solid #eee6df;color:#e56600;font-weight:850;text-decoration:none}.tt-notif-footer.is-disabled{color:#a79d95;cursor:default}
@media(max-width:700px){.tt-notif-menu{position:fixed;left:12px;right:12px;top:82px;width:auto}.tt-notif-list{max-height:60vh}}
</style>
<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{const roots=document.querySelectorAll('.tt-notif:not([data-ready])');roots.forEach(root=>{root.dataset.ready='1';const bell=root.querySelector('.tt-notif-bell'),badge=root.querySelector('.tt-notif-badge'),menu=root.querySelector('.tt-notif-menu'),list=root.querySelector('.tt-notif-list'),readAll=root.querySelector('.tt-notif-readall');const feed=root.dataset.feed,base=root.dataset.readBase;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const icon=t=>/ORDER|COMMANDE/.test(t)?'🛒':/PAY/.test(t)?'💳':/SUPPORT/.test(t)?'💬':/LOYALTY|TIOP/.test(t)?'⭐':/PROMO/.test(t)?'🎁':'🔔';const ago=d=>{const n=Math.max(0,Date.now()-new Date(d).getTime()),m=Math.floor(n/60000);return m<1?'À l’instant':m<60?`Il y a ${m} min`:m<1440?`Il y a ${Math.floor(m/60)} h`:new Date(d).toLocaleDateString('fr-FR')};
function summary(s){const n=Number(s?.unread||0);badge.textContent=n>99?'99+':n;badge.hidden=!n;window.dispatchEvent(new CustomEvent('tiop:notifications:summary',{detail:s||{unread:0}}))}function draw(items){list.innerHTML=items?.length?items.map(x=>`<div class="tt-notif-item ${x.read_at?'':'unread'}" data-id="${x.id}" data-target="${esc(x.target_url||'')}"><span class="tt-notif-icon">${icon(x.notification_type)}</span><span class="tt-notif-copy"><strong>${esc(x.title)}</strong><p>${esc(x.body)}</p><time>${ago(x.created_at)}</time></span>${x.read_at?'':'<i class="tt-notif-dot"></i>'}</div>`).join(''):'<div class="tt-notif-empty">✨ Vous êtes à jour.<br>Aucune nouvelle notification.</div>'}async function load(){try{const r=await fetch(feed,{headers:{Accept:'application/json'}});if(!r.ok)return;const d=await r.json();summary(d.summary);draw(d.items)}catch(_){}}async function post(url){const r=await fetch(url,{method:'POST',headers:{Accept:'application/json'}});if(r.ok){const d=await r.json();summary(d.summary);await load()}}
bell.addEventListener('click',e=>{e.stopPropagation();menu.hidden=!menu.hidden;bell.setAttribute('aria-expanded',String(!menu.hidden));if(!menu.hidden)load()});document.addEventListener('click',e=>{if(!root.contains(e.target)){menu.hidden=true;bell.setAttribute('aria-expanded','false')}});list.addEventListener('click',async e=>{const it=e.target.closest('.tt-notif-item');if(!it)return;await post(`${base}/${it.dataset.id}/read`);const target=it.dataset.target;if(target&&target.startsWith('/')&&!target.startsWith('//'))window.location.assign(target)});readAll.addEventListener('click',()=>post(`${base}/read-all`));load();setInterval(load,30000);
if(window.io){window.tiopNotificationSocket=window.tiopNotificationSocket||io();window.tiopNotificationSocket.on('notification:new',load);window.tiopNotificationSocket.on('notification:changed',load)} });})();
</script>
