<% const fmt=d=>d?new Date(d).toLocaleDateString('fr-FR'):'—'; const typeLabel={PERCENT:'Pourcentage',FIXED:'Prix fixe',FREE_DELIVERY:'Livraison offerte',POINTS_MULTIPLIER:'Bonus Tiop+'}; %>
<section class="promo-client">
  <div class="promo-hero"><div><span class="promo-kicker">Offres spéciales</span><h1>🎁 Promotions et bons plans</h1><p>Des offres exclusives pour encore plus de plaisir !</p></div><div class="promo-hero-art"><span>Des saveurs<br>à prix doux !</span><b>🍔 🍟 🥤</b></div></div>
  <form class="promo-filters" method="get" action="/offres"><input name="q" value="<%= filters.q %>" placeholder="⌕  Rechercher une promotion..."><select name="category"><option value="">Toutes les catégories</option><%categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(filters.category)===String(c.id)?'selected':''%>><%=c.name%></option><%})%></select><select name="type"><option value="">Tous les types</option><% Object.entries(typeLabel).forEach(([v,l])=>{ %><option value="<%=v%>" <%=filters.type===v?'selected':''%>><%=l%></option><% }) %></select><select name="status"><option value="">Tous les statuts</option><option value="ACTIVE" <%=filters.status==='ACTIVE'?'selected':''%>>En cours</option><option value="UPCOMING" <%=filters.status==='UPCOMING'?'selected':''%>>À venir</option></select><button>Filtrer</button></form>
  <div class="promo-grid">
  <% if(!promotions.length){ %><div class="promo-empty">Aucune promotion ne correspond à votre recherche.</div><% } %>
  <% promotions.forEach(p=>{ const upcoming=p.computed_status==='UPCOMING'; const badge=p.discount_type==='PERCENT'?`-${Number(p.discount_value)}%`:p.discount_type==='FREE_DELIVERY'?'Livraison offerte':p.discount_type==='FIXED'?'Bon plan':'Bonus Tiop+'; %>
    <article class="promo-card"><div class="promo-image" style="background-image:url('<%=p.image_url||'/assets/img/logo.svg'%>')"><span class="promo-value"><%=badge%></span><span class="promo-status <%=upcoming?'soon':''%>"><%=upcoming?'À venir':'En cours'%></span></div><div class="promo-body"><h2><%=p.name%></h2><p><%=p.description||'Profitez de cette offre TiopTiop.'%></p><div class="promo-meta"><span>⏰ <%=p.starts_at&&upcoming?'Du '+fmt(p.starts_at):'Jusqu’au '+fmt(p.ends_at)%></span><span>🏷 <%=p.category_names||'Toutes les catégories'%></span></div><% if(p.code){ %><div class="promo-code">Code : <strong><%=p.code%></strong></div><% } %><a class="promo-cta <%=upcoming?'disabled':''%>" href="<%=upcoming?'#':('/menu'+(p.code?'?promo='+encodeURIComponent(p.code):''))%>"><%=upcoming?'Bientôt disponible':'J’en profite'%></a></div></article>
  <% }) %></div>
</section>
<style>
.promo-client{max-width:1180px;margin:auto;padding:28px 20px 70px;color:#171310}.promo-hero{min-height:190px;display:flex;justify-content:space-between;align-items:center;gap:30px;background:linear-gradient(100deg,#fffaf4,#fff1df);border-radius:28px;padding:30px 38px;overflow:hidden}.promo-kicker{display:inline-block;background:#fff0d9;color:#ff7900;padding:7px 12px;border-radius:20px;font-weight:900;font-size:12px}.promo-hero h1{font-size:48px;line-height:1;margin:18px 0 10px;font-weight:950}.promo-hero p{color:#706a65;font-size:17px}.promo-hero-art{display:flex;align-items:center;gap:28px;color:#ff7900;font-weight:900;transform:rotate(-3deg)}.promo-hero-art span{background:#fff;padding:15px;border-radius:16px;box-shadow:0 10px 30px #ff790033}.promo-hero-art b{font-size:58px;white-space:nowrap}.promo-filters{margin:-16px 20px 22px;position:relative;background:#fff;padding:12px;border:1px solid #eee2d6;border-radius:18px;display:grid;grid-template-columns:2fr 1fr 1fr 1fr 130px;gap:10px;box-shadow:0 10px 30px #3d22080b}.promo-filters input,.promo-filters select{height:45px;border:1px solid #e6ded7;border-radius:12px;padding:0 14px;background:#fff}.promo-filters button,.promo-cta{border:0;background:#ff7900;color:#fff;border-radius:12px;font-weight:900}.promo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.promo-card{background:#fff;border:1px solid #eadfd4;border-radius:18px;overflow:hidden;box-shadow:0 7px 22px #3d22080b}.promo-image{height:150px;background-size:cover;background-position:center;position:relative;background-color:#f7eee5}.promo-value,.promo-status{position:absolute;top:12px;padding:7px 11px;border-radius:20px;color:#fff;font-weight:900;font-size:12px}.promo-value{left:12px;background:#ff7900}.promo-status{right:12px;background:#c8f3d2;color:#08722d}.promo-status.soon{background:#fff0c5;color:#7a5100}.promo-body{padding:16px}.promo-body h2{font-size:18px;margin:0 0 8px}.promo-body p{color:#6e6862;line-height:1.45;min-height:42px;margin:0 0 12px}.promo-meta{font-size:11px;font-weight:700;display:flex;justify-content:space-between;gap:8px;margin-bottom:10px}.promo-code{font-size:12px;color:#6e6862;margin:8px 0}.promo-cta{height:40px;display:flex;align-items:center;justify-content:center;text-decoration:none}.promo-cta.disabled{background:#ffe9d3;color:#df6500;pointer-events:none}.promo-empty{grid-column:1/-1;padding:50px;text-align:center;background:#fff;border-radius:18px}.promo-client *{box-sizing:border-box}@media(max-width:1000px){.promo-grid{grid-template-columns:repeat(2,1fr)}.promo-hero h1{font-size:38px}.promo-hero-art{display:none}}@media(max-width:650px){.promo-grid{grid-template-columns:1fr}.promo-filters{grid-template-columns:1fr;margin:12px 0 20px}.promo-hero{padding:24px}.promo-hero h1{font-size:34px}}
</style>
