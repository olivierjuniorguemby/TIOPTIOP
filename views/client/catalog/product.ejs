<script>
  /* =========================================================
     GALERIE
  ========================================================= */

  function changeProductImage(button, imageUrl) {

    const mainImage =
      document.getElementById("mainProductImage");

    mainImage.src = imageUrl;

    document
      .querySelectorAll(".product-thumbnail")
      .forEach(item => {
        item.classList.remove("active");
      });

    button.classList.add("active");
  }


  /* =========================================================
     FAVORI
  ========================================================= */

  function toggleProductFavorite(button) {

    button.classList.toggle("active");

    if (button.classList.contains("active")) {
      button.innerHTML = "♥ Favori";
    }
    else {
      button.innerHTML = "♡ Favori";
    }
  }


  /* =========================================================
     CALCUL AUTOMATIQUE DU PRIX
  ========================================================= */

  function updateProductPrice() {

    const priceElement =
      document.getElementById("productPrice");

    const button =
      document.getElementById("addToCartButton");

    let total =
      parseFloat(priceElement.dataset.basePrice);


    /* ACCOMPAGNEMENT */

    const accompaniment =
      document.querySelector(
        'input[name="accompaniment"]:checked'
      );

    if (accompaniment) {
      total += parseFloat(
        accompaniment.dataset.price || 0
      );
    }


    /* EXTRAS */

    document
      .querySelectorAll(
        'input[name="extras"]:checked'
      )
      .forEach(extra => {

        total += parseFloat(
          extra.dataset.price || 0
        );

      });


    const formatted =
      total.toLocaleString(
        "fr-FR",
        {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      );


    priceElement.textContent =
      formatted + " €";

    button.innerHTML =
      "🛒 Ajouter · " + formatted + " €";
  }
</script>
