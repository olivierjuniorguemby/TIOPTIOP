<section class="section">
  <div class="container">

<style>
  .tiop-product-page {
    --orange: #ff7900;
    --orange-dark: #e86e00;
    --dark: #1b1714;
    --text: #201c19;
    --muted: #77716f;
    --border: #e8e1da;
    --soft: #faf7f3;
    --cream: #fff0d8;

    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
  }

  .tiop-product-page * {
    box-sizing: border-box;
  }

  /* =========================================================
     PRODUIT PRINCIPAL
  ========================================================= */

  .product-main {
    display: grid;
    grid-template-columns: 58px minmax(300px, .95fr) minmax(360px, 1.15fr);
    gap: 16px;
    align-items: stretch;
  }

  /* =========================================================
     MINIATURES
  ========================================================= */

  .product-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .product-thumbnail {
    width: 58px;
    height: 58px;
    padding: 0;
    overflow: hidden;

    border: 1px solid transparent;
    border-radius: 10px;

    background: #fff;

    cursor: pointer;
  }

  .product-thumbnail.active {
    border: 2px solid var(--orange);
  }

  .product-thumbnail img {
    width: 100%;
    height: 100%;

    display: block;
    object-fit: cover;
  }

  /* =========================================================
     GRANDE IMAGE
  ========================================================= */

  .product-main-image {
    min-height: 645px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 22px;
    background: #eee;
  }

  .product-main-image img {
    width: 100%;
    height: 100%;
    min-height: 645px;

    display: block;
    object-fit: cover;
  }

  .product-no-image {
    width: 100%;
    min-height: 645px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #ffe7bf;

    font-size: 100px;
  }

  /* =========================================================
     INFORMATIONS PRODUIT
  ========================================================= */

  .product-information {
    min-height: 645px;

    padding: 25px;

    background: #fff;

    border: 1px solid var(--border);
    border-radius: 27px;
  }

  .product-category {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    min-height: 26px;

    padding: 0 12px;
    margin-bottom: 20px;

    border-radius: 999px;

    background: #fff0df;
    color: var(--orange);

    font-size: 10px;
    font-weight: 900;
  }

  .product-title {
    margin: 0 0 12px;

    font-size: clamp(32px, 4vw, 45px);
    line-height: 1;

    font-weight: 900;
    letter-spacing: -2px;
  }

  .product-short-description {
    margin: 0 0 18px;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.6;
  }

  /* =========================================================
     BADGES
  ========================================================= */

  .product-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;

    margin-bottom: 20px;
  }

  .product-badge {
    min-height: 25px;

    display: inline-flex;
    align-items: center;

    padding: 0 9px;

    border-radius: 999px;

    background: #f7f3ef;

    font-size: 9px;
    font-weight: 800;
  }

  .product-badge.featured {
    background: #fff0df;
    color: var(--orange);
  }

  .product-badge.halal {
    background: #edf8f0;
    color: #277a45;
  }

  .product-badge.vegetarian {
    background: #edf8f0;
    color: #277a45;
  }

  /* =========================================================
     PIMENT
  ========================================================= */

  .product-spice {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;

    margin-bottom: 18px;

    font-size: 12px;
  }

  .product-spice strong {
    margin-right: 5px;
  }

  /* =========================================================
     PRIX
  ========================================================= */

  .product-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 18px;
  }

  .product-price-container {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .product-old-price {
    color: #999;

    font-size: 13px;
    font-weight: 700;

    text-decoration: line-through;
  }

  .product-price {
    font-size: 23px;
    font-weight: 900;
  }

  .product-favorite {
    min-height: 43px;

    padding: 0 16px;

    border: 0;
    border-radius: 999px;

    background: #fff;

    color: var(--text);

    box-shadow: 0 5px 20px rgba(0,0,0,.06);

    font-weight: 900;
    cursor: pointer;
  }

  .product-favorite.active {
    color: #e63946;
  }

  /* =========================================================
     INFORMATIONS TECHNIQUES
  ========================================================= */

  .product-details {
    display: grid;
    gap: 10px;

    margin: 18px 0;
  }

  .product-detail-item {
    padding: 13px;

    background: var(--soft);

    border: 1px solid #f0ebe6;
    border-radius: 12px;
  }

  .product-detail-item strong {
    display: block;

    margin-bottom: 5px;

    font-size: 12px;
  }

  .product-detail-item p {
    margin: 0;

    color: var(--muted);

    font-size: 12px;
    line-height: 1.6;
  }

  /* =========================================================
     DESCRIPTION
  ========================================================= */

  .product-option-box {
    margin-top: 10px;
    padding: 18px;

    border: 1px solid #dedbd7;
    border-radius: 15px;
  }

  .product-option-title {
    margin: 0 0 10px;

    font-size: 14px;
    font-weight: 900;
  }

  .product-description {
    margin: 0;

    color: var(--muted);

    font-size: 12px;
    line-height: 1.7;
  }

  /* =========================================================
     INSTRUCTIONS
  ========================================================= */

  .product-instructions {
    width: 100%;
    min-height: 60px;

    margin-top: 12px;
    padding: 14px;

    border: 1px solid #dedbd7;
    border-radius: 14px;

    font-family: inherit;
    font-size: 12px;

    resize: vertical;
    outline: none;
  }

  .product-instructions:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(255,121,0,.08);
  }

  /* =========================================================
     ACTIONS
  ========================================================= */

  .product-actions {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-top: 18px;
  }

  .product-add-cart,
  .product-view-cart {
    min-height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 18px;

    border: 0;
    border-radius: 999px;

    font-size: 12px;
    font-weight: 900;

    text-decoration: none;
    cursor: pointer;
  }

  .product-add-cart {
    background: var(--orange);
    color: #fff;
  }

  .product-add-cart:hover {
    background: var(--orange-dark);
  }

  .product-view-cart {
    background: var(--dark);
    color: #fff;
  }

  /* =========================================================
     SEPARATEUR
  ========================================================= */

  .african-separator {
    display: flex;
    align-items: center;
    gap: 5px;

    margin: 80px 0;

    overflow: hidden;
  }

  .african-separator span {
    height: 9px;
    flex: 1 0 17px;
  }

  .african-separator span:nth-child(5n+1) {
    background: #3d7653;
  }

  .african-separator span:nth-child(5n+2) {
    background: #d69645;
  }

  .african-separator span:nth-child(5n+3) {
    background: #81543a;
  }

  .african-separator span:nth-child(5n+4) {
    background: #eee1b3;
  }

  .african-separator span:nth-child(5n+5) {
    background: #34704e;
  }

   /* =========================================================
     OPTIONGROUPS
  ========================================================= */
  .product-option-row {
    min-height: 38px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 4px 0;

    border-bottom: 1px dashed #ddd8d3;

    font-size: 12px;
  }

  .product-option-row:last-child {
      border-bottom: 0;
  }

  .product-option-label {
      display: flex;
      align-items: center;
      gap: 8px;

      cursor: pointer;
  }

  .product-option-label input {
      margin: 0;

      accent-color: var(--orange);
  }

  .product-option-price {
      font-weight: 900;
      white-space: nowrap;
  }

  .product-option-title small {
      margin-left: 4px;

      color: var(--orange);

      font-size: 9px;
      font-weight: 800;
  }

  /* =========================================================
     SUGGESTIONS
  ========================================================= */

  .suggestion-label {
    display: inline-flex;
    align-items: center;

    min-height: 25px;

    padding: 0 10px;
    margin-bottom: 12px;

    border-radius: 999px;

    background: #fff0df;
    color: var(--orange);

    font-size: 9px;
    font-weight: 900;
  }

  .suggestions-title {
    margin: 0 0 24px;

    font-size: clamp(32px, 4vw, 45px);
    line-height: 1;

    font-weight: 900;
    letter-spacing: -2px;
  }

  .suggestions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 13px;
  }

  .suggestion-card {
    overflow: hidden;

    background: #fff;

    border: 1px solid var(--border);
    border-radius: 20px;
  }

  .suggestion-image {
    height: 150px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #ffe7bf;

    color: inherit;
    text-decoration: none;

    font-size: 45px;
  }

  .suggestion-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  .suggestion-content {
    padding: 13px;
  }

  .suggestion-header {
    display: flex;
    justify-content: space-between;
    gap: 10px;

    margin-bottom: 12px;
  }

  .suggestion-name {
    margin: 0;

    font-size: 12px;
    font-weight: 900;
  }

  .suggestion-price {
    font-size: 12px;
    font-weight: 900;

    white-space: nowrap;
  }

  .suggestion-description {
    min-height: 34px;

    margin: 0 0 12px;

    color: var(--muted);

    font-size: 10px;
    line-height: 1.5;
  }

  .suggestion-actions {
    display: grid;
    grid-template-columns: 35px 1fr;
    gap: 7px;
  }

  .suggestion-favorite {
    min-height: 35px;

    border: 0;
    border-radius: 10px;

    background: #f8f5f1;

    cursor: pointer;
  }

  .suggestion-add {
    min-height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 10px;

    background: var(--orange);
    color: #fff;

    font-size: 11px;
    font-weight: 900;

    text-decoration: none;
    cursor: pointer;
  }

  .no-suggestions {
    padding: 25px;

    background: #fff;

    border: 1px solid var(--border);
    border-radius: 15px;

    color: var(--muted);

    font-size: 13px;
  }

  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 1000px) {

    .product-main {
      grid-template-columns: 55px 1fr 1fr;
    }

    .suggestions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 800px) {

    .product-main {
      grid-template-columns: 1fr;
    }

    .product-thumbnails {
      flex-direction: row;
      flex-wrap: wrap;

      order: 2;
    }

    .product-main-image {
      order: 1;

      min-height: 450px;
    }

    .product-main-image img {
      min-height: 450px;
    }

    .product-no-image {
      min-height: 450px;
    }

    .product-information {
      order: 3;

      min-height: auto;
    }

    .african-separator {
      margin: 55px 0;
    }
  }

  @media (max-width: 520px) {

    .product-main-image,
    .product-main-image img,
    .product-no-image {
      min-height: 350px;
    }

    .product-information {
      padding: 19px;

      border-radius: 22px;
    }

    .product-title {
      font-size: 35px;
    }

    .product-price-row {
      align-items: flex-start;
    }

    .product-actions {
      flex-direction: column;
    }

    .product-add-cart,
    .product-view-cart {
      width: 100%;
    }

    .suggestions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>


<section class="tiop-product-page">

  <!-- =====================================================
       PRODUIT PRINCIPAL
  ====================================================== -->

  <div class="product-main">


    <!-- =====================================================
         MINIATURES - MAXIMUM 6 IMAGES MYSQL
    ====================================================== -->

    <div class="product-thumbnails">

      <% if (product.images && product.images.length > 0) { %>

        <% product.images.forEach((image, index) => { %>

          <button
            type="button"
            class="product-thumbnail <%= index === 0 ? 'active' : '' %>"
            onclick='changeProductImage(
              this,
              <%- JSON.stringify(image.image_url) %>
            )'
          >

            <img
              src="<%= image.image_url %>"
              alt="<%= image.alt_text || product.name %>"
            >

          </button>

        <% }) %>

      <% } %>

    </div>


    <!-- =====================================================
         GRANDE IMAGE
    ====================================================== -->

    <div class="product-main-image">

      <% if (product.main_image) { %>

        <img
          id="mainProductImage"
          src="<%= product.main_image %>"
          alt="<%= product.name %>"
        >

      <% } else { %>

        <div class="product-no-image">
          🍽️
        </div>

      <% } %>

    </div>


    <!-- =====================================================
         INFORMATIONS PRODUIT
    ====================================================== -->

    <article class="product-information">


      <!-- CATEGORIE -->

      <span class="product-category">

        <%= product.category_icon || "🍽️" %>

        <%= product.category_name %>

      </span>


      <!-- NOM -->

      <h1 class="product-title">
        <%= product.name %>
      </h1>


      <!-- DESCRIPTION COURTE -->

      <% if (product.short_description) { %>

        <p class="product-short-description">
          <%= product.short_description %>
        </p>

      <% } %>


      <!-- =====================================================
           BADGES
      ====================================================== -->

      <div class="product-badges">

        <span class="product-badge">
          ⏱ <%= product.preparation_minutes || 15 %> min
        </span>


        <span class="product-badge">
          📦 Disponible
        </span>


        <% if (product.calories !== null && product.calories !== undefined) { %>

          <span class="product-badge">
            🔥 <%= product.calories %> kcal
          </span>

        <% } %>


        <% if (Number(product.is_halal) === 1) { %>

          <span class="product-badge halal">
            ✓ Halal
          </span>

        <% } %>


        <% if (Number(product.is_vegetarian) === 1) { %>

          <span class="product-badge vegetarian">
            🌱 Végétarien
          </span>

        <% } %>


        <% if (Number(product.is_breakfast) === 1) { %>

          <span class="product-badge">
            ☕ Petit-déjeuner
          </span>

        <% } %>


        <% if (Number(product.is_featured) === 1) { %>

          <span class="product-badge featured">
            ⭐ Produit vedette
          </span>

        <% } %>

      </div>


      <!-- =====================================================
           NIVEAU EPICE
      ====================================================== -->

      <% if (
        product.spice_level !== null &&
        product.spice_level !== undefined &&
        Number(product.spice_level) > 0
      ) { %>

        <div class="product-spice">

          <strong>
            Niveau épicé :
          </strong>

          <% for (let i = 1; i <= 5; i++) { %>

            <span>
              <%= i <= Number(product.spice_level) ? "🌶️" : "○" %>
            </span>

          <% } %>

        </div>

      <% } %>


      <!-- =====================================================
           PRIX
      ====================================================== -->

      <div class="product-price-row">

        <div class="product-price-container">


          <% if (
            product.compare_at_price !== null &&
            product.compare_at_price !== undefined &&
            Number(product.compare_at_price) > Number(product.price)
          ) { %>

            <span class="product-old-price">

              <%= Number(product.compare_at_price)
                    .toLocaleString("fr-FR") %>

              <%= product.currency || "XAF" %>

            </span>

          <% } %>


          <strong
            class="product-price"
            id="productPrice"
            data-base-price="<%= Number(product.price) %>"
            data-currency="<%= product.currency || 'XAF' %>"
          >

            <%= Number(product.price)
                  .toLocaleString("fr-FR") %>

            <%= product.currency || "XAF" %>

          </strong>

        </div>


        <button
          type="button"
          class="product-favorite"
          onclick="toggleProductFavorite(this)"
        >
          ♡ Favori
        </button>

      </div>


      <!-- =====================================================
           INGREDIENTS / ALLERGENES / PETIT DEJEUNER
      ====================================================== -->

      <div class="product-details">


        <% if (product.ingredients) { %>

          <div class="product-detail-item">

            <strong>
              🥘 Ingrédients
            </strong>

            <p>
              <%= product.ingredients %>
            </p>

          </div>

        <% } %>


        <% if (product.allergens) { %>

          <div class="product-detail-item">

            <strong>
              ⚠️ Allergènes
            </strong>

            <p>
              <%= product.allergens %>
            </p>

          </div>

        <% } %>


        <% if (
          Number(product.is_breakfast) === 1 &&
          product.breakfast_start &&
          product.breakfast_end
        ) { %>

          <div class="product-detail-item">

            <strong>
              ☕ Horaires petit-déjeuner
            </strong>

            <p>

              Disponible de

              <%= String(product.breakfast_start).substring(0, 5) %>

              à

              <%= String(product.breakfast_end).substring(0, 5) %>

            </p>

          </div>

        <% } %>

      </div>


      <!-- =====================================================
           DESCRIPTION COMPLETE
      ====================================================== -->

      <% if (product.description) { %>

        <div class="product-option-box">

          <h2 class="product-option-title">
            📖 Description
          </h2>

          <p class="product-description">
            <%= product.description %>
          </p>

        </div>

      <% } %>


      <!-- =====================================================
           FORMULAIRE

           IMPORTANT :
           Les accompagnements et suppléments seront branchés
           sur MySQL à l'étape 7.
      ====================================================== -->

      <form
        id="productForm"
        action="#"
        method="POST"
        onsubmit="return false;"
      >

        <input
          type="hidden"
          name="product_id"
          value="<%= product.id %>"
        >

        <% if (
          typeof optionGroups !== "undefined" &&
          optionGroups &&
          optionGroups.length > 0
      ) { %>

          <% optionGroups.forEach(group => { %>

              <div
                  class="product-option-box"
                  data-group-id="<%= group.id %>"
                  data-selection-type="<%= group.selection_type %>"
                  data-min-choices="<%= group.min_choices %>"
                  data-max-choices="<%= group.max_choices || '' %>"
              >

                  <h2 class="product-option-title">

                      <% if (group.selection_type === "single") { %>
                          🍚
                      <% } else { %>
                          ✨
                      <% } %>

                      <%= group.name %>

                      <% if (Number(group.is_required) === 1) { %>
                          <small>
                              (obligatoire)
                          </small>
                      <% } %>

                  </h2>


                  <% group.options.forEach(option => { %>

                      <div class="product-option-row">

                          <label class="product-option-label">

                              <input
                                  type="<%= group.selection_type === 'single'
                                      ? 'radio'
                                      : 'checkbox'
                                  %>"

                                  name="<%= group.selection_type === 'single'
                                      ? 'option_group_' + group.id
                                      : 'option_group_' + group.id + '[]'
                                  %>"

                                  value="<%= option.id %>"

                                  data-price="<%= Number(option.price_delta) %>"

                                  <%= Number(option.is_default) === 1
                                      ? "checked"
                                        : ""
                                    %>

                                    onchange="updateProductPrice()"
                                >

                                <%= option.name %>

                            </label>


                            <strong class="product-option-price">

                                <% if (Number(option.price_delta) === 0) { %>

                                    Inclus

                                <% } else { %>

                                    +<%= Number(option.price_delta)
                                        .toLocaleString("fr-FR") %>

                                    <%= product.currency || "XAF" %>

                                <% } %>

                            </strong>

                        </div>

                    <% }) %>

                </div>

            <% }) %>

        <% } %>

        <!-- INSTRUCTIONS -->

        <textarea
          name="instructions"
          class="product-instructions"
          placeholder="📝 Instructions pour la cuisine..."
        ></textarea>


        <!-- ACTIONS -->

        <div class="product-actions">

          <button
            type="button"
            class="product-add-cart"
            id="addToCartButton"
          >

            🛒 Ajouter ·

            <%= Number(product.price)
                  .toLocaleString("fr-FR") %>

            <%= product.currency || "XAF" %>

          </button>


          <a
            href="/panier"
            class="product-view-cart"
          >
            🧺 Voir le panier
          </a>

        </div>

      </form>

    </article>

  </div>


  <!-- =====================================================
       MOTIF AFRICAIN
  ====================================================== -->

  <div
    class="african-separator"
    aria-hidden="true"
  >

    <% for (let i = 0; i < 35; i++) { %>

      <span></span>

    <% } %>

  </div>


  <!-- =====================================================
       SUGGESTIONS DYNAMIQUES
  ====================================================== -->

  <section class="product-suggestions">

    <span class="suggestion-label">
      ✨ Suggestions
    </span>

    <h2 class="suggestions-title">
      Vous aimerez aussi
    </h2>


    <% if (
      typeof suggestions !== "undefined" &&
      suggestions &&
      suggestions.length > 0
    ) { %>


      <div class="suggestions-grid">


        <% suggestions.forEach(item => { %>


          <article class="suggestion-card">


            <!-- IMAGE -->

            <a
              href="/produit/<%= item.id %>"
              class="suggestion-image"
            >

              <% if (item.image_url) { %>

                <img
                  src="<%= item.image_url %>"
                  alt="<%= item.name %>"
                >

              <% } else { %>

                🍽️

              <% } %>

            </a>


            <!-- CONTENU -->

            <div class="suggestion-content">


              <div class="suggestion-header">

                <h3 class="suggestion-name">
                  <%= item.name %>
                </h3>


                <strong class="suggestion-price">

                  <%= Number(item.price)
                        .toLocaleString("fr-FR") %>

                  <%= item.currency || "XAF" %>

                </strong>

              </div>


              <!-- DESCRIPTION -->

              <p class="suggestion-description">

                <%= item.short_description || "Découvrez ce produit TiopTiop." %>

              </p>


              <!-- ACTIONS -->

              <div class="suggestion-actions">

                <button
                  type="button"
                  class="suggestion-favorite"
                  onclick="toggleSuggestionFavorite(this)"
                >
                  ♡
                </button>


                <a
                  href="/produit/<%= item.id %>"
                  class="suggestion-add"
                >
                  Voir
                </a>

              </div>

            </div>

          </article>


        <% }) %>


      </div>


    <% } else { %>


      <div class="no-suggestions">

        Aucun autre produit de cette catégorie
        n'est disponible pour le moment.

      </div>


    <% } %>

  </section>

</section>


<script>

  /* =========================================================
     GALERIE PRODUIT
  ========================================================= */

  function changeProductImage(button, imageUrl) {

    const mainImage =
      document.getElementById("mainProductImage");


    if (!mainImage) {
      return;
    }


    mainImage.src = imageUrl;


    document
      .querySelectorAll(".product-thumbnail")
      .forEach(item => {

        item.classList.remove("active");

      });


    button.classList.add("active");
  }


  /* =========================================================
     FAVORI PRODUIT
     Temporaire : étape Auth / favoris plus tard
  ========================================================= */

  function toggleProductFavorite(button) {

    button.classList.toggle("active");


    if (button.classList.contains("active")) {

      button.innerHTML =
        "♥ Favori";

    }
    else {

      button.innerHTML =
        "♡ Favori";

    }
  }


  /* =========================================================
     FAVORI SUGGESTION
  ========================================================= */

  function toggleSuggestionFavorite(button) {

    button.classList.toggle("active");


    if (button.classList.contains("active")) {

      button.innerHTML = "♥";

    }
    else {

      button.innerHTML = "♡";

    }
  }

  function updateProductPrice() {

    const priceElement =
        document.getElementById("productPrice");

    const button =
        document.getElementById("addToCartButton");


    if (!priceElement || !button) {
        return;
    }


    const basePrice =
        Number(
            priceElement.dataset.basePrice || 0
        );


    const currency =
        priceElement.dataset.currency || "XAF";


    let total = basePrice;


    /*
     * On récupère toutes les options sélectionnées :
     *
     * - radio
     * - checkbox
     */
    document
        .querySelectorAll(
            '.product-option-box input:checked'
        )
        .forEach(input => {

            const additionalPrice =
                Number(
                    input.dataset.price || 0
                );


            total += additionalPrice;

        });


    const formatted =
        total.toLocaleString("fr-FR");


    priceElement.textContent =
        formatted + " " + currency;


    button.innerHTML =
        "🛒 Ajouter · "
        + formatted
        + " "
        + currency;
}


/*
 * Calcule immédiatement le prix
 * lorsque la page est chargée.
 *
 * Important si une option par défaut
 * possède un supplément.
 */
document.addEventListener(
    "DOMContentLoaded",
    updateProductPrice
);

</script>

  </div>
</section>