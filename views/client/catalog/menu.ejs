<section class="page-hero">
  <div class="container">
    <span class="eyebrow">🍽️ Catalogue</span>
    <h1>Menu</h1>
    <form
    action="/menu"
    method="GET"
    class="filters"
>

    <!-- RECHERCHE -->

    <input
        type="text"
        name="q"
        class="field"
        placeholder="Rechercher un plat..."
        value="<%= query || '' %>"
    >


    <!-- CATEGORIE -->

    <select name="category" class="field">

        <option value="">
            Toutes catégories
        </option>

        <% categories.forEach(category => { %>

            <option
                value="<%= category.id %>"

                <%= String(selectedCategory) === String(category.id)
                    ? 'selected'
                    : ''
                %>
            >

                <%= category.name %>

            </option>

        <% }) %>

    </select>


    <!-- PRIX -->

    <input
        type="number"
        name="maxPrice"
        class="field"
        min="0"
        step="100"
        placeholder="Prix maximum"
        value="<%= maxPrice || '' %>"
    >


    <!-- BOUTON -->

    <button
        type="submit"
        class="button primary"
    >
        Filtrer
    </button>


    <!-- RESET -->

    <a
        href="/menu"
        class="button"
    >
        Réinitialiser
    </a>

</form>
  </div>
</section>

<section class="section">
  
  <div class="container product-grid">
    <% if (products.length === 0) { %>

    <div class="empty-state">
        <h2>Aucun produit trouvé</h2>
        <p>
            Aucun produit ne correspond à votre recherche.
        </p>

        <a href="/menu" class="button">
            Voir tout le menu
        </a>
    </div>

    <% } else { %>

    <% products.forEach((product) => { %>
      <article class="card">
        <% if (product.image_url) { %>
          <img src="<%= product.image_url %>" alt="<%= product.name %>">
        <% } %>
        <div class="card-body">
          <span class="badge"><%= product.category_name %></span>
          <h3><%= product.name %></h3>
          <p><%= product.short_description || product.description || "" %></p>
          <div class="card-row">
            <strong>
                <%= formatMoney(product.price) %>
            </strong>

            <div
                style="
                    display:flex;
                    align-items:center;
                    gap:7px;
                    flex-wrap:wrap;
                "
            >

                <a
                    class="button small"
                    href="/produit/<%= product.id %>"
                >
                    Voir
                </a>

                <button
                    type="button"
                    class="button small primary add-product-to-cart"
                    data-product-id="<%= product.id %>"
                >
                    🛒 Ajouter
                </button>

            </div>

        </div>
        </div>
      </article>
    <% }) %>

    <% } %>
  </div>
</section>

