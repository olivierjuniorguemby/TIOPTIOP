<section class="page-hero">
  <div class="container">
    <span class="eyebrow">💼 <%= job.contract_type %></span>
    <h1><%= job.title %></h1>
    <p><%= job.department %> · <%= job.location %></p>
  </div>
</section>

  <div class="container">
    <!-- =========================================================
     TIOPTIOP - DÉTAIL OFFRE D'EMPLOI
     Exemple : /emploi/1
========================================================= -->

<style>
  .tiop-job-detail {
    --orange: #ff7900;
    --orange-hover: #e96e00;
    --text: #1d1a17;
    --muted: #77716c;
    --border: #eee4da;
    --soft: #f8f4ef;

    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
  }

  /* =====================================================
     EN-TÊTE
  ===================================================== */

  .job-detail-header {
    margin-bottom: 72px;
  }

  .job-opportunity {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    min-height: 27px;

    padding: 0 11px;
    margin-bottom: 13px;

    border-radius: 999px;

    background: #fff0df;
    color: var(--orange);

    font-size: 10px;
    font-weight: 900;
  }

  .job-detail-title {
    margin: 0 0 12px;

    font-size: clamp(40px, 5vw, 58px);
    line-height: .95;
    font-weight: 900;

    letter-spacing: -2.5px;
  }

  .job-detail-subtitle {
    margin: 0;

    color: var(--muted);

    font-size: 14px;
  }

  /* =====================================================
     LAYOUT
  ===================================================== */

  .job-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;

    align-items: stretch;
  }

  .job-detail-card {
    padding: 22px 20px;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid var(--border);
    border-radius: 24px;
  }

  /* =====================================================
     IMAGE
  ===================================================== */

  .job-cover {
    width: 100%;
    height: 174px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 8px;

    overflow: hidden;

    border-radius: 15px;

    background:
      linear-gradient(
        135deg,
        #3a2113 0%,
        #9d4800 50%,
        #ff7900 100%
      );
  }

  .job-cover span {
    font-size: 30px;
  }

  .job-cover img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  /* =====================================================
     BADGES
  ===================================================== */

  .job-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;

    margin-bottom: 14px;
  }

  .job-meta {
    min-height: 22px;

    display: inline-flex;
    align-items: center;

    padding: 0 9px;

    border-radius: 999px;

    background: var(--soft);

    font-size: 9px;
    font-weight: 800;
  }

  /* =====================================================
     DESCRIPTION
  ===================================================== */

  .job-description h2 {
    margin: 0 0 16px;

    font-size: 19px;
    font-weight: 900;
  }

  .job-description h3 {
    display: flex;
    align-items: center;
    gap: 7px;

    margin: 16px 0 10px;

    font-size: 14px;
    font-weight: 900;
  }

  .job-description p {
    margin: 0;

    color: #514b46;

    font-size: 12px;
    line-height: 1.6;
  }

  /* =====================================================
     CANDIDATURE
  ===================================================== */

  .job-application h2 {
    display: flex;
    align-items: center;
    gap: 8px;

    margin: 13px 0 25px;

    font-size: 18px;
    font-weight: 900;
  }

  .job-application-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* =====================================================
     CHAMPS
  ===================================================== */

  .application-field {
    width: 100%;
    min-height: 43px;

    padding: 0 12px;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid #dedbd8;
    border-radius: 12px;

    color: var(--text);

    font-family: inherit;
    font-size: 12px;

    outline: none;

    transition:
      border-color .2s ease,
      box-shadow .2s ease;
  }

  .application-field:focus {
    border-color: var(--orange);

    box-shadow:
      0 0 0 3px rgba(255,121,0,.08);
  }

  /* CV */

  .application-file {
    padding: 9px;
  }

  /* MESSAGE */

  .application-message {
    min-height: 80px;

    padding: 13px 12px;

    resize: vertical;

    line-height: 1.5;
  }

  /* =====================================================
     BOUTON
  ===================================================== */

  .application-submit {
    width: 100%;
    min-height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    padding: 0 18px;

    box-sizing: border-box;

    border: 0;
    border-radius: 999px;

    background: var(--orange);
    color: #ffffff;

    font-size: 12px;
    font-weight: 900;

    cursor: pointer;

    transition:
      background .2s ease,
      transform .2s ease,
      box-shadow .2s ease;
  }

  .application-submit:hover {
    background: var(--orange-hover);

    transform: translateY(-1px);

    box-shadow:
      0 7px 18px rgba(255,121,0,.18);
  }

  /* =====================================================
     RESPONSIVE
  ===================================================== */

  @media (max-width: 800px) {

    .job-detail-header {
      margin-bottom: 40px;
    }

    .job-detail-grid {
      grid-template-columns: 1fr;
    }

    .job-detail-title {
      font-size: 44px;
    }
  }

  @media (max-width: 500px) {

    .job-detail-header {
      margin-bottom: 30px;
    }

    .job-detail-title {
      font-size: 37px;
      letter-spacing: -1.5px;
    }

    .job-detail-card {
      padding: 17px;

      border-radius: 20px;
    }

    .job-cover {
      height: 150px;
    }
  }
</style>


<section class="tiop-job-detail">


  <!-- =====================================================
       CONTENU
  ====================================================== -->

  <div class="job-detail-grid">


    <!-- =================================================
         DÉTAILS DU POSTE
    ================================================== -->

    <article class="job-detail-card">


      <!-- IMAGE -->

      <div class="job-cover">
        <span>💼</span>
      </div>


      <!-- BADGES -->

      <div class="job-detail-meta">

        <span class="job-meta">
          📍 Brazzaville
        </span>

        <span class="job-meta">
          🕘 Temps plein
        </span>

        <span class="job-meta">
          🎓 1 à 2 ans
        </span>

        <span class="job-meta">
          💰 Selon profil
        </span>

      </div>


      <!-- DESCRIPTION -->

      <div class="job-description">

        <h2>
          À propos du poste
        </h2>

        <p>
          Rejoignez une équipe ambitieuse qui construit une
          nouvelle expérience de restauration congolaise.
        </p>


        <h3>
          🎯 Missions
        </h3>

        <p>
          Assurer un service de qualité, respecter les standards
          TiopTiop, contribuer à la satisfaction client et
          collaborer avec l'équipe.
        </p>


        <h3>
          🧩 Profil recherché
        </h3>

        <p>
          Sens du service, fiabilité, esprit d'équipe
        </p>

      </div>

    </article>


    <!-- =================================================
         FORMULAIRE CANDIDATURE
    ================================================== -->

    <aside class="job-detail-card job-application">

      <h2>
        📄 Postuler
      </h2>


      <!-- IMPORTANT :
           enctype obligatoire pour envoyer le CV
      -->

      <form
        class="job-application-form"
        action="/emploi/1/postuler"
        method="POST"
        enctype="multipart/form-data"
      >

        <!-- POSTE -->

        <input
          type="hidden"
          name="jobId"
          value="1"
        >


        <!-- NOM -->

        <input
          type="text"
          name="fullName"
          class="application-field"
          placeholder="Nom complet"
          required
        >


        <!-- EMAIL -->

        <input
          type="email"
          name="email"
          class="application-field"
          placeholder="Email"
          required
        >


        <!-- TÉLÉPHONE -->

        <input
          type="tel"
          name="phone"
          class="application-field"
          placeholder="Téléphone"
          required
        >


        <!-- CV -->

        <input
          type="file"
          name="cv"
          class="application-field application-file"
          accept=".pdf,.doc,.docx"
          required
        >


        <!-- EXPÉRIENCE -->

        <input
          type="text"
          name="experience"
          class="application-field"
          placeholder="Expérience"
        >


        <!-- DISPONIBILITÉ -->

        <input
          type="text"
          name="availability"
          class="application-field"
          placeholder="Disponibilité"
        >


        <!-- MOTIVATION -->

        <textarea
          name="motivation"
          class="application-field application-message"
          placeholder="Message / motivation"
          required
        ></textarea>


        <!-- ENVOYER -->

        <button
          type="submit"
          class="application-submit"
          onclick="openApplicationModal()"
        >
          📄 Envoyer ma candidature
        </button>

      </form>

    </aside>

  </div>

</section>
  </div>

<!-- =========================================================
     MODAL - CANDIDATURE ENVOYÉE
========================================================= -->

<div id="applicationSuccessModal" class="application-modal">

  <div class="application-modal-backdrop"
       onclick="closeApplicationModal()"></div>

  <div class="application-modal-box">

    <!-- HEADER -->
    <div class="application-modal-header">

      <h2>
        ✅ Candidature envoyée
      </h2>

      <button
        type="button"
        class="application-modal-close"
        onclick="closeApplicationModal()"
        aria-label="Fermer"
      >
        ×
      </button>

    </div>


    <!-- SUCCÈS -->
    <div class="application-success-icon">
      ✓
    </div>


    <h3 class="application-success-title">
      Votre candidature est bien partie !
    </h3>


    <p class="application-success-message">
      Merci
      <strong id="modalCandidateName"></strong>.
      Votre candidature au poste de
      <strong>Équipier cuisine</strong>
      a été enregistrée.
    </p>


    <!-- RÉFÉRENCE -->
    <div class="application-reference">
      Référence :
      <strong id="modalApplicationReference">
        TIOP-JOB-2026-0003
      </strong>
    </div>


    <!-- INFORMATIONS -->
    <div class="application-summary">

      <div class="application-summary-row">
        💼
        <strong>Poste :</strong>
        <span>Équipier cuisine</span>
      </div>

      <div class="application-summary-row">
        📧
        <strong>Email :</strong>
        <span id="modalCandidateEmail"></span>
      </div>

      <div class="application-summary-row">
        📞
        <strong>Téléphone :</strong>
        <span id="modalCandidatePhone"></span>
      </div>

      <div class="application-summary-row">
        📄
        <strong>CV :</strong>
        <span id="modalCandidateCV"></span>
      </div>

    </div>


    <p class="application-admin-message">
      L’équipe TiopTiop peut maintenant consulter et traiter
      votre dossier depuis son espace d’administration.
    </p>


    <button
      type="button"
      class="application-modal-button"
      onclick="closeApplicationModal()"
    >
      Fermer
    </button>

  </div>

</div>

<style>
  /* =========================================================
   MODAL CANDIDATURE
========================================================= */

.application-modal {
  position: fixed;
  inset: 0;

  z-index: 99999;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 25px;
}

.application-modal.active {
  display: flex;
}

.application-modal-backdrop {
  position: absolute;
  inset: 0;

  background: rgba(20, 16, 13, .72);
  backdrop-filter: blur(3px);
}

.application-modal-box {
  position: relative;
  z-index: 2;

  width: min(900px, 100%);
  max-height: 92vh;

  overflow-y: auto;

  padding: 34px 42px 38px;

  box-sizing: border-box;

  background: #fff;

  border-radius: 38px;

  box-shadow:
    0 30px 80px rgba(0,0,0,.25);

  animation: applicationModalIn .28s ease;
}

@keyframes applicationModalIn {

  from {
    opacity: 0;
    transform: translateY(25px) scale(.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* HEADER */

.application-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.application-modal-header h2 {
  margin: 0;

  font-size: 31px;
  font-weight: 900;
}

.application-modal-close {
  width: 54px;
  height: 54px;

  flex: 0 0 54px;

  border: 0;
  border-radius: 50%;

  background: #f4f4f4;
  color: #111;

  font-size: 29px;

  cursor: pointer;
}


/* ICÔNE */

.application-success-icon {
  width: 120px;
  height: 120px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 38px auto 30px;

  border-radius: 50%;

  background: #e8f6ed;
  color: #287a4c;

  font-size: 70px;
  font-weight: 400;
}


/* TITRE */

.application-success-title {
  margin: 0 0 25px;

  text-align: center;

  font-size: 40px;
  line-height: 1.15;
  font-weight: 900;
}


/* MESSAGE */

.application-success-message {
  margin: 0 auto 35px;

  text-align: center;

  font-size: 19px;
  line-height: 1.6;
}


/* RÉFÉRENCE */

.application-reference {
  width: fit-content;

  margin: 0 auto 38px;

  padding: 14px 24px;

  background: #fff0df;
  color: #9b4c00;

  border-radius: 999px;

  font-size: 18px;
  font-weight: 900;
}


/* RÉCAP */

.application-summary {
  padding: 24px;

  margin-bottom: 27px;

  background: #faf8f5;

  border-radius: 25px;
}

.application-summary-row {
  display: flex;
  align-items: center;
  gap: 7px;

  padding: 12px 5px;

  font-size: 18px;

  border-bottom: 1px dashed #ddd6cf;
}

.application-summary-row:last-child {
  border-bottom: 0;
}

.application-summary-row strong {
  font-weight: 900;
}


/* MESSAGE ADMIN */

.application-admin-message {
  max-width: 760px;

  margin: 0 auto 24px;

  text-align: center;

  color: #77716c;

  font-size: 18px;
  line-height: 1.5;
}


/* BOUTON */

.application-modal-button {
  min-width: 125px;
  min-height: 48px;

  display: block;

  margin: auto;

  padding: 0 25px;

  border: 0;
  border-radius: 999px;

  background: #ff7900;
  color: #fff;

  font-size: 17px;
  font-weight: 900;

  cursor: pointer;
}

.application-modal-button:hover {
  background: #e96e00;
}


/* RESPONSIVE */

@media (max-width: 650px) {

  .application-modal {
    padding: 12px;
  }

  .application-modal-box {
    padding: 25px 18px;

    border-radius: 26px;
  }

  .application-modal-header h2 {
    font-size: 22px;
  }

  .application-modal-close {
    width: 44px;
    height: 44px;

    flex-basis: 44px;
  }

  .application-success-icon {
    width: 90px;
    height: 90px;

    font-size: 52px;
  }

  .application-success-title {
    font-size: 29px;
  }

  .application-success-message,
  .application-admin-message {
    font-size: 15px;
  }

  .application-reference {
    font-size: 14px;
  }

  .application-summary-row {
    flex-wrap: wrap;

    font-size: 15px;
  }
}
</style>

<script>

function openApplicationModal(reference = "TIOP-JOB-2026-0003") {

  const form = document.querySelector(".job-application-form");

  if (!form) return;


  /* RÉCUPÉRATION DES DONNÉES */

  const name =
    form.querySelector('[name="fullName"]')?.value || "";

  const email =
    form.querySelector('[name="email"]')?.value || "";

  const phone =
    form.querySelector('[name="phone"]')?.value || "";

  const cvInput =
    form.querySelector('[name="cv"]');

  const cv =
    cvInput?.files?.length
      ? cvInput.files[0].name
      : "Non joint";


  /* INJECTION DANS LE MODAL */

  document.getElementById("modalCandidateName").textContent =
    name;

  document.getElementById("modalCandidateEmail").textContent =
    email;

  document.getElementById("modalCandidatePhone").textContent =
    phone;

  document.getElementById("modalCandidateCV").textContent =
    cv;

  document.getElementById("modalApplicationReference").textContent =
    reference;


  /* AFFICHAGE */

  document
    .getElementById("applicationSuccessModal")
    .classList.add("active");

  document.body.style.overflow = "hidden";
}



function closeApplicationModal() {

  document
    .getElementById("applicationSuccessModal")
    .classList.remove("active");

  document.body.style.overflow = "";
}


/* ESC POUR FERMER */

document.addEventListener("keydown", function(event) {

  if (event.key === "Escape") {
    closeApplicationModal();
  }

});

</script>
