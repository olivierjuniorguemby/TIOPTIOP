<section class="section tiop-checkout-page">

<style>

.tiop-checkout-page {

    --orange: #ff7900;
    --orange-dark: #e56d00;

    --dark: #17130f;
    --text: #231f1b;
    --muted: #746d66;

    --line: #e9dfd5;
    --soft: #fff8ef;
    --soft-2: #f8f5f1;

    --green: #267346;
    --green-bg: #eaf7ee;

    --red: #a73535;
    --red-bg: #fff0f0;

    color: var(--text);
}


.tiop-checkout-page * {
    box-sizing: border-box;
}


.checkout-container {

    width: min(
        1180px,
        calc(100% - 32px)
    );

    margin: 0 auto;
}


/* =========================================================
   HEADER
========================================================= */

.checkout-header {

    margin-bottom: 35px;
}


.checkout-eyebrow {

    display: inline-flex;
    align-items: center;

    min-height: 29px;

    padding: 0 12px;

    margin-bottom: 12px;

    border-radius: 999px;

    background: #fff0df;

    color: var(--orange);

    font-size: 11px;
    font-weight: 900;
}


.checkout-title {

    margin: 0 0 10px;

    font-size:
        clamp(38px, 6vw, 64px);

    line-height: .95;

    letter-spacing: -3px;

    font-weight: 1000;
}


.checkout-subtitle {

    max-width: 720px;

    margin: 0;

    color: var(--muted);

    font-size: 14px;
    line-height: 1.65;
}


/* =========================================================
   ERROR
========================================================= */

.checkout-error {

    margin-bottom: 20px;

    padding: 15px 17px;

    border: 1px solid #f0caca;
    border-radius: 14px;

    background: var(--red-bg);

    color: var(--red);

    font-size: 12px;
    font-weight: 800;
}


/* =========================================================
   LAYOUT
========================================================= */

.checkout-layout {

    display: grid;

    grid-template-columns:
        minmax(0, 1.5fr)
        minmax(340px, .75fr);

    gap: 24px;

    align-items: start;
}


.checkout-left {

    display: flex;
    flex-direction: column;

    gap: 18px;
}


.checkout-card {

    padding: 24px;

    background: #fff;

    border: 1px solid var(--line);
    border-radius: 24px;
}


.checkout-card-title {

    margin: 0 0 18px;

    font-size: 19px;
    font-weight: 1000;
}


.checkout-card-description {

    margin: -8px 0 18px;

    color: var(--muted);

    font-size: 11px;
    line-height: 1.55;
}


/* =========================================================
   CUSTOMER
========================================================= */

.customer-box {

    display: flex;
    align-items: center;

    gap: 14px;

    padding: 14px;

    border-radius: 16px;

    background: var(--soft-2);
}


.customer-avatar {

    width: 48px;
    height: 48px;

    flex: 0 0 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background: #fff0df;

    font-weight: 1000;
}


.customer-avatar img {

    width: 100%;
    height: 100%;

    object-fit: cover;
}


.customer-name {

    margin: 0 0 3px;

    font-size: 14px;
    font-weight: 1000;
}


.customer-contact {

    color: var(--muted);

    font-size: 11px;
    line-height: 1.5;
}


/* =========================================================
   FIELD
========================================================= */

.checkout-field-group {

    display: flex;
    flex-direction: column;

    gap: 7px;

    margin-bottom: 15px;
}


.checkout-label {

    font-size: 11px;
    font-weight: 900;
}


.checkout-field {

    width: 100%;
    min-height: 48px;

    padding: 0 14px;

    border: 1px solid #ded8d2;
    border-radius: 13px;

    background: #fff;

    color: var(--text);

    font: inherit;
    font-size: 12px;

    outline: none;
}


.checkout-field:focus {

    border-color: var(--orange);

    box-shadow:
        0 0 0 3px
        rgba(255,121,0,.08);
}


textarea.checkout-field {

    min-height: 100px;

    padding-top: 13px;

    resize: vertical;
}


/* =========================================================
   ORDER TYPE
========================================================= */

.order-types {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;
}


.order-type-card {

    position: relative;

    min-height: 105px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;

    gap: 5px;

    padding: 14px;

    border: 1px solid var(--line);
    border-radius: 15px;

    cursor: pointer;

    transition:
        border-color .2s,
        background .2s,
        transform .2s;
}


.order-type-card:hover {

    transform:
        translateY(-1px);

    border-color:
        #ffc88f;
}


.order-type-card.active {

    border-color:
        var(--orange);

    background:
        #fff8ef;
}


.order-type-card.disabled {

    opacity: .45;

    cursor: not-allowed;

    transform: none;
}


.order-type-card input {

    position: absolute;

    opacity: 0;

    pointer-events: none;
}


.order-type-icon {

    font-size: 23px;
}


.order-type-title {

    font-size: 12px;
    font-weight: 1000;
}


.order-type-description {

    color: var(--muted);

    font-size: 9px;
    line-height: 1.4;
}


/* =========================================================
   ADDRESS
========================================================= */

.address-preview {

    display: none;

    margin-top: 10px;

    padding: 13px;

    border-radius: 13px;

    background: var(--soft-2);

    color: var(--muted);

    font-size: 11px;
    line-height: 1.6;
}


.address-preview.visible {

    display: block;
}


.checkout-link {

    display: inline-flex;

    margin-top: 7px;

    color: var(--orange);

    font-size: 10px;
    font-weight: 900;

    text-decoration: none;
}


/* =========================================================
   DELIVERY ZONE
========================================================= */

.delivery-zone-info {

    display: none;

    margin-top: 10px;

    padding: 13px;

    border-radius: 13px;

    background: #f7faf8;

    color: #466251;

    font-size: 11px;
    line-height: 1.6;
}


.delivery-zone-info.visible {

    display: block;
}


/* =========================================================
   PAYMENT
========================================================= */

.payment-options {

    display: grid;

    gap: 9px;
}


.payment-card {

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 13px 15px;

    border: 1px solid var(--line);
    border-radius: 14px;

    cursor: pointer;
}


.payment-card:has(input:checked) {

    border-color: var(--orange);

    background: #fff8ef;
}


.payment-card input {

    accent-color:
        var(--orange);
}


.payment-icon {

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--soft-2);

    font-size: 17px;
}


.payment-name {

    font-size: 12px;
    font-weight: 900;
}


.payment-description {

    margin-top: 2px;

    color: var(--muted);

    font-size: 9px;
}


/* =========================================================
   MTN MOMO
========================================================= */

.momo-payment-fields {
    display: none;
    margin-top: 12px;
    padding: 14px;
    border: 1px solid #f2d5b4;
    border-radius: 14px;
    background: #fffaf4;
}

.momo-payment-fields.visible {
    display: block;
}

.momo-payment-help {
    margin-top: 7px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.55;
}

/* =========================================================
   SUMMARY
========================================================= */

.checkout-summary {

    position: sticky;

    top: 90px;
}


.summary-products {

    display: flex;
    flex-direction: column;

    gap: 13px;

    margin-bottom: 20px;
}


.summary-product {

    display: grid;

    grid-template-columns:
        58px minmax(0,1fr) auto;

    gap: 10px;

    align-items: start;
}


.summary-product-image {

    width: 58px;
    height: 58px;

    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: #f4eee7;

    font-size: 23px;
}


.summary-product-image img {

    width: 100%;
    height: 100%;

    object-fit: cover;
}


.summary-product-name {

    margin: 0 0 3px;

    font-size: 11px;
    font-weight: 1000;
}


.summary-product-meta {

    color: var(--muted);

    font-size: 9px;
    line-height: 1.5;
}


.summary-product-options {

    margin-top: 4px;

    color: #84694f;

    font-size: 9px;
    line-height: 1.45;
}


.summary-product-price {

    font-size: 10px;
    font-weight: 1000;

    white-space: nowrap;
}


/* =========================================================
   TOTALS
========================================================= */

.summary-separator {

    height: 1px;

    margin: 17px 0;

    background: var(--line);
}


.summary-row {

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin: 11px 0;

    color: var(--muted);

    font-size: 11px;
}


.summary-row strong {

    color: var(--text);
}


.summary-total {

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding-top: 17px;

    border-top: 1px solid var(--line);

    font-size: 16px;
    font-weight: 1000;
}


.summary-total strong {

    color: var(--orange);

    font-size: 20px;
}


.summary-minimum-warning {

    display: none;

    margin-top: 13px;

    padding: 11px;

    border-radius: 12px;

    background: var(--red-bg);

    color: var(--red);

    font-size: 10px;
    font-weight: 800;
}


.summary-minimum-warning.visible {

    display: block;
}


/* =========================================================
   SUBMIT
========================================================= */

.checkout-submit {

    width: 100%;
    min-height: 49px;

    margin-top: 18px;

    border: 0;
    border-radius: 999px;

    background: var(--orange);

    color: #fff;

    font: inherit;
    font-size: 12px;
    font-weight: 1000;

    cursor: pointer;
}


.checkout-submit:hover {

    background:
        var(--orange-dark);
}


.checkout-submit:disabled {

    opacity: .55;

    cursor: not-allowed;
}


.checkout-back {

    width: 100%;

    min-height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-top: 9px;

    border: 1px solid var(--line);
    border-radius: 999px;

    color: var(--dark);

    text-decoration: none;

    font-size: 10px;
    font-weight: 900;
}


/* =========================================================
   SECURITY INFO
========================================================= */

.checkout-security {

    margin-top: 14px;

    color: var(--muted);

    text-align: center;

    font-size: 9px;
    line-height: 1.5;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:900px) {

    .checkout-layout {

        grid-template-columns: 1fr;
    }


    .checkout-summary {

        position: static;
    }
}


@media(max-width:650px) {

    .order-types {

        grid-template-columns: 1fr;
    }


    .checkout-card {

        padding: 18px;

        border-radius: 20px;
    }


    .summary-product {

        grid-template-columns:
            50px minmax(0,1fr);
    }


    .summary-product-image {

        width: 50px;
        height: 50px;
    }


    .summary-product-price {

        grid-column: 2;
    }
}


/* 16.6 — TIOP+ CHECKOUT */
.loyalty-options{display:grid;gap:10px}.loyalty-option{display:block;cursor:pointer}.loyalty-option input{position:absolute;opacity:0;pointer-events:none}.loyalty-option-box{display:flex;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:16px;background:#fff;transition:.18s}.loyalty-option input:checked+.loyalty-option-box{border-color:var(--orange);box-shadow:0 0 0 3px rgba(255,121,0,.09);background:#fffaf4}.loyalty-icon{width:46px;height:46px;border-radius:13px;background:#fff0df;display:grid;place-items:center;overflow:hidden;flex:0 0 46px}.loyalty-icon img{width:100%;height:100%;object-fit:cover}.loyalty-copy{flex:1;min-width:0}.loyalty-copy strong{display:block;font-size:13px}.loyalty-copy small{display:block;color:var(--muted);margin-top:4px;line-height:1.4}.loyalty-badge{font-size:10px;font-weight:900;padding:5px 8px;border-radius:999px;background:#f3eee8}.summary-loyalty{color:#16753c}.summary-loyalty[hidden]{display:none!important}
</style>


<div class="checkout-container">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="checkout-header">

        <span class="checkout-eyebrow">
            🔒 Commande sécurisée
        </span>

        <h1 class="checkout-title">
            Finaliser la commande
        </h1>

        <p class="checkout-subtitle">
            Vérifiez votre panier, choisissez votre restaurant,
            votre mode de récupération et votre moyen de paiement.
        </p>

    </header>


    <!-- =====================================================
         ERREUR SERVEUR
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="checkout-error">
            ⚠️ <%= error %>
        </div>

    <% } %>


    <form
        id="checkoutForm"
        action="/checkout"
        method="POST"
    >

        <div class="checkout-layout">


            <!-- =================================================
                 COLONNE GAUCHE
            ================================================== -->

            <div class="checkout-left">


                <!-- =============================================
                     CLIENT
                ============================================== -->

                <section class="checkout-card">

                    <h2 class="checkout-card-title">
                        👤 Votre compte
                    </h2>


                    <div class="customer-box">

                        <div class="customer-avatar">

                            <% if (customer && customer.avatar_url) { %>

                                <img
                                    src="<%= customer.avatar_url %>"
                                    alt=""
                                >

                            <% } else { %>

                                👤

                            <% } %>

                        </div>


                        <div>

                            <div class="customer-name">

                                <%= customer?.display_name
                                    ||
                                    [
                                        customer?.first_name,
                                        customer?.last_name
                                    ]
                                    .filter(Boolean)
                                    .join(" ")
                                    ||
                                    "Client TiopTiop"
                                %>

                            </div>


                            <div class="customer-contact">

                                <% if (customer?.email) { %>
                                    <div>
                                        ✉️ <%= customer.email %>
                                    </div>
                                <% } %>

                                <% if (customer?.phone) { %>
                                    <div>
                                        📞 <%= customer.phone %>
                                    </div>
                                <% } %>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =============================================
                     RESTAURANT
                ============================================== -->

                <section class="checkout-card">

                    <h2 class="checkout-card-title">
                        🏪 Restaurant
                    </h2>

                    <p class="checkout-card-description">
                        Sélectionnez le restaurant qui préparera
                        votre commande.
                    </p>


                    <div class="checkout-field-group">

                        <label
                            for="restaurantId"
                            class="checkout-label"
                        >
                            Restaurant
                        </label>


                        <select
                            id="restaurantId"
                            name="restaurant_id"
                            class="checkout-field"
                            required
                        >

                            <% (restaurants || []).forEach(restaurant => { %>

                                <option
                                    value="<%= restaurant.id %>"

                                    data-supports-delivery="<%= Number(restaurant.supports_delivery) %>"
                                    data-supports-pickup="<%= Number(restaurant.supports_pickup) %>"
                                    data-supports-dine-in="<%= Number(restaurant.supports_dine_in) %>"

                                    <%= Number(values?.restaurant_id)
                                        === Number(restaurant.id)
                                            ? "selected"
                                            : ""
                                    %>
                                >

                                    <%= restaurant.name %>

                                    <% if (restaurant.district) { %>
                                        — <%= restaurant.district %>
                                    <% } %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                </section>


                <!-- =============================================
                     TYPE COMMANDE
                ============================================== -->

                <section class="checkout-card">

                    <h2 class="checkout-card-title">
                        🍽 Mode de commande
                    </h2>


                    <div class="order-types">


                        <!-- LIVRAISON -->

                        <label
                            class="order-type-card"
                            data-order-type-card="DELIVERY"
                        >

                            <input
                                type="radio"
                                name="order_type"
                                value="DELIVERY"

                                <%= (values?.order_type || "DELIVERY") === "DELIVERY"
                                    ? "checked"
                                    : ""
                                %>
                            >

                            <span class="order-type-icon">
                                🛵
                            </span>

                            <span class="order-type-title">
                                Livraison
                            </span>

                            <span class="order-type-description">
                                Livré à votre adresse.
                            </span>

                        </label>


                        <!-- RETRAIT -->

                        <label
                            class="order-type-card"
                            data-order-type-card="PICKUP"
                        >

                            <input
                                type="radio"
                                name="order_type"
                                value="PICKUP"

                                <%= values?.order_type === "PICKUP"
                                    ? "checked"
                                    : ""
                                %>
                            >

                            <span class="order-type-icon">
                                🥡
                            </span>

                            <span class="order-type-title">
                                À emporter
                            </span>

                            <span class="order-type-description">
                                Retrait au restaurant.
                            </span>

                        </label>


                        <!-- SUR PLACE -->

                        <label
                            class="order-type-card"
                            data-order-type-card="DINE_IN"
                        >

                            <input
                                type="radio"
                                name="order_type"
                                value="DINE_IN"

                                <%= values?.order_type === "DINE_IN"
                                    ? "checked"
                                    : ""
                                %>
                            >

                            <span class="order-type-icon">
                                🍽️
                            </span>

                            <span class="order-type-title">
                                Sur place
                            </span>

                            <span class="order-type-description">
                                Commande à consommer sur place.
                            </span>

                        </label>


                    </div>

                </section>


                <!-- =============================================
                     LIVRAISON
                ============================================== -->

                <section
                    class="checkout-card"
                    id="deliverySection"
                >

                    <h2 class="checkout-card-title">
                        📍 Livraison
                    </h2>


                    <!-- ADRESSES -->

                    <div class="checkout-field-group">

                        <label
                            for="deliveryAddressId"
                            class="checkout-label"
                        >
                            Adresse
                        </label>


                        <% if (
                            addresses &&
                            addresses.length > 0
                        ) { %>

                            <select
                                id="deliveryAddressId"
                                name="delivery_address_id"
                                class="checkout-field"
                            >

                                <option value="">
                                    Choisir une adresse
                                </option>


                                <% addresses.forEach(address => { %>

                                    <option
                                        value="<%= address.id %>"

                                        data-label="<%= address.label || '' %>"
                                        data-recipient="<%= address.recipient_name || '' %>"
                                        data-phone="<%= address.phone || '' %>"
                                        data-address1="<%= address.address_line1 || '' %>"
                                        data-address2="<%= address.address_line2 || '' %>"
                                        data-district="<%= address.district || '' %>"
                                        data-city="<%= address.city || '' %>"
                                        data-instructions="<%= address.delivery_instructions || '' %>"

                                        <%= Number(values?.delivery_address_id)
                                            === Number(address.id)
                                                ? "selected"
                                                : ""
                                        %>
                                    >

                                        <%= address.label || "Adresse" %>
                                        —
                                        <%= address.address_line1 %>

                                        <% if (address.district) { %>
                                            · <%= address.district %>
                                        <% } %>

                                    </option>

                                <% }) %>

                            </select>


                            <div
                                id="addressPreview"
                                class="address-preview"
                            ></div>


                            <a
                                href="/profil"
                                class="checkout-link"
                            >
                                + Gérer mes adresses
                            </a>


                        <% } else { %>


                            <div class="checkout-error">

                                Vous n'avez encore aucune
                                adresse de livraison.

                            </div>


                            <a
                                href="/profil"
                                class="checkout-link"
                            >
                                Ajouter une adresse →
                            </a>


                        <% } %>

                    </div>


                    <!-- ZONE -->

                    <div class="checkout-field-group">

                        <label
                            for="deliveryZoneId"
                            class="checkout-label"
                        >
                            Zone de livraison
                        </label>


                        <select
                            id="deliveryZoneId"
                            name="delivery_zone_id"
                            class="checkout-field"
                        >

                            <option value="">
                                Sélectionnez votre zone
                            </option>


                            <% (deliveryZones || []).forEach(zone => { %>

                                <option
                                    value="<%= zone.id %>"

                                    data-fee="<%= Number(zone.delivery_fee || 0) %>"
                                    data-min-order="<%= Number(zone.min_order || 0) %>"
                                    data-free-from="<%= zone.free_delivery_from !== null
                                        ? Number(zone.free_delivery_from)
                                        : ''
                                    %>"
                                    data-estimated-min="<%= zone.estimated_min_minutes || '' %>"
                                    data-estimated-max="<%= zone.estimated_max_minutes || '' %>"

                                    <%= Number(values?.delivery_zone_id)
                                        === Number(zone.id)
                                            ? "selected"
                                            : ""
                                    %>
                                >

                                    <%= zone.name %>

                                </option>

                            <% }) %>

                        </select>


                        <div
                            id="deliveryZoneInfo"
                            class="delivery-zone-info"
                        ></div>

                    </div>

                </section>


                <!-- =============================================
                     NOTE
                ============================================== -->

                <section class="checkout-card">

                    <h2 class="checkout-card-title">
                        📝 Note pour la commande
                    </h2>


                    <textarea
                        name="customer_note"
                        class="checkout-field"
                        maxlength="2000"
                        placeholder="Exemple : appeler à l'arrivée, sauce séparée..."
                    ><%= values?.customer_note || "" %></textarea>

                </section>


                <!-- =============================================
                     PAIEMENT
                ============================================== -->

                <section class="checkout-card">

                    <h2 class="checkout-card-title">
                        💳 Paiement
                    </h2>


                    <div class="payment-options">


                        <label class="payment-card">

                            <input
                                type="radio"
                                name="payment_method"
                                value="MOBILE_MONEY"

                                <%= values?.payment_method === "MOBILE_MONEY"
                                    ? "checked"
                                    : ""
                                %>
                            >

                            <div class="payment-icon">
                                📱
                            </div>

                            <div>

                                <div class="payment-name">
                                    Mobile Money
                                </div>

                                <div class="payment-description">
                                    Paiement mobile.
                                </div>

                            </div>

                        </label>


                        <label class="payment-card">

                            <input
                                type="radio"
                                name="payment_method"
                                value="CARD"

                                <%= values?.payment_method === "CARD"
                                    ? "checked"
                                    : ""
                                %>
                            >

                            <div class="payment-icon">
                                💳
                            </div>

                            <div>

                                <div class="payment-name">
                                    Carte bancaire
                                </div>

                                <div class="payment-description">
                                    Paiement par carte.
                                </div>

                            </div>

                        </label>


                        <label class="payment-card">

                            <input
                                type="radio"
                                name="payment_method"
                                value="CASH"

                                <%= !values?.payment_method
                                    || values?.payment_method === "CASH"
                                        ? "checked"
                                        : ""
                                %>
                            >

                            <div class="payment-icon">
                                💵
                            </div>

                            <div>

                                <div class="payment-name">
                                    Espèces
                                </div>

                                <div class="payment-description">
                                    Paiement lors de la récupération.
                                </div>

                            </div>

                        </label>


                    </div>

                    <div
                        id="momoPaymentFields"
                        class="momo-payment-fields <%= values?.payment_method === "MOBILE_MONEY" ? "visible" : "" %>"
                    >
                        <div class="checkout-field-group">
                            <label for="momoMsisdn" class="checkout-label">
                                Numéro MTN MoMo
                            </label>
                            <input
                                type="tel"
                                inputmode="numeric"
                                autocomplete="tel"
                                id="momoMsisdn"
                                name="momo_msisdn"
                                class="checkout-field"
                                value="<%= values?.momo_msisdn || customer?.phone || '' %>"
                                placeholder="Exemple : 24206XXXXXXX"
                                maxlength="20"
                            >
                            <div class="momo-payment-help">
                                Sandbox MTN : aucun argent réel n'est débité.
                            </div>
                        </div>
                    </div>

                </section>


                <!-- =============================================
                     16.6 — AVANTAGES TIOP+
                ============================================== -->
                <section class="checkout-card">
                    <h2 class="checkout-card-title">🎁 Mes avantages Tiop+</h2>
                    <p class="checkout-card-description">Un seul avantage peut être utilisé par commande. La vérification finale est faite côté serveur.</p>
                    <div class="loyalty-options">
                        <label class="loyalty-option">
                            <input type="radio" name="loyalty_redemption_public_id" value="" <%= !values?.loyalty_redemption_public_id ? 'checked' : '' %>>
                            <span class="loyalty-option-box"><span class="loyalty-icon">✕</span><span class="loyalty-copy"><strong>Ne pas utiliser d’avantage</strong><small>Conserver mes récompenses pour plus tard.</small></span></span>
                        </label>
                        <% (availableRedemptions || []).forEach(function(redemption){ %>
                            <label class="loyalty-option">
                                <input type="radio" name="loyalty_redemption_public_id" value="<%= redemption.public_id %>"
                                  data-type="<%= redemption.reward_type %>" data-value="<%= Number(redemption.reward_value || 0) %>"
                                  data-name="<%= redemption.name %>"
                                  <%= values?.loyalty_redemption_public_id === redemption.public_id ? 'checked' : '' %>>
                                <span class="loyalty-option-box">
                                    <span class="loyalty-icon"><% if(redemption.image_url){ %><img src="<%= redemption.image_url %>" alt=""><% } else { %>🎁<% } %></span>
                                    <span class="loyalty-copy"><strong><%= redemption.name %></strong><small><%= redemption.description || 'Avantage Tiop+ débloqué' %></small></span>
                                    <span class="loyalty-badge"><%= redemption.reward_type %></span>
                                </span>
                            </label>
                        <% }) %>
                    </div>
                </section>
            </div>


            <!-- =================================================
                 RECAPITULATIF
            ================================================== -->

            <aside
                class="checkout-card checkout-summary"
            >

                <h2 class="checkout-card-title">
                    Votre commande
                </h2>


                <div class="summary-products">


                    <% (items || []).forEach(item => { %>

                        <article class="summary-product">


                            <div class="summary-product-image">

                                <% if (item.image_url) { %>

                                    <img
                                        src="<%= item.image_url %>"
                                        alt="<%= item.item_name %>"
                                    >

                                <% } else { %>

                                    <%= item.item_type === "FORMULA"
                                        ? "🍱"
                                        : "🍽️"
                                    %>

                                <% } %>

                            </div>


                            <div>

                                <h3 class="summary-product-name">

                                    <%= item.quantity %>×
                                    <%= item.item_name %>

                                </h3>


                                <div class="summary-product-meta">

                                    <%= item.item_type === "FORMULA"
                                        ? "Formule"
                                        : "Produit"
                                    %>

                                </div>


                                <% if (
                                    item.options &&
                                    item.options.length
                                ) { %>

                                    <div class="summary-product-options">

                                        <% item.options.forEach(option => { %>

                                            <div>

                                                <% if (option.group_name) { %>

                                                    <%= option.group_name %> :

                                                <% } %>

                                                <%= option.value_name %>

                                            </div>

                                        <% }) %>

                                    </div>

                                <% } %>


                                <% if (item.instructions) { %>

                                    <div class="summary-product-options">
                                        📝 <%= item.instructions %>
                                    </div>

                                <% } %>

                            </div>


                            <strong class="summary-product-price">

                                <%= Number(
                                    item.line_total || 0
                                ).toLocaleString("fr-FR") %>

                                <%= item.currency || currency || "XAF" %>

                            </strong>

                        </article>

                    <% }) %>


                </div>


                <div class="summary-separator"></div>


                <!-- SOUS TOTAL -->

                <div class="summary-row">

                    <span>
                        Sous-total
                    </span>

                    <strong
                        id="checkoutSubtotal"
                        data-subtotal="<%= Number(cart.subtotal || 0) %>"
                    >

                        <%= Number(
                            cart.subtotal || 0
                        ).toLocaleString("fr-FR") %>

                        <%= currency || "XAF" %>

                    </strong>

                </div>


                <!-- LIVRAISON -->

                <div class="summary-row">

                    <span>
                        Livraison
                    </span>

                    <strong id="checkoutDeliveryFee">
                        0 <%= currency || "XAF" %>
                    </strong>

                </div>



                <div id="loyaltySummaryRow" class="summary-row summary-loyalty" hidden>
                    <span id="loyaltySummaryLabel">🎁 Avantage Tiop+</span>
                    <strong id="loyaltySummaryAmount">—</strong>
                </div>

                <!-- TOTAL -->

                <div class="summary-total">

                    <span>
                        À payer
                    </span>

                    <strong id="checkoutTotal">

                        <%= Number(
                            cart.subtotal || 0
                        ).toLocaleString("fr-FR") %>

                        <%= currency || "XAF" %>

                    </strong>

                </div>


                <!-- MINIMUM -->

                <div
                    id="minimumOrderWarning"
                    class="summary-minimum-warning"
                ></div>


                <!-- SUBMIT -->

                <button
                    type="submit"
                    id="checkoutSubmit"
                    class="checkout-submit"
                >
                    Confirmer la commande
                </button>


                <a
                    href="/panier"
                    class="checkout-back"
                >
                    ← Retour au panier
                </a>


                <div class="checkout-security">

                    🔒 Les montants sont recalculés
                    côté serveur avant création de la commande.

                </div>

            </aside>

        </div>

    </form>

</div>


<script>
    window.TIOP_CHECKOUT = {
        currency:
            <%- JSON.stringify(currency || "XAF") %>
    };
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const fields = document.getElementById("momoPaymentFields");
    const input = document.getElementById("momoMsisdn");
    const radios = document.querySelectorAll('input[name="payment_method"]');

    function refreshMomoFields() {
        const selected = document.querySelector('input[name="payment_method"]:checked');
        const isMomo = selected && selected.value === "MOBILE_MONEY";
        if (fields) fields.classList.toggle("visible", Boolean(isMomo));
        if (input) input.required = Boolean(isMomo);
    }

    radios.forEach(radio => radio.addEventListener("change", refreshMomoFields));
    refreshMomoFields();
});
</script>

<script src="/js/checkout.js"></script>

</section>