<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            🧾 Mon espace
        </span>

        <h2>
            🧾 Mes commandes
        </h2>

        <p>
            Retrouvez vos commandes,
            factures et leur suivi.
        </p>

    </div>

</section>


<div class="container">


<style>

.tiop-orders-block {

    --orange: #ff7900;
    --orange-hover: #e96f00;
    --text: #1c1916;
    --muted: #77716c;
    --border: #e5dfd9;
    --card: #ffffff;

    padding-bottom: 70px;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    color: var(--text);
}


.orders-filters {

    display: grid;

    grid-template-columns:
        minmax(230px, 1.8fr)
        minmax(180px, 1fr)
        minmax(160px, 1fr)
        auto
        auto;

    gap: 10px;

    padding: 14px;

    margin-bottom: 22px;

    background: #fff;

    border-radius: 23px;
}


.orders-field {

    width: 100%;
    height: 52px;

    padding: 0 14px;

    box-sizing: border-box;

    border:
        1px solid var(--border);

    border-radius: 15px;

    background: #fff;

    color: var(--text);

    font-size: 14px;

    outline: none;
}


.orders-field:focus {

    border-color:
        var(--orange);

    box-shadow:
        0 0 0 3px
        rgba(255,121,0,.08);
}


.orders-filter-button,
.orders-reset-button {

    min-height: 52px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0 18px;

    border-radius: 999px;

    font-weight: 900;
    font-size: 13px;

    text-decoration: none;

    cursor: pointer;
}


.orders-filter-button {

    border: 0;

    background:
        var(--orange);

    color: #fff;
}


.orders-reset-button {

    border:
        1px solid var(--border);

    background: #fff;

    color: var(--text);
}


.orders-count {

    margin-bottom: 16px;

    color: var(--muted);

    font-size: 13px;
}


.orders-count strong {

    color: var(--text);
}


.orders-list {

    display: flex;

    flex-direction: column;

    gap: 14px;
}


.order-card {

    display: grid;

    grid-template-columns:
        55px
        minmax(0,1fr)
        auto;

    gap: 15px;

    align-items: center;

    padding: 17px;

    background: var(--card);

    border:
        1px solid var(--border);

    border-radius: 22px;
}


.order-icon {

    width: 52px;
    height: 52px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 15px;

    background: #fff0df;

    font-size: 22px;
}


.order-information {

    min-width: 0;
}


.order-number {

    display: block;

    margin-bottom: 5px;

    font-size: 15px;
    font-weight: 900;
}


.order-meta {

    margin-bottom: 5px;

    color: var(--muted);

    font-size: 12px;
}


.order-description {

    margin: 0;

    max-width: 700px;

    color: var(--muted);

    font-size: 13px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


.order-right {

    display: flex;

    flex-direction: column;

    align-items: flex-end;

    gap: 10px;
}


.order-summary {

    display: flex;

    align-items: center;

    gap: 10px;
}


.order-status {

    display: inline-flex;

    align-items: center;

    min-height: 28px;

    padding: 0 11px;

    border-radius: 999px;

    background: #fff0df;

    color: #a85a00;

    font-size: 10px;
    font-weight: 900;
}


.order-status.delivered {

    background: #eaf8ef;

    color: #267347;
}


.order-status.cancelled {

    background: #fff0f0;

    color: #b93838;
}


.order-price {

    font-size: 15px;
    font-weight: 1000;

    white-space: nowrap;
}


.order-buttons {

    display: flex;

    gap: 7px;

    flex-wrap: wrap;

    justify-content: flex-end;
}


.order-button {

    min-height: 36px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0 13px;

    border-radius: 999px;

    text-decoration: none;

    font-size: 11px;
    font-weight: 900;

    transition: .2s ease;
}


.order-button.view {

    background:
        var(--orange);

    color: #fff;
}


.order-button.invoice {

    background: #fff;

    color: var(--text);

    border:
        1px solid var(--border);
}


.order-button.track {

    background: #1c1916;

    color: #fff;
}


.order-button:hover {

    transform:
        translateY(-1px);
}


.orders-empty {

    padding: 60px 25px;

    text-align: center;

    background: #fff;

    border:
        1px solid var(--border);

    border-radius: 24px;
}


.orders-empty-icon {

    margin-bottom: 15px;

    font-size: 55px;
}


.orders-empty h3 {

    margin:
        0 0 8px;

    font-size: 22px;
}


.orders-empty p {

    color: var(--muted);
}


.orders-empty a {

    min-height: 42px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    margin-top: 10px;

    padding: 0 18px;

    border-radius: 999px;

    background:
        var(--orange);

    color: #fff;

    text-decoration: none;

    font-size: 12px;
    font-weight: 900;
}


@media(max-width:950px) {

    .orders-filters {

        grid-template-columns:
            1fr 1fr;
    }


    .order-card {

        grid-template-columns:
            52px minmax(0,1fr);
    }


    .order-right {

        grid-column:
            2;

        align-items:
            flex-start;
    }


    .order-buttons {

        justify-content:
            flex-start;
    }
}


@media(max-width:600px) {

    .orders-filters {

        grid-template-columns:
            1fr;
    }


    .order-card {

        grid-template-columns:
            45px minmax(0,1fr);

        padding: 14px;
    }


    .order-icon {

        width: 45px;
        height: 45px;
    }


    .order-description {

        white-space:
            normal;
    }


    .order-summary {

        flex-wrap: wrap;
    }


    .order-buttons {

        width: 100%;
    }


    .order-button {

        flex: 1;
    }
}

</style>


<%

const money = value =>
    Number(value || 0)
        .toLocaleString(
            "fr-FR",
            {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }
        );


const dateTime = value => {

    if (!value) {
        return "";
    }


    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {
        return "";
    }


    return date.toLocaleString(
        "fr-FR",
        {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        }
    );
};


const statusLabels = {

    RECEIVED:
        "Commande reçue",

    CONFIRMED:
        "Confirmée",

    PREPARING:
        "En préparation",

    READY:
        "Prête",

    PICKED_UP:
        "Retirée",

    ON_THE_WAY:
        "En livraison",

    DELIVERED:
        "Livrée",

    CANCELLED:
        "Annulée",

    REFUNDED:
        "Remboursée"
};


const typeLabels = {

    DELIVERY:
        "Livraison",

    PICKUP:
        "À emporter",

    DINE_IN:
        "Sur place"
};

%>


<section class="tiop-orders-block">


    <form
        class="orders-filters"
        action="/commandes"
        method="GET"
    >


        <input
            type="search"
            name="search"
            class="orders-field"
            placeholder="Référence, produit ou restaurant"
            value="<%= filters?.search || '' %>"
        >


        <select
            name="status"
            class="orders-field"
        >

            <option value="">
                Tous les statuts
            </option>


            <option
                value="RECEIVED"
                <%= filters?.status === "RECEIVED"
                    ? "selected"
                    : ""
                %>
            >
                Commande reçue
            </option>


            <option
                value="CONFIRMED"
                <%= filters?.status === "CONFIRMED"
                    ? "selected"
                    : ""
                %>
            >
                Confirmée
            </option>


            <option
                value="PREPARING"
                <%= filters?.status === "PREPARING"
                    ? "selected"
                    : ""
                %>
            >
                En préparation
            </option>


            <option
                value="READY"
                <%= filters?.status === "READY"
                    ? "selected"
                    : ""
                %>
            >
                Prête
            </option>


            <option
                value="ON_THE_WAY"
                <%= filters?.status === "ON_THE_WAY"
                    ? "selected"
                    : ""
                %>
            >
                En livraison
            </option>


            <option
                value="DELIVERED"
                <%= filters?.status === "DELIVERED"
                    ? "selected"
                    : ""
                %>
            >
                Livrée
            </option>


            <option
                value="CANCELLED"
                <%= filters?.status === "CANCELLED"
                    ? "selected"
                    : ""
                %>
            >
                Annulée
            </option>

        </select>


        <input
            type="number"
            name="maxPrice"
            class="orders-field"
            placeholder="Prix maximum"
            min="0"
            value="<%= filters?.maxPrice || '' %>"
        >


        <button
            type="submit"
            class="orders-filter-button"
        >
            Filtrer
        </button>


        <a
            href="/commandes"
            class="orders-reset-button"
        >
            Réinitialiser
        </a>

    </form>


    <div class="orders-count">

        <strong>
            <%= (orders || []).length %>
        </strong>

        commande(s)

    </div>


    <div class="orders-list">


        <% if (
            !orders ||
            orders.length === 0
        ) { %>


            <div class="orders-empty">

                <div class="orders-empty-icon">
                    🧾
                </div>


                <h3>
                    Aucune commande
                </h3>


                <p>

                    Vous n'avez aucune commande
                    correspondant à votre recherche.

                </p>


                <a href="/menu">
                    Découvrir le menu
                </a>

            </div>


        <% } %>


        <% (orders || [])
            .forEach(order => { %>


            <article class="order-card">


                <div class="order-icon">

                    <%= order.order_type === "DELIVERY"
                        ? "🛵"
                        : order.order_type === "PICKUP"
                            ? "🥡"
                            : "🍽️"
                    %>

                </div>


                <div class="order-information">


                    <strong class="order-number">

                        <%= order.reference %>

                    </strong>


                    <div class="order-meta">

                        <%= dateTime(
                            order.created_at
                        ) %>

                        ·

                        <%= typeLabels[
                            order.order_type
                        ] || order.order_type %>

                        ·

                        <%= order.restaurant_name %>

                    </div>


                    <p class="order-description">

                        <%= order.items_summary
                            || "Commande TiopTiop"
                        %>

                    </p>

                </div>


                <div class="order-right">


                    <div class="order-summary">


                        <span
                            class="
                                order-status

                                <%= order.status === "DELIVERED"
                                    ? "delivered"
                                    : ""
                                %>

                                <%= order.status === "CANCELLED"
                                    ? "cancelled"
                                    : ""
                                %>
                            "
                        >

                            <%= statusLabels[
                                order.status
                            ] || order.status %>

                        </span>


                        <strong class="order-price">

                            <%= money(
                                order.total_amount
                            ) %>

                            <%= order.currency
                                || "XAF"
                            %>

                        </strong>

                    </div>


                    <div class="order-buttons">


                        <a
                            href="/commande/confirmation/<%= encodeURIComponent(order.reference) %>"
                            class="order-button view"
                        >
                            👁 Voir
                        </a>


                        <a
                            href="/commande/<%= encodeURIComponent(order.reference) %>/facture"
                            class="order-button invoice"
                        >
                            🧾 Facture
                        </a>


                        <a
                            href="/commande/<%= encodeURIComponent(order.reference) %>/suivi"
                            class="order-button track"
                        >
                            🛵 Suivre
                        </a>


                    </div>

                </div>

            </article>


        <% }) %>


    </div>

</section>


</div>