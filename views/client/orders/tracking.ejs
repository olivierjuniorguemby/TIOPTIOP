.tracking-primary-btn,.tracking-secondary-btn{min-height:43px;display:inline-flex;align-items:center;justify-content:center;padding:0 18px;border-radius:999px;text-decoration:none;font-size:11px;font-weight:900}
.tracking-primary-btn{background:#ff7900;color:#fff}
.tracking-secondary-btn{border:1px solid #e1dcd7;background:#fff;color:#1b1714}
