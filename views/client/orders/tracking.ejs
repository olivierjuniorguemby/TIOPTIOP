#trackingMap{width:100%;height:390px;border-radius:22px;overflow:hidden;z-index:1}
.tracking-map-warning{position:absolute;left:20px;right:20px;bottom:20px;z-index:500;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.95);color:#7a5b3d;font-size:10px;font-weight:800;box-shadow:0 4px 18px rgba(0,0,0,.12)}
.tracking-driver-card,.tracking-payment,.tracking-status-card{padding:25px;border-radius:24px;background:#fff;box-shadow:0 15px 40px rgba(32,20,10,.05)}
.tracking-driver-card h3,.tracking-payment h3{margin:0 0 12px}
