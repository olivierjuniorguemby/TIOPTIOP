<script>
document.addEventListener("DOMContentLoaded", function () {

    console.log("Leaflet chargé :", typeof L);

    const mapContainer =
        document.getElementById("trackingMap");

    console.log(
        "Conteneur carte :",
        mapContainer
    );

    if (!mapContainer) {
        console.error(
            "ERREUR : #trackingMap n'existe pas."
        );
        return;
    }

    if (typeof L === "undefined") {
        console.error(
            "ERREUR : Leaflet n'est pas chargé."
        );
        return;
    }

    // Centre de Brazzaville
    const restaurant = [-4.2634, 15.2429];

    // Client
    const client = [-4.2505, 15.2650];

    // Livreur
    const driver = [-4.2575, 15.2520];


    /* ==============================
       CRÉATION DE LA CARTE
    ============================== */

    const map = L.map("trackingMap").setView(
        restaurant,
        14
    );


    /* ==============================
       OPENSTREETMAP
    ============================== */

    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution:
                '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);


    /* ==============================
       RESTAURANT
    ============================== */

    L.marker(restaurant)
        .addTo(map)
        .bindPopup(
            "<strong>🍽️ TiopTiop</strong><br>Restaurant"
        );


    /* ==============================
       LIVREUR
    ============================== */

    const driverIcon = L.divIcon({

        className: "",

        html: `
            <div style="
                width:50px;
                height:50px;
                background:#ff7900;
                border:4px solid white;
                border-radius:50%;
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:27px;
                box-shadow:0 5px 20px rgba(0,0,0,.3);
            ">
                🛵
            </div>
        `,

        iconSize: [50, 50],
        iconAnchor: [25, 25]

    });


    const driverMarker = L.marker(
        driver,
        {
            icon: driverIcon
        }
    )
    .addTo(map)
    .bindPopup(
        "<strong>Junior</strong><br>Votre livreur"
    );


    /* ==============================
       CLIENT
    ============================== */

    L.marker(client)
        .addTo(map)
        .bindPopup(
            "<strong>🏠 Vous</strong><br>Adresse de livraison"
        );


    /* ==============================
       TRAJET
    ============================== */

    L.polyline(
        [
            restaurant,
            driver,
            client
        ],
        {
            weight: 6,
            opacity: 0.8
        }
    ).addTo(map);


    /* Correction affichage Leaflet */

    setTimeout(function () {
        map.invalidateSize();
    }, 300);


    console.log(
        "✅ Carte TiopTiop initialisée"
    );

});
</script>