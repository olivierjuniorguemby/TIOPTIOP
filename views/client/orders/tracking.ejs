<%
    const statusLabels = {
        RECEIVED: "Commande reçue",
        CONFIRMED: "Confirmée",
        PREPARING: "En préparation",
        READY: "Prête",
        PICKED_UP: "Retirée",
        ON_THE_WAY: "En livraison",
        DELIVERED: "Livrée",
        CANCELLED: "Annulée",
        REFUNDED: "Remboursée"
    };


    const paymentLabels = {
        CARD: "Carte bancaire",
        MOBILE_MONEY: "Mobile Money",
        CASH: "Espèces"
    };


    const paymentStatusLabels = {
        PENDING: "En attente",
        AUTHORIZED: "Autorisé",
        PAID: "Payé",
        FAILED: "Échoué",
        CANCELLED: "Annulé",
        PARTIAL: "Partiel",
        REFUNDED: "Remboursé"
    };


    const workflows = {

        DELIVERY: [
            "RECEIVED",
            "CONFIRMED",
            "PREPARING",
            "READY",
            "ON_THE_WAY",
            "DELIVERED"
        ],

        PICKUP: [
            "RECEIVED",
            "CONFIRMED",
            "PREPARING",
            "READY",
            "PICKED_UP"
        ],

        DINE_IN: [
            "RECEIVED",
            "CONFIRMED",
            "PREPARING",
            "READY",
            "DELIVERED"
        ]
    };


    const currentWorkflow =
        workflows[order.order_type]
        ||
        workflows.DELIVERY;


    const currentStatus =
        String(
            order.status || "RECEIVED"
        );


    const currentStatusIndex =
        currentWorkflow.indexOf(
            currentStatus
        );


    const restaurantLat =
        delivery?.restaurant_latitude !== null &&
        delivery?.restaurant_latitude !== undefined
            ? Number(delivery.restaurant_latitude)

            : order?.restaurant_latitude !== null &&
              order?.restaurant_latitude !== undefined
                ? Number(order.restaurant_latitude)
                : null;


    const restaurantLng =
        delivery?.restaurant_longitude !== null &&
        delivery?.restaurant_longitude !== undefined
            ? Number(delivery.restaurant_longitude)

            : order?.restaurant_longitude !== null &&
              order?.restaurant_longitude !== undefined
                ? Number(order.restaurant_longitude)
                : null;


    const destinationLat =
        delivery?.delivery_latitude !== null &&
        delivery?.delivery_latitude !== undefined
            ? Number(delivery.delivery_latitude)

            : order?.delivery_latitude !== null &&
              order?.delivery_latitude !== undefined
                ? Number(order.delivery_latitude)
                : null;


    const destinationLng =
        delivery?.delivery_longitude !== null &&
        delivery?.delivery_longitude !== undefined
            ? Number(delivery.delivery_longitude)

            : order?.delivery_longitude !== null &&
              order?.delivery_longitude !== undefined
                ? Number(order.delivery_longitude)
                : null;


    const initialDriverLat =
        latestTrackingPoint
        &&
        latestTrackingPoint.latitude !== null
        &&
        latestTrackingPoint.latitude !== undefined

            ? Number(
                latestTrackingPoint.latitude
            )

            : null;


    const initialDriverLng =
        latestTrackingPoint
        &&
        latestTrackingPoint.longitude !== null
        &&
        latestTrackingPoint.longitude !== undefined

            ? Number(
                latestTrackingPoint.longitude
            )

            : null;
%>


<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="/socket.io/socket.io.js"></script>

<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>


<section class="section">

<div class="container">

<section class="tracking-page">


    <header class="tracking-heading">

        <span class="tracking-live">
            🛵 Suivi en temps réel
        </span>


        <h1>
            Suivi <%= order.reference %>
        </h1>


        <p>
            Le statut et la position du livreur sont synchronisés
            en temps réel avec TiopTiop.
        </p>


        <div
            id="liveConnectionState"
            class="tracking-connection"
        >
            Connexion au suivi…
        </div>

    </header>


    <div class="tracking-layout">


        <div class="tracking-left">


            <section class="tracking-map-card">

                <div id="trackingMap"></div>


                <div
                    id="mapMissingCoordinates"
                    class="tracking-map-warning"
                    hidden
                ></div>

            </section>


            <section class="tracking-driver-card">

                <h3 id="driverCardTitle">

                    🛵
                    <%= delivery?.driver_name
                        || "Livraison TiopTiop"
                    %>

                </h3>


                <p id="driverCardDetails">

                    <% if (delivery?.driver_name) { %>

                        Livreur affecté

                        <% if (delivery.driver_phone) { %>
                            · 📞 <%= delivery.driver_phone %>
                        <% } %>

                        <% if (delivery.estimated_arrival) { %>

                            <br>

                            Arrivée estimée :

                            <strong>
                                <%= new Date(
                                    delivery.estimated_arrival
                                ).toLocaleString(
                                    "fr-FR"
                                ) %>
                            </strong>

                        <% } %>

                    <% } else { %>

                        Votre commande attend encore
                        l'affectation d'un livreur.

                    <% } %>

                </p>


                <p>

                    <span id="driverOperationalStatus"></span>

                    <br>

                    <span id="gpsStatus">

                        <% if (latestTrackingPoint) { %>

                            Dernière position GPS :

                            <%= new Date(
                                latestTrackingPoint.recorded_at
                            ).toLocaleString(
                                "fr-FR"
                            ) %>

                        <% } else { %>

                            En attente de la première position GPS du livreur.

                        <% } %>

                    </span>

                </p>


                <div
                    id="gpsMetrics"
                    class="tracking-gps-metrics"
                    <%= latestTrackingPoint
                        ? ""
                        : "hidden"
                    %>
                >

                    <span>
                        Précision :
                        <strong id="gpsAccuracyClient">
                            <%= latestTrackingPoint?.accuracy_meters !== null
                                && latestTrackingPoint?.accuracy_meters !== undefined
                                    ? Math.round(
                                        Number(
                                            latestTrackingPoint.accuracy_meters
                                        )
                                    ) + " m"
                                    : "—"
                            %>
                        </strong>
                    </span>


                    <span>
                        Vitesse :
                        <strong id="gpsSpeedClient">
                            <%= latestTrackingPoint?.speed_kmh !== null
                                && latestTrackingPoint?.speed_kmh !== undefined
                                    ? Number(
                                        latestTrackingPoint.speed_kmh
                                    ).toFixed(1)
                                        + " km/h"
                                    : "—"
                            %>
                        </strong>
                    </span>

                </div>


                <div class="tracking-driver-actions">

                    <a
                        href="/contact"
                        class="tracking-secondary-btn"
                    >
                        💬 Contacter TiopTiop
                    </a>

                </div>

            </section>


        </div>


        <div class="tracking-right">


            <section class="tracking-status-card">

                <span class="tracking-status-label">
                    Statut actuel
                </span>

                <strong
                    id="currentOrderStatus"
                    class="tracking-status-current"
                >
                    <%= statusLabels[currentStatus]
                        || currentStatus
                    %>
                </strong>

                <small id="lastStatusUpdate">

                    Dernière mise à jour :

                    <%= order.updated_at
                        ? new Date(
                            order.updated_at
                        ).toLocaleString(
                            "fr-FR"
                        )
                        : "—"
                    %>

                </small>

            </section>


            <section
                id="trackingSteps"
                class="tracking-steps"
            >


                <% currentWorkflow
                    .forEach(
                        (status, index) => {

                            let stateClass =
                                "";


                            if (
                                currentStatusIndex >= 0
                            ) {

                                if (
                                    index <
                                    currentStatusIndex
                                ) {

                                    stateClass =
                                        "completed";
                                }
                                else if (
                                    index ===
                                    currentStatusIndex
                                ) {

                                    stateClass =
                                        "active";
                                }
                            }

                %>


                    <div
                        class="tracking-step <%= stateClass %>"
                        data-status="<%= status %>"
                    >

                        <span class="tracking-number">
                            <%= index + 1 %>
                        </span>


                        <div>

                            <strong>
                                <%= statusLabels[status]
                                    || status
                                %>
                            </strong>

                            <small>

                                <%= stateClass === "active"
                                    ? "Étape actuelle"
                                    : stateClass === "completed"
                                        ? "Terminée"
                                        : "À venir"
                                %>

                            </small>

                        </div>

                    </div>


                <% }) %>


            </section>


            <section
                id="exceptionStatus"
                class="tracking-exception"
                <%= (
                    currentStatus === "CANCELLED"
                    ||
                    currentStatus === "REFUNDED"
                )
                    ? ""
                    : "hidden"
                %>
            >

                <% if (
                    currentStatus === "CANCELLED"
                    ||
                    currentStatus === "REFUNDED"
                ) { %>

                    <strong>
                        <%= statusLabels[currentStatus]
                            || currentStatus
                        %>
                    </strong>

                    <span>
                        Consultez votre historique de commande
                        pour plus d'informations.
                    </span>

                <% } %>

            </section>


            <section class="tracking-payment">

                <h3>
                    Paiement
                </h3>


                <p>

                    Moyen :

                    <strong>
                        <%= payment
                            ? (
                                paymentLabels[
                                    payment.method
                                ]
                                ||
                                payment.method
                            )
                            : "—"
                        %>
                    </strong>

                </p>


                <p>

                    Statut :

                    <span class="tracking-paid">

                        <%= payment
                            ? (
                                paymentStatusLabels[
                                    payment.status
                                ]
                                ||
                                payment.status
                            )
                            : "—"
                        %>

                    </span>

                </p>

            </section>


            <a
                href="/commande/confirmation/<%= encodeURIComponent(order.reference) %>"
                class="tracking-primary-btn"
            >
                Voir le détail de la commande
            </a>


        </div>


    </div>


</section>

</div>

</section>


<style>

.tracking-page{
max-width:1180px;margin:0 auto;padding:35px 20px 80px
}
.tracking-heading{margin-bottom:45px}
.tracking-live{display:inline-flex;padding:8px 15px;background:#fff0df;color:#ff7900;border-radius:30px;font-size:13px;font-weight:800}
.tracking-heading h1{margin:22px 0 10px;font-size:clamp(42px,6vw,72px);line-height:.95;letter-spacing:-4px;color:#17130f}
.tracking-heading p{max-width:680px;color:#746d66;font-size:16px;line-height:1.7}
.tracking-connection{display:inline-flex;align-items:center;min-height:28px;margin-top:12px;padding:0 10px;border-radius:999px;background:#f2f0ed;color:#716962;font-size:10px;font-weight:900}
.tracking-connection.connected{background:#eaf8ef;color:#277347}
