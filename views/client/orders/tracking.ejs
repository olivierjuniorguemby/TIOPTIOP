<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const orderReference =
            <%- JSON.stringify(order.reference) %>;


        const orderType =
            <%- JSON.stringify(order.order_type) %>;


        let currentStatus =
            <%- JSON.stringify(currentStatus) %>;


        const statusLabels =
            <%- JSON.stringify(statusLabels) %>;


        const workflows =
            <%- JSON.stringify(workflows) %>;


        const restaurant = {

            lat:
                <%- JSON.stringify(restaurantLat) %>,

            lng:
                <%- JSON.stringify(restaurantLng) %>
        };


        const destination = {

            lat:
                <%- JSON.stringify(destinationLat) %>,

            lng:
                <%- JSON.stringify(destinationLng) %>
        };


        let driverPosition = {

            lat:
                <%- JSON.stringify(initialDriverLat) %>,

            lng:
                <%- JSON.stringify(initialDriverLng) %>
        };


        const currentStatusElement =
            document.getElementById(
                "currentOrderStatus"
            );


        const lastUpdateElement =
            document.getElementById(
                "lastStatusUpdate"
            );


        const connectionElement =
            document.getElementById(
                "liveConnectionState"
            );


        const exceptionElement =
            document.getElementById(
                "exceptionStatus"
            );


        const gpsStatusElement =
            document.getElementById(
                "gpsStatus"
            );


        const gpsMetricsElement =
            document.getElementById(
                "gpsMetrics"
            );


        const gpsAccuracyElement =
            document.getElementById(
                "gpsAccuracyClient"
            );


        const gpsSpeedElement =
            document.getElementById(
                "gpsSpeedClient"
            );


        const mapWarning =
            document.getElementById(
                "mapMissingCoordinates"
            );


        function isCoordinate(
            value
        ) {

            return typeof value ===
                "number"
                &&
                Number.isFinite(
                    value
                );
        }


        function escapeHtml(
            value
        ) {

            const div =
                document.createElement(
                    "div"
                );


            div.textContent =
                String(
                    value || ""
                );


            return div.innerHTML;
        }


        /* =================================================
           STATUT COMMANDE
        ================================================= */

        function renderStatus(
            status,
            changedAt = null
        ) {

            currentStatus =
                status;


            if (
                currentStatusElement
            ) {

                currentStatusElement.textContent =
                    statusLabels[status]
                    ||
                    status;
            }


            if (
                lastUpdateElement
            ) {

                lastUpdateElement.textContent =
                    "Dernière mise à jour : "
                    +
                    new Date(
                        changedAt
                        ||
                        Date.now()
                    ).toLocaleString(
                        "fr-FR"
                    );
            }


            const workflow =
                workflows[orderType]
                ||
                workflows.DELIVERY;


            const currentIndex =
                workflow.indexOf(
                    status
                );


            document
                .querySelectorAll(
                    ".tracking-step"
                )
                .forEach(
                    (
                        element,
                        index
                    ) => {

                        element.classList.remove(
                            "active",
                            "completed"
                        );


                        const small =
                            element.querySelector(
                                "small"
                            );


                        if (
                            currentIndex >= 0
                            &&
                            index <
                            currentIndex
                        ) {

                            element.classList.add(
                                "completed"
                            );


                            if (small) {
                                small.textContent =
                                    "Terminée";
                            }
                        }
                        else if (
                            currentIndex >= 0
                            &&
                            index ===
                            currentIndex
                        ) {

                            element.classList.add(
                                "active"
                            );


                            if (small) {
                                small.textContent =
                                    "Étape actuelle";
                            }
                        }
                        else if (small) {

                            small.textContent =
                                "À venir";
                        }
                    }
                );


            if (
                status === "CANCELLED"
                ||
                status === "REFUNDED"
            ) {

                exceptionElement.hidden =
                    false;


                exceptionElement.innerHTML =
                    `
                        <strong>
                            ${escapeHtml(
                                statusLabels[status]
                                ||
                                status
                            )}
                        </strong>

                        <span>
                            Consultez le détail de la commande
                            pour plus d'informations.
                        </span>
                    `;
            }
            else {

                exceptionElement.hidden =
                    true;


                exceptionElement.innerHTML =
                    "";
            }
        }


        /* =================================================
           LEAFLET - VRAIES COORDONNEES
        ================================================= */

        const map =
            L
                .map(
                    "trackingMap"
                )
                .setView(
                    [0, 0],
                    2
                );


        L
            .tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom:
                        19,

                    attribution:
                        "&copy; OpenStreetMap"
                }
            )
            .addTo(
                map
            );


        let restaurantMarker =
            null;


        let destinationMarker =
            null;


        let driverMarker =
            null;


        let route =
            null;


        const driverIcon =
            L.divIcon({
                className:
                    "",

                html:
                    `
                        <div style="
                            width:50px;
                            height:50px;
                            background:#ff7900;
                            border:4px solid white;
                            border-radius:50%;
                            display:flex;
                            align-items:center;
                            justify-content:center;
                            font-size:27px;
                            box-shadow:0 5px 20px rgba(0,0,0,.3);
                        ">
                            🛵
                        </div>
                    `,

                iconSize:
                    [50, 50],

                iconAnchor:
                    [25, 25]
            });


        if (
            isCoordinate(
                restaurant.lat
            )
            &&
            isCoordinate(
                restaurant.lng
            )
        ) {

            restaurantMarker =
                L
                    .marker([
                        restaurant.lat,
                        restaurant.lng
                    ])
                    .addTo(
                        map
                    )
                    .bindPopup(
                        "<strong>🍽️ Restaurant TiopTiop</strong>"
                    );
        }


        if (
            isCoordinate(
                destination.lat
            )
            &&
            isCoordinate(
                destination.lng
            )
        ) {

            destinationMarker =
                L
                    .marker([
                        destination.lat,
                        destination.lng
                    ])
                    .addTo(
                        map
                    )
                    .bindPopup(
                        "<strong>🏠 Destination</strong>"
                    );
        }
        else if (mapWarning) {

            mapWarning.hidden =
                false;


            mapWarning.textContent =
                "L'adresse de livraison ne possède pas encore de coordonnées GPS. Le livreur reste suivi, mais le marqueur destination ne peut pas être positionné.";
        }


        function ensureDriverMarker(
            lat,
            lng
        ) {

            if (
                !driverMarker
            ) {

                driverMarker =
                    L
                        .marker(
                            [
                                lat,
                                lng
                            ],
                            {
                                icon:
                                    driverIcon
                            }
                        )
                        .addTo(
                            map
                        )
                        .bindPopup(
                            "<strong>🛵 Votre livreur</strong>"
                        );
            }
            else {

                driverMarker.setLatLng(
                    [
                        lat,
                        lng
                    ]
                );
            }
        }


        function renderRoute() {

            const points =
                [];


            if (
                restaurantMarker
            ) {

                points.push([
                    restaurant.lat,
                    restaurant.lng
                ]);
            }


            if (
                isCoordinate(
                    driverPosition.lat
                )
                &&
                isCoordinate(
                    driverPosition.lng
                )
            ) {

                points.push([
                    driverPosition.lat,
                    driverPosition.lng
                ]);
            }


            if (
                destinationMarker
            ) {

                points.push([
                    destination.lat,
                    destination.lng
                ]);
            }


            if (
                route
            ) {

                route.remove();


                route =
                    null;
            }


            if (
                points.length >= 2
            ) {

                route =
                    L
                        .polyline(
                            points,
                            {
                                weight:
                                    5,

                                opacity:
                                    .8
                            }
                        )
                        .addTo(
                            map
                        );
            }
        }


        function fitMap() {

            const layers =
                [];


            if (
                restaurantMarker
            ) {
                layers.push(
                    restaurantMarker
                );
            }


            if (
                destinationMarker
            ) {
                layers.push(
                    destinationMarker
                );
            }


            if (
                driverMarker
            ) {
                layers.push(
                    driverMarker
                );
            }


            if (
                layers.length === 1
            ) {

                map.setView(
                    layers[0]
                        .getLatLng(),
                    15
                );
            }
            else if (
                layers.length > 1
            ) {

                map.fitBounds(
                    L
                        .featureGroup(
                            layers
                        )
                        .getBounds()
                        .pad(.20)
                );
            }
            else {

                /*
                 * Aucune coordonnée disponible :
                 * carte monde neutre, pas de fausse localisation.
                 */

                map.setView(
                    [0, 0],
                    2
                );
            }


            setTimeout(
                () =>
                    map.invalidateSize(),
                200
            );
        }


        if (
            isCoordinate(
                driverPosition.lat
            )
            &&
            isCoordinate(
                driverPosition.lng
            )
        ) {

            ensureDriverMarker(
                driverPosition.lat,
                driverPosition.lng
            );
        }


        renderRoute();
        fitMap();


        /* =================================================
           POSITION LIVREUR
        ================================================= */

        function updateDriverPosition(
            data
        ) {

            const lat =
                Number(
                    data.lat
                );


            const lng =
                Number(
                    data.lng
                );


            if (
                !Number.isFinite(
                    lat
                )
                ||
                !Number.isFinite(
                    lng
                )
            ) {

                return;
            }


            driverPosition = {
                lat,
                lng
            };


            ensureDriverMarker(
                lat,
                lng
            );


            renderRoute();


            /*
             * On ne refait pas fitBounds à chaque point,
             * sinon la carte "saute".
             * On centre doucement si le marqueur sort de la vue.
             */

            const driverLatLng =
                L.latLng(
                    lat,
                    lng
                );


            if (
                !map
                    .getBounds()
                    .pad(-.15)
                    .contains(
                        driverLatLng
                    )
            ) {

                map.panTo(
                    driverLatLng
                );
            }


            if (
                gpsStatusElement
            ) {

                gpsStatusElement.textContent =
                    "Position GPS reçue : "
                    +
                    new Date(
                        data.recordedAt
                        ||
                        Date.now()
                    )
                        .toLocaleTimeString(
                            "fr-FR"
                        );
            }


            if (
                gpsMetricsElement
            ) {

                gpsMetricsElement.hidden =
                    false;
            }


            if (
                gpsAccuracyElement
            ) {

                gpsAccuracyElement.textContent =
                    Number.isFinite(
                        Number(
                            data.accuracyMeters
                        )
                    )

                        ? Math.round(
                            Number(
                                data.accuracyMeters
                            )
                        )
                            + " m"

                        : "—";
            }


            if (
                gpsSpeedElement
            ) {

                gpsSpeedElement.textContent =
                    Number.isFinite(
                        Number(
                            data.speedKmh
                        )
                    )

                        ? Number(
                            data.speedKmh
                        )
                            .toFixed(1)
                            + " km/h"

                        : "—";
            }
        }


        /* =================================================
           SOCKET.IO
        ================================================= */

        const socket =
            io();


        let joinedOrderReference =
            null;


        socket.on(
            "connect",
            function () {

                connectionElement.textContent =
                    "● Suivi connecté";


                connectionElement.classList.add(
                    "connected"
                );


                socket.emit(
                    "order:join",
                    orderReference
                );


                joinedOrderReference =
                    orderReference;
            }
        );


        socket.on(
            "disconnect",
            function () {

                connectionElement.textContent =
                    "Reconnexion au suivi…";


                connectionElement.classList.remove(
                    "connected"
                );
            }
        );


        socket.on(
            "order:status",
            function (
                data
            ) {

                if (
                    !data
                    ||
                    String(
                        data.reference || ""
                    )
                    !==
                    String(
                        orderReference
                    )
                ) {
                    return;
                }


                renderStatus(
                    data.status,
                    data.changedAt
                );
            }
        );


        socket.on(
            "delivery:assigned",
            function (
                data
            ) {

                if (
                    !data
                    ||
                    String(
                        data.reference || ""
                    )
                    !==
                    String(
                        orderReference
                    )
                ) {
                    return;
                }


                const title =
                    document.getElementById(
                        "driverCardTitle"
                    );


                const details =
                    document.getElementById(
                        "driverCardDetails"
                    );


                title.textContent =
                    "🛵 "
                    +
                    (
                        data.driverName
                        ||
                        "Livraison TiopTiop"
                    );


                let text =
                    "Livreur affecté";


                if (
                    data.driverPhone
                ) {

                    text +=
                        " · 📞 "
                        +
                        data.driverPhone;
                }


                if (
                    data.estimatedArrival
                ) {

                    text +=
                        " · arrivée estimée : "
                        +
                        new Date(
                            data.estimatedArrival
                        )
                            .toLocaleString(
                                "fr-FR"
                            );
                }


                details.textContent =
                    text;
            }
        );


        socket.on(
            "delivery:status",
            function (
                data
            ) {

                if (
                    !data
                    ||
                    String(
                        data.reference || ""
                    )
                    !==
                    String(
                        orderReference
                    )
                ) {
                    return;
                }


                const element =
                    document.getElementById(
                        "driverOperationalStatus"
                    );


                if (
                    element
                ) {

                    element.textContent =
                        data.message
                        ||
                        (
                            "Livraison : "
                            +
                            data.status
                        );
                }
            }
        );

        /* =================================================
           POSITION GPS LIVREUR EN TEMPS REEL
        ================================================= */

        socket.on(
            "driver:location",
            function (
                data
            ) {

                if (
                    !data
                    ||
                    String(
                        data.orderId
                        ||
                        data.reference
                        ||
                        ""
                    )
                    !==
                    String(
                        orderReference
                    )
                ) {

                    return;
                }


                updateDriverPosition(
                    data
                );
            }
        );


        window.addEventListener(
            "beforeunload",
            function () {

                if (
                    socket.connected
                    &&
                    joinedOrderReference
                ) {

                    socket.emit(
                        "order:leave",
                        joinedOrderReference
                    );
                }
            }
        );


        renderStatus(
            currentStatus,
            <%- JSON.stringify(order.updated_at || null) %>
        );
    }
);

</script>
