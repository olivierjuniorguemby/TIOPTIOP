.tracking-driver-actions{display:flex;gap:10px;flex-wrap:wrap}
.tracking-status-label{display:block;margin-bottom:7px;color:#817970;font-size:10px;font-weight:900;text-transform:uppercase}
.tracking-status-current{display:block;color:#ff7900;font-size:24px}
.tracking-status-card small{display:block;margin-top:8px;color:#8a8179}
