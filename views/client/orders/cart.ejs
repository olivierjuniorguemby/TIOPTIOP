<section class="section tiop-cart-page">

    <style>
        .tiop-cart-page {
            --orange: #ff7900;
            --orange-dark: #e86d00;
            --dark: #17130f;
            --muted: #746d66;
            --line: #eadfd3;
            --soft: #fff8ef;
            --white: #fff;
        }

        * {
            box-sizing: border-box;
        }

        .cart-container {
            width: min(1180px, calc(100% - 32px));
            margin: 0 auto;
        }

        .cart-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .cart-label {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            padding: 0 12px;
            margin-bottom: 10px;
            border-radius: 999px;
            background: #fff0df;
            color: var(--orange);
            font-size: 11px;
            font-weight: 900;
        }

        .cart-title {
            margin: 0;
            color: var(--dark);
            font-size: clamp(34px, 5vw, 56px);
            line-height: .95;
            letter-spacing: -2.5px;
            font-weight: 1000;
        }

        .cart-count {
            color: var(--muted);
            font-size: 13px;
            font-weight: 800;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) minmax(300px, .75fr);
            gap: 24px;
            align-items: start;
        }

        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 125px minmax(0, 1fr);
            gap: 18px;
            padding: 15px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 22px;
        }

        .cart-item-image {
            width: 125px;
            height: 125px;
            overflow: hidden;
            border-radius: 17px;
            background: #f3eee8;
        }

        .cart-item-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

        .cart-item-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 42px;
        }

        .cart-item-content {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .cart-item-top {
            display: flex;
            justify-content: space-between;
            gap: 20px;
        }

        .cart-item-type {
            display: inline-flex;
            width: max-content;
            padding: 5px 9px;
            margin-bottom: 7px;
            border-radius: 999px;
            background: #fff3e5;
            color: var(--orange);
            font-size: 9px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .cart-item-name {
            margin: 0;
            color: var(--dark);
            font-size: 19px;
            font-weight: 1000;
        }

        .cart-item-unit-price {
            color: var(--muted);
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .cart-item-total {
            color: var(--dark);
            font-size: 17px;
            font-weight: 1000;
            white-space: nowrap;
        }

        .cart-options {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 10px;
        }

        .cart-option {
            padding: 6px 9px;
            border-radius: 8px;
            background: #f8f5f1;
            color: #5f5954;
            font-size: 10px;
            font-weight: 800;
        }

        .cart-option-price {
            color: var(--orange);
        }

        .cart-instructions {
            margin: 10px 0 0;
            padding: 9px 11px;
            border-left: 3px solid var(--orange);
            background: #fffaf5;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.5;
        }

        .cart-item-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-top: auto;
            padding-top: 14px;
        }

        .quantity-control {
            display: inline-flex;
            align-items: center;
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 999px;
        }

        .quantity-button {
            width: 36px;
            height: 36px;
            border: 0;
            background: #fff;
            color: var(--dark);
            font-size: 17px;
            font-weight: 900;
            cursor: pointer;
        }

        .quantity-button:hover {
            background: #fff4e8;
            color: var(--orange);
        }

        .quantity-value {
            min-width: 34px;
            text-align: center;
            font-size: 12px;
            font-weight: 900;
        }

        .cart-remove {
            border: 0;
            background: transparent;
            color: #b53939;
            font-size: 11px;
            font-weight: 900;
            cursor: pointer;
        }

        .cart-summary {
            position: sticky;
            top: 90px;
            padding: 22px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 24px;
        }

        .cart-summary-title {
            margin: 0 0 22px;
            font-size: 20px;
            font-weight: 1000;
        }

        .summary-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 10px 0;
            color: var(--muted);
            font-size: 12px;
        }

        .summary-row strong {
            color: var(--dark);
        }

        .summary-total {
            margin-top: 10px;
            padding-top: 17px;
            border-top: 1px solid var(--line);
            color: var(--dark);
            font-size: 17px;
            font-weight: 1000;
        }

        .cart-checkout {
            width: 100%;
            min-height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 18px;
            padding: 0 18px;
            border: 0;
            border-radius: 999px;
            background: var(--orange);
            color: #fff;
            text-decoration: none;
            font-size: 12px;
            font-weight: 1000;
        }

        .cart-checkout:hover {
            background: var(--orange-dark);
        }

        .cart-continue {
            width: 100%;
            min-height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 9px;
            border: 1px solid var(--line);
            border-radius: 999px;
            color: var(--dark);
            text-decoration: none;
            font-size: 11px;
            font-weight: 900;
        }

        .cart-clear {
            width: 100%;
            margin-top: 15px;
            padding: 9px;
            border: 0;
            background: transparent;
            color: #a84141;
            font-size: 10px;
            font-weight: 900;
            cursor: pointer;
        }

        .cart-empty {
            grid-column: 1 / -1;
            padding: 70px 25px;
            text-align: center;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 25px;
        }

        .cart-empty-icon {
            margin-bottom: 15px;
            font-size: 55px;
        }

        .cart-empty h2 {
            margin: 0 0 8px;
            font-size: 25px;
        }

        .cart-empty p {
            margin: 0 auto 22px;
            max-width: 460px;
            color: var(--muted);
            line-height: 1.6;
            font-size: 12px;
        }

        .cart-empty a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 44px;
            padding: 0 22px;
            border-radius: 999px;
            background: var(--orange);
            color: #fff;
            text-decoration: none;
            font-size: 11px;
            font-weight: 900;
        }

        .cart-message {
            display: none;
            margin-bottom: 18px;
            padding: 12px 15px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 800;
        }

        .cart-message.show {
            display: block;
        }

        .cart-message.success {
            background: #eaf8ef;
            color: #20713c;
        }

        .cart-message.error {
            background: #fff0f0;
            color: #a22d2d;
        }

        @media (max-width: 850px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }

            .cart-summary {
                position: static;
            }
        }

        @media (max-width: 580px) {
            .cart-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .cart-item {
                grid-template-columns: 85px minmax(0, 1fr);
                gap: 12px;
            }

            .cart-item-image {
                width: 85px;
                height: 85px;
            }

            .cart-item-top {
                flex-direction: column;
                gap: 7px;
            }

            .cart-item-bottom {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>


    <div class="cart-container">

        <header class="cart-header">

            <div>
                <span class="cart-label">
                    🛒 Votre sélection
                </span>

                <h1 class="cart-title">
                    Mon panier
                </h1>
            </div>

            <div class="cart-count">
                <strong id="cartPageCount">
                    <%= Number(cart?.total_quantity || 0) %>
                </strong>
                article(s)
            </div>

        </header>


        <div
            id="cartMessage"
            class="cart-message"
        ></div>


        <% if (!items || items.length === 0) { %>

            <!-- =============================================
                 PANIER VIDE
            ============================================== -->

            <div class="cart-empty">

                <div class="cart-empty-icon">
                    🧺
                </div>

                <h2>
                    Votre panier est vide
                </h2>

                <p>
                    Découvrez nos plats, formules et spécialités
                    puis ajoutez ce qui vous fait envie.
                </p>

                <a href="/menu">
                    Découvrir le menu
                </a>

            </div>

        <% } else { %>

            <div class="cart-layout">

                <!-- =========================================
                     ARTICLES
                ========================================== -->

                <div class="cart-items">

                    <% items.forEach(item => { %>

                        <article
                            class="cart-item"
                            data-cart-item-id="<%= item.id %>"
                        >

                            <!-- IMAGE -->

                            <div class="cart-item-image">

                                <% if (item.image_url) { %>

                                    <img
                                        src="<%= item.image_url %>"
                                        alt="<%= item.item_name %>"
                                    >

                                <% } else { %>

                                    <div class="cart-item-placeholder">
                                        <%= item.item_type === "FORMULA" ? "🍱" : "🍽️" %>
                                    </div>

                                <% } %>

                            </div>


                            <!-- CONTENU -->

                            <div class="cart-item-content">

                                <div class="cart-item-top">

                                    <div>

                                        <span class="cart-item-type">
                                            <%= item.item_type === "FORMULA"
                                                ? "Formule"
                                                : "Produit" %>
                                        </span>

                                        <h2 class="cart-item-name">
                                            <%= item.item_name %>
                                        </h2>

                                        <div class="cart-item-unit-price">

                                            Prix unitaire :

                                            <%= Number(
                                                item.final_unit_price || 0
                                            ).toLocaleString(
                                                "fr-FR",
                                                {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                }
                                            ) %>

                                            <%= item.currency || "XAF" %>

                                        </div>

                                    </div>


                                    <strong class="cart-item-total">

                                        <%= Number(
                                            item.line_total || 0
                                        ).toLocaleString(
                                            "fr-FR",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        ) %>

                                        <%= item.currency || "XAF" %>

                                    </strong>

                                </div>


                                <!-- OPTIONS -->

                                <% if (
                                    item.options &&
                                    item.options.length > 0
                                ) { %>

                                    <div class="cart-options">

                                        <% item.options.forEach(option => { %>

                                            <span class="cart-option">

                                                <% if (option.group_name) { %>
                                                    <%= option.group_name %> :
                                                <% } %>

                                                <%= option.value_name || "Option" %>

                                                <% if (
                                                    Number(option.price_delta || 0) > 0
                                                ) { %>

                                                    <span class="cart-option-price">

                                                        +<%= Number(
                                                            option.price_delta
                                                        ).toLocaleString(
                                                            "fr-FR",
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    </span>

                                                <% } %>

                                            </span>

                                        <% }); %>

                                    </div>

                                <% } %>


                                <!-- INSTRUCTIONS -->

                                <% if (item.instructions) { %>

                                    <p class="cart-instructions">
                                        📝 <%= item.instructions %>
                                    </p>

                                <% } %>


                                <div class="cart-item-bottom">

                                    <!-- QUANTITE -->

                                    <div class="quantity-control">

                                        <button
                                            type="button"
                                            class="quantity-button cart-quantity-minus"
                                            data-item-id="<%= item.id %>"
                                            aria-label="Diminuer"
                                        >
                                            −
                                        </button>

                                        <span
                                            class="quantity-value"
                                            data-quantity="<%= item.quantity %>"
                                        >
                                            <%= item.quantity %>
                                        </span>

                                        <button
                                            type="button"
                                            class="quantity-button cart-quantity-plus"
                                            data-item-id="<%= item.id %>"
                                            aria-label="Augmenter"
                                        >
                                            +
                                        </button>

                                    </div>


                                    <!-- SUPPRESSION -->

                                    <button
                                        type="button"
                                        class="cart-remove"
                                        data-item-id="<%= item.id %>"
                                    >
                                        🗑 Supprimer
                                    </button>

                                </div>

                            </div>

                        </article>

                    <% }); %>

                </div>


                <!-- =========================================
                     RESUME
                ========================================== -->

                <aside class="cart-summary">

                    <h2 class="cart-summary-title">
                        Récapitulatif
                    </h2>


                    <div class="summary-row">

                        <span>
                            Articles
                        </span>

                        <strong id="summaryQuantity">
                            <%= Number(cart.total_quantity || 0) %>
                        </strong>

                    </div>


                    <div class="summary-row">

                        <span>
                            Livraison
                        </span>

                        <strong>
                            Calculée à l'étape suivante
                        </strong>

                    </div>


                    <div class="summary-row summary-total">

                        <span>
                            Sous-total
                        </span>

                        <strong id="summarySubtotal">

                            <%= Number(
                                cart.subtotal || 0
                            ).toLocaleString(
                                "fr-FR",
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>

                            <%= items[0]?.currency || "XAF" %>

                        </strong>

                    </div>


                    <a
                        href="/checkout"
                        class="cart-checkout"
                    >
                        Continuer vers la commande →
                    </a>


                    <a
                        href="/menu"
                        class="cart-continue"
                    >
                        ← Continuer mes achats
                    </a>


                    <button
                        type="button"
                        id="clearCartButton"
                        class="cart-clear"
                    >
                        Vider le panier
                    </button>

                </aside>

            </div>

        <% } %>

    </div>

</section>


<script src="/js/cart.js"></script>