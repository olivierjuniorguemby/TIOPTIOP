<section class="section">
  <div class="container">
    <!-- =========================================================
     TIOPTIOP - BLOC PANIER
     views/client/cart/cart.ejs
========================================================= -->

<style>
  .tiop-cart {
    --orange: #ff7900;
    --orange-hover: #e96e00;
    --text: #1d1a17;
    --muted: #77716c;
    --border: #eee4da;

    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
  }

  /* =====================================================
     STRUCTURE
  ===================================================== */

  .cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(270px, .9fr);
    gap: 25px;
    align-items: start;
  }

  /* =====================================================
     PRODUITS
  ===================================================== */

  .cart-products {
    display: flex;
    flex-direction: column;
  }

  .cart-product {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;

    min-height: 82px;

    padding: 10px 5px;

    border-bottom: 1px solid #dfd8d1;
  }

  /* IMAGE */

  .cart-product-image {
    width: 42px;
    height: 42px;

    overflow: hidden;

    border-radius: 50%;

    background: #f6eee6;
  }

  .cart-product-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  /* INFORMATIONS */

  .cart-product-info {
    min-width: 0;
  }

  .cart-product-name {
    margin: 0 0 4px;

    font-size: 14px;
    font-weight: 900;
  }

  .cart-product-unit-price {
    margin: 0 0 7px;

    color: var(--muted);

    font-size: 12px;
  }

  /* =====================================================
     QUANTITÉ
  ===================================================== */

  .cart-quantity {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .quantity-btn {
    width: 24px;
    height: 24px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: #ffffff;
    color: #333;

    box-shadow: 0 2px 8px rgba(0,0,0,.06);

    cursor: pointer;

    font-size: 13px;
    font-weight: 800;
  }

  .quantity-value {
    min-width: 15px;

    text-align: center;

    font-size: 12px;
    font-weight: 800;
  }

  /* =====================================================
     ACTIONS PRODUIT
  ===================================================== */

  .cart-product-actions {
    min-width: 100px;

    text-align: right;
  }

  .cart-product-total {
    display: block;

    margin-bottom: 9px;

    font-size: 13px;
    font-weight: 900;
  }

  .cart-remove {
    min-height: 30px;

    padding: 0 12px;

    border: 0;
    border-radius: 999px;

    background: #ffffff;
    color: var(--text);

    box-shadow: 0 3px 12px rgba(0,0,0,.07);

    font-size: 11px;
    font-weight: 900;

    cursor: pointer;
  }

  .cart-remove:hover {
    color: #c0392b;
  }

  /* =====================================================
     RÉCAPITULATIF
  ===================================================== */

  .cart-summary {
    padding: 24px;

    background: #ffffff;

    border: 1px solid var(--border);
    border-radius: 22px;

    box-shadow: 0 8px 25px rgba(0,0,0,.025);
  }

  .cart-summary h2 {
    margin: 0 0 20px;

    font-size: 17px;
    font-weight: 900;
  }

  /* LIGNES */

  .summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 7px;

    color: var(--muted);

    font-size: 12px;
  }

  .summary-row strong {
    color: var(--text);
    font-weight: 800;
  }

  /* TOTAL */

  .summary-total {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 19px;
    padding-top: 17px;

    border-top: 1px solid var(--border);

    font-size: 13px;
    font-weight: 900;
  }

  .summary-total strong {
    font-size: 14px;
  }

  /* =====================================================
     PAIEMENT
  ===================================================== */

  .cart-checkout {
    width: 100%;
    min-height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-top: 17px;

    padding: 0 18px;

    box-sizing: border-box;

    border: 0;
    border-radius: 999px;

    background: var(--orange);
    color: #ffffff;

    font-size: 12px;
    font-weight: 900;

    text-decoration: none;

    cursor: pointer;

    transition:
      background .2s ease,
      transform .2s ease,
      box-shadow .2s ease;
  }

  .cart-checkout:hover {
    background: var(--orange-hover);

    transform: translateY(-1px);

    box-shadow: 0 7px 18px rgba(255,121,0,.18);
  }

  /* =====================================================
     RESPONSIVE
  ===================================================== */

  @media (max-width: 800px) {

    .cart-layout {
      grid-template-columns: 1fr;
    }

    .cart-summary {
      position: static;
    }
  }

  @media (max-width: 500px) {

    .cart-product {
      grid-template-columns: 45px 1fr;
    }

    .cart-product-actions {
      grid-column: 2;

      width: 100%;

      display: flex;
      justify-content: space-between;
      align-items: center;

      text-align: left;
    }

    .cart-product-total {
      margin: 0;
    }

    .cart-summary {
      padding: 20px;

      border-radius: 19px;
    }
  }

</style>


<!-- =========================================================
     PANIER
========================================================= -->

