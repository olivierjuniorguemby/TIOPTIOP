<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            📄 Facture
        </span>

        <h1>
            📄 Facture / Reçu
        </h1>

        <p>
            Commande <%= order.reference %>
        </p>

    </div>

</section>


<section class="section">

<div class="container">


<style>

.tiop-invoice {

    --orange: #ff7900;
    --text: #211e1b;
    --muted: #77716c;
    --border: #e2dfdc;

    max-width: 800px;

    margin: 0 auto;

    padding: 38px 36px;

    background: #fff;

    border-radius: 27px;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    color: var(--text);
}


.invoice-header {

    display: flex;

    justify-content:
        space-between;

    align-items:
        flex-start;

    gap: 30px;

    padding-bottom: 20px;

    margin-bottom: 22px;

    border-bottom:
        1px solid var(--border);
}


.invoice-brand h1 {

    margin: 0 0 10px;

    font-size: 29px;
    font-weight: 1000;
}


.invoice-brand-orange {

    color: var(--orange);
}


.invoice-brand p,
.invoice-reference span {

    color: var(--muted);

    font-size: 13px;
}


.invoice-reference {

    text-align: right;
}


.invoice-reference h2 {

    margin:
        0 0 12px;

    font-size: 20px;
}


.invoice-reference strong {

    display: block;

    margin-bottom: 5px;
}


.invoice-information {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 35px;

    margin-bottom: 30px;
}


.invoice-info-column {

    padding: 17px;

    background: #faf7f3;

    border-radius: 15px;
}


.invoice-info-column h3 {

    margin:
        0 0 10px;

    font-size: 14px;
}


.invoice-info-column p {

    margin: 0;

    font-size: 13px;
    line-height: 1.6;
}


.invoice-table {

    width: 100%;

    border-collapse:
        collapse;

    font-size: 13px;
}


.invoice-table th,
.invoice-table td {

    padding: 13px 10px;

    text-align: left;

    border-bottom:
        1px solid var(--border);
}


.invoice-table th {

    font-weight: 900;
}


.invoice-item-options {

    margin-top: 5px;

    color: var(--muted);

    font-size: 11px;
}


.invoice-summary {

    width: min(100%, 350px);

    margin:
        25px 0 0 auto;
}


.invoice-summary-row {

    display: flex;

    justify-content:
        space-between;

    gap: 20px;

    padding: 8px 0;

    font-size: 13px;
}


.invoice-summary-row.total {

    margin-top: 7px;

    padding-top: 14px;

    border-top:
        2px solid var(--text);

    font-size: 17px;
    font-weight: 1000;
}


.invoice-message {

    margin:
        25px 0;

    color: var(--muted);

    font-size: 13px;
}


.invoice-actions {

    display: flex;

    gap: 9px;

    flex-wrap: wrap;
}


.invoice-button {

    min-height: 43px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0 17px;

    border: 0;

    border-radius: 999px;

    text-decoration: none;

    font-size: 12px;
    font-weight: 900;

    cursor: pointer;
}


.invoice-button.primary {

    background:
        var(--orange);

    color: #fff;
}


.invoice-button.secondary {

    background: #fff;

    color: var(--text);

    border:
        1px solid var(--border);
}


@media(max-width:650px) {

    .tiop-invoice {

        padding: 23px 18px;
    }


    .invoice-header {

        flex-direction:
            column;
    }


    .invoice-reference {

        text-align:
            left;
    }


    .invoice-information {

        grid-template-columns:
            1fr;
    }
}


@media print {

    body * {

        visibility:
            hidden;
    }


    .tiop-invoice,
    .tiop-invoice * {

        visibility:
            visible;
    }


    .tiop-invoice {

        position:
            absolute;

        inset: 0;

        width: 100%;

        max-width: none;

        border-radius: 0;
    }


    .invoice-actions {

        display: none;
    }
}

</style>


<%

const money = value =>
    Number(value || 0)
        .toLocaleString(
            "fr-FR",
            {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }
        );


const formatDate = value => {

    if (!value) {
        return "";
    }


    return new Date(value)
        .toLocaleString(
            "fr-FR",
            {
                dateStyle:
                    "medium",

                timeStyle:
                    "short"
            }
        );
};


const paymentLabels = {

    CASH:
        "Espèces",

    CARD:
        "Carte bancaire",

    MOBILE_MONEY:
        "Mobile Money"
};


const paymentStatusLabels = {

    PENDING:
        "En attente",

    AUTHORIZED:
        "Autorisé",

    PAID:
        "Payé",

    FAILED:
        "Échoué",

    CANCELLED:
        "Annulé",

    REFUNDED:
        "Remboursé"
};

%>


<section class="tiop-invoice">


<header class="invoice-header">


    <div class="invoice-brand">

        <h1>

            Tiop<span
                class="invoice-brand-orange"
            >Tiop</span>

        </h1>


        <p>
            Reçu de commande
        </p>

    </div>


    <div class="invoice-reference">

        <h2>
            FACTURE / REÇU
        </h2>


        <strong>
            <%= order.reference %>
        </strong>


        <span>

            <%= formatDate(
                order.created_at
            ) %>

        </span>

    </div>


</header>


<section class="invoice-information">


    <div class="invoice-info-column">

        <h3>
            Client
        </h3>


        <p>

            <strong>

                <%= customer?.display_name
                    ||
                    [
                        customer?.first_name,
                        customer?.last_name
                    ]
                        .filter(Boolean)
                        .join(" ")
                    ||
                    "Client TiopTiop"
                %>

            </strong>

            <br>

            <%= customer?.email || "" %>

            <% if (customer?.phone) { %>

                <br>

                <%= customer.phone %>

            <% } %>

        </p>

    </div>


    <div class="invoice-info-column">

        <h3>
            Commande
        </h3>


        <p>

            <strong>
                <%= order.restaurant_name %>
            </strong>

            <br>

            Paiement :

            <%= payment
                ? (
                    paymentLabels[
                        payment.method
                    ]
                    ||
                    payment.method
                )
                : "Non renseigné"
            %>

            <br>

            Statut paiement :

            <%= payment
                ? (
                    paymentStatusLabels[
                        payment.status
                    ]
                    ||
                    payment.status
                )
                : "—"
            %>

        </p>

    </div>


</section>


<div class="invoice-table-wrapper">


<table class="invoice-table">


<thead>

<tr>

    <th>
        Article
    </th>

    <th>
        Qté
    </th>

    <th>
        Prix
    </th>

    <th>
        Montant
    </th>

</tr>

</thead>


<tbody>


<% (items || [])
    .forEach(item => { %>


<tr>


    <td>

        <strong>
            <%= item.product_name %>
        </strong>


        <% if (
            item.options &&
            item.options.length
        ) { %>


            <div class="invoice-item-options">


                <% item.options
                    .forEach(option => { %>


                    <div>

                        <%= option.option_name %>

                        :

                        <%= option.option_value %>

                    </div>


                <% }) %>


            </div>


        <% } %>


        <% if (item.notes) { %>

            <div class="invoice-item-options">

                📝 <%= item.notes %>

            </div>

        <% } %>

    </td>


    <td>

        <%= item.quantity %>

    </td>


    <td>

        <%= money(
            item.unit_price
        ) %>

        <%= order.currency %>

    </td>


    <td>

        <strong>

            <%= money(
                item.line_total
            ) %>

            <%= order.currency %>

        </strong>

    </td>


</tr>


<% }) %>


</tbody>


</table>


</div>


<div class="invoice-summary">


    <div class="invoice-summary-row">

        <span>
            Sous-total
        </span>

        <strong>

            <%= money(
                order.subtotal
            ) %>

            <%= order.currency %>

        </strong>

    </div>


    <% if (
        Number(
            order.delivery_fee || 0
        ) > 0
    ) { %>


        <div class="invoice-summary-row">

            <span>
                Livraison
            </span>

            <strong>

                <%= money(
                    order.delivery_fee
                ) %>

                <%= order.currency %>

            </strong>

        </div>


    <% } %>


    <% if (
        Number(
            order.discount_amount || 0
        ) > 0
    ) { %>


        <div class="invoice-summary-row">

            <span>
                Réduction
            </span>

            <strong>

                -<%= money(
                    order.discount_amount
                ) %>

                <%= order.currency %>

            </strong>

        </div>


    <% } %>


    <% if (
        Number(
            order.tax_amount || 0
        ) > 0
    ) { %>


        <div class="invoice-summary-row">

            <span>
                Taxes
            </span>

            <strong>

                <%= money(
                    order.tax_amount
                ) %>

                <%= order.currency %>

            </strong>

        </div>


    <% } %>


    <div class="invoice-summary-row total">

        <span>
            TOTAL
        </span>

        <strong>

            <%= money(
                order.total_amount
            ) %>

            <%= order.currency %>

        </strong>

    </div>


</div>


<p class="invoice-message">

    Merci pour votre confiance.
    Ce document est généré par TiopTiop.

</p>


<div class="invoice-actions">


    <button
        type="button"
        class="invoice-button primary"
        onclick="window.print()"
    >

        🖨️ Imprimer / PDF

    </button>


    <a
        href="/commande/confirmation/<%= encodeURIComponent(order.reference) %>"
        class="invoice-button secondary"
    >

        👁 Voir la commande

    </a>


    <a
        href="/commandes"
        class="invoice-button secondary"
    >

        ← Mes commandes

    </a>


</div>


</section>


</div>

</section>