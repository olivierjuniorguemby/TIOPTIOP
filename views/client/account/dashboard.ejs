<style>
  .account-overview {
    --overview-orange: #ff7900;
    --overview-text: #191714;
    --overview-muted: #746f69;
    --overview-card: #ffffff;

    padding: 8px 0 42px;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--overview-text);
  }

  /* =========================
     KPI
  ========================== */

  .overview-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 18px;
  }

  .overview-kpi {
    background: var(--overview-card);
    border-radius: 24px;
    padding: 20px 18px;
    min-height: 96px;

    display: flex;
    flex-direction: column;
    justify-content: center;

    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
  }

  .overview-kpi-label {
    display: flex;
    align-items: center;
    gap: 8px;

    font-size: 15px;
    font-weight: 500;
    margin-bottom: 5px;
  }

  .overview-kpi-icon {
    font-size: 16px;
    line-height: 1;
  }

  .overview-kpi-value {
    margin: 0;
    font-size: 30px;
    line-height: 1.1;
    font-weight: 800;
    color: #171512;
  }

  /* =========================
     CARTE BIENVENUE
  ========================== */

  .overview-welcome {
    background: #ffffff;
    border-radius: 26px;
    padding: 46px 22px 17px;
    min-height: 185px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
  }

  .overview-welcome h2 {
    display: flex;
    align-items: center;
    gap: 10px;

    margin: 0 0 20px;
    font-size: 25px;
    line-height: 1.2;
    font-weight: 800;
    color: #1c1916;
  }

  .overview-welcome p {
    margin: 0 0 7px;
    color: var(--overview-muted);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .overview-profile-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;
    margin-top: 0;
    padding: 0 17px;

    background: var(--overview-orange);
    color: #ffffff;

    border: none;
    border-radius: 999px;

    font-size: 16px;
    font-weight: 800;
    text-decoration: none;

    cursor: pointer;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .overview-profile-btn:hover {
    background: #e96e00;
    transform: translateY(-1px);
  }

  /* =========================
     RESPONSIVE
  ========================== */

  @media (max-width: 900px) {
    .overview-kpis {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .overview-kpis {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .overview-kpi {
      min-height: 85px;
      border-radius: 20px;
      padding: 17px;
    }

    .overview-kpi-value {
      font-size: 27px;
    }

    .overview-welcome {
      min-height: auto;
      padding: 30px 20px;
      border-radius: 22px;
    }

    .overview-welcome h2 {
      font-size: 22px;
    }

    .overview-profile-btn {
      width: 100%;
    }
  }
</style>


