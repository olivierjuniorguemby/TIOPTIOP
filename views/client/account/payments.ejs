    background: #fff7f7;
    transform: translateY(-1px);
  }

  /* =========================
     RESPONSIVE
  ========================== */

  @media (max-width: 600px) {

    .tiop-payment-block {
      padding: 22px 16px;
      border-radius: 22px;
