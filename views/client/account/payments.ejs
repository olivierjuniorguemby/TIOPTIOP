    padding: 28px 22px 22px;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--tiop-text);
  }

  /* =========================
     EN-TÊTE
  ========================== */

  .payment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 22px;
  }

  .payment-header h2 {
    margin: 0;

    font-size: 42px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -1.5px;
    color: #171512;
  }

  .payment-add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    min-height: 36px;
    padding: 0 17px;

    border: 0;
    border-radius: 999px;

    background: var(--tiop-orange);
    color: #ffffff;

    font-size: 12px;
    font-weight: 800;

    cursor: pointer;

    transition:
      background .2s ease,
      transform .2s ease;
  }

  .payment-add-btn:hover {
    background: var(--tiop-orange-hover);
    transform: translateY(-1px);
  }

  /* =========================
     LISTE DES MOYENS
  ========================== */

  .payment-methods {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .payment-method {
    min-height: 66px;

    display: flex;
    align-items: center;

    padding: 0 13px;

    border: 1px solid var(--tiop-border);
    border-radius: 16px;

    background: #ffffff;

    transition:
      border-color .2s ease,
      box-shadow .2s ease;
  }

  .payment-method:hover {
    border-color: #d3ccc5;

    box-shadow:
      0 5px 18px rgba(0, 0, 0, .035);
  }

  /* =========================
     ICÔNE
  ========================== */

  .payment-icon {
    width: 40px;
    height: 40px;

    min-width: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-right: 10px;

    border-radius: 12px;

    background: #fff0df;

    font-size: 20px;
  }

  /* =========================
     INFORMATIONS
  ========================== */

  .payment-info {
    min-width: 0;
    flex: 1;
  }

  .payment-info strong {
    display: block;

    margin-bottom: 2px;

    color: #211e1b;

    font-size: 13px;
    font-weight: 800;
  }

  .payment-info small {
    display: block;

    color: var(--tiop-muted);

    font-size: 12px;
  }

  /* =========================
     PAR DÉFAUT
  ========================== */

  .payment-default {
    margin-right: 14px;

    color: #49443f;

    font-size: 12px;
    white-space: nowrap;
  }

  /* =========================
     SUPPRIMER
  ========================== */

  .payment-delete-btn {
    min-height: 38px;

    padding: 0 15px;

    border: 0;
    border-radius: 999px;

    background: #ffffff;

