<style>
  .tiop-settings {
    --orange: #ff7900;
    --text: #1d1a17;
    --muted: #77716c;
    --border: #e4e0dc;

    background: #fff;
    border-radius: 28px;
    padding: 26px 22px 22px;
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
  }

  /* =========================
     SECTIONS
  ========================== */

  .settings-section {
    padding: 12px 0 16px;
    border-bottom: 1px solid var(--border);
  }

  .settings-section:first-child {
    padding-top: 4px;
  }

  .settings-section:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .settings-title {
    display: flex;
    align-items: center;
    gap: 8px;

    margin: 0 0 20px;
    font-size: 21px;
    font-weight: 800;
  }

  .settings-description {
    margin: -5px 0 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  /* =========================
     LIGNES
  ========================== */

  .settings-row {
    min-height: 58px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    padding: 8px 2px;

    border-bottom: 1px solid var(--border);
  }

  .settings-row:last-child {
    border-bottom: 0;
  }

  .settings-row-text {
    min-width: 0;
  }

  .settings-row-text strong {
    display: block;

    margin-bottom: 2px;

    font-size: 13px;
    font-weight: 800;
  }

  .settings-row-text small {
    display: block;

    color: var(--muted);

    font-size: 12px;
    line-height: 1.4;
  }

  /* =========================
     SWITCH
  ========================== */

  .tiop-switch {
    position: relative;

    width: 38px;
    height: 22px;

    flex: 0 0 38px;
  }

  .tiop-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-slider {
    position: absolute;
    inset: 0;

    background: #d9d9d9;

    border-radius: 999px;

    cursor: pointer;

    transition: .2s;
  }

  .switch-slider::before {
    content: "";

    position: absolute;

    width: 18px;
    height: 18px;

    left: 2px;
    top: 2px;

    background: #fff;

    border-radius: 50%;

    box-shadow: 0 1px 4px rgba(0,0,0,.15);

    transition: .2s;
  }

  .tiop-switch input:checked + .switch-slider {
    background: var(--orange);
  }

  .tiop-switch input:checked + .switch-slider::before {
    transform: translateX(16px);
  }

  /* =========================
     LANGUE
  ========================== */

  .settings-select {
    min-width: 88px;
    min-height: 42px;

    padding: 0 12px;

    border: 1px solid var(--border);
    border-radius: 13px;

    background: #fff;
    color: var(--text);

    outline: none;
    cursor: pointer;
  }

  .settings-select:focus {
    border-color: var(--orange);
  }

  /* =========================
     BOUTON MOT DE PASSE
  ========================== */

  .password-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    min-height: 38px;

    padding: 0 15px;

    background: #fff;

    border: 0;
    border-radius: 999px;

    color: var(--text);

    box-shadow: 0 5px 18px rgba(0,0,0,.05);

    font-size: 13px;
    font-weight: 800;

    cursor: pointer;

    transition: .2s ease;
  }

  .password-button:hover {
    color: var(--orange);
    transform: translateY(-1px);
  }

  /* =========================
     MOTIFS AFRICAINS
  ========================== */

  .african-patterns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;

    margin-top: 10px;
  }

  .pattern-option {
    position: relative;
  }

  .pattern-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pattern-card {
    display: block;

    padding: 10px;

    border: 1.5px solid transparent;
    border-radius: 15px;

    cursor: pointer;

    transition:
      border-color .2s ease,
      background .2s ease,
      transform .2s ease;
  }

  .pattern-card:hover {
    background: #fff8f1;
  }

  .pattern-option input:checked + .pattern-card {
    border-color: var(--orange);
    background: #fff8f1;
  }

  .pattern-preview {
    width: 100%;
    height: 42px;

    border-radius: 10px;

    margin-bottom: 7px;
  }

  .pattern-name {
    display: block;

    color: #151310;

    font-size: 12px;
    font-weight: 800;
  }

  /* KONGO AUTHENTIQUE */

  .pattern-kongo {
    background:
      repeating-linear-gradient(
        45deg,
        #0c0b0a 0px,
        #0c0b0a 8px,
        #ff7900 8px,
        #ff7900 12px,
        #3a1c0a 12px,
        #3a1c0a 18px
      );
  }

  /* AFRO ÉLÉGANT */

  .pattern-elegant {
    background:
      linear-gradient(
        135deg,
        #3a160b 0%,
        #6d2d12 42%,
        #ff7900 48%,
        #f6ead5 51%,
        #7fa584 100%
      );
  }

  /* CONGO BRAZZAVILLE */

  .pattern-congo {
    background:
      repeating-linear-gradient(
        90deg,
        #22633e 0px,
        #22633e 15px,
        #d79035 15px,
        #d79035 23px,
        #f4dfaa 23px,
        #f4dfaa 31px,
        #8c431f 31px,
        #8c431f 39px
      );
  }

  /* AFRO FUTURISTE */

  .pattern-futurist {
    background:
      linear-gradient(
        135deg,
        #064f4b 0%,
        #0a6661 43%,
        #c28a25 48%,
        #f2c766 52%,
        #16120f 58%,
        #050505 100%
      );
  }

  /* =========================
     RESPONSIVE
  ========================== */

  @media (max-width: 800px) {

    .african-patterns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {

    .tiop-settings {
      padding: 20px 16px;
      border-radius: 22px;
    }

    .settings-title {
      font-size: 19px;
    }

    .settings-row {
      gap: 12px;
    }

    .african-patterns {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .pattern-card {
      padding: 7px;
    }

    .pattern-name {
      font-size: 11px;
    }
  }

</style>


