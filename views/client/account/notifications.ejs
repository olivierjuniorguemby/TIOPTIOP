<% const icons=t=>/ORDER|COMMANDE/.test(t)?'🛒':/DELIVERY|LIVRAISON/.test(t)?'🚚':/PAY|REFUND/.test(t)?'💳':/SUPPORT|TICKET/.test(t)?'💬':/LOYALTY|TIOP/.test(t)?'⭐':/PROMO/.test(t)?'🎁':'🔔'; const labelDate=d=>{const x=new Date(d),now=new Date(),a=new Date(now.getFullYear(),now.getMonth(),now.getDate()),b=new Date(x.getFullYear(),x.getMonth(),x.getDate()),diff=Math.round((a-b)/86400000);return diff===0?"Aujourd’hui":diff===1?'Hier':x.toLocaleDateString('fr-FR',{day:'2-digit',month:'long',year:'numeric'});}; let lastGroup=''; %>
<section class="nc-page">
  <aside class="nc-side">
    <div class="nc-side-title">Mon espace</div>
    <a href="/compte">⌂ <span>Vue d'ensemble</span></a><a href="/profil">◎ <span>Mon profil</span></a><a href="/commandes">▣ <span>Mes commandes</span></a><a href="/paiements-client">▤ <span>Mes paiements</span></a><a href="/compte/demandes">💬 <span>Mes demandes</span></a><a class="active" href="/compte/notifications">🔔 <span>Notifications</span><b class="nc-side-badge" <%= summary.unread?'':'hidden' %>><%= summary.unread>99?'99+':summary.unread %></b></a><a href="/favoris">♡ <span>Mes favoris</span></a><a href="/tiopplus">☆ <span>Mes points Tiop+</span></a><a href="/parametres">⚙ <span>Paramètres</span></a>
  </aside>
  <main class="nc-main">
    <header class="nc-hero"><div><span class="nc-eyebrow">🔔 CENTRE PERSONNEL</span><h1>Mes notifications</h1><p>Retrouvez tout ce qui compte, au même endroit.</p></div><button id="ncReadAll" <%= summary.unread?'':'disabled' %>>✓ Tout marquer comme lu</button></header>
    <div class="nc-stats"><article><span>🔴 Non lues</span><strong id="ncUnread"><%= summary.unread %></strong></article><article><span>✨ Aujourd'hui</span><strong><%= summary.today %></strong></article><article><span>✓ Lues</span><strong><%= summary.read %></strong></article><article><span>🔔 Total</span><strong><%= summary.total %></strong></article></div>
    <section class="nc-panel">
      <div class="nc-toolbar"><form method="get" class="nc-search"><span>⌕</span><input name="q" value="<%= search %>" placeholder="Rechercher dans mes notifications…"><input type="hidden" name="filter" value="<%= filter %>"></form><div class="nc-filters"><% [['ALL','Toutes'],['UNREAD','Non lues'],['ORDERS','Commandes'],['PAYMENTS','Paiements'],['SUPPORT','Support'],['LOYALTY','Tiop+'],['PROMOTIONS','Promotions']].forEach(([v,l])=>{ %><a class="<%= filter===v?'active':'' %>" href="/compte/notifications?filter=<%= v %><%= search?'&q='+encodeURIComponent(search):'' %>"><%= l %></a><% }) %></div></div>
      <div class="nc-list" id="ncList">
      <% if(!items.length){ %><div class="nc-empty"><span>✨</span><h3>Rien à afficher</h3><p><%= search?'Aucune notification ne correspond à votre recherche.':'Vous êtes à jour. Les nouvelles informations apparaîtront ici.' %></p></div><% } %>
      <% items.forEach(n=>{ const group=labelDate(n.created_at); if(group!==lastGroup){lastGroup=group;%><div class="nc-group"><span><%= group %></span></div><% } %>
        <article class="nc-item <%= n.read_at?'':'unread' %>" data-id="<%= n.id %>"><div class="nc-icon"><%= icons(String(n.notification_type||'').toUpperCase()) %></div><div class="nc-copy"><div class="nc-top"><h3><%= n.title %></h3><time><%= new Date(n.created_at).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) %></time></div><p><%= n.body %></p><div class="nc-actions"><% if(n.target_url){ %><a href="<%= n.target_url %>" class="nc-open" data-id="<%= n.id %>">Voir le détail →</a><% } %><button class="nc-toggle" data-id="<%= n.id %>" data-read="<%= n.read_at?'1':'0' %>"><%= n.read_at?'Marquer non lue':'Marquer comme lue' %></button></div></div><i class="nc-dot" <%= n.read_at?'hidden':'' %>></i></article>
      <% }) %></div>
    </section>
  </main>
</section>
<style>
.nc-page{max-width:1460px;margin:34px auto 80px;padding:0 24px;display:grid;grid-template-columns:245px minmax(0,1fr);gap:28px;color:#241b15}.nc-side{background:#fff;border:1px solid #eadfd4;border-radius:22px;padding:14px;height:max-content;position:sticky;top:100px;box-shadow:0 12px 35px rgba(50,30,10,.04)}.nc-side-title{padding:9px 12px;color:#9a8d82;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:1px}.nc-side a{display:flex;align-items:center;gap:10px;padding:12px;border-radius:12px;text-decoration:none;color:#30251e;font-weight:750;font-size:13px}.nc-side a:hover{background:#fff7ef}.nc-side a.active{background:#ff7900;color:#fff}.nc-side-badge{margin-left:auto;min-width:22px;padding:3px 6px;text-align:center;border-radius:99px;background:#fff;color:#e66400;font-size:10px}.nc-main{min-width:0}.nc-hero{background:linear-gradient(125deg,#211812,#35251a);color:#fff;border-radius:26px;padding:30px 32px;display:flex;justify-content:space-between;align-items:center;gap:20px;box-shadow:0 18px 45px rgba(38,24,14,.14)}.nc-eyebrow{color:#ffc177;font-size:10px;font-weight:900;letter-spacing:1.2px}.nc-hero h1{font-size:32px;margin:5px 0}.nc-hero p{margin:0;color:#d7cbc2}.nc-hero button{border:0;border-radius:999px;background:#ff7900;color:#fff;padding:12px 17px;font-weight:900;cursor:pointer}.nc-hero button:disabled{opacity:.45;cursor:default}.nc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:18px 0}.nc-stats article{background:#fff;border:1px solid #eadfd4;border-radius:18px;padding:17px 19px;display:flex;flex-direction:column;gap:6px}.nc-stats span{font-size:11px;color:#897b70;font-weight:750}.nc-stats strong{font-size:25px}.nc-panel{background:#fff;border:1px solid #eadfd4;border-radius:24px;overflow:hidden}.nc-toolbar{padding:18px;border-bottom:1px solid #f0e8e0}.nc-search{height:45px;border:1px solid #e6dbd1;border-radius:14px;display:flex;align-items:center;gap:8px;padding:0 13px;background:#fcfaf8}.nc-search input{width:100%;border:0;outline:0;background:transparent;font:inherit}.nc-filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.nc-filters a{padding:8px 12px;border-radius:999px;background:#f7f3ef;color:#65584e;text-decoration:none;font-size:11px;font-weight:850}.nc-filters a.active{background:#ff7900;color:#fff}.nc-group{padding:18px 20px 8px;color:#9a8b7f;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.7px}.nc-item{display:grid;grid-template-columns:48px 1fr 10px;gap:14px;padding:17px 20px;border-top:1px solid #f2ece6;align-items:start}.nc-item.unread{background:linear-gradient(90deg,#fff8ef,#fff)}.nc-icon{width:46px;height:46px;border-radius:15px;background:#fff0df;display:grid;place-items:center;font-size:19px}.nc-top{display:flex;justify-content:space-between;gap:12px}.nc-top h3{margin:1px 0 5px;font-size:14px}.nc-top time{color:#a4968b;font-size:10px;white-space:nowrap}.nc-copy p{margin:0;color:#75685e;font-size:12px;line-height:1.5}.nc-actions{display:flex;gap:15px;margin-top:10px;align-items:center}.nc-actions a,.nc-actions button{font-size:11px;font-weight:850}.nc-actions a{color:#e86600;text-decoration:none}.nc-actions button{border:0;background:none;color:#8c7d72;padding:0;cursor:pointer}.nc-dot{width:9px;height:9px;background:#ff7900;border-radius:50%;margin-top:7px}.nc-empty{text-align:center;padding:70px 20px;color:#8c7e73}.nc-empty span{font-size:35px}.nc-empty h3{color:#30241d;margin-bottom:5px}@media(max-width:900px){.nc-page{grid-template-columns:1fr}.nc-side{position:static;display:flex;overflow:auto;gap:4px}.nc-side-title{display:none}.nc-side a{white-space:nowrap}.nc-stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.nc-page{padding:0 12px;margin-top:18px}.nc-hero{padding:24px 20px;align-items:flex-start;flex-direction:column}.nc-hero h1{font-size:26px}.nc-stats{grid-template-columns:1fr 1fr}.nc-item{grid-template-columns:42px 1fr 8px;padding:15px 13px}.nc-icon{width:40px;height:40px}.nc-top{display:block}.nc-actions{flex-wrap:wrap}}
</style>
<script>
(()=>{const post=async(url)=>{const r=await fetch(url,{method:'POST',headers:{Accept:'application/json'}});if(!r.ok)throw new Error('Action impossible');return r.json()};const refresh=()=>location.reload();document.getElementById('ncReadAll')?.addEventListener('click',async()=>{await post('/notifications/read-all');refresh()});document.addEventListener('click',async e=>{const b=e.target.closest('.nc-toggle');if(b){e.preventDefault();await post(b.dataset.read==='1'?`/compte/notifications/${b.dataset.id}/unread`:`/notifications/${b.dataset.id}/read`);refresh();return}const a=e.target.closest('.nc-open');if(a){try{await post(`/notifications/${a.dataset.id}/read`)}catch(_){}}});let timer;document.querySelector('.nc-search input[name=q]')?.addEventListener('input',e=>{clearTimeout(timer);timer=setTimeout(()=>e.target.form.submit(),450)});if(window.io){const s=window.tiopNotificationSocket||io();s.on('notification:new',()=>location.reload());s.on('notification:changed',()=>location.reload())}})();
</script>
