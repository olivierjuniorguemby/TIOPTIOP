    display: flex;
}


.address-modal-overlay {

    position: absolute;

    inset: 0;

    background: rgba(18, 14, 10, .60);

    backdrop-filter: blur(4px);
}


.address-modal-dialog {

    position: relative;

    z-index: 2;

    width: min(720px, 100%);

    max-height: calc(100vh - 40px);

    overflow-y: auto;

    padding: 28px;

    box-sizing: border-box;

    border-radius: 27px;

    background: #fff;
}


.address-modal-header {

    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
}


.address-modal-header h2 {

    margin: 0;

    font-size: 28px;
}


.modal-close {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    border: 0;
    border-radius: 50%;

    background: #f5f2ef;

    font-size: 26px;

    cursor: pointer;
}


.checkbox-field {

    min-height: 50px;

    display: flex !important;
    flex-direction: row !important;

    align-items: center;

    gap: 10px !important;

    cursor: pointer;
}


.checkbox-field input {

    width: 17px !important;
    height: 17px !important;

    min-height: 0 !important;

    accent-color: var(--orange);
}


.modal-actions {

    display: flex;

    justify-content: flex-end;

    gap: 10px;

    margin-top: 24px;
}


.modal-message {

    display: none;

    margin-top: 15px;

    padding: 12px;

    border-radius: 12px;

    font-size: 13px;
    font-weight: 800;
}


.modal-message.error {

    display: block;

    background: #fff0ef;

    color: #a6372d;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .account-layout {

        grid-template-columns: 1fr;
    }


    .account-sidebar {

        position: static;

        flex-direction: row;

        overflow-x: auto;
    }


    .account-nav-item {

        white-space: nowrap;
    }
}


@media (max-width: 700px) {

    .form-grid,
    .addresses-grid {

        grid-template-columns: 1fr;
    }


    .form-group.full {

        grid-column: auto;
    }


    .address-heading {

        align-items: flex-start;
        flex-direction: column;
    }


    .profile-avatar-section {

        align-items: flex-start;
    }
}


@media (max-width: 520px) {

    .account-page {

        padding:
            25px 13px
            55px;
    }


    .account-card {

        padding: 20px;

        border-radius: 22px;
    }


    .profile-avatar-section {

        flex-direction: column;
    }


    .modal-actions {

        flex-direction: column-reverse;
    }


    .modal-actions button {

        width: 100%;
    }
}

</style>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* =====================================================
           AVATAR PREVIEW
        ===================================================== */

        const profilePhoto =
            document.getElementById(
                "profilePhoto"
            );


        if (profilePhoto) {

            profilePhoto.addEventListener(
                "change",
                function () {

                    const file =
                        this.files &&
                        this.files[0];


                    if (!file) {
                        return;
                    }


                    if (
                        ![
                            "image/jpeg",
                            "image/png",
                            "image/webp"
                        ].includes(file.type)
                    ) {

                        alert(
                            "Format non autorisé. Utilisez JPG, PNG ou WEBP."
                        );

                        this.value = "";

                        return;
                    }


                    if (
                        file.size >
                        5 * 1024 * 1024
                    ) {

                        alert(
                            "L'image ne doit pas dépasser 5 Mo."
                        );

                        this.value = "";

                        return;
                    }


                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            const container =
                                document.getElementById(
                                    "profileAvatarPreview"
                                );


                            container.innerHTML = `
                                <img
                                    src="${event.target.result}"
                                    alt="Nouvelle photo de profil"
                                >
                            `;
                        };


                    reader.readAsDataURL(
                        file
                    );
                }
            );
        }


        /* =====================================================
           MODAL
        ===================================================== */

        const modal =
            document.getElementById(
                "addressModal"
            );

        const form =
            document.getElementById(
                "addressForm"
            );

        const title =
            document.getElementById(
                "addressModalTitle"
            );

        const message =
            document.getElementById(
                "addressMessage"
            );


        function openModal() {

            modal.classList.add(
                "open"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";
        }


        function closeModal() {

            modal.classList.remove(
                "open"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

            resetAddressForm();
        }


        function resetAddressForm() {

            form.reset();

            document.getElementById(
                "addressId"
            ).value = "";


            document.getElementById(
                "city"
            ).value =
                "Brazzaville";


            document.getElementById(
                "countryCode"
            ).value =
                "CG";


            title.textContent =
                "Ajouter une adresse";


            message.className =
                "modal-message";

            message.textContent =
                "";
        }


        document
            .getElementById(
                "openAddressModal"
            )
            ?.addEventListener(
                "click",
                function () {

                    resetAddressForm();

                    openModal();
                }
            );


        document
            .getElementById(
                "emptyAddAddress"
            )
            ?.addEventListener(
                "click",
                function () {

                    resetAddressForm();

                    openModal();
                }
            );


        document
            .getElementById(
                "closeAddressModal"
            )
            ?.addEventListener(
                "click",
                closeModal
            );


        document
            .getElementById(
                "cancelAddressModal"
            )
            ?.addEventListener(
                "click",
                closeModal
            );


        document
            .getElementById(
                "addressModalOverlay"
            )
            ?.addEventListener(
                "click",
                closeModal
            );


        /* =====================================================
   EDITION ADRESSE
===================================================== */

document
    .querySelectorAll(".edit-address")
    .forEach(function (button) {

        button.addEventListener(
            "click",
            function () {

                const data = this.dataset;


                /* =============================================
                   ID
                ============================================= */

                document.getElementById(
                    "addressId"
                ).value =
                    data.id || "";


                /* =============================================
                   TYPE
                ============================================= */

                document.getElementById(
                    "addressLabel"
                ).value =
                    data.label || "Maison";


                /* =============================================
                   DESTINATAIRE
                ============================================= */

                document.getElementById(
                    "recipientName"
                ).value =
                    data.recipientName || "";


                /* =============================================
                   TELEPHONE
                ============================================= */

                document.getElementById(
                    "addressPhone"
                ).value =
                    data.phone || "";


                /* =============================================
                   ADRESSE
                ============================================= */

                document.getElementById(
                    "addressLine1"
                ).value =
                    data.addressLine1 || "";


                document.getElementById(
                    "addressLine2"
                ).value =
                    data.addressLine2 || "";


                /* =============================================
                   QUARTIER
                ============================================= */

                document.getElementById(
                    "district"
                ).value =
                    data.district || "";


                /* =============================================
                   VILLE
                ============================================= */

                document.getElementById(
                    "city"
                ).value =
                    data.city || "Brazzaville";


                /* =============================================
                   PAYS
                ============================================= */

                document.getElementById(
                    "countryCode"
                ).value =
                    data.countryCode || "CG";


                /* =============================================
                   INSTRUCTIONS
                ============================================= */

                document.getElementById(
                    "deliveryInstructions"
                ).value =
                    data.deliveryInstructions || "";


                /* =============================================
                   GPS
                ============================================= */

                document.getElementById(
                    "addressLatitude"
                ).value =
                    data.latitude || "";


                document.getElementById(
                    "addressLongitude"
                ).value =
                    data.longitude || "";


                /* =============================================
                   PAR DEFAUT
                ============================================= */

                document.getElementById(
                    "isDefault"
                ).checked =
                    data.isDefault === "1";


                /* =============================================
                   TITRE
                ============================================= */

                title.textContent =
                    "Modifier l’adresse";


                /* =============================================
                   NETTOYER MESSAGE
                ============================================= */

                message.className =
                    "modal-message";

                message.textContent =
                    "";


                /* =============================================
                   OUVERTURE
                ============================================= */

                openModal();
            }
        );
    });

        /* =====================================================
           CREATION / MODIFICATION
        ===================================================== */

        form.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();


                const addressId =
                    document.getElementById(
                        "addressId"
                    ).value;


                const submitButton =
                    document.getElementById(
                        "saveAddressButton"
                    );


                submitButton.disabled =
                    true;

                submitButton.textContent =
                    "Enregistrement...";


                message.className =
                    "modal-message";

                message.textContent =
                    "";


                try {

                    const formData =
                        new FormData(
                            form
                        );


                    const data =
                        Object.fromEntries(
                            formData.entries()
                        );


                    data.is_default =
                        document.getElementById(
                            "isDefault"
                        ).checked;


                    const url =
                        addressId
                            ? `/profil/adresses/${addressId}/update`
                            : "/profil/adresses";


                    const response =
                        await fetch(
                            url,
                            {
                                method:
                                    "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                body:
                                    JSON.stringify(
                                        data
                                    )
                            }
                        );


                    const contentType =
                        response.headers.get("content-type") || "";

                    if (!contentType.includes("application/json")) {

                        const text =
                            await response.text();

                        console.error(
                            "Réponse serveur non JSON :",
                            text
                        );

                        throw new Error(
                            "Le serveur n'a pas retourné une réponse valide."
                        );
                    }

                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message
                            ||
                            "Une erreur est survenue."
                        );
                    }


                    window.location.reload();

                }
                catch (error) {

                    message.textContent =
                        error.message;


                    message.className =
                        "modal-message error";

                }
                finally {

                    submitButton.disabled =
                        false;

                    submitButton.textContent =
                        "Enregistrer l’adresse";
                }
            }
        );


        /* =====================================================
           ADRESSE PAR DEFAUT
        ===================================================== */

        document
            .querySelectorAll(
                ".set-default-address"
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        async function () {

                            const id =
                                this.dataset.id;


                            if (!id) {
                                return;
                            }


                            try {

                                const response =
                                    await fetch(
                                        `/profil/adresses/${id}/default`,
                                        {
                                            method:
                                                "POST"
                                        }
                                    );


                                const contentType =
                                    response.headers.get("content-type") || "";

                                if (!contentType.includes("application/json")) {

                                    const text =
                                        await response.text();

                                    console.error(
                                        "Réponse serveur non JSON :",
                                        text
                                    );

                                    throw new Error(
                                        "Le serveur n'a pas retourné une réponse valide."
                                    );
                                }

                                const result =
                                    await response.json();


                                if (
                                    !response.ok ||
                                    !result.success
                                ) {

                                    throw new Error(
                                        result.message
                                    );
                                }


                                window.location.reload();

                            }
                            catch (error) {

                                alert(
                                    error.message
                                    ||
                                    "Impossible de modifier l'adresse."
                                );
                            }
                        }
                    );
                }
            );


        /* =====================================================
           SUPPRESSION
        ===================================================== */

        document
            .querySelectorAll(
                ".delete-address"
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        async function () {

                            const id =
                                this.dataset.id;


                            const confirmation =
                                window.confirm(
                                    "Voulez-vous vraiment supprimer cette adresse ?"
                                );


                            if (!confirmation) {
                                return;
                            }


                            try {

                                const response =
                                    await fetch(
                                        `/profil/adresses/${id}/delete`,
                                        {
                                            method:
                                                "POST"
                                        }
                                    );


                                const contentType =
                                    response.headers.get("content-type") || "";

                                if (!contentType.includes("application/json")) {

                                    const text =
                                        await response.text();

                                    console.error(
                                        "Réponse serveur non JSON :",
                                        text
                                    );

                                    throw new Error(
                                        "Le serveur n'a pas retourné une réponse valide."
                                    );
                                }

                                const result =
                                    await response.json();


                                if (
                                    !response.ok ||
                                    !result.success
                                ) {

                                    throw new Error(
                                        result.message
                                    );
                                }


                                window.location.reload();

                            }
                            catch (error) {

                                alert(
                                    error.message
                                    ||
                                    "Impossible de supprimer cette adresse."
                                );
                            }
                        }
                    );
                }
            );


        /* =====================================================
           ESC
        ===================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key ===
                    "Escape"
                ) {

                    closeModal();
                }
            }
        );

    }
);

</script>