ound:#fff;color:#202638;border-radius:12px;padding:8px;box-shadow:0 12px 35px rgba(0,0,0,.3);display:grid;gap:4px;min-width:180px}.smv-share-menu[hidden]{display:none}.smv-share-menu button{border:0;background:#fff;text-align:left;padding:9px;border-radius:8px;cursor:pointer}.smv-share-menu button:hover{background:#f3f4f6}@media(max-width:720px){.smv-stage{padding:12px 48px}.smv-top{padding:0 8px}.smv-btn{padding:8px}.smv-strip{height:78px}.smv-thumb{width:56px;height:56px;flex-basis:56px}}
