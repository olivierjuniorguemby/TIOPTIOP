<% const labels={NEW:'Ouverte',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'Attente de votre réponse',RESOLVED:'Résolue',CLOSED:'Fermée'}; const catIcons={ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}; const selected=tickets.find(t=>Number(t.id)===Number(selectedId))||tickets[0]; const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; %>
<section class="sd-page">
 <aside class="sd-side"><div class="sd-side-title">Mon espace</div><a href="/compte">⌂ <span>Vue d'ensemble</span></a><a href="/profil">◎ <span>Mon profil</span></a><a href="/commandes">▣ <span>Mes commandes</span></a><a href="/paiements-client">▤ <span>Mes paiements</span></a><a class="active" href="/compte/demandes">💬 <span>Mes demandes</span></a><a href="/favoris">♡ <span>Mes favoris</span></a><a href="/tiopplus">☆ <span>Mes points Tiop+</span></a><a href="/parametres">⚙ <span>Paramètres</span></a></aside>
 <main class="sd-main">
  <header class="sd-head"><div class="sd-title"><span class="sd-logo">💬</span><div><h1>Mes demandes</h1><p>Échangez avec le support TiopTiop et suivez vos demandes.</p></div></div><a href="/contact" class="sd-new">＋ Nouvelle demande</a></header>
  <% if(sent){ %><div class="sd-success">✓ Votre message a bien été envoyé au support.</div><% } %>
  <div class="sd-workspace">
   <section class="sd-list-panel">
    <div class="sd-tabs"><button class="active" data-filter="ALL">Toutes <b><%= counts.all %></b></button><button data-filter="NEW">Ouvertes <b><%= counts.open %></b></button><button data-filter="PROGRESS">En cours <b><%= counts.inProgress %></b></button><button data-filter="RESOLVED">Résolues <b><%= counts.resolved %></b></button><button data-filter="CLOSED">Fermées <b><%= counts.closed %></b></button></div>
    <div class="sd-tools"><label>⌕ <input id="ticketSearch" placeholder="Rechercher une demande..."></label><select id="ticketSort"><option value="new">Plus récent</option><option value="old">Plus ancien</option></select></div>
    <div id="ticketList" class="sd-ticket-list">
     <% if(!tickets.length){ %><div class="sd-empty"><span>💬</span><h3>Aucune demande</h3><p>Vous n'avez pas encore contacté notre support.</p><a href="/contact">Créer une demande</a></div><% } %>
     <% tickets.forEach(t=>{ const time=t.last_message_at||t.updated_at; %><a href="/compte/demandes?ticket=<%= t.id %>" class="sd-ticket <%= selected&&selected.id===t.id?'selected':'' %> <%= Number(t.unread_count||0)>0?'unread':'' %>" data-id="<%= t.id %>" data-unread="<%= Number(t.unread_count||0) %>" data-status="<%= t.status %>" data-time="<%= new Date(time).getTime() %>" data-search="<%= (t.reference+' '+t.subject+' '+(t.order_reference||'')+' '+(t.last_message||'')).toLowerCase() %>"><div class="sd-ticket-icon"><%= catIcons[t.category]||'💬' %></div><div class="sd-ticket-body"><div class="sd-ticket-top"><strong><%= t.reference %> · <%= t.subject %></strong><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span></div><p><%= t.last_message||'Demande support' %></p><small><%= t.order_reference?'Commande : '+t.order_reference+' · ':'' %><%= new Date(time).toLocaleString('fr-FR') %></small></div><% if(Number(t.unread_count||0)>0){ %><span class="sd-unread"><%= t.unread_count %></span><% } %><span class="sd-chevron">›</span></a><% }) %>
    </div>
   </section>
   <section class="sd-conversation">
    <% if(selected){ const lastId=(selected.messages||[]).length?(selected.messages||[])[(selected.messages||[]).length-1].id:0; %>
    <div class="sd-conv-head"><div class="sd-ticket-icon"><%= catIcons[selected.category]||'💬' %></div><div><h2><%= selected.reference %> · <%= selected.subject %></h2><p><%= selected.order_reference?'Commande : '+selected.order_reference:'Demande générale' %></p><small>Créée le <%= new Date(selected.created_at).toLocaleString('fr-FR') %></small></div><span class="badge b-<%= selected.status.toLowerCase() %>"><%= labels[selected.status]||selected.status %></span><form method="POST" action="/compte/demandes/<%= selected.id %>/archiver" onsubmit="return confirm('Retirer cette demande de votre espace ?')"><button class="archive-ticket" title="Supprimer de mes demandes">🗑</button></form></div>
    <div class="sd-messages" id="clientMessages" data-last-id="<%= lastId %>" data-ticket="<%= selected.id %>">
     <% (selected.messages||[]).forEach(m=>{ const mine=m.sender_type==='CUSTOMER'; %><div class="sd-message-row <%= m.sender_type==='ADMIN'?'admin':'customer' %>" data-message-id="<%= m.id %>"><div class="sd-avatar"><%= m.sender_type==='ADMIN'?'🎧':'👤' %></div><div class="sd-bubble"><div class="sd-msg-head"><strong><%= m.sender_type==='ADMIN'?'Support TiopTiop':'Vous' %></strong><% if(mine && !m.deleted_at){ %><span class="sd-msg-actions"><button type="button" class="msg-edit" data-id="<%= m.id %>" data-text="<%= String(m.message||'').replace(/"/g,'&quot;') %>">✎</button><button type="button" class="msg-delete" data-id="<%= m.id %>">🗑</button></span><% } %></div><% if(m.deleted_at){ %><p class="sd-deleted">Message supprimé</p><% }else{ %><% if(m.message){ %><p><%= m.message %></p><% } %><% (m.attachments||[]).forEach(a=>{ const href=a.id?('/compte/demandes/fichier/'+a.id):(a.legacy_url||('#')); %><a class="sd-attachment" href="<%= href %>" target="_blank" rel="noopener"><% if(isImg(a)){ %><img src="<%= href %>" alt="Pièce jointe"><% }else{ %><span>📄</span><span><%= a.original_name||'Ouvrir la pièce jointe' %></span><% } %></a><% }) %><% } %><div class="sd-reactions"><% (m.reactions||[]).forEach(r=>{ %><span><%= r.emoji %></span><% }) %></div><div class="sd-msg-foot"><small><%= new Date(m.created_at).toLocaleString('fr-FR') %><%= m.edited_at?' · Modifié':'' %></small><% if(mine){ %><span class="read-state" title="<%= m.read_at?'Lu':'Envoyé' %>"><%= m.read_at?'✓✓':'✓' %></span><% } %></div><% if(!m.deleted_at){ %><div class="sd-react-bar"><button type="button" class="react-open" data-id="<%= m.id %>">☺</button><div class="react-menu" hidden><% reactionSet.forEach(e=>{ %><button type="button" data-id="<%= m.id %>" data-emoji="<%= e %>"><%= e %></button><% }) %></div></div><% } %></div></div><% }) %>
    </div>
    <% if(selected.status!=='CLOSED'){ %>
    <form class="sd-compose" method="POST" action="/compte/demandes/<%= selected.id %>/repondre" enctype="multipart/form-data">
      <div class="sd-actions"><button type="button" class="sd-icon-btn emoji-toggle" title="Ajouter un emoji">😊</button><label class="sd-icon-btn" title="Ajouter des pièces jointes">📎<input type="file" name="attachments" multiple accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt" hidden></label></div>
      <div class="sd-editor"><textarea name="message" maxlength="4000" placeholder="Écrire votre message..."></textarea><div class="emoji-panel" hidden></div><div class="file-name"></div><div class="file-preview"></div></div><button class="sd-send" title="Envoyer">➤</button>
    </form><% }else{ %><div class="sd-closed">🔒 Cette demande est fermée. Créez une nouvelle demande si vous avez besoin d'aide.</div><% } %>
    <% }else{ %><div class="sd-empty sd-empty-conv"><span>🎧</span><h3>Support TiopTiop</h3><p>Sélectionnez une demande pour afficher la conversation.</p></div><% } %>
   </section>
  </div>
 </main>
</section>
<style>
.sd-page{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;max-width:1500px;margin:30px auto 70px;padding:0 24px;color:#161a2d}.sd-side{background:#fff;border:1px solid #edf0f4;border-radius:22px;padding:20px 12px;height:max-content;position:sticky;top:100px;box-shadow:0 14px 40px rgba(27,34,58,.05)}.sd-side-title{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#9aa1ad;padding:8px 14px 14px;font-weight:800}.sd-side a{display:flex;gap:12px;align-items:center;padding:13px 14px;margin:3px 0;border-radius:12px;color:#4e5668;text-decoration:none;font-weight:650}.sd-side a.active{background:#fff0e4;color:#b65300}.sd-side a:hover{background:#f7f8fa}.sd-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.sd-title{display:flex;gap:15px;align-items:center}.sd-logo{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#8e55dc;color:#fff;font-size:22px}.sd-head h1{margin:0;font-size:30px}.sd-head p{margin:5px 0 0;color:#7a8190}.sd-new{background:#ff7100;color:#fff;text-decoration:none;padding:14px 20px;border-radius:13px;font-weight:850;box-shadow:0 10px 24px rgba(255,113,0,.2)}.sd-success{padding:13px 16px;border-radius:13px;background:#eaf9ef;color:#15703a;font-weight:750;margin-bottom:15px}.sd-workspace{display:grid;grid-template-columns:minmax(430px,.95fr) minmax(440px,1.05fr);gap:16px}.sd-list-panel,.sd-conversation{background:#fff;border:1px solid #e7ebf0;border-radius:18px;box-shadow:0 12px 35px rgba(28,39,64,.05);overflow:hidden}.sd-tabs{display:flex;gap:6px;padding:14px;border-bottom:1px solid #edf0f4;overflow:auto}.sd-tabs button{white-space:nowrap;border:0;background:#f7f8fa;padding:10px 12px;border-radius:11px;font-weight:750;color:#697182;cursor:pointer}.sd-tabs button.active{background:#eef1f5;color:#17203a}.sd-tabs b{display:inline-grid;place-items:center;min-width:22px;height:22px;border-radius:999px;background:#fff;margin-left:6px;font-size:11px}.sd-tools{display:grid;grid-template-columns:1fr 125px;gap:10px;padding:12px 14px}.sd-tools label{display:flex;align-items:center;border:1px solid #dfe4ea;border-radius:11px;padding:0 12px;color:#777}.sd-tools input{border:0;outline:0;background:transparent;width:100%;padding:11px;font:inherit}.sd-tools select{border:1px solid #dfe4ea;border-radius:11px;background:#fff;padding:10px}.sd-ticket-list{padding:0 14px 14px;display:flex;flex-direction:column;gap:9px}.sd-ticket{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #e3e7ed;border-radius:14px;text-decoration:none;color:inherit;transition:.18s}.sd-ticket:hover,.sd-ticket.selected{border-color:#ff7900;background:#fffaf5;transform:translateY(-1px)}.sd-ticket.unread .sd-ticket-body strong,.sd-ticket.unread .sd-ticket-body p{font-weight:900;color:#111827}.sd-unread{display:grid;place-items:center;min-width:22px;height:22px;border-radius:999px;background:#ff7100;color:#fff;font-size:11px;font-weight:900}.sd-ticket-icon{width:46px;height:46px;border-radius:13px;background:#fff1e5;display:grid;place-items:center;flex:0 0 46px;font-size:20px}.sd-ticket-body{min-width:0;flex:1}.sd-ticket-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.sd-ticket p{margin:5px 0;color:#3f4654;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sd-ticket small,.sd-conv-head small,.sd-bubble small{color:#8b929e}.sd-chevron{font-size:25px}.badge{display:inline-flex;align-items:center;padding:7px 11px;border-radius:999px;font-size:12px;font-weight:850;white-space:nowrap}.b-new{background:#ffe7eb;color:#d91f45}.b-in_progress,.b-waiting_customer{background:#fff0dc;color:#c36a00}.b-resolved{background:#e4f7ec;color:#08763b}.b-closed{background:#eceff3;color:#68707e}.sd-conv-head{display:flex;align-items:center;gap:13px;padding:16px;border-bottom:1px solid #edf0f4}.sd-conv-head>div:nth-child(2){flex:1}.sd-conv-head h2{margin:0 0 4px;font-size:18px}.sd-conv-head p{margin:0 0 3px;color:#697182}.sd-messages{padding:20px;min-height:380px;max-height:540px;overflow:auto;background:linear-gradient(180deg,#fff,#fbfcfd);scroll-behavior:smooth}.sd-message-row{display:flex;gap:9px;margin-bottom:17px;max-width:86%}.sd-message-row.admin{margin-left:auto;flex-direction:row-reverse}.sd-avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#eef1f6;flex:0 0 36px}.sd-message-row.admin .sd-avatar{background:#e5f2ff}.sd-bubble{position:relative;background:#f3f5f7;border-radius:15px;padding:12px 14px;min-width:150px}.sd-message-row.admin .sd-bubble{background:#e8f3ff}.sd-msg-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.sd-msg-actions{opacity:0;transition:.15s}.sd-bubble:hover .sd-msg-actions{opacity:1}.sd-msg-actions button,.sd-react-bar button,.react-menu button{border:0;background:transparent;cursor:pointer}.sd-bubble p{margin:5px 0 8px;line-height:1.5;white-space:pre-wrap}.sd-deleted{font-style:italic;color:#8d94a0}.sd-attachment{display:flex;gap:8px;align-items:center;margin:8px 0;text-decoration:none;color:#285ea8;font-weight:750}.sd-attachment img{display:block;max-width:230px;max-height:180px;border-radius:12px;border:1px solid #dce3eb}.sd-msg-foot{display:flex;align-items:center;justify-content:space-between;gap:12px}.read-state{font-size:12px;color:#4a8cca;font-weight:900}.sd-reactions{display:flex;gap:4px;flex-wrap:wrap}.sd-reactions span{background:#fff;border:1px solid #e6e8ec;border-radius:999px;padding:2px 6px}.sd-react-bar{position:relative;margin-top:4px}.react-menu{position:absolute;z-index:30;bottom:26px;left:0;display:flex;gap:2px;padding:6px;background:#fff;border:1px solid #e1e5ea;border-radius:999px;box-shadow:0 10px 28px rgba(20,30,50,.15)}.react-menu[hidden]{display:none}.sd-compose{display:grid;grid-template-columns:82px minmax(0,1fr) 48px;gap:8px;align-items:center;padding:14px;border-top:1px solid #edf0f4}.sd-actions{display:flex;gap:6px;align-items:center}.sd-icon-btn{width:38px;height:38px;border:1px solid #dfe4ea;background:#fff;border-radius:10px;display:grid;place-items:center;cursor:pointer;font-size:17px}.sd-editor{position:relative;min-width:0}.sd-compose textarea{display:block;width:100%;box-sizing:border-box;resize:none;min-height:46px;max-height:110px;border:1px solid #dfe4ea;border-radius:12px;padding:12px;font:inherit;outline:0}.sd-compose textarea:focus{border-color:#ff7900}.sd-send{border:0;width:46px;height:46px;border-radius:12px;background:#ff7100;color:#fff;font-size:20px;cursor:pointer}.emoji-panel{position:absolute;bottom:58px;left:0;z-index:20;width:245px;padding:10px;border:1px solid #e0e4ea;border-radius:14px;background:#fff;box-shadow:0 12px 35px rgba(20,30,50,.14);display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.emoji-panel[hidden]{display:none}.emoji-panel button{border:0;background:transparent;font-size:20px;padding:5px;cursor:pointer;border-radius:8px}.emoji-panel button:hover{background:#f2f4f7}.file-name{font-size:11px;color:#677180;padding:4px 3px 0;min-height:14px}.sd-closed{padding:18px;text-align:center;background:#f5f6f8;color:#6c7380}.sd-empty{text-align:center;padding:45px 20px;color:#7b8290}.sd-empty>span{font-size:34px}.sd-empty h3{color:#202638}.sd-empty a{display:inline-block;margin-top:8px;color:#ff7100;font-weight:800}.sd-empty-conv{padding-top:150px}@media(max-width:1050px){.sd-page{grid-template-columns:1fr}.sd-side{position:static;display:flex;overflow:auto}.sd-side-title{display:none}.sd-side a{white-space:nowrap}.sd-workspace{grid-template-columns:1fr}}@media(max-width:650px){.sd-page{padding:0 12px}.sd-head{align-items:flex-start;gap:12px}.sd-new{padding:11px 12px}.sd-workspace{display:block}.sd-conversation{margin-top:14px}.sd-tools{grid-template-columns:1fr}.sd-ticket-top .badge{display:none}.sd-compose{grid-template-columns:82px minmax(0,1fr) 48px}.sd-message-row{max-width:95%}}
</style>
<style>.archive-ticket{border:1px solid #e3e7ed;background:#fff;border-radius:10px;padding:8px;cursor:pointer}.file-preview{display:flex;gap:7px;flex-wrap:wrap;padding-top:6px}.file-chip{display:flex;align-items:center;gap:6px;background:#f4f6f8;border:1px solid #e1e5ea;border-radius:9px;padding:5px 7px;font-size:11px}.file-chip img,.file-chip video{width:42px;height:32px;object-fit:cover;border-radius:6px}.file-chip button{border:0;background:#fff;border-radius:50%;cursor:pointer;color:#c33}.sd-unread{background:#e32636!important}</style>

<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{
  const box=document.getElementById('clientMessages');
  const ticketId=Number(box?.dataset.ticket||0);
  const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅'];
  const labels={NEW:'Ouverte',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'Attente de votre réponse',RESOLVED:'Résolue',CLOSED:'Fermée'};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fr=d=>{try{return new Date(d).toLocaleString('fr-FR')}catch{return ''}};
  const nearBottom=el=>!el||el.scrollHeight-el.scrollTop-el.clientHeight<110;
  const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||''));
  const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||''));
  let syncing=false, queued=false;

  function attachmentHtml(a){
    const href=a.id?('/compte/demandes/fichier/'+a.id):(a.legacy_url||'#');
    if(isImg(a))return `<a class="sd-attachment" href="${esc(href)}" target="_blank" rel="noopener"><img src="${esc(href)}" alt="Pièce jointe"></a>`;
    if(isVideo(a))return `<a class="sd-attachment" href="${esc(href)}" target="_blank" rel="noopener"><video controls preload="metadata" src="${esc(href)}" style="display:block;max-width:260px;max-height:180px;border-radius:10px;background:#000"></video><span>🎬 ${esc(a.original_name||'Vidéo de préparation')}</span></a>`;
    return `<a class="sd-attachment" href="${esc(href)}" target="_blank" rel="noopener"><span>📄</span><span>${esc(a.original_name||'Ouvrir la pièce jointe')}</span></a>`;
  }
  function messageHtml(m){
    const mine=m.sender_type==='CUSTOMER', admin=m.sender_type==='ADMIN';
    const actions=mine&&!m.deleted_at?`<span class="sd-msg-actions"><button type="button" class="msg-edit" data-id="${m.id}" data-text="${esc(m.message||'')}">✎</button><button type="button" class="msg-delete" data-id="${m.id}">🗑</button></span>`:'';
    const content=m.deleted_at?'<p class="sd-deleted">Message supprimé</p>':`${m.message?`<p>${esc(m.message)}</p>`:''}${(m.attachments||[]).map(attachmentHtml).join('')}`;
    const reactions=(m.reactions||[]).map(r=>`<span>${esc(r.emoji)}</span>`).join('');
    const menu=!m.deleted_at?`<div class="sd-react-bar"><button type="button" class="react-open" data-id="${m.id}">☺</button><div class="react-menu" hidden>${reactionSet.map(e=>`<button type="button" data-id="${m.id}" data-emoji="${e}">${e}</button>`).join('')}</div></div>`:'';
    return `<div class="sd-message-row ${admin?'admin':'customer'}" data-message-id="${m.id}"><div class="sd-avatar">${admin?'🎧':'👤'}</div><div class="sd-bubble"><div class="sd-msg-head"><strong>${admin?'Support TiopTiop':'Vous'}</strong>${actions}</div>${content}<div class="sd-reactions">${reactions}</div><div class="sd-msg-foot"><small>${esc(fr(m.created_at))}${m.edited_at?' · Modifié':''}</small>${mine?`<span class="read-state" title="${m.read_at?'Lu':'Envoyé'}">${m.read_at?'✓✓':'✓'}</span>`:''}</div>${menu}</div></div>`;
  }
  function updateTickets(tickets){
    const list=document.getElementById('ticketList'); if(!list)return;
    const byId=new Map((tickets||[]).map(t=>[String(t.id),t]));
    [...list.querySelectorAll('.sd-ticket')].forEach(el=>{if(!byId.has(el.dataset.id))el.remove();});
    (tickets||[]).forEach(t=>{
      let el=list.querySelector(`.sd-ticket[data-id="${t.id}"]`);
      if(!el)return;
      el.dataset.unread=Number(t.unread_count||0); el.dataset.status=t.status; el.dataset.time=new Date(t.last_message_at||t.updated_at).getTime();
      el.classList.toggle('unread',Number(t.unread_count||0)>0);
      const p=el.querySelector('.sd-ticket-body p'); if(p)p.textContent=t.last_message||'Demande support';
      const small=el.querySelector('.sd-ticket-body small'); if(small)small.textContent=(t.order_reference?'Commande : '+t.order_reference+' · ':'')+fr(t.last_message_at||t.updated_at);
      let badge=el.querySelector('.sd-unread');
      if(Number(t.unread_count||0)>0){if(!badge){badge=document.createElement('span');badge.className='sd-unread';el.insertBefore(badge,el.querySelector('.sd-chevron'));}badge.textContent=t.unread_count;} else badge?.remove();
    });
    [...list.querySelectorAll('.sd-ticket')].sort((a,b)=>Number(b.dataset.time)-Number(a.dataset.time)).forEach(el=>list.appendChild(el));
  }
  async function syncSupport(reason='socket'){
    if(syncing){queued=true;return;} syncing=true;
    try{
      const res=await fetch(`/compte/demandes/poll?ticket=${ticketId}`,{headers:{Accept:'application/json'},cache:'no-store'}); if(!res.ok)return;
      const data=await res.json(); updateTickets(data.tickets||[]);
      if(box&&ticketId){const stick=nearBottom(box);box.innerHTML=(data.messages||[]).map(messageHtml).join('');box.dataset.lastId=String((data.messages||[]).at(-1)?.id||0);if(stick||reason==='message:new'||reason==='send')requestAnimationFrame(()=>box.scrollTop=box.scrollHeight);}
    }finally{syncing=false;if(queued){queued=false;syncSupport('queued');}}
  }
  async function post(url,data){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:new URLSearchParams(data)});if(!r.ok)throw new Error('Action impossible');return r.json();}
  document.addEventListener('click',async e=>{
    const edit=e.target.closest('.msg-edit'); if(edit){const text=prompt('Modifier votre message :',edit.dataset.text||'');if(text===null)return;await post(`/compte/demandes/${ticketId}/messages/${edit.dataset.id}/edit`,{message:text});await syncSupport('edit');return;}
    const del=e.target.closest('.msg-delete'); if(del){if(!confirm('Supprimer ce message ?'))return;await post(`/compte/demandes/${ticketId}/messages/${del.dataset.id}/delete`,{});await syncSupport('delete');return;}
    const ro=e.target.closest('.react-open'); if(ro){const m=ro.parentElement.querySelector('.react-menu');if(m)m.hidden=!m.hidden;return;}
    const rb=e.target.closest('.react-menu button'); if(rb){await post(`/compte/demandes/${ticketId}/messages/${rb.dataset.id}/react`,{emoji:rb.dataset.emoji});await syncSupport('reaction');}
  });
  const emojis=['😀','😂','😊','😍','🥰','😅','😢','😭','😡','👍','🙏','👏','❤️','🔥','✅','❌','🎉','🤝','📦','🚚','💳','⭐','🍽️','📞','💡','👌','😉','🙂'];
  document.querySelectorAll('.sd-compose').forEach(form=>{
    const ta=form.querySelector('textarea'),panel=form.querySelector('.emoji-panel'),toggle=form.querySelector('.emoji-toggle'),input=form.querySelector('input[type=file]'),preview=form.querySelector('.file-preview'),name=form.querySelector('.file-name'); let chosen=[];
    emojis.forEach(em=>{const b=document.createElement('button');b.type='button';b.textContent=em;b.onclick=()=>{const a=ta.selectionStart||ta.value.length,c=ta.selectionEnd||a;ta.value=ta.value.slice(0,a)+em+ta.value.slice(c);ta.focus();ta.selectionStart=ta.selectionEnd=a+em.length;panel.hidden=true};panel.appendChild(b)}); toggle?.addEventListener('click',()=>panel.hidden=!panel.hidden);
    const render=()=>{if(!preview)return;preview.innerHTML='';chosen.forEach((f,i)=>{const c=document.createElement('div');c.className='file-chip';if(f.type.startsWith('image/')){const im=document.createElement('img');im.src=URL.createObjectURL(f);c.appendChild(im)}const n=document.createElement('span');n.textContent=f.name;c.appendChild(n);const x=document.createElement('button');x.type='button';x.textContent='×';x.onclick=()=>{chosen.splice(i,1);syncFiles()};c.appendChild(x);preview.appendChild(c)});if(name)name.textContent=chosen.length?`📎 ${chosen.length} fichier(s)`:'';};
    const syncFiles=()=>{const dt=new DataTransfer();chosen.forEach(f=>dt.items.add(f));input.files=dt.files;render()}; input?.addEventListener('change',()=>{chosen=[...input.files];render()});
    form.addEventListener('submit',async ev=>{ev.preventDefault();if(!ta.value.trim()&&!input?.files?.length){ta.focus();return;}const btn=form.querySelector('.sd-send');btn.disabled=true;try{const r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});if(!r.ok)throw new Error('Envoi impossible');ta.value='';chosen=[];syncFiles();await syncSupport('send');}catch(err){alert(err.message||'Envoi impossible');}finally{btn.disabled=false;}});
  });
  if(window.io){const socket=io(); if(ticketId)socket.emit('support:join',{ticketId}); socket.on('support:changed',e=>syncSupport(e?.type||'socket'));}
  if(box){requestAnimationFrame(()=>box.scrollTop=box.scrollHeight);syncSupport('initial');}
})();
</script>
