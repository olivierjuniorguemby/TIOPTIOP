<style>.archive-ticket{border:1px solid #e3e7ed;background:#fff;border-radius:10px;padding:8px;cursor:pointer}.file-preview{display:flex;gap:7px;flex-wrap:wrap;padding-top:6px}.file-chip{display:flex;align-items:center;gap:6px;background:#f4f6f8;border:1px solid #e1e5ea;border-radius:9px;padding:5px 7px;font-size:11px}.file-chip img,.file-chip video{width:42px;height:32px;object-fit:cover;border-radius:6px}.file-chip button{border:0;background:#fff;border-radius:50%;cursor:pointer;color:#c33}.sd-unread{background:#e32636!important}.typing-indicator{position:absolute;left:12px;bottom:100%;z-index:8;font-size:12px;color:#8e55dc;font-weight:750;padding:4px 9px;margin-bottom:5px;background:#fff;border:1px solid #eee5fb;border-radius:12px;box-shadow:0 3px 10px rgba(0,0,0,.08);white-space:nowrap;pointer-events:none}.sd-compose{position:relative}.sd-list-typing{display:block;color:#8e55dc!important;font-weight:800!important;font-size:11px!important}.sd-no-selection{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:35px;color:#667085}.sd-no-selection .inner{max-width:330px}.sd-no-selection .pic{font-size:72px;display:block;margin-bottom:14px}.sd-no-selection h3{margin:0 0 7px;color:#172033}.sd-no-selection p{margin:0;line-height:1.5}.sd-file-hint{font-size:11px;color:#697386;font-weight:700}</style>
<style>
/* 18.7.1.3 — hauteur type WhatsApp + scroll indépendant */
.sd-list-panel,.sd-conversation{height:650px;min-height:0}
.sd-list-panel{display:flex;flex-direction:column}
.sd-ticket-list{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable}
.sd-conversation{display:flex;flex-direction:column;position:relative}
.sd-messages{flex:1;min-height:0;max-height:none;height:auto;overflow-y:auto}
.sd-compose{flex:0 0 auto;margin:0}
.sd-closed{flex:0 0 auto}
.sd-scroll-bottom{position:absolute;right:18px;bottom:82px;z-index:35;width:44px;height:44px;border:0;border-radius:50%;background:#fff;color:#ff7100;box-shadow:0 5px 20px rgba(25,35,55,.22);cursor:pointer;font-weight:900;font-size:18px;display:none}
.sd-scroll-bottom.show{display:grid;place-items:center}
.sd-scroll-bottom b{position:absolute;right:-5px;top:-7px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:#e32636;color:#fff;font-size:10px;display:grid;place-items:center}
