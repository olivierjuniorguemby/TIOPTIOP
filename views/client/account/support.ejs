<% const labels={NEW:'Ouverte',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'Attente de votre réponse',RESOLVED:'Résolue',CLOSED:'Fermée'}; const catIcons={ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}; const selected=tickets.find(t=>Number(t.id)===Number(selectedId))||null; const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; %>
<section class="sd-page">
 <aside class="sd-side"><div class="sd-side-title">Mon espace</div><a href="/compte">⌂ <span>Vue d'ensemble</span></a><a href="/profil">◎ <span>Mon profil</span></a><a href="/commandes">▣ <span>Mes commandes</span></a><a href="/paiements-client">▤ <span>Mes paiements</span></a><a class="active" href="/compte/demandes">💬 <span>Mes demandes</span></a><a href="/favoris">♡ <span>Mes favoris</span></a><a href="/tiopplus">☆ <span>Mes points Tiop+</span></a><a href="/parametres">⚙ <span>Paramètres</span></a></aside>
 <main class="sd-main">
  <header class="sd-head"><div class="sd-title"><span class="sd-logo">💬</span><div><h1>Mes demandes</h1><p>Échangez avec le support TiopTiop et suivez vos demandes.</p></div></div><div style="display:flex;gap:8px;align-items:center"><button type="button" class="sd-sound-toggle sd-new" style="border:0" title="Activer/désactiver les sons">🔊</button><a href="/contact" class="sd-new">＋ Nouvelle demande</a></div></header>
  <% if(sent){ %><div class="sd-success">✓ Votre message a bien été envoyé au support.</div><% } %>
  <div class="sd-workspace">
   <section class="sd-list-panel">
    <div class="sd-tabs"><button class="active" data-filter="ALL">Toutes <b><%= counts.all %></b></button><button data-filter="NEW">Ouvertes <b><%= counts.open %></b></button><button data-filter="PROGRESS">En cours <b><%= counts.inProgress %></b></button><button data-filter="RESOLVED">Résolues <b><%= counts.resolved %></b></button><button data-filter="CLOSED">Fermées <b><%= counts.closed %></b></button></div>
    <div class="sd-tools"><label>⌕ <input id="ticketSearch" placeholder="Rechercher une demande..."></label><select id="ticketSort"><option value="new">Plus récent</option><option value="old">Plus ancien</option></select></div>
    <div id="ticketList" class="sd-ticket-list">
     <% if(!tickets.length){ %><div class="sd-empty"><span>💬</span><h3>Aucune demande</h3><p>Vous n'avez pas encore contacté notre support.</p><a href="/contact">Créer une demande</a></div><% } %>
     <% tickets.forEach(t=>{ const time=t.last_message_at||t.updated_at; %><a href="/compte/demandes?ticket=<%= t.id %>" class="sd-ticket <%= selected&&selected.id===t.id?'selected':'' %> <%= Number(t.unread_count||0)>0?'unread':'' %>" data-id="<%= t.id %>" data-unread="<%= Number(t.unread_count||0) %>" data-status="<%= t.status %>" data-time="<%= new Date(time).getTime() %>" data-search="<%= (t.reference+' '+t.subject+' '+(t.order_reference||'')+' '+(t.last_message||'')).toLowerCase() %>"><div class="sd-ticket-icon"><%= catIcons[t.category]||'💬' %></div><div class="sd-ticket-body"><div class="sd-ticket-top"><strong><%= t.reference %> · <%= t.subject %></strong><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span></div><p><%= t.last_message||'Demande support' %></p><small><%= t.order_reference?'Commande : '+t.order_reference+' · ':'' %><%= new Date(time).toLocaleString('fr-FR') %></small></div><% if(Number(t.unread_count||0)>0){ %><span class="sd-unread"><%= t.unread_count %></span><% } %><span class="sd-chevron">›</span></a><% }) %>
    </div>
   </section>
   <section class="sd-conversation">
    <% if(selected){ const lastId=(selected.messages||[]).length?(selected.messages||[])[(selected.messages||[]).length-1].id:0; %>
    <div class="sd-conv-head"><div class="sd-ticket-icon"><%= catIcons[selected.category]||'💬' %></div><div><h2><%= selected.reference %> · <%= selected.subject %></h2><p><%= selected.order_reference?'Commande : '+selected.order_reference:'Demande générale' %></p><small>Créée le <%= new Date(selected.created_at).toLocaleString('fr-FR') %></small></div><span class="badge b-<%= selected.status.toLowerCase() %>"><%= labels[selected.status]||selected.status %></span><form method="POST" action="/compte/demandes/<%= selected.id %>/archiver" onsubmit="return confirm('Retirer cette demande de votre espace ?')"><button class="archive-ticket" title="Supprimer de mes demandes">🗑</button></form></div>
    <details class="sd-lifecycle"><summary>🕘 Suivi de la demande</summary><div class="sd-history"><% if(!(selected.history||[]).length){ %><small>Aucun changement de statut enregistré depuis l’activation de 18.7.</small><% } %><% (selected.history||[]).slice().reverse().forEach(h=>{ %><div><span>●</span><p><b><%= labels[h.from_status]||h.from_status %> → <%= labels[h.to_status]||h.to_status %></b><small><%= new Date(h.created_at).toLocaleString('fr-FR') %></small></p></div><% }) %></div></details>
    <div class="sd-messages" id="clientMessages" data-last-id="<%= lastId %>" data-ticket="<%= selected.id %>">
     <% (selected.messages||[]).forEach(m=>{ const mine=m.sender_type==='CUSTOMER'; %><div class="sd-message-row <%= m.sender_type==='ADMIN'?'admin':'customer' %>" data-message-id="<%= m.id %>" data-sender="<%= m.sender_type %>"><div class="sd-avatar"><%= m.sender_type==='ADMIN'?'🎧':'👤' %></div><div class="sd-bubble"><div class="sd-msg-head"><strong><%= m.sender_type==='ADMIN'?'Support TiopTiop':'Vous' %></strong><% if(!m.deleted_at){ %><span class="sd-msg-actions"><button type="button" class="msg-reply" data-id="<%= m.id %>" data-author="<%= m.sender_type==='ADMIN'?'Support TiopTiop':'Vous' %>" data-text="<%= String(m.message||((m.attachments||[]).length?'Pièce jointe':'Message')).replace(/&/g,'&amp;').replace(/"/g,'&quot;') %>">↩</button><% if(mine){ %><button type="button" class="msg-edit" data-id="<%= m.id %>" data-text="<%= String(m.message||'').replace(/"/g,'&quot;') %>">✎</button><button type="button" class="msg-delete" data-id="<%= m.id %>">🗑</button><% } %></span><% } %></div><% if(m.deleted_at){ %><p class="sd-deleted">Message supprimé</p><% }else{ %><% if(m.message){ %><p><%= m.message %></p><% } %><% (m.attachments||[]).forEach(a=>{ const href=a.id?('/compte/demandes/fichier/'+a.id):(a.legacy_url||('#')); %><a class="sd-attachment" href="<%= href %>" target="_blank" rel="noopener"><% if(isImg(a)){ %><img src="<%= href %>" alt="Pièce jointe"><% }else{ %><span>📄</span><span><%= a.original_name||'Ouvrir la pièce jointe' %></span><% } %></a><% }) %><% } %><div class="sd-reactions"><% (m.reactions||[]).forEach(r=>{ %><span><%= r.emoji %></span><% }) %></div><div class="sd-msg-foot"><small><%= new Date(m.created_at).toLocaleString('fr-FR') %><%= m.edited_at?' · Modifié':'' %></small><% if(mine){ %><span class="read-state" title="<%= m.read_at?'Lu':'Envoyé' %>"><%= m.read_at?'✓✓':'✓' %></span><% } %></div><% if(!m.deleted_at){ %><div class="sd-react-bar"><button type="button" class="react-open" data-id="<%= m.id %>">☺</button><div class="react-menu" hidden><% reactionSet.forEach(e=>{ %><button type="button" data-id="<%= m.id %>" data-emoji="<%= e %>"><%= e %></button><% }) %></div></div><% } %></div></div><% }) %>
    </div>
    <form class="sd-compose" data-lifecycle-compose="<%= selected.id %>" style="<%= ['CLOSED','RESOLVED'].includes(selected.status)?'display:none':'' %>" method="POST" action="/compte/demandes/<%= selected.id %>/repondre" enctype="multipart/form-data">
      <div class="sd-actions"><button type="button" class="sd-icon-btn emoji-toggle" title="Ajouter un emoji">😊</button><label class="sd-icon-btn" title="Ajouter des pièces jointes">📎<input type="file" name="attachments" multiple accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt" hidden></label></div>
      <div class="sd-editor"><textarea name="message" maxlength="4000" placeholder="Écrire votre message..."></textarea><div class="emoji-panel" hidden></div><div class="file-name"></div><div class="file-preview"></div></div><button class="sd-send" title="Envoyer">➤</button>
    </form><div class="sd-closed" data-lifecycle-closed="<%= selected.id %>" style="<%= ['CLOSED','RESOLVED'].includes(selected.status)?'':'display:none' %>">🔒 Cette demande est <b class="sd-closed-label"><%= selected.status==='RESOLVED'?'résolue':'fermée' %></b>. <button type="button" class="client-reopen" data-ticket="<%= selected.id %>">↻ Réouvrir la demande</button></div>
    <% }else{ %><div class="sd-empty sd-empty-conv"><div class="sd-chat-illustration" aria-hidden="true"><i></i><i></i><b>•••</b></div><h3>Vos conversations Support</h3><p>Cliquez sur un ticket à gauche pour visualiser la conversation.</p></div><% } %>
   </section>
  </div>
 </main>
</section>
