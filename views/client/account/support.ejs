<% const labels={NEW:'Ouverte',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'Attente de votre réponse',RESOLVED:'Résolue',CLOSED:'Fermée'}; const catIcons={ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}; const selected=tickets.find(t=>Number(t.id)===Number(selectedId))||tickets[0]; const isImg=u=>/\.(png|jpe?g|webp|avif)$/i.test(String(u||'')); %>
<section class="sd-page">
 <aside class="sd-side"><div class="sd-side-title">Mon espace</div><a href="/compte">⌂ <span>Vue d'ensemble</span></a><a href="/profil">◎ <span>Mon profil</span></a><a href="/commandes">▣ <span>Mes commandes</span></a><a href="/paiements-client">▤ <span>Mes paiements</span></a><a class="active" href="/compte/demandes">💬 <span>Mes demandes</span></a><a href="/favoris">♡ <span>Mes favoris</span></a><a href="/tiopplus">☆ <span>Mes points Tiop+</span></a><a href="/parametres">⚙ <span>Paramètres</span></a></aside>
 <main class="sd-main">
  <header class="sd-head"><div class="sd-title"><span class="sd-logo">💬</span><div><h1>Mes demandes</h1><p>Échangez avec le support TiopTiop et suivez vos demandes en temps réel.</p></div></div><a href="/contact" class="sd-new">＋ Nouvelle demande</a></header>
  <% if(sent){ %><div class="sd-success">✓ Votre message a bien été envoyé au support.</div><% } %>
  <div class="sd-workspace">
   <section class="sd-list-panel">
    <div class="sd-tabs"><button class="active" data-filter="ALL">Toutes <b><%= counts.all %></b></button><button data-filter="NEW">Ouvertes <b><%= counts.open %></b></button><button data-filter="PROGRESS">En cours <b><%= counts.inProgress %></b></button><button data-filter="RESOLVED">Résolues <b><%= counts.resolved %></b></button><button data-filter="CLOSED">Fermées <b><%= counts.closed %></b></button></div>
    <div class="sd-tools"><label>⌕ <input id="ticketSearch" placeholder="Rechercher une demande..."></label><select id="ticketSort"><option value="new">Plus récent</option><option value="old">Plus ancien</option></select></div>
    <div id="ticketList" class="sd-ticket-list">
     <% if(!tickets.length){ %><div class="sd-empty"><span>💬</span><h3>Aucune demande</h3><p>Vous n'avez pas encore contacté notre support.</p><a href="/contact">Créer une demande</a></div><% } %>
     <% tickets.forEach(t=>{ %><a href="/compte/demandes?ticket=<%= t.id %>" class="sd-ticket <%= selected&&selected.id===t.id?'selected':'' %>" data-status="<%= t.status %>" data-time="<%= new Date(t.updated_at).getTime() %>" data-search="<%= (t.reference+' '+t.subject+' '+(t.order_reference||'')+' '+(t.first_message||'')).toLowerCase() %>"><div class="sd-ticket-icon"><%= catIcons[t.category]||'💬' %></div><div class="sd-ticket-body"><div class="sd-ticket-top"><strong><%= t.reference %> · <%= t.subject %></strong><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span></div><p><%= t.first_message||'Demande support' %></p><small><%= t.order_reference?'Commande : '+t.order_reference+' · ':'' %><%= new Date(t.updated_at).toLocaleString('fr-FR') %></small></div><span class="sd-chevron">›</span></a><% }) %>
    </div>
   </section>
   <section class="sd-conversation">
    <% if(selected){ %>
    <div class="sd-conv-head"><div class="sd-ticket-icon"><%= catIcons[selected.category]||'💬' %></div><div><h2><%= selected.reference %> · <%= selected.subject %></h2><p><%= selected.order_reference?'Commande : '+selected.order_reference:'Demande générale' %></p><small>Créée le <%= new Date(selected.created_at).toLocaleString('fr-FR') %></small></div><span class="badge b-<%= selected.status.toLowerCase() %>"><%= labels[selected.status]||selected.status %></span></div>
    <div class="sd-messages" id="clientMessages">
     <% (selected.messages||[]).forEach(m=>{ %><div class="sd-message-row <%= m.sender_type==='ADMIN'?'admin':'customer' %>"><div class="sd-avatar"><%= m.sender_type==='ADMIN'?'🎧':'👤' %></div><div class="sd-bubble"><strong><%= m.sender_type==='ADMIN'?'Support TiopTiop':'Vous' %></strong><% if(m.message){ %><p><%= m.message %></p><% } %><% if(m.attachment_url){ %><a class="sd-attachment" href="<%= m.attachment_url %>" target="_blank" rel="noopener"><% if(isImg(m.attachment_url)){ %><img src="<%= m.attachment_url %>" alt="Pièce jointe"><% }else{ %><span>📄</span><span>Ouvrir la pièce jointe</span><% } %></a><% } %><small><%= new Date(m.created_at).toLocaleString('fr-FR') %></small></div></div><% }) %>
    </div>
    <% if(selected.status!=='CLOSED'){ %>
    <form class="sd-compose" method="POST" action="/compte/demandes/<%= selected.id %>/repondre" enctype="multipart/form-data">
      <div class="sd-actions"><button type="button" class="sd-icon-btn emoji-toggle" title="Ajouter un emoji">😊</button><label class="sd-icon-btn" title="Ajouter une pièce jointe">📎<input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt" hidden></label></div>
      <div class="sd-editor"><textarea name="message" maxlength="4000" placeholder="Écrire votre message..."></textarea><div class="emoji-panel" hidden></div><div class="file-name"></div></div><button class="sd-send" title="Envoyer">➤</button>
    </form><% }else{ %><div class="sd-closed">🔒 Cette demande est fermée. Créez une nouvelle demande si vous avez besoin d'aide.</div><% } %>
    <% }else{ %><div class="sd-empty sd-empty-conv"><span>🎧</span><h3>Support TiopTiop</h3><p>Sélectionnez une demande pour afficher la conversation.</p></div><% } %>
   </section>
  </div>
 </main>
</section>
<style>
.sd-page{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;max-width:1500px;margin:30px auto 70px;padding:0 24px;color:#161a2d}.sd-side{background:#fff;border:1px solid #edf0f4;border-radius:22px;padding:20px 12px;height:max-content;position:sticky;top:100px;box-shadow:0 14px 40px rgba(27,34,58,.05)}.sd-side-title{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#9aa1ad;padding:8px 14px 14px;font-weight:800}.sd-side a{display:flex;gap:12px;align-items:center;padding:13px 14px;margin:3px 0;border-radius:12px;color:#4e5668;text-decoration:none;font-weight:650}.sd-side a.active{background:#fff0e4;color:#b65300}.sd-side a:hover{background:#f7f8fa}.sd-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.sd-title{display:flex;gap:15px;align-items:center}.sd-logo{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#8e55dc;color:#fff;font-size:22px}.sd-head h1{margin:0;font-size:30px}.sd-head p{margin:5px 0 0;color:#7a8190}.sd-new{background:#ff7100;color:#fff;text-decoration:none;padding:14px 20px;border-radius:13px;font-weight:850;box-shadow:0 10px 24px rgba(255,113,0,.2)}.sd-success{padding:13px 16px;border-radius:13px;background:#eaf9ef;color:#15703a;font-weight:750;margin-bottom:15px}.sd-workspace{display:grid;grid-template-columns:minmax(430px,.95fr) minmax(440px,1.05fr);gap:16px}.sd-list-panel,.sd-conversation{background:#fff;border:1px solid #e7ebf0;border-radius:18px;box-shadow:0 12px 35px rgba(28,39,64,.05);overflow:hidden}.sd-tabs{display:flex;gap:6px;padding:14px;border-bottom:1px solid #edf0f4;overflow:auto}.sd-tabs button{white-space:nowrap;border:0;background:#f7f8fa;padding:10px 12px;border-radius:11px;font-weight:750;color:#697182;cursor:pointer}.sd-tabs button.active{background:#eef1f5;color:#17203a}.sd-tabs b{display:inline-grid;place-items:center;min-width:22px;height:22px;border-radius:999px;background:#fff;margin-left:6px;font-size:11px}.sd-tools{display:grid;grid-template-columns:1fr 125px;gap:10px;padding:12px 14px}.sd-tools label{display:flex;align-items:center;border:1px solid #dfe4ea;border-radius:11px;padding:0 12px;color:#777}.sd-tools input{border:0;outline:0;background:transparent;width:100%;padding:11px;font:inherit}.sd-tools select{border:1px solid #dfe4ea;border-radius:11px;background:#fff;padding:10px}.sd-ticket-list{padding:0 14px 14px;display:flex;flex-direction:column;gap:9px}.sd-ticket{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #e3e7ed;border-radius:14px;text-decoration:none;color:inherit;transition:.18s}.sd-ticket:hover,.sd-ticket.selected{border-color:#ff7900;background:#fffaf5;transform:translateY(-1px)}.sd-ticket-icon{width:46px;height:46px;border-radius:13px;background:#fff1e5;display:grid;place-items:center;flex:0 0 46px;font-size:20px}.sd-ticket-body{min-width:0;flex:1}.sd-ticket-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.sd-ticket p{margin:5px 0;color:#3f4654;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sd-ticket small,.sd-conv-head small,.sd-bubble small{color:#8b929e}.sd-chevron{font-size:25px}.badge{display:inline-flex;align-items:center;padding:7px 11px;border-radius:999px;font-size:12px;font-weight:850;white-space:nowrap}.b-new{background:#ffe7eb;color:#d91f45}.b-in_progress,.b-waiting_customer{background:#fff0dc;color:#c36a00}.b-resolved{background:#e4f7ec;color:#08763b}.b-closed{background:#eceff3;color:#68707e}.sd-conv-head{display:flex;align-items:center;gap:13px;padding:16px;border-bottom:1px solid #edf0f4}.sd-conv-head>div:nth-child(2){flex:1}.sd-conv-head h2{margin:0 0 4px;font-size:18px}.sd-conv-head p{margin:0 0 3px;color:#697182}.sd-messages{padding:20px;min-height:380px;max-height:540px;overflow:auto;background:linear-gradient(180deg,#fff,#fbfcfd)}.sd-message-row{display:flex;gap:9px;margin-bottom:17px;max-width:86%}.sd-message-row.admin{margin-left:auto;flex-direction:row-reverse}.sd-avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#eef1f6;flex:0 0 36px}.sd-message-row.admin .sd-avatar{background:#e5f2ff}.sd-bubble{background:#f3f5f7;border-radius:15px;padding:12px 14px;min-width:150px}.sd-message-row.admin .sd-bubble{background:#e8f3ff}.sd-bubble p{margin:5px 0 8px;line-height:1.5;white-space:pre-wrap}.sd-attachment{display:flex;gap:8px;align-items:center;margin:8px 0;text-decoration:none;color:#285ea8;font-weight:750}.sd-attachment img{display:block;max-width:230px;max-height:180px;border-radius:12px;border:1px solid #dce3eb}.sd-compose{display:grid;grid-template-columns:auto 1fr 48px;gap:8px;align-items:end;padding:14px;border-top:1px solid #edf0f4}.sd-actions{display:flex;gap:5px}.sd-icon-btn{width:38px;height:38px;border:1px solid #dfe4ea;background:#fff;border-radius:10px;display:grid;place-items:center;cursor:pointer;font-size:17px}.sd-editor{position:relative}.sd-compose textarea{width:100%;box-sizing:border-box;resize:none;min-height:46px;max-height:110px;border:1px solid #dfe4ea;border-radius:12px;padding:12px;font:inherit;outline:0}.sd-compose textarea:focus{border-color:#ff7900}.sd-send{border:0;width:46px;height:46px;border-radius:12px;background:#ff7100;color:#fff;font-size:20px;cursor:pointer}.emoji-panel{position:absolute;bottom:58px;left:0;z-index:20;width:245px;padding:10px;border:1px solid #e0e4ea;border-radius:14px;background:#fff;box-shadow:0 12px 35px rgba(20,30,50,.14);display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.emoji-panel[hidden]{display:none}.emoji-panel button{border:0;background:transparent;font-size:20px;padding:5px;cursor:pointer;border-radius:8px}.emoji-panel button:hover{background:#f2f4f7}.file-name{font-size:11px;color:#677180;padding:4px 3px 0;min-height:14px}.sd-closed{padding:18px;text-align:center;background:#f5f6f8;color:#6c7380}.sd-empty{text-align:center;padding:45px 20px;color:#7b8290}.sd-empty>span{font-size:34px}.sd-empty h3{color:#202638}.sd-empty a{display:inline-block;margin-top:8px;color:#ff7100;font-weight:800}.sd-empty-conv{padding-top:150px}@media(max-width:1050px){.sd-page{grid-template-columns:1fr}.sd-side{position:static;display:flex;overflow:auto}.sd-side-title{display:none}.sd-side a{white-space:nowrap}.sd-workspace{grid-template-columns:1fr}}@media(max-width:650px){.sd-page{padding:0 12px}.sd-head{align-items:flex-start;gap:12px}.sd-new{padding:11px 12px}.sd-workspace{display:block}.sd-conversation{margin-top:14px}.sd-tools{grid-template-columns:1fr}.sd-ticket-top{align-items:flex-start}.sd-ticket-top .badge{display:none}.sd-compose{grid-template-columns:1fr 48px}.sd-actions{grid-column:1/-1}.sd-message-row{max-width:95%}}
</style>
<script>
(()=>{const tabs=[...document.querySelectorAll('.sd-tabs button')],tickets=[...document.querySelectorAll('.sd-ticket')],search=document.getElementById('ticketSearch'),sort=document.getElementById('ticketSort'),list=document.getElementById('ticketList');let filter='ALL';function apply(){const q=(search?.value||'').toLowerCase().trim();tickets.forEach(t=>{const st=t.dataset.status;const okF=filter==='ALL'||filter===st||(filter==='PROGRESS'&&['IN_PROGRESS','WAITING_CUSTOMER'].includes(st));t.style.display=okF&&(!q||t.dataset.search.includes(q))?'flex':'none'});if(list&&sort){const arr=[...tickets].sort((a,b)=>Number(a.dataset.time)-Number(b.dataset.time));if(sort.value==='new')arr.reverse();arr.forEach(x=>list.appendChild(x));}}tabs.forEach(b=>b.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('active'));b.classList.add('active');filter=b.dataset.filter;apply()}));search?.addEventListener('input',apply);sort?.addEventListener('change',apply);const box=document.getElementById('clientMessages');if(box)box.scrollTop=box.scrollHeight;
const emojis=['😀','😂','😊','😍','🥰','😅','😢','😭','😡','👍','🙏','👏','❤️','🔥','✅','❌','🎉','🤝','📦','🚚','💳','⭐','🍽️','📞','💡','👌','😉','🙂'];document.querySelectorAll('.sd-compose').forEach(form=>{const ta=form.querySelector('textarea'),panel=form.querySelector('.emoji-panel'),toggle=form.querySelector('.emoji-toggle'),file=form.querySelector('input[type=file]'),name=form.querySelector('.file-name');if(panel){emojis.forEach(e=>{const b=document.createElement('button');b.type='button';b.textContent=e;b.onclick=()=>{const a=ta.selectionStart||ta.value.length,c=ta.selectionEnd||a;ta.value=ta.value.slice(0,a)+e+ta.value.slice(c);ta.focus();ta.selectionStart=ta.selectionEnd=a+e.length;panel.hidden=true};panel.appendChild(b)});}toggle?.addEventListener('click',()=>panel.hidden=!panel.hidden);file?.addEventListener('change',()=>name.textContent=file.files?.[0]?`📎 ${file.files[0].name}`:'');form.addEventListener('submit',e=>{if(!ta.value.trim()&&!file?.files?.length){e.preventDefault();ta.focus();}})});})();
</script>
