<style>
/* 18.7.1.3 — hauteur type WhatsApp + scroll indépendant */
.sd-list-panel,.sd-conversation{height:650px;min-height:0}
.sd-list-panel{display:flex;flex-direction:column}
.sd-ticket-list{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable}
.sd-conversation{display:flex;flex-direction:column;position:relative}
.sd-messages{flex:1;min-height:0;max-height:none;height:auto;overflow-y:auto}
.sd-compose{flex:0 0 auto;margin:0}
.sd-closed{flex:0 0 auto}
.sd-scroll-bottom{position:absolute;right:18px;bottom:82px;z-index:35;width:44px;height:44px;border:0;border-radius:50%;background:#fff;color:#ff7100;box-shadow:0 5px 20px rgba(25,35,55,.22);cursor:pointer;font-weight:900;font-size:18px;display:none}
.sd-scroll-bottom.show{display:grid;place-items:center}
.sd-scroll-bottom b{position:absolute;right:-5px;top:-7px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:#e32636;color:#fff;font-size:10px;display:grid;place-items:center}
@media(max-width:1050px){.sd-list-panel,.sd-conversation{height:620px}}

.sd-day-separator,.sd-unread-separator{display:flex;align-items:center;justify-content:center;margin:14px 0;clear:both}.sd-day-separator span{background:#f1f3f6;color:#626b78;border-radius:999px;padding:5px 12px;font-size:12px;font-weight:800;box-shadow:0 1px 3px rgba(0,0,0,.05)}.sd-unread-separator{position:relative;color:#d95f00;font-size:12px;font-weight:900}.sd-unread-separator:before,.sd-unread-separator:after{content:'';height:1px;background:#ffd4b2;flex:1}.sd-unread-separator span{padding:0 10px;background:#fff}.sd-message-row[data-unread="1"] .sd-bubble{box-shadow:0 0 0 1px rgba(255,113,0,.08)}
</style>

<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{
  let box=document.getElementById('clientMessages');
  let ticketId=Number(box?.dataset.ticket||0); let socket=null;
  const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅'];
  const labels={NEW:'Ouverte',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'Attente de votre réponse',RESOLVED:'Résolue',CLOSED:'Fermée'};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fr=d=>{try{return new Date(d).toLocaleString('fr-FR')}catch{return ''}}; const timeOnly=d=>{try{return new Date(d).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}catch{return ''}};
  const nearBottom=el=>!el||el.scrollHeight-el.scrollTop-el.clientHeight<110;
  let pendingBelow=0;
  function ensureScrollBottom(){const conv=document.querySelector('.sd-conversation');if(!conv)return null;let b=conv.querySelector('.sd-scroll-bottom');if(!b){b=document.createElement('button');b.type='button';b.className='sd-scroll-bottom';b.title='Revenir aux nouveaux messages';b.innerHTML='↓<b>0</b>';b.addEventListener('click',()=>{if(box){box.scrollTo({top:box.scrollHeight,behavior:'smooth'});pendingBelow=0;updateScrollBottom();}});conv.appendChild(b);}return b;}
  function updateScrollBottom(){const b=ensureScrollBottom();if(!b)return;const show=!!box&&!nearBottom(box)&&pendingBelow>0;b.classList.toggle('show',show);const n=b.querySelector('b');if(n)n.textContent=String(pendingBelow>99?'99+':pendingBelow);}
  function bindMessageScroll(){if(!box||box.dataset.scrollBound==='1')return;box.dataset.scrollBound='1';box.addEventListener('scroll',()=>{if(nearBottom(box)){pendingBelow=0;updateScrollBottom();}});ensureScrollBottom();}
  function scrollConversationBottom(behavior='auto'){if(!box)return;requestAnimationFrame(()=>{box.scrollTo({top:box.scrollHeight,behavior});pendingBelow=0;updateScrollBottom();});}
  const sound={muted:localStorage.getItem('tiop-support-sound')==='0',ctx:null,play(kind){if(this.muted)return;try{this.ctx=this.ctx||new (window.AudioContext||window.webkitAudioContext)();const c=this.ctx,n=c.currentTime,o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);const cfg=kind==='send'?[620,.16]:kind==='reaction'?[760,.18]:kind==='status'?[520,.20]:[880,.24];o.frequency.setValueAtTime(cfg[0],n);if(kind==='receive')o.frequency.exponentialRampToValueAtTime(1180,n+.11);if(kind==='send')o.frequency.exponentialRampToValueAtTime(820,n+.08);g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.10,n+.012);g.gain.exponentialRampToValueAtTime(.0001,n+cfg[1]);o.start(n);o.stop(n+cfg[1]+.02);}catch(_){}}};
  function updateSoundButton(){document.querySelectorAll('.sd-sound-toggle').forEach(b=>b.textContent=sound.muted?'🔇':'🔊')}document.querySelectorAll('.sd-sound-toggle').forEach(b=>b.addEventListener('click',()=>{sound.muted=!sound.muted;localStorage.setItem('tiop-support-sound',sound.muted?'0':'1');updateSoundButton();if(!sound.muted)sound.play('send')}));updateSoundButton();
  function updateCounts(c){const bs=document.querySelectorAll('.sd-tabs button b');if(bs.length>=5){bs[0].textContent=Number(c?.all||0);bs[1].textContent=Number(c?.open||0);bs[2].textContent=Number(c?.inProgress||0);bs[3].textContent=Number(c?.resolved||0);bs[4].textContent=Number(c?.closed||0);}}
  function clientHistoryHtml(h){return `<div><span>●</span><p><b>${esc(labels[h.from_status]||h.from_status)} → ${esc(labels[h.to_status]||h.to_status)}</b><small>${esc(fr(h.created_at))}</small></p></div>`;}
  function updateLifecycle(ticket,history){if(!ticket)return;const st=ticket.status;const head=document.querySelector('.sd-conv-head .badge');if(head){head.className='badge b-'+st.toLowerCase();head.textContent=labels[st]||st;}const compose=document.querySelector('[data-lifecycle-compose]'),closed=document.querySelector('[data-lifecycle-closed]'),isClosed=['RESOLVED','CLOSED'].includes(st);if(compose)compose.style.display=isClosed?'none':'';if(closed){closed.style.display=isClosed?'':'none';const l=closed.querySelector('.sd-closed-label');if(l)l.textContent=st==='RESOLVED'?'résolue':'fermée';}const hb=document.querySelector('.sd-history');if(hb)hb.innerHTML=(history||[]).length?(history||[]).slice().reverse().map(clientHistoryHtml).join(''):'<small>Aucun changement de statut enregistré.</small>';}

  const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||''));
  const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||''));
  function reactionSummary(rs){const a=rs||[];if(!a.length)return '';const emojis=[...new Set(a.map(x=>x.emoji))].join(' ');return `<span class="sd-reaction-summary">${esc(emojis)}${a.length>1?` <b>${a.length}</b>`:''}</span>`;}
  function clearReply(form){if(!form)return;form.querySelector('input[name="replyToMessageId"]')?.remove();form.querySelector('.sd-replying')?.remove();}
  function setReply(id,author,text){const form=document.querySelector('.sd-compose');if(!form)return;clearReply(form);const h=document.createElement('input');h.type='hidden';h.name='replyToMessageId';h.value=String(id);form.appendChild(h);const bar=document.createElement('div');bar.className='sd-replying';bar.innerHTML=`<div><b>↩ ${esc(author)}</b><span>${esc(text||'Message')}</span></div><button type="button" aria-label="Annuler">×</button>`;form.querySelector('.sd-editor')?.prepend(bar);bar.querySelector('button').onclick=()=>clearReply(form);form.querySelector('textarea')?.focus();}
  document.addEventListener('click',e=>{const r=e.target.closest('.msg-reply');if(r){e.preventDefault();setReply(r.dataset.id,r.dataset.author,r.dataset.text);return;}const q=e.target.closest('.sd-reply-quote');if(q){const target=document.querySelector(`.sd-message-row[data-message-id="${q.dataset.target}"]`);if(target){target.scrollIntoView({behavior:'smooth',block:'center'});target.classList.add('sd-message-highlight');setTimeout(()=>target.classList.remove('sd-message-highlight'),1400);}return;}});

  let syncing=false, queued=false;

  function attachmentHtml(a){
    const href=a.id?('/compte/demandes/fichier/'+a.id):(a.legacy_url||'#');
    if(isImg(a))return `<a class="sd-attachment" href="${esc(href)}" target="_blank" rel="noopener"><img src="${esc(href)}" alt="Pièce jointe"></a>`;
    if(isVideo(a))return `<a class="sd-attachment" href="${esc(href)}" target="_blank" rel="noopener"><video controls preload="metadata" src="${esc(href)}" style="display:block;max-width:260px;max-height:180px;border-radius:10px;background:#000"></video><span>🎬 ${esc(a.original_name||'Vidéo de préparation')}</span></a>`;
    return `<a class="sd-attachment" href="${esc(href)}" target="_blank" rel="noopener"><span>📄</span><span>${esc(a.original_name||'Ouvrir la pièce jointe')}</span></a>`;
  }
  const dayKey=d=>{const x=new Date(d);return `${x.getFullYear()}-${x.getMonth()}-${x.getDate()}`};
  const dayLabel=d=>{const x=new Date(d),n=new Date(),y=new Date();y.setDate(n.getDate()-1);if(dayKey(x)===dayKey(n))return 'Aujourd’hui';if(dayKey(x)===dayKey(y))return 'Hier';return x.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'});};
  function messageHtml(m){
    const mine=m.sender_type==='CUSTOMER', admin=m.sender_type==='ADMIN';
    const actions=!m.deleted_at?`<span class="sd-msg-actions"><button type="button" class="msg-reply" data-id="${m.id}" data-author="${esc(admin?'Support TiopTiop':'Vous')}" data-text="${esc(m.message||((m.attachments||[]).length?'Pièce jointe':''))}">↩</button>${mine?`<button type="button" class="msg-edit" data-id="${m.id}" data-text="${esc(m.message||'')}">✎</button><button type="button" class="msg-delete" data-id="${m.id}">🗑</button>`:''}</span>`:'';
    const content=m.deleted_at?'<p class="sd-deleted">Message supprimé</p>':`${m.message?`<p>${esc(m.message)}</p>`:''}${(m.attachments||[]).map(attachmentHtml).join('')}`;
    const reactions=(m.reactions||[]).map(r=>`<span>${esc(r.emoji)}</span>`).join('');
    const menu=!m.deleted_at?`<div class="sd-react-bar"><button type="button" class="react-open" data-id="${m.id}">☺</button><div class="react-menu" hidden>${reactionSet.map(e=>`<button type="button" data-id="${m.id}" data-emoji="${e}">${e}</button>`).join('')}</div></div>`:'';
    return `<div class="sd-message-row ${admin?'admin':'customer'}" data-message-id="${m.id}" data-sender="${m.sender_type}" data-unread="${admin&&!m.read_at?'1':'0'}"><div class="sd-avatar">${admin?'🎧':'👤'}</div><div class="sd-bubble"><div class="sd-msg-head"><strong>${admin?'Support TiopTiop':'Vous'}</strong>${actions}</div>${m.reply_to_message_id?`<button type="button" class="sd-reply-quote" data-target="${m.reply_to_message_id}"><b>${esc(m.reply_sender_type==='ADMIN'?'Support TiopTiop':'Vous')}</b><span>${esc(m.reply_deleted_at?'Message supprimé':(m.reply_message||((m.reply_attachment_count||0)>0?'📎 Pièce jointe':'Message')))}</span></button>`:''}${content}<div class="sd-reactions">${reactionSummary(m.reactions||[])}</div><div class="sd-msg-foot"><small>${esc(timeOnly(m.created_at))}${m.edited_at?' · Modifié':''}</small>${mine?`<span class="read-state" title="${m.read_at?'Lu':'Envoyé'}">${m.read_at?'✓✓':'✓'}</span>`:''}</div>${menu}</div></div>`;
  }
  function messagesHtml(msgs){let out='',prev='',unreadInserted=false;const unread=(msgs||[]).filter(m=>m.sender_type==='ADMIN'&&!m.read_at).length;(msgs||[]).forEach(m=>{const dk=dayKey(m.created_at);if(dk!==prev){out+=`<div class="sd-day-separator"><span>${esc(dayLabel(m.created_at))}</span></div>`;prev=dk;}if(!unreadInserted&&m.sender_type==='ADMIN'&&!m.read_at){out+=`<div class="sd-unread-separator" data-unread-separator><span>${unread} nouveau${unread>1?'x':''} message${unread>1?'s':''}</span></div>`;unreadInserted=true;}out+=messageHtml(m);});return out;}
  let readObserver=null,readTimer=null,pendingReadId=0;
  async function flushVisibleRead(){const id=pendingReadId;pendingReadId=0;if(!id||!ticketId)return;try{await fetch(`/compte/demandes/${ticketId}/read-visible`,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:new URLSearchParams({messageId:String(id)})});}catch(_){}}
  function bindReadObserver(){readObserver?.disconnect();if(!box)return;readObserver=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting&&e.intersectionRatio>=.55&&e.target.dataset.sender==='ADMIN'&&e.target.dataset.unread==='1'){e.target.dataset.unread='0';pendingReadId=Math.max(pendingReadId,Number(e.target.dataset.messageId||0));clearTimeout(readTimer);readTimer=setTimeout(flushVisibleRead,220);}})},{root:box,threshold:[.55]});box.querySelectorAll('.sd-message-row[data-unread="1"]').forEach(x=>readObserver.observe(x));}
  function positionInitialRead(){if(!box)return;const first=box.querySelector('.sd-message-row[data-unread="1"]');if(first){const sep=box.querySelector('[data-unread-separator]');(sep||first).scrollIntoView({block:'start',behavior:'auto'});pendingBelow=box.querySelectorAll('.sd-message-row[data-unread="1"]').length;updateScrollBottom();}else scrollConversationBottom('auto');bindReadObserver();}
  function updateTickets(tickets){
    const list=document.getElementById('ticketList'); if(!list)return;
    const byId=new Map((tickets||[]).map(t=>[String(t.id),t]));
    [...list.querySelectorAll('.sd-ticket')].forEach(el=>{if(!byId.has(el.dataset.id))el.remove();});
    (tickets||[]).forEach(t=>{
      let el=list.querySelector(`.sd-ticket[data-id="${t.id}"]`);
      if(!el){el=document.createElement('a');el.href=`/compte/demandes?ticket=${t.id}`;el.className='sd-ticket';el.dataset.id=t.id;el.innerHTML=`<div class="sd-ticket-icon">${({ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}[t.category]||'💬')}</div><div class="sd-ticket-body"><div class="sd-ticket-top"><strong>${esc(t.reference)} · ${esc(t.subject)}</strong><span class="badge"></span></div><p></p><small></small><div class="sd-file-hint"></div></div><span class="sd-chevron">›</span>`;list.querySelector('.sd-empty')?.remove();list.appendChild(el);}
      el.dataset.unread=Number(t.unread_count||0); el.dataset.status=t.status; el.dataset.time=new Date(t.last_message_at||t.updated_at).getTime();
      el.classList.toggle('unread',Number(t.unread_count||0)>0);
      const sb=el.querySelector('.sd-ticket-top .badge');if(sb){sb.className='badge b-'+String(t.status||'').toLowerCase();sb.textContent=labels[t.status]||t.status;}
      const p=el.querySelector('.sd-ticket-body p'); if(p)p.textContent=t.last_message||'Demande support';
      const small=el.querySelector('.sd-ticket-body small'); if(small)small.textContent=(t.order_reference?'Commande : '+t.order_reference+' · ':'')+fr(t.last_message_at||t.updated_at);let fh=el.querySelector('.sd-file-hint');if(!fh){fh=document.createElement('div');fh.className='sd-file-hint';el.querySelector('.sd-ticket-body')?.appendChild(fh)}if(fh)fh.textContent=Number(t.last_attachment_count||0)?`📎 ${t.last_attachment_count} fichier${Number(t.last_attachment_count)>1?'s':''}`:'';let lr=el.querySelector('.sd-last-reactions');if(!lr){lr=document.createElement('div');lr.className='sd-last-reactions';el.querySelector('.sd-ticket-body')?.appendChild(lr)}if(lr){const rc=Number(t.last_reaction_count||0);lr.textContent=rc?`${t.last_reactions||''}${rc>1?' · '+rc:''}`:'';}
      let badge=el.querySelector('.sd-unread');
      if(Number(t.unread_count||0)>0){if(!badge){badge=document.createElement('span');badge.className='sd-unread';el.insertBefore(badge,el.querySelector('.sd-chevron'));}badge.textContent=t.unread_count;} else badge?.remove();
    });
    [...list.querySelectorAll('.sd-ticket')].sort((a,b)=>Number(b.dataset.time)-Number(a.dataset.time)).forEach(el=>list.appendChild(el));
  }
  async function activateTicket(id){id=Number(id);if(!id)return;try{const r=await fetch(`/compte/demandes?ticket=${id}`,{headers:{'X-Requested-With':'XMLHttpRequest'},cache:'no-store'});if(!r.ok)return;const html=await r.text(),doc=new DOMParser().parseFromString(html,'text/html'),fresh=doc.querySelector('.sd-conversation'),current=document.querySelector('.sd-conversation');if(!fresh||!current)return; if(socket&&ticketId)socket.emit('support:leave',{ticketId});current.replaceWith(fresh);ticketId=id;box=document.getElementById('clientMessages');if(socket)socket.emit('support:join',{ticketId});document.querySelectorAll('.sd-ticket').forEach(x=>x.classList.toggle('selected',Number(x.dataset.id)===id));history.replaceState(null,'',`/compte/demandes?ticket=${id}`);bindCompose(document.querySelector('.sd-compose'));bindMessageScroll();await syncSupport('open');}catch(_){}}
  document.addEventListener('click',e=>{const a=e.target.closest('.sd-ticket');if(!a)return;e.preventDefault();activateTicket(Number(a.dataset.id));});
  async function syncSupport(reason='socket'){
    if(syncing){queued=true;return;} syncing=true;
    try{
      const res=await fetch(`/compte/demandes/poll?ticket=${ticketId}`,{headers:{Accept:'application/json'},cache:'no-store'}); if(!res.ok)return;
      const data=await res.json(); updateTickets(data.tickets||[]);updateCounts(data.counts||{});updateLifecycle(data.selectedTicket,data.history||[]);
      if(box&&ticketId){const stick=nearBottom(box),oldLast=Number(box.dataset.lastId||0),msgs=(data.messages||[]),newLast=Number(msgs.at(-1)?.id||0),added=msgs.filter(m=>Number(m.id)>oldLast).length;box.innerHTML=messagesHtml(msgs);box.dataset.lastId=String(newLast);bindMessageScroll();bindReadObserver();if(reason==='open'||reason==='initial'){positionInitialRead();}else if(reason==='send'||stick){scrollConversationBottom('auto');}else if(reason==='message:new'&&added>0){pendingBelow+=added;updateScrollBottom();}}
    }finally{syncing=false;if(queued){queued=false;syncSupport('queued');}}
  }
  async function post(url,data){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:new URLSearchParams(data)});if(!r.ok)throw new Error('Action impossible');return r.json();}
  document.addEventListener('click',async e=>{
    const edit=e.target.closest('.msg-edit'); if(edit){const text=prompt('Modifier votre message :',edit.dataset.text||'');if(text===null)return;await post(`/compte/demandes/${ticketId}/messages/${edit.dataset.id}/edit`,{message:text});await syncSupport('edit');return;}
    const del=e.target.closest('.msg-delete'); if(del){const scope=await (window.supportDeleteChoice?window.supportDeleteChoice(1):Promise.resolve(confirm('Supprimer pour tout le monde ?')?'everyone':null));if(!scope)return;await post(`/compte/demandes/${ticketId}/messages/bulk-delete`,{messageIds:[Number(del.dataset.id)],scope});await syncSupport('delete');return;}
    const ro=e.target.closest('.react-open'); if(ro){const m=ro.parentElement.querySelector('.react-menu');if(m)m.hidden=!m.hidden;return;}
    const rb=e.target.closest('.react-menu button'); if(rb){await post(`/compte/demandes/${ticketId}/messages/${rb.dataset.id}/react`,{emoji:rb.dataset.emoji});await syncSupport('reaction');}
  });
  const emojis=['😀','😂','😊','😍','🥰','😅','😢','😭','😡','👍','🙏','👏','❤️','🔥','✅','❌','🎉','🤝','📦','🚚','💳','⭐','🍽️','📞','💡','👌','😉','🙂'];
  function bindCompose(form){if(!form||form.dataset.bound==='1')return;form.dataset.bound='1';
    const ta=form.querySelector('textarea'),panel=form.querySelector('.emoji-panel'),toggle=form.querySelector('.emoji-toggle'),input=form.querySelector('input[type=file]'),preview=form.querySelector('.file-preview'),name=form.querySelector('.file-name'); let chosen=[];
    emojis.forEach(em=>{const b=document.createElement('button');b.type='button';b.textContent=em;b.onclick=()=>{const a=ta.selectionStart||ta.value.length,c=ta.selectionEnd||a;ta.value=ta.value.slice(0,a)+em+ta.value.slice(c);ta.focus();ta.selectionStart=ta.selectionEnd=a+em.length;panel.hidden=true};panel.appendChild(b)}); toggle?.addEventListener('click',()=>panel.hidden=!panel.hidden);
    const render=()=>{if(!preview)return;preview.innerHTML='';chosen.forEach((f,i)=>{const c=document.createElement('div');c.className='file-chip';if(f.type.startsWith('image/')){const im=document.createElement('img');im.src=URL.createObjectURL(f);c.appendChild(im)}const n=document.createElement('span');n.textContent=f.name;c.appendChild(n);const x=document.createElement('button');x.type='button';x.textContent='×';x.onclick=()=>{chosen.splice(i,1);syncFiles()};c.appendChild(x);preview.appendChild(c)});if(name)name.textContent=chosen.length?`📎 ${chosen.length} fichier(s)`:'';};
    const syncFiles=()=>{const dt=new DataTransfer();chosen.forEach(f=>dt.items.add(f));input.files=dt.files;render()}; input?.addEventListener('change',()=>{const incoming=[...input.files];if(input.dataset.previewSkip==='1'){chosen=incoming;render();return;}const key=f=>[f.name,f.size,f.lastModified,f.type].join('::');const seen=new Set(chosen.map(key));incoming.forEach(f=>{const k=key(f);if(!seen.has(k)){chosen.push(f);seen.add(k);}});syncFiles()});
    let typingTimer;ta?.addEventListener('input',()=>{if(!socket||!ticketId)return;socket.emit('support:typing',{ticketId,typing:true});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('support:typing',{ticketId,typing:false}),900)});
    form.addEventListener('submit',async ev=>{ev.preventDefault();if(!ta.value.trim()&&!input?.files?.length){ta.focus();return;}const btn=form.querySelector('.sd-send');btn.disabled=true;try{const r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});if(!r.ok)throw new Error('Envoi impossible');ta.value='';chosen=[];syncFiles();clearReply(form);if(socket)socket.emit('support:typing',{ticketId,typing:false});await syncSupport('send');}catch(err){alert(err.message||'Envoi impossible');}finally{btn.disabled=false;}});
  } document.querySelectorAll('.sd-compose').forEach(bindCompose);
  document.addEventListener('click',async e=>{const b=e.target.closest('.client-reopen');if(!b)return;if(!confirm('Réouvrir cette demande ?'))return;try{const r=await fetch(`/compte/demandes/${b.dataset.ticket}/reopen`,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});if(!r.ok)throw new Error('Réouverture impossible');await syncSupport('ticket:status');}catch(err){alert(err.message)}});
  if(window.io){socket=io(); if(ticketId)socket.emit('support:join',{ticketId});socket.on('support:typing',e=>{const id=Number(e?.ticketId||0);const row=document.querySelector(`.sd-ticket[data-id="${id}"]`);let li=row?.querySelector('.sd-list-typing');if(e.typing){if(row&&!li){li=document.createElement('small');li.className='sd-list-typing';row.querySelector('.sd-ticket-body')?.appendChild(li)}if(li)li.textContent=(e.actorName||'Support TiopTiop')+' écrit…';}else li?.remove();if(id!==ticketId)return;let x=document.querySelector('.sd-conversation .typing-indicator');if(!x&&e.typing){x=document.createElement('div');x.className='typing-indicator';document.querySelector('.sd-compose')?.appendChild(x)}if(x){x.textContent=e.typing?(e.actorName||'Support TiopTiop')+' écrit…':'';x.style.display=e.typing?'block':'none'}}); socket.on('support:changed',e=>{const type=String(e?.type||'');if(type==='message:new')sound.play(e?.actorType==='CUSTOMER'?'send':'receive');else if(type==='ticket:new'){sound.play('receive');syncSupport('ticket:new');return;}else if(type==='reaction')sound.play(e?.actorType==='CUSTOMER'?'send':'reaction');else if(type==='ticket:status')sound.play('status');syncSupport(type||'socket')});}
  if(box){bindMessageScroll();syncSupport('initial');}
})();
