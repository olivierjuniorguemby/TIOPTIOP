<style>
    /* =========================================================
   TIOPTIOP — BANDES ARTISTIQUES RESPONSIVES
========================================================= */

.tiop-art-band {
    width: 100%;
    max-width: 1600px;

    /* avant : 170px */
    min-height: 90px;

    /* avant : 10px auto 25px */
    

    display: flex;
    align-items: center;
    justify-content: space-around;

    /* avant : clamp(15px, 3vw, 55px) */
    gap: clamp(8px, 2vw, 30px);

    overflow: hidden;
    position: relative;
    z-index: 0;
    pointer-events: none;
}


/* ---------------------------------------------------------
   SVG
--------------------------------------------------------- */

.tiop-art-band .art-svg {
    display: block;

    width: clamp(100px, 13vw, 230px);
    height: auto;

    flex: 0 1 auto;

    fill: none;

    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;

    opacity: .24;

    transition: opacity .25s ease;
}


/* ---------------------------------------------------------
   COULEURS
--------------------------------------------------------- */

.art-zigzag {
    stroke: #ff7900;
}

.art-lines {
    stroke: #71835a;
}

.art-diamonds {
    stroke: #c7bba9;
}

.art-waves {
    stroke: #17120e;
}

.art-triangles {
    stroke: #73835b;
}

.art-spiral {
    stroke: #e4a64b;
}


/* ---------------------------------------------------------
   VARIATIONS DE TAILLE
--------------------------------------------------------- */

.art-zigzag {
    width: clamp(160px, 18vw, 290px) !important;
}

.art-waves {
    width: clamp(180px, 21vw, 350px) !important;
}

.art-lines {
    width: clamp(90px, 9vw, 150px) !important;
}

.art-diamonds {
    width: clamp(130px, 15vw, 230px) !important;
}

.art-triangles {
    width: clamp(130px, 14vw, 220px) !important;
}

.art-spiral {
    width: clamp(90px, 10vw, 150px) !important;
}


/* =========================================================
   VERSION "GRANDE ZONE"
========================================================= */

.tiop-art-band.large {
    min-height: 130px;
    margin-top: 25px;
    margin-bottom: 25px;
}


/* =========================================================
   VERSION PLUS DISCRÈTE
========================================================= */

.tiop-art-band.soft .art-svg {
    opacity: .15;
}


/* =========================================================
   VERSION PLUS MARQUÉE
========================================================= */

.tiop-art-band.strong .art-svg {
    opacity: .30;
}


/* =========================================================
   TABLETTE
