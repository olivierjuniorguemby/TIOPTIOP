<!-- =========================================================
     TIOPTIOP — 16.3 CARTE FIDÉLITÉ NUMÉRIQUE
     Reproduction HTML/CSS de la maquette validée.
========================================================= -->

<style>
  .tp-plus {
    --orange: #ff7900;
    --orange-dark: #df6300;
    --black: #17130f;
    --ink: #16120f;
    --cream: #fffaf4;
    --cream-2: #fff4e7;
    --line: #eadfd3;
    --muted: #746b63;
    --green: #188844;
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    background: #fffaf5;
  }

  .tp-shell { max-width: 1220px; margin: 0 auto; }

  .tp-hero {
    padding: 34px 30px 28px;
    background:
      radial-gradient(circle at 88% 50%, rgba(255,121,0,.09), transparent 30%),
      linear-gradient(120deg, #fffaf5 0%, #fffaf5 63%, #fff2df 100%);
  }

  .tp-hero-grid {
    display: grid;
    grid-template-columns: .82fr 1.28fr;
    gap: 42px;
    align-items: center;
  }

  .tp-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 12px; border-radius: 999px;
    background: #fff0da; color: #a95b00;
    font-size: 12px; font-weight: 900;
  }

  .tp-title {
    margin: 38px 0 22px;
    font-size: clamp(54px, 6vw, 84px);
    line-height: .92;
    letter-spacing: -4px;
    font-weight: 950;
  }
  .tp-title span { color: var(--orange); }

  .tp-lead {
    max-width: 380px;
    margin: 0 0 22px;
    font-size: 18px;
    line-height: 1.45;
  }

  .tp-member-state {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 16px; border-radius: 999px;
    background: var(--green); color: #fff;
    font-weight: 900; font-size: 14px;
  }

  .tp-subscribe {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 0 20px; border: 0; border-radius: 999px;
    background: var(--orange); color: #fff; font-weight: 900; cursor: pointer;
  }
  .tp-subscribe:hover { background: var(--orange-dark); }

  .tp-welcome {
    margin: 20px 0 0;
    font-size: 17px; line-height: 1.4; font-weight: 900; color: #136f38;
  }
  .tp-welcome span { display: block; color: #1d2a22; font-weight: 600; font-size: 14px; margin-top: 2px; }

  /* ================= CARTE ================= */
  .tp-card-wrap { position: relative; perspective: 1200px; }

  .tp-card {
    position: relative;
    overflow: hidden;
    min-height: 390px;
    border-radius: 34px;
    color: #fff;
    background:
      radial-gradient(circle at 92% 38%, rgba(255,125,0,.24), transparent 24%),
      linear-gradient(135deg, #0b0b0b 0%, #15110d 54%, #25150a 100%);
    box-shadow: 0 26px 56px rgba(49,31,12,.18);
    border: 1px solid rgba(255,255,255,.06);
  }

  .tp-card::before {
    content: '';
    position: absolute; inset: 0;
    background:
      repeating-linear-gradient(135deg, transparent 0 24px, rgba(255,121,0,.035) 24px 25px),
      linear-gradient(115deg, transparent 52%, rgba(255,121,0,.08) 78%, rgba(255,121,0,.17) 100%);
    pointer-events: none;
  }

  .tp-card::after {
    content: '';
    position: absolute;
    width: 260px; height: 260px; right: -80px; bottom: -120px;
    border-radius: 50%;
    box-shadow: 0 0 0 24px rgba(255,121,0,.035), 0 0 0 52px rgba(255,121,0,.025);
  }

  .tp-card-top {
    position: relative; z-index: 2;
    min-height: 270px;
    padding: 32px 36px 28px;
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 20px;
  }

  .tp-card-brand { font-size: 42px; font-weight: 950; letter-spacing: -2px; }
  .tp-card-brand span { color: var(--orange); }
  .tp-card-sub { margin-top: 4px; color: #ffc15f; font-size: 12px; font-weight: 900; letter-spacing: 1.4px; }

  .tp-card-member { margin-top: 40px; }
  .tp-card-label { display: block; color: #d8d0c8; font-size: 11px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; }
  .tp-card-number { display: inline-block; margin-top: 8px; color: #ffb23c; font-size: 26px; line-height: 1; font-weight: 950; letter-spacing: 1px; }
  .tp-card-name { margin-top: 26px; font-size: 20px; font-weight: 950; letter-spacing: .4px; text-transform: uppercase; }

  .tp-contactless {
    display: inline-flex; margin-left: 14px; font-size: 27px; transform: rotate(90deg); color: #ffbb4d;
  }

  .tp-card-right { text-align: center; }
  .tp-level { text-align: right; margin-bottom: 25px; font-size: 12px; color: #d9cec0; }
  .tp-level strong { display: block; color: #ffba48; font-size: 23px; line-height: 1; margin-top: 4px; }

  .tp-qr-box {
    width: 142px; min-height: 142px; margin-left: auto;
    padding: 10px; border-radius: 18px;
    background: #fff; border: 5px solid #ffb23c;
    box-shadow: 0 8px 28px rgba(255,121,0,.28);
  }
  #tp-card-qr { width: 112px; height: 112px; margin: 0 auto; }
  #tp-card-qr img, #tp-card-qr canvas { width: 112px !important; height: 112px !important; display: block; }
  .tp-scan { margin-top: 8px; font-size: 11px; font-weight: 800; color: #f7eee5; text-align: right; }

  .tp-card-bottom {
    position: relative; z-index: 3;
    min-height: 120px;
    display: grid; grid-template-columns: 1fr 1fr;
    background: linear-gradient(90deg, #ff7900 0%, #ef7200 52%, rgba(255,121,0,.58) 100%);
  }
  .tp-stat {
    display: flex; align-items: center; gap: 18px;
    padding: 22px 36px;
  }
  .tp-stat + .tp-stat { border-left: 1px solid rgba(255,255,255,.22); }
  .tp-stat-icon { font-size: 36px; }
  .tp-stat-label { font-size: 11px; font-weight: 900; text-transform: uppercase; }
  .tp-stat-value { margin-top: 3px; font-size: 38px; line-height: 1; font-weight: 950; }
  .tp-stat-value small { font-size: 12px; font-weight: 800; }

  .tp-card-rate {
    position: absolute; z-index: 5; left: 0; right: 0; bottom: 6px;
    text-align: center; color: #ffc760; font-size: 11px; font-weight: 900;
  }

  /* ================= CONTENU ================= */
  .tp-content {
    padding: 34px 30px 42px;
    background:
      repeating-linear-gradient(45deg, rgba(255,121,0,.018) 0 2px, transparent 2px 25px),
      #fffaf5;
  }

  .tp-benefits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .tp-benefit {
    min-height: 150px; padding: 22px 20px;
    background: rgba(255,255,255,.94); border: 1px solid var(--line); border-radius: 22px;
    box-shadow: 0 8px 22px rgba(49,31,12,.03);
  }
  .tp-benefit-icon {
    width: 42px; height: 42px; display: grid; place-items: center;
    margin-bottom: 15px; border-radius: 50%; background: #fff2df; font-size: 21px;
  }
  .tp-benefit h3 { margin: 0 0 10px; font-size: 17px; font-weight: 950; }
  .tp-benefit p { margin: 0; font-size: 13px; line-height: 1.5; color: #39332e; }

  .tp-how {
    margin-top: 20px; padding: 28px 24px 26px;
    background: #fff; border: 1px solid var(--line); border-radius: 22px;
  }
  .tp-how h2 { margin: 0 0 24px; font-size: 22px; font-weight: 950; }
  .tp-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .tp-step { position: relative; text-align: center; }
  .tp-step:not(:last-child)::after { content: '→'; position: absolute; right: -14px; top: 40px; color: var(--orange); font-size: 24px; }
  .tp-step-n { width: 30px; height: 30px; display: grid; place-items: center; margin: 0 auto -4px 2px; border-radius: 50%; background: var(--orange); color: #fff; font-weight: 950; }
  .tp-step-icon { width: 74px; height: 74px; display: grid; place-items: center; margin: 0 auto 10px; border-radius: 50%; background: #fff2df; font-size: 31px; }
  .tp-step strong { display: block; font-size: 15px; margin-bottom: 5px; }
  .tp-step p { margin: 0 auto; max-width: 210px; color: #5e554e; font-size: 12px; line-height: 1.4; }

  .tp-next {
    margin-top: 18px; padding: 15px 18px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    border: 1px solid #f0dfc9; border-radius: 19px; background: #fff3df;
  }
  .tp-next strong { display: block; font-size: 16px; margin-bottom: 3px; }
  .tp-next span { font-size: 12px; color: #5d554e; }
  .tp-next a {
    flex: 0 0 auto; padding: 12px 20px; border-radius: 999px;
    background: var(--orange); color: #fff; text-decoration: none; font-weight: 900; font-size: 13px;
  }

  .tp-privacy-note { margin-top: 10px; text-align: right; color: #81776d; font-size: 10px; }

  /* ================= RÉCOMPENSES TIOP+ ================= */
  .tp-rewards {
    margin-top: 28px;
    padding: 26px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: 0 10px 28px rgba(49,31,12,.04);
  }

  .tp-rewards-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 20px;
  }
  .tp-rewards-head h2 { margin: 0 0 6px; font-size: 24px; font-weight: 950; }
  .tp-rewards-head p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.45; }
  .tp-rewards-head > strong {
    flex: 0 0 auto;
    padding: 9px 13px;
    border-radius: 999px;
    background: #fff1df;
    color: #a95b00;
    font-size: 12px;
    font-weight: 950;
  }

  .tp-reward-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  .tp-reward-card {
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #fffaf5;
    border: 1px solid #eadfd3;
    border-radius: 20px;
    box-shadow: 0 8px 24px rgba(49,31,12,.05);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .tp-reward-card:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(49,31,12,.09); }

  .tp-reward-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, #fff0dc, #fff8ef);
    color: var(--orange);
    font-size: 42px;
  }
  .tp-reward-img img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .tp-reward-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 17px 17px 16px;
  }
  .tp-reward-type {
    align-self: flex-start;
    margin-bottom: 9px;
    padding: 5px 8px;
    border-radius: 999px;
    background: #f2ede7;
    color: #554c45;
    font-size: 9px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: .45px;
    text-transform: uppercase;
  }
  .tp-reward-body h3 {
    margin: 0 0 7px;
    font-size: 17px;
    line-height: 1.2;
    font-weight: 950;
  }
  .tp-reward-body p {
    min-height: 38px;
    margin: 0 0 15px;
    color: #5e554e;
    font-size: 12px;
    line-height: 1.5;
  }
  .tp-reward-meta {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px dashed #e7d9cb;
  }
  .tp-reward-cost { color: var(--orange-dark); font-size: 17px; font-weight: 950; }
  .tp-reward-meta > strong { color: #332b25; font-size: 12px; }

  .tp-reward-lock {
    margin-top: 12px;
    padding: 10px 11px;
    border-radius: 12px;
    background: #fff1df;
    color: #8a5a22;
    font-size: 11px;
    line-height: 1.35;
    font-weight: 800;
  }
  .tp-reward-lock.ok { background: #e7f7ec; color: #14723a; }

  .tp-no-reward {
    padding: 34px 18px;
    text-align: center;
    border: 1px dashed #e1d3c4;
    border-radius: 16px;
    background: #fffaf5;
    color: var(--muted);
    font-size: 13px;
  }


  .tp-flash { margin: 0 0 16px; padding: 13px 15px; border-radius: 14px; font-size: 12px; font-weight: 900; }
  .tp-flash.ok { background:#e8f8ed; color:#176f3a; border:1px solid #bfe7cb; }
  .tp-flash.err { background:#fff0ef; color:#a42d27; border:1px solid #f1cbc7; }
  .tp-redeem-form { margin-top: 12px; }
  .tp-redeem-btn { width:100%; border:0; border-radius:12px; padding:11px 13px; background:var(--orange); color:#fff; font-weight:950; cursor:pointer; box-shadow:0 8px 18px rgba(255,121,0,.18); }
  .tp-redeem-btn:hover { filter:brightness(.97); transform:translateY(-1px); }
  .tp-redeem-btn:disabled { cursor:not-allowed; background:#ddd4cb; color:#7c7168; box-shadow:none; transform:none; }
  .tp-wallet { margin-top:20px; padding:18px; border:1px solid #eadfd3; border-radius:18px; background:#fffaf5; }
  .tp-wallet h3 { margin:0 0 5px; font-size:17px; }
  .tp-wallet > p { margin:0 0 14px; color:var(--muted); font-size:12px; }
  .tp-wallet-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .tp-wallet-item { display:grid; grid-template-columns:58px 1fr; gap:11px; align-items:center; min-width:0; padding:10px; background:#fff; border:1px solid #eadfd3; border-radius:14px; }
  .tp-wallet-item img,.tp-wallet-ico { width:58px; height:58px; object-fit:cover; border-radius:11px; background:#fff1df; display:grid; place-items:center; font-size:24px; }
  .tp-wallet-item strong { display:block; font-size:12px; line-height:1.25; }
  .tp-wallet-item small { display:block; margin-top:4px; color:#766c63; font-size:10px; }
  .tp-wallet-code { margin-top:5px; font-family:monospace; color:#a95b00; font-size:9px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  @media (max-width: 950px) {
    .tp-hero-grid { grid-template-columns: 1fr; }
    .tp-card-top { grid-template-columns: 1fr 150px; }
    .tp-benefits, .tp-steps { grid-template-columns: repeat(2, 1fr); }
    .tp-reward-grid, .tp-wallet-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tp-step:nth-child(2)::after { display: none; }
  }

  @media (max-width: 640px) {
    .tp-hero, .tp-content { padding-left: 16px; padding-right: 16px; }
    .tp-title { font-size: 58px; }
    .tp-card { min-height: auto; border-radius: 26px; }
    .tp-card-top { grid-template-columns: 1fr; padding: 26px 24px 18px; }
    .tp-card-right { display: grid; grid-template-columns: 1fr 138px; align-items: end; gap: 15px; }
    .tp-level { text-align: left; margin: 0; }
    .tp-qr-box { margin-left: auto; width: 126px; min-height: 126px; }
    #tp-card-qr, #tp-card-qr img, #tp-card-qr canvas { width: 96px !important; height: 96px !important; }
    .tp-card-bottom { grid-template-columns: 1fr; }
    .tp-stat + .tp-stat { border-left: 0; border-top: 1px solid rgba(255,255,255,.22); }
    .tp-card-rate { position: static; padding: 8px 10px 12px; background: #17130f; }
    .tp-benefits, .tp-steps, .tp-reward-grid, .tp-wallet-grid { grid-template-columns: 1fr; }
    .tp-rewards { padding: 18px 14px; border-radius: 18px; }
    .tp-rewards-head { align-items: flex-start; flex-direction: column; }
    .tp-reward-img { aspect-ratio: 16 / 9; }
    .tp-step::after { display: none !important; }
    .tp-next { align-items: flex-start; flex-direction: column; }
  }
</style>

<div class="tp-plus">
  <section class="tp-hero">
    <div class="tp-shell tp-hero-grid">
      <div>
        <span class="tp-pill">⭐ Fidélité</span>
        <h1 class="tp-title">Tiop<span>+</span></h1>
        <p class="tp-lead">Plus vous commandez, plus vous êtes récompensé.</p>

        <% if (isSubscribed) { %>
          <div class="tp-member-state">
            ✓ Membre Tiop+ depuis le
            <%= new Date(account.subscribed_at).toLocaleDateString('fr-FR') %>
          </div>
          <% if (joined) { %>
            <p class="tp-welcome">🎉 Bienvenue dans Tiop+ !<span>Ton compte fidélité est maintenant actif.</span></p>
          <% } %>
        <% } else { %>
          <form method="post" action="/tiopplus/subscribe">
            <button class="tp-subscribe" type="submit">Je m’abonne</button>
          </form>
        <% } %>
      </div>

      <% if (isSubscribed) { %>
        <div class="tp-card-wrap">
          <article class="tp-card" aria-label="Carte de fidélité numérique Tiop+">
            <div class="tp-card-top">
              <div>
                <div class="tp-card-brand">Tiop<span>+</span></div>
                <div class="tp-card-sub">CARTE DE FIDÉLITÉ</div>

                <div class="tp-card-member">
                  <span class="tp-card-label">N° membre</span>
                  <span class="tp-card-number"><%= memberNumber %></span>
                  <span class="tp-contactless" aria-hidden="true">)))</span>
                </div>

                <div class="tp-card-name">
                  <span class="tp-card-label">Nom du membre</span>
                  <%= memberName || 'MEMBRE TIOP+' %>
                </div>
              </div>

              <div class="tp-card-right">
                <div class="tp-level">👑 NIVEAU<strong><%= memberLevel %></strong></div>
                <div>
                  <div class="tp-qr-box"><div id="tp-card-qr" aria-label="QR sécurisé Tiop+"></div></div>
                  <div class="tp-scan">🛡 Scan en caisse</div>
                </div>
              </div>
            </div>

            <div class="tp-card-bottom">
              <div class="tp-stat">
                <div class="tp-stat-icon">⭐</div>
                <div>
                  <div class="tp-stat-label">Solde points</div>
                  <div class="tp-stat-value"><%= Number(points || 0).toLocaleString('fr-FR') %> <small>points</small></div>
                </div>
              </div>
              <div class="tp-stat">
                <div class="tp-stat-icon">👛</div>
                <div>
                  <div class="tp-stat-label">Valeur estimée</div>
                  <div class="tp-stat-value"><%= Number(amountEquivalent || 0).toLocaleString('fr-FR') %> <small>XAF</small></div>
                </div>
              </div>
            </div>

            <div class="tp-card-rate"><%= pointsPer1000Xaf %> points gagnés par tranche de 1 000 XAF</div>
          </article>
          <div class="tp-privacy-note">Le QR ne contient aucune donnée personnelle : uniquement un identifiant signé Tiop+.</div>
        </div>
      <% } else { %>
        <div class="tp-card-wrap">
          <article class="tp-card" style="min-height:320px;display:grid;place-items:center;text-align:center;padding:40px;">
            <div style="position:relative;z-index:2;">
              <div class="tp-card-brand">Tiop<span>+</span></div>
              <p style="font-size:18px;max-width:440px;line-height:1.5;color:#eee2d7;">Abonne-toi gratuitement pour obtenir ta carte numérique et commencer à cumuler des points.</p>
            </div>
          </article>
        </div>
      <% } %>
    </div>
  </section>

  <section class="tp-content">
    <div class="tp-shell">
      <div class="tp-benefits">
        <article class="tp-benefit"><div class="tp-benefit-icon">🎁</div><h3>Promotions exclusives</h3><p>Profitez d’offres réservées aux membres Tiop+.</p></article>
        <article class="tp-benefit"><div class="tp-benefit-icon">⭐</div><h3>Gagnez des points</h3><p>Des points à chaque commande payée et éligible.</p></article>
        <article class="tp-benefit"><div class="tp-benefit-icon">🔔</div><h3>Infos prioritaires</h3><p>Soyez le premier informé des nouveautés.</p></article>
        <article class="tp-benefit"><div class="tp-benefit-icon">🎉</div><h3>Surprises & cadeaux</h3><p>Recevez des bonus et des récompenses spéciales.</p></article>
      </div>

      <section class="tp-rewards" id="recompenses">
        <% if (redeemed) { %><div class="tp-flash ok">✅ Récompense échangée avec succès. Tes points ont été débités et l’avantage est maintenant disponible.</div><% } %>
        <% if (redeemError) { const messages={INSUFFICIENT_POINTS:'Tu n’as pas encore assez de points pour cette récompense.',REWARD_UNAVAILABLE:'Cette récompense n’est plus disponible.',NOT_SUBSCRIBED:'Tu dois être membre Tiop+ pour échanger tes points.',INVALID_REQUEST:'La demande a expiré. Recharge la page puis réessaie.',INVALID_REWARD:'Récompense invalide.',INVALID_COST:'Le coût de cette récompense est invalide.',REDEEM_FAILED:'Impossible d’échanger cette récompense pour le moment.'}; %><div class="tp-flash err">⚠️ <%= messages[redeemError] || messages.REDEEM_FAILED %></div><% } %>
        <div class="tp-rewards-head">
          <div><h2>🎁 Mes récompenses Tiop+</h2><p>Le catalogue est géré par TiopTiop et se met à jour automatiquement.</p></div>
          <% if (isSubscribed) { %><strong><%= Number(points||0).toLocaleString('fr-FR') %> points disponibles</strong><% } %>
        </div>
        <% if (rewards && rewards.length) { %>
          <div class="tp-reward-grid">
            <% rewards.forEach(function(r){ const enough = Number(points||0) >= Number(r.points_cost||0); %>
              <article class="tp-reward-card">
                <div class="tp-reward-img"><% if(r.image_url){ %><img src="<%= r.image_url %>" alt="<%= r.name %>"><% } else { %>🎁<% } %></div>
                <div class="tp-reward-body">
                  <span class="tp-reward-type"><%= r.reward_type === 'FREE_DELIVERY' ? 'LIVRAISON' : r.reward_type %></span>
                  <h3><%= r.name %></h3><p><%= r.description || 'Récompense réservée aux membres Tiop+.' %></p>
                  <div class="tp-reward-meta"><span class="tp-reward-cost"><%= Number(r.points_cost).toLocaleString('fr-FR') %> pts</span><% if(r.reward_value){ %><strong><%= Number(r.reward_value).toLocaleString('fr-FR') %></strong><% } %></div>
                  <% if (!isSubscribed) { %>
                    <div class="tp-reward-lock">🔒 Abonnez-vous pour en profiter.</div>
                  <% } else if (enough) { %>
                    <div class="tp-reward-lock ok">✓ Vous avez assez de points</div>
                    <form class="tp-redeem-form" method="post" action="/tiopplus/rewards/<%= r.id %>/redeem" onsubmit="return confirm('Échanger <%= Number(r.points_cost).toLocaleString('fr-FR') %> points contre « <%= String(r.name).replace(/'/g, '’') %> » ?');">
                      <input type="hidden" name="request_key" value="<%= rewardRequestKeys && rewardRequestKeys[r.id] ? rewardRequestKeys[r.id] : '' %>">
                      <button class="tp-redeem-btn" type="submit">🎁 Échanger mes points</button>
                    </form>
                  <% } else { %>
                    <div class="tp-reward-lock">Encore <%= Number(r.points_cost)-Number(points||0) %> points à gagner</div>
                    <button class="tp-redeem-btn" type="button" disabled>Points insuffisants</button>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %><div class="tp-no-reward">Aucune récompense disponible pour le moment.</div><% } %>

        <% if (isSubscribed && availableRedemptions && availableRedemptions.length) { %>
          <div class="tp-wallet">
            <h3>🎟️ Mes avantages débloqués</h3>
            <p>Ces récompenses ont déjà été payées avec tes points. Elles seront utilisables dans le panier/commande à l’étape 16.6.</p>
            <div class="tp-wallet-grid">
              <% availableRedemptions.forEach(function(x){ %>
                <article class="tp-wallet-item">
                  <% if (x.image_url) { %><img src="<%= x.image_url %>" alt=""><% } else { %><div class="tp-wallet-ico">🎁</div><% } %>
                  <div>
                    <strong><%= x.name %></strong>
                    <small><%= Number(x.points_cost||0).toLocaleString('fr-FR') %> points utilisés · disponible</small>
                    <div class="tp-wallet-code"><%= x.public_id %></div>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        <% } %>
      </section>

      <section class="tp-how">
        <h2>Comment ça marche ?</h2>
        <div class="tp-steps">
          <div class="tp-step"><span class="tp-step-n">1</span><div class="tp-step-icon">👤</div><strong>Je m’abonne</strong><p>Je rejoins Tiop+ en un clic et deviens membre.</p></div>
          <div class="tp-step"><span class="tp-step-n">2</span><div class="tp-step-icon">🛒</div><strong>Je commande</strong><p>Je passe mes commandes comme d’habitude.</p></div>
          <div class="tp-step"><span class="tp-step-n">3</span><div class="tp-step-icon">⭐</div><strong>Je gagne</strong><p>Je cumule des points à chaque commande payée.</p></div>
          <div class="tp-step"><span class="tp-step-n">4</span><div class="tp-step-icon">🎁</div><strong>Je profite</strong><p>J’échange mes points contre des récompenses.</p></div>
        </div>
      </section>

      <div class="tp-next">
        <div><strong>👑 Plus vous cumulez, plus vous profitez !</strong><span>Continuez à commander pour débloquer de nouveaux avantages Tiop+.</span></div>
        <a href="#recompenses">Voir mes récompenses →</a>
      </div>
    </div>
  </section>
</div>

<% if (isSubscribed && cardPayload) { %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
  (function () {
    const el = document.getElementById('tp-card-qr');
    const payload = <%- JSON.stringify(cardPayload) %>;
    if (!el || !payload) return;

    function renderQr() {
      if (typeof QRCode === 'undefined') {
        el.innerHTML = '<div style="font-size:10px;color:#222;padding:18px 4px;text-align:center">QR indisponible<br>Rechargez la page</div>';
        return;
      }
      el.innerHTML = '';
      new QRCode(el, {
        text: payload,
        width: 112,
        height: 112,
        colorDark: '#111111',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.H
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', renderQr);
    else renderQr();
  })();
</script>
<% } %>
