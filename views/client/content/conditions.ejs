<style>
  .tiop-conditions {
    --text: #1d1a17;
    --muted: #77716c;
    --border: #eee5dc;
    --orange: #ff7900;

    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
  }

  /* ================================================
     LISTE
  ================================================= */

  .conditions-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ================================================
     CARTE
  ================================================= */

  .condition-card {
    width: 100%;
    min-height: 100px;

    padding: 24px 26px;

    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    justify-content: center;

    background: #ffffff;

    border: 1px solid var(--border);
    border-radius: 20px;

    transition:
      transform .2s ease,
      border-color .2s ease,
      box-shadow .2s ease;
  }

  .condition-card:hover {
    transform: translateY(-1px);

    border-color: #e5d8cb;

    box-shadow:
      0 7px 24px rgba(0, 0, 0, .025);
  }

  /* ================================================
     TITRE
  ================================================= */

  .condition-card h2 {
    margin: 0 0 13px;

    font-size: 14px;
    line-height: 1.3;

    font-weight: 900;
  }

  /* ================================================
     TEXTE
  ================================================= */

  .condition-card p {
    margin: 0;

    color: var(--muted);

    font-size: 11px;
    line-height: 1.6;
  }

  /* ================================================
     RESPONSIVE
  ================================================= */

  @media (max-width: 650px) {

    .conditions-list {
      gap: 7px;
    }

    .condition-card {
      min-height: auto;

      padding: 20px;

      border-radius: 17px;
    }

    .condition-card h2 {
      margin-bottom: 10px;

      font-size: 13px;
    }

    .condition-card p {
      font-size: 11px;
    }
  }
</style>


<!-- =========================================================
