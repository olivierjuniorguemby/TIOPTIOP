<style>
    /* =====================================================
   ROLES & PERMISSIONS
   VERSION COMPACTE SANS AJOUTER DE CLASSE
===================================================== */

.roles-page {
    padding: 14px 15px 20px;
}


/* =====================================================
   EN-TETE
===================================================== */

.admin-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    padding: 14px 18px 10px;

    margin-bottom: 12px;
}

.admin-heading > div {
    min-width: 0;
}

.admin-badge {
    display: inline-flex;
    align-items: center;

    padding: 7px 13px;

    margin-bottom: 10px;

    border-radius: 999px;

    background: #fff0df;
    color: #ff7900;

    font-size: 13px;
    font-weight: 800;
}

.admin-heading h1 {
    margin: 0;

    color: #111;

    font-size: 38px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.btn-orange {
    flex: 0 0 auto;

    border: 0;

    padding: 13px 22px;

    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-family: inherit;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;

    transition:
        background .15s ease,
        transform .15s ease;
}

.btn-orange:hover {
    background: #e96f00;
}

.btn-orange:active {
    transform: scale(.98);
}


/* =====================================================
   GRILLE
===================================================== */

.roles-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 16px;
}


/* =====================================================
   CARTES
===================================================== */

.role-card {
    box-sizing: border-box;

    min-width: 0;
    min-height: 245px;

    padding: 24px 24px 22px;

    border-radius: 24px;

    background: #fff;

    box-shadow:
        0 8px 28px rgba(0, 0, 0, .035);
}

.role-card h2 {
    margin: 0 0 16px;

    color: #111;

    font-size: 23px;
    line-height: 1.2;
    font-weight: 800;
}

.role-count {
    margin: 0 0 16px;

    color: #777;

    font-size: 15px;
    line-height: 1.4;
}

.role-permission {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 14px;

    min-height: 38px;

    border-bottom: 1px dotted #ddd;

    color: #111;

    font-size: 15px;
}

.permission-ok {
    flex: 0 0 auto;

    padding: 6px 10px;

    border-radius: 999px;

    background: #e8f7ed;
    color: #257444;

    font-size: 11px;
    font-weight: 800;
}

.btn-edit-role {
    border: 0;

    margin-top: 13px;

    padding: 11px 16px;

    border-radius: 999px;

    background: #fff;
    color: #111;

    font-family: inherit;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;

    box-shadow:
        0 6px 20px rgba(0, 0, 0, .06);

    transition:
        transform .15s ease,
        background .15s ease;
}

.btn-edit-role:hover {
    background: #fff7ef;
}

.btn-edit-role:active {
    transform: scale(.98);
}


/* =====================================================
   MODAL OVERLAY
===================================================== */

.role-modal-overlay {
    position: fixed;
    inset: 0;

    z-index: 9999;

    display: none;
    align-items: center;
    justify-content: center;

    box-sizing: border-box;

    padding: 18px;

    background: rgba(0, 0, 0, .52);
}

.role-modal-overlay.show {
    display: flex;
}


/* =====================================================
   MODAL COMPACTE
===================================================== */

.role-modal {
    box-sizing: border-box;

    width: min(760px, 90vw);
    max-height: 88vh;

    overflow-y: auto;

    padding: 22px 24px 24px;

    border-radius: 24px;

    background: #fff;

    box-shadow:
        0 24px 60px rgba(0, 0, 0, .28);
}


/* =====================================================
   HEADER MODAL
===================================================== */

.role-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 14px;

    margin-bottom: 16px;
}

.role-modal-header h2 {
    margin: 0;

    color: #111;

    font-size: 25px;
    line-height: 1.2;
    font-weight: 800;
}

.role-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 40px;

    width: 40px;
    height: 40px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: #f1f1f1;
    color: #111;

    font-family: inherit;

    font-size: 18px;
    line-height: 1;

    cursor: pointer;
}

.role-modal-close:hover {
    background: #e6e6e6;
}


/* =====================================================
   NOM ROLE
===================================================== */

.role-name-input {
    display: block;

    box-sizing: border-box;

    width: 100%;
    height: 46px;

    padding: 0 14px;

    margin-bottom: 10px;

    border: 1px solid #ddd;
    border-radius: 12px;

    background: #fff;
    color: #111;

    outline: none;

    font-family: inherit;

    font-size: 15px;
}

.role-name-input:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255, 121, 0, .08);
}


/* =====================================================
   PERMISSIONS
===================================================== */

.permissions-grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 7px 9px;
}

.permission-choice {
    box-sizing: border-box;

    display: flex;
    align-items: center;

    gap: 10px;

    min-height: 40px;

    padding: 7px 12px;

    border: 1px solid #ded8d3;
    border-radius: 12px;

    background: #faf7f4;

    cursor: pointer;

    transition:
        border-color .15s ease,
        background .15s ease;
}

.permission-choice:hover {
    border-color: #ff7900;

    background: #fff8f1;
}

.permission-choice input {
    flex: 0 0 auto;

    width: 15px;
    height: 15px;

    margin: 0;

    cursor: pointer;

    accent-color: #147bf3;
}

.permission-choice span {
    min-width: 0;

    color: #111;

    font-size: 14px;
    line-height: 1.2;
}


/* =====================================================
   PERMISSION TOUT
===================================================== */

.permission-all {
    margin-bottom: 8px;
}

.permission-all span {
    font-size: 14px;
}


/* =====================================================
   BOUTON ENREGISTRER
===================================================== */

.role-save-btn {
    width: 100%;
    height: 46px;

    margin-top: 11px;

    border: 0;
    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-family: inherit;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;
}

.role-save-btn:hover {
    background: #e96f00;
}


/* =====================================================
   TABLETTE
===================================================== */

@media (max-width: 900px) {

    .roles-grid {
        grid-template-columns: 1fr;
    }

    .role-modal {
        width: min(700px, 94vw);
    }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

    .admin-heading {
        flex-direction: column;

        padding: 12px;
    }

    .admin-heading h1 {
        font-size: 28px;
    }

    .btn-orange {
        width: 100%;
    }

    .roles-page {
        padding: 10px 12px 16px;
    }

    .role-card {
        min-height: auto;

        padding: 18px;

        border-radius: 20px;
    }

    .role-card h2 {
        font-size: 20px;
    }

    .role-modal-overlay {
        padding: 10px;
    }

    .role-modal {
        width: 100%;

        max-height: 92vh;

        padding: 18px 16px;

        border-radius: 20px;
    }

    .role-modal-header h2 {
        font-size: 21px;
    }

    .permissions-grid {
        grid-template-columns: 1fr;
    }

    .permission-choice {
        min-height: 39px;
    }

}
</style>

<script>

const roleModal = document.getElementById("roleModal");
const roleForm = document.getElementById("roleForm");

function resetRolePermissions() {

    document
        .querySelectorAll(
            '#roleForm input[name="permissions[]"]'
        )
        .forEach(function(input) {
            input.checked = false;
        });
}


/* =====================================================
   NOUVEAU ROLE
===================================================== */

function openNewRoleModal() {

    resetRolePermissions();

    document.getElementById("roleModalTitle").textContent =
        "🔐 Nouveau rôle";

    document.getElementById("roleId").value = "";

    document.getElementById("roleName").value = "";

    /*
       Quand votre backend sera branché :
       POST /admin/roles
    */
    roleForm.action = "/admin/roles";

    roleModal.classList.add("show");

    document.body.style.overflow = "hidden";
}


/* =====================================================
   MODIFIER ROLE
===================================================== */

function openEditRoleModal(id, name, permissions) {

    resetRolePermissions();

    document.getElementById("roleModalTitle").textContent =
        "🔐 Modifier le rôle";

    document.getElementById("roleId").value = id;

    document.getElementById("roleName").value = name;


    /*
       Cocher les permissions du rôle
    */

    document
        .querySelectorAll(
            '#roleForm input[name="permissions[]"]'
        )
        .forEach(function(input) {

            if (permissions.includes(input.value)) {
                input.checked = true;
            }

        });


    /*
       Route Express
    */

    roleForm.action =
        "/admin/roles/" + id + "/update";


    roleModal.classList.add("show");

    document.body.style.overflow = "hidden";
}


/* =====================================================
   FERMETURE
===================================================== */

function closeRoleModal() {

    roleModal.classList.remove("show");

    document.body.style.overflow = "";
}


/* CLIC SUR FOND GRIS */

roleModal.addEventListener("click", function(event) {

    if (event.target === roleModal) {
        closeRoleModal();
    }

});


/* TOUCHE ESC */

document.addEventListener("keydown", function(event) {

    if (
        event.key === "Escape" &&
        roleModal.classList.contains("show")
    ) {

        closeRoleModal();

    }

});

function toggleAllPermissions(master) {

    document
        .querySelectorAll(
            '#roleForm input[name="permissions[]"]'
        )
        .forEach(function(input) {

            if (input !== master) {
                input.checked = master.checked;
            }

        });
}

</script>