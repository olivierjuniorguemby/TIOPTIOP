                    <span>Catégories</span>
                </label>

                <label class="permission-choice">
                    <input type="checkbox" name="permissions[]" value="Formules">
                    <span>Formules</span>
                </label>

                <label class="permission-choice">
                    <input type="checkbox" name="permissions[]" value="Promotions">
                    <span>Promotions</span>
                </label>

                <label class="permission-choice">
                    <input type="checkbox" name="permissions[]" value="Tiop+">
                    <span>Tiop+</span>
                </label>

                <label class="permission-choice">
                    <input type="checkbox" name="permissions[]" value="Clients">
                    <span>Clients</span>
                </label>

                <label class="permission-choice">
                    <input type="checkbox" name="permissions[]" value="Support">
                    <span>Support</span>
                </label>

                <label class="permission-choice">
