<section class="an-head"><div><span>Administration</span><h1>🔔 Notifications</h1><p>Suivez les événements importants de TiopTiop en temps réel.</p></div><button id="anReadAll" <%= summary.unread?'':'disabled' %>>✓ Tout marquer comme lu</button></section>
<section class="an-page">
  <div class="an-stats"><article><small>🔴 Non lues</small><strong id="anUnread"><%= summary.unread %></strong></article><article><small>🔔 Aujourd’hui</small><strong id="anToday"><%= summary.today %></strong></article><article><small>✓ Lues</small><strong id="anRead"><%= summary.read %></strong></article><article><small>📨 Total</small><strong id="anTotal"><%= summary.total %></strong></article></div>
  <div class="an-panel">
    <div class="an-tools"><label>⌕ <input id="anSearch" placeholder="Rechercher une notification…"></label><select id="anSort"><option value="new">Plus récentes</option><option value="old">Plus anciennes</option></select></div>
    <div class="an-filters"><button class="active" data-filter="ALL">Toutes</button><button data-filter="UNREAD">Non lues</button><button data-filter="ORDERS">Commandes</button><button data-filter="PAYMENTS">Paiements</button><button data-filter="SUPPORT">Support</button><button data-filter="STOCKS">Stocks</button><button data-filter="APPLICATIONS">Candidatures</button></div>
    <div id="anList" class="an-list"></div>
  </div>
</section>
<style>
.an-head{margin:0 20px 18px;padding:25px 28px;border-radius:24px;background:linear-gradient(135deg,#211914,#33231a);color:#fff;display:flex;justify-content:space-between;align-items:center;gap:20px}.an-head span{display:inline-block;color:#ffad59;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.9px}.an-head h1{margin:6px 0 4px;font-size:34px}.an-head p{margin:0;color:#d8cec6}.an-head button{border:0;border-radius:999px;padding:12px 16px;background:#ff7900;color:#fff;font-weight:900;cursor:pointer}.an-head button:disabled{opacity:.45;cursor:default}.an-page{padding:0 20px 24px}.an-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}.an-stats article{background:#fff;border:1px solid #eee5dd;border-radius:20px;padding:18px 20px;box-shadow:0 10px 30px rgba(30,20,10,.035)}.an-stats small{display:block;color:#756c65;font-weight:700;margin-bottom:9px}.an-stats strong{font-size:28px}.an-panel{background:#fff;border:1px solid #eee5dd;border-radius:24px;overflow:hidden;box-shadow:0 12px 35px rgba(30,20,10,.035)}.an-tools{padding:18px;display:flex;gap:12px}.an-tools label{flex:1;border:1px solid #e7ddd4;border-radius:14px;padding:0 14px;display:flex;align-items:center;gap:8px}.an-tools input{width:100%;height:42px;border:0;outline:0;font:inherit}.an-tools select{border:1px solid #e7ddd4;border-radius:14px;padding:0 14px;background:#fff}.an-filters{display:flex;gap:8px;flex-wrap:wrap;padding:0 18px 17px;border-bottom:1px solid #f0e8e1}.an-filters button{border:0;border-radius:999px;padding:10px 14px;background:#f5f1ee;color:#554d47;font-weight:850;cursor:pointer}.an-filters button.active{background:#ff7900;color:#fff}.an-item{display:grid;grid-template-columns:48px 1fr auto;gap:13px;padding:17px 20px;border-bottom:1px solid #f1eae4;align-items:start}.an-item.unread{background:#fffaf4}.an-icon{width:46px;height:46px;border-radius:15px;background:#fff0df;display:grid;place-items:center;font-size:19px}.an-copy strong{font-size:14px}.an-copy p{margin:5px 0;color:#756b63;font-size:13px}.an-meta{display:flex;align-items:center;gap:12px;color:#9b8f85;font-size:11px}.an-actions{display:flex;align-items:center;gap:8px}.an-actions button,.an-actions a{border:0;background:#fff1e3;color:#d65d00;text-decoration:none;border-radius:999px;padding:8px 10px;font-size:11px;font-weight:850;cursor:pointer}.an-state{font-size:11px;font-weight:800;color:#6f9f68}.an-state.unread{color:#e06b00}.an-empty{text-align:center;padding:60px 20px;color:#8c8178}.an-live{animation:anFlash 1.2s ease}@keyframes anFlash{0%{background:#fff0dc}100%{background:inherit}}@media(max-width:900px){.an-stats{grid-template-columns:repeat(2,1fr)}.an-head{align-items:flex-start;flex-direction:column}.an-tools{flex-direction:column}.an-tools select{height:44px}}@media(max-width:600px){.an-page{padding:0 10px 18px}.an-head{margin:0 10px 14px}.an-item{grid-template-columns:42px 1fr}.an-actions{grid-column:2;justify-content:flex-start}.an-stats{gap:8px}.an-stats article{padding:14px}}
</style>
<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{const initial=<%- JSON.stringify(items||[]).replace(/</g,'\\u003c') %>;let items=initial,filter='ALL',search='',sort='new';const list=document.getElementById('anList'),q=document.getElementById('anSearch'),sortEl=document.getElementById('anSort'),readAll=document.getElementById('anReadAll');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const icon=t=>/ORDER|COMMANDE|DELIVERY/.test(t)?'🛒':/PAY|REFUND/.test(t)?'💳':/SUPPORT|TICKET/.test(t)?'💬':/STOCK/.test(t)?'📦':/APPLICATION|CANDIDATURE|JOB/.test(t)?'📨':'🔔';const when=d=>new Date(d).toLocaleString('fr-FR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
function stats(s){document.getElementById('anUnread').textContent=s.unread||0;document.getElementById('anToday').textContent=s.today||0;document.getElementById('anRead').textContent=s.read||0;document.getElementById('anTotal').textContent=s.total||0;readAll.disabled=!Number(s.unread||0)}
function draw(){let a=[...items];if(sort==='old')a.reverse();list.innerHTML=a.length?a.map(n=>`<article class="an-item ${n.read_at?'':'unread'}" data-id="${n.id}"><span class="an-icon">${icon(String(n.notification_type||'').toUpperCase())}</span><div class="an-copy"><strong>${esc(n.title)}</strong><p>${esc(n.body)}</p><div class="an-meta"><span>${when(n.created_at)}</span><span class="an-state ${n.read_at?'':'unread'}">${n.read_at?'✓ Lue':'● Non lue'}</span></div></div><div class="an-actions">${n.target_url?`<a href="${esc(n.target_url)}" data-open="1">Voir →</a>`:''}<button data-toggle="1">${n.read_at?'Marquer non lue':'Marquer lue'}</button></div></article>`).join(''):'<div class="an-empty">✨ Aucune notification pour ce filtre.</div>'}
async function load(live=false){const u=new URL('/admin/notifications/list',location.origin);u.searchParams.set('filter',filter);if(search)u.searchParams.set('q',search);const r=await fetch(u,{headers:{Accept:'application/json'}});if(!r.ok)return;const d=await r.json();items=d.items||[];stats(d.summary||{});draw();if(live){const x=list.querySelector('.an-item');if(x)x.classList.add('an-live')}}
async function post(url){const r=await fetch(url,{method:'POST',headers:{Accept:'application/json'}});if(r.ok)await load()}
document.querySelectorAll('.an-filters button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.an-filters button').forEach(x=>x.classList.remove('active'));b.classList.add('active');filter=b.dataset.filter;load()});let timer;q.oninput=()=>{clearTimeout(timer);timer=setTimeout(()=>{search=q.value.trim();load()},220)};sortEl.onchange=()=>{sort=sortEl.value;draw()};readAll.onclick=()=>post('/admin/notifications/read-all');list.onclick=e=>{const row=e.target.closest('.an-item');if(!row)return;if(e.target.closest('[data-toggle]')){const n=items.find(x=>String(x.id)===row.dataset.id);post(`/admin/notifications/${row.dataset.id}/${n&&n.read_at?'unread':'read'}`)}else if(e.target.closest('[data-open]')){const n=items.find(x=>String(x.id)===row.dataset.id);if(n&&!n.read_at)navigator.sendBeacon?.(`/admin/notifications/${row.dataset.id}/read`)}};
draw();if(window.io){window.tiopNotificationSocket=window.tiopNotificationSocket||io();window.tiopNotificationSocket.on('notification:new',()=>load(true));window.tiopNotificationSocket.on('notification:changed',()=>load())}window.addEventListener('tiop:notifications:summary',e=>stats(e.detail||{}));})();
</script>
