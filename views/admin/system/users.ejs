}

.admin-users-row > div {
    padding: 20px 25px;
}

.admin-users-head {
    min-height: 70px;
    background: #faf7f4;
    font-weight: 800;
}


/* PHOTO TABLEAU */

.admin-user-name {
    display: flex;
    align-items: center;
    gap: 14px;
}

.admin-user-name strong {
    font-size: 17px;
}

.admin-user-avatar {
