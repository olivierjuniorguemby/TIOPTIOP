    color: #111;
    box-shadow: 0 5px 20px rgba(0,0,0,.05);
}

.btn-user-toggle {
    background: #fde8e7;
    color: #bd4036;
}


/* =========================================================
   MODAL
========================================================= */

.admin-user-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 25px;

