    background: #fff;
    border-radius: 38px;

    box-shadow:
        0 30px 80px
        rgba(0,0,0,.30);
}

.admin-user-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 30px;
}

.admin-user-modal-header h2 {
