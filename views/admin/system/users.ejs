    padding: 20px;
}

.admin-users-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 30px;
}

.admin-users-header h1 {
    margin: 12px 0 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    color: #171310;
}

.admin-badge {
    display: inline-flex;
    padding: 8px 16px;
    border-radius: 999px;
    background: #fff0df;
    color: #ff7900;
    font-weight: 800;
}

.btn-user-add {
    border: 0;
    background: #ff7900;
    color: #fff;
    padding: 17px 28px;
    border-radius: 999px;
