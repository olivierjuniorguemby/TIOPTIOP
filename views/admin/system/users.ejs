<section class="admin-heading">
  <div>
    <span class="admin-badge">Administration</span>
    <h1>👨‍💼 Utilisateurs admin</h1>
  </div>
  <button
      type="button"
      class="btn-user-add"
      onclick="openAddAdminUserModal()"
    >
      + Ajouter
    </button>
</section>

<section class="admin-users-page">



  <!-- =========================
       TABLEAU
  ========================== -->
  <div class="admin-users-table-card">

    <div class="admin-users-row admin-users-head">
      <div>Utilisateur</div>
      <div>Email</div>
      <div>Rôle</div>
      <div>Statut</div>
      <div>Actions</div>
    </div>


    <!-- UTILISATEUR 1 -->
    <div class="admin-users-row">

      <div class="admin-user-name">

        <img
          src="/media/admin/admin-default.jpg"
          alt="Administrateur TiopTiop"
          class="admin-user-avatar"
          onerror="this.src='/media/icons/avatar-default.png'"
        >

        <strong>Administrateur TiopTiop</strong>

      </div>

      <div>
        admin@tioptiop.cg
      </div>

      <div>
        Super Admin
      </div>

      <div>
        <span class="admin-user-status inactive">
          Inactif
        </span>
      </div>

      <div class="admin-user-actions">

        <button
          type="button"
          class="btn-user-edit"
          onclick="openEditAdminUserModal(
            1,
            'Administrateur TiopTiop',
            'admin@tioptiop.cg',
            '',
            'Super Admin',
            false,
            '/media/admin/admin-default.jpg'
          )"
        >
          ✏️ Modifier
        </button>

        <button
          type="button"
          class="btn-user-toggle"
        >
          Activer
        </button>

      </div>

    </div>


    <!-- UTILISATEUR 2 -->
    <div class="admin-users-row">

      <div class="admin-user-name">

        <img
          src="/media/admin/manager.jpg"
          alt="Manager Centre-ville"
          class="admin-user-avatar"
          onerror="this.src='/media/icons/avatar-default.png'"
        >

        <strong>Manager Centre-ville</strong>

      </div>

      <div>
        manager@tioptiop.cg
      </div>

      <div>
        Manager restaurant
      </div>

      <div>
        <span class="admin-user-status active">
          Actif
        </span>
      </div>

      <div class="admin-user-actions">

        <button
          type="button"
          class="btn-user-edit"
          onclick="openEditAdminUserModal(
            2,
            'Manager Centre-ville',
            'manager@tioptiop.cg',
            '0644702966',
            'Manager restaurant',
            true,
            '/media/admin/manager.jpg'
          )"
        >
          ✏️ Modifier
        </button>

        <button
          type="button"
          class="btn-user-toggle danger"
        >
          Désactiver
        </button>

      </div>

    </div>


    <!-- UTILISATEUR 3 -->
    <div class="admin-users-row">

      <div class="admin-user-name">

        <img
          src="/media/admin/support.jpg"
          alt="Agent Support"
          class="admin-user-avatar"
          onerror="this.src='/media/icons/avatar-default.png'"
        >

        <strong>Agent Support</strong>

      </div>

      <div>
        support@tioptiop.cg
      </div>

      <div>
        Support
      </div>

      <div>
        <span class="admin-user-status active">
          Actif
        </span>
      </div>

      <div class="admin-user-actions">

        <button
          type="button"
          class="btn-user-edit"
          onclick="openEditAdminUserModal(
            3,
            'Agent Support',
            'support@tioptiop.cg',
            '',
            'Support',
            true,
            '/media/admin/support.jpg'
          )"
        >
          ✏️ Modifier
        </button>

        <button
          type="button"
          class="btn-user-toggle danger"
        >
          Désactiver
        </button>

      </div>

    </div>

  </div>


  <!-- ======================================================
       MODAL AJOUT
  ======================================================= -->
  <div
    class="admin-user-modal-overlay"
    id="addAdminUserModal"
    onclick="closeAdminUserModalOutside(event, 'addAdminUserModal')"
  >

    <div class="admin-user-modal">

      <div class="admin-user-modal-header">

        <h2>
          ➕ Nouvel utilisateur admin
        </h2>

        <button
          type="button"
          class="admin-user-modal-close"
          onclick="closeAdminUserModal('addAdminUserModal')"
        >
          ×
        </button>

      </div>


      <form
        action="/admin/users"
        method="POST"
        enctype="multipart/form-data"
      >

        <input
          type="text"
          name="name"
          class="admin-user-input"
          placeholder="Nom"
          required
        >


        <input
          type="email"
          name="email"
          class="admin-user-input"
          placeholder="Email"
          required
        >


        <input
          type="tel"
          name="phone"
          class="admin-user-input"
          placeholder="Téléphone"
        >


        <select
          name="role"
          class="admin-user-input admin-user-select"
          required
        >
          <option value="Super Admin">
            Super Admin
          </option>

          <option value="Manager restaurant">
            Manager restaurant
          </option>

          <option value="Support">
            Support
          </option>

          <option value="Caissier">
            Caissier
          </option>

          <option value="Livreur">
            Livreur
          </option>
        </select>


        <!-- PHOTO -->
        <div class="admin-photo-field">

          <label>
            📷 Photo de profil
          </label>

          <div class="admin-file-wrapper">

            <input
              type="file"
              name="profileImage"
              id="addAdminProfileImage"
              accept="image/png,image/jpeg,image/jpg,image/webp"
              onchange="previewAdminImage(this, 'addAdminPreview')"
            >

          </div>

          <!-- aperçu -->
          <div class="admin-image-preview-container">

            <img
              id="addAdminPreview"
              class="admin-image-preview"
              src="/media/icons/avatar-default.png"
              alt="Aperçu"
            >

          </div>

        </div>


        <!-- ACTIF -->
        <label class="admin-active-field">

          <span>
            Compte actif
          </span>

          <input
            type="checkbox"
            name="active"
            value="1"
            checked
          >

        </label>


        <button
          type="submit"
          class="admin-user-save"
        >
          💾 Enregistrer l’utilisateur
        </button>

      </form>

    </div>

  </div>


  <!-- ======================================================
       MODAL MODIFICATION
  ======================================================= -->
  <div
    class="admin-user-modal-overlay"
    id="editAdminUserModal"
    onclick="closeAdminUserModalOutside(event, 'editAdminUserModal')"
  >

    <div class="admin-user-modal">

      <div class="admin-user-modal-header">

        <h2>
          ✏️ Modifier utilisateur
        </h2>

        <button
          type="button"
          class="admin-user-modal-close"
          onclick="closeAdminUserModal('editAdminUserModal')"
        >
          ×
        </button>

      </div>


      <form
        id="editAdminUserForm"
        method="POST"
        enctype="multipart/form-data"
      >

        <input
          type="hidden"
          name="id"
          id="editAdminId"
        >


        <input
          type="text"
          name="name"
          id="editAdminName"
          class="admin-user-input"
          placeholder="Nom"
          required
        >


        <input
          type="email"
          name="email"
          id="editAdminEmail"
          class="admin-user-input"
          placeholder="Email"
          required
        >


        <input
          type="tel"
          name="phone"
          id="editAdminPhone"
          class="admin-user-input"
          placeholder="Téléphone"
        >


        <select
          name="role"
          id="editAdminRole"
          class="admin-user-input admin-user-select"
        >

          <option value="Super Admin">
            Super Admin
          </option>

          <option value="Manager restaurant">
            Manager restaurant
          </option>

          <option value="Support">
            Support
          </option>

          <option value="Caissier">
            Caissier
          </option>

          <option value="Livreur">
            Livreur
          </option>

        </select>


        <!-- PHOTO -->
        <div class="admin-photo-field">

          <label>
            📷 Photo de profil
          </label>

          <div class="admin-file-wrapper">

            <input
              type="file"
              name="profileImage"
              id="editAdminProfileImage"
              accept="image/png,image/jpeg,image/jpg,image/webp"
              onchange="previewAdminImage(this, 'editAdminPreview')"
            >

          </div>


          <div class="admin-image-preview-container">

            <img
              id="editAdminPreview"
              class="admin-image-preview"
              src="/media/icons/avatar-default.png"
              alt="Photo utilisateur"
            >

          </div>

        </div>


        <!-- ACTIF -->
        <label class="admin-active-field">

          <span>
            Compte actif
          </span>

          <input
            type="checkbox"
            name="active"
            id="editAdminActive"
            value="1"
          >

        </label>


        <button
          type="submit"
          class="admin-user-save"
        >
          💾 Enregistrer l’utilisateur
        </button>

      </form>

    </div>

  </div>

</section>

<style>
  /* =========================================================
   UTILISATEURS ADMIN
========================================================= */

