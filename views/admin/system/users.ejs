    justify-content: space-between;
    align-items: center;

    min-height: 80px;

    padding: 0 25px;
    margin-bottom: 18px;

    border-radius: 22px;

    background: #faf7f4;

    font-size: 23px;

    cursor: pointer;
}

.admin-active-field input {
    width: 24px;
    height: 24px;

    accent-color: #ff7900;

    cursor: pointer;
}


/* BOUTON ENREGISTRER */

.admin-user-save {
    width: 100%;
    min-height: 80px;

    border: 0;
    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-size: 24px;
    font-weight: 800;

    cursor: pointer;
}

.admin-user-save:hover,
.btn-user-add:hover {
    background: #e96f00;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {

    .admin-users-table-card {
        overflow-x: auto;
    }

    .admin-users-row {
        min-width: 1050px;
    }

    .admin-user-modal {
        padding: 30px;
        border-radius: 28px;
    }

}

@media (max-width: 600px) {

    .admin-users-page {
        padding: 12px;
    }

    .admin-users-header {
        flex-direction: column;
    }

    .btn-user-add {
        width: 100%;
    }

    .admin-user-modal-overlay {
        padding: 10px;
    }

    .admin-user-modal {
        width: 100%;
        padding: 22px;
        border-radius: 25px;
    }

    .admin-user-input {
        min-height: 60px;
        font-size: 17px;
        border-radius: 16px;
    }

    .admin-active-field {
        min-height: 65px;
        font-size: 18px;
    }

    .admin-user-save {
        min-height: 65px;
        font-size: 18px;
    }

    .admin-user-modal-close {
        width: 48px;
        height: 48px;
    }

}
</style>

<script>

function openAddAdminUserModal() {

    const modal = document.getElementById("addAdminUserModal");

    modal.classList.add("show");

    document.body.style.overflow = "hidden";
}


function openEditAdminUserModal(
    id,
    name,
    email,
    phone,
    role,
    active,
    image
) {

    document.getElementById("editAdminId").value = id;

    document.getElementById("editAdminName").value = name;

    document.getElementById("editAdminEmail").value = email;

    document.getElementById("editAdminPhone").value = phone || "";

    document.getElementById("editAdminRole").value = role;

    document.getElementById("editAdminActive").checked =
        active === true ||
        active === 1 ||
        active === "1";


    /* PHOTO ACTUELLE */

    const preview =
        document.getElementById("editAdminPreview");

    if (image) {

        preview.src = image;

    } else {

        preview.src =
            "/media/icons/avatar-default.png";
    }


    /* URL FORMULAIRE */

    document.getElementById(
        "editAdminUserForm"
    ).action =
        "/admin/users/" + id + "/update";


    /* AFFICHAGE */

    document.getElementById(
        "editAdminUserModal"
    ).classList.add("show");

    document.body.style.overflow = "hidden";
}


function closeAdminUserModal(id) {

    document
        .getElementById(id)
        .classList.remove("show");

    document.body.style.overflow = "";
}


function closeAdminUserModalOutside(event, id) {

    if (event.target.id === id) {
        closeAdminUserModal(id);
    }
}


/* =====================================================
   PREVIEW IMAGE AVANT UPLOAD
===================================================== */

function previewAdminImage(input, previewId) {

    const preview =
        document.getElementById(previewId);

    if (!input.files || !input.files[0]) {
        return;
    }

    const file = input.files[0];


    /* Vérification type */

    if (!file.type.startsWith("image/")) {

        alert(
            "Veuillez sélectionner une image."
        );

        input.value = "";

        return;
    }


    /* Taille max : 5 Mo */

    if (file.size > 5 * 1024 * 1024) {

        alert(
            "L'image ne doit pas dépasser 5 Mo."
        );

        input.value = "";

        return;
    }


    const reader = new FileReader();

    reader.onload = function(event) {

        preview.src =
            event.target.result;
    };

    reader.readAsDataURL(file);
}


/* ESC ferme les modals */

document.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Escape") {

            document
                .querySelectorAll(
                    ".admin-user-modal-overlay.show"
                )
                .forEach(function(modal) {

                    modal.classList.remove("show");

                });

            document.body.style.overflow = "";
        }
    }
);

</script>
