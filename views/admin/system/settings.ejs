        </form>

    </div>

</div>



<!-- =========================================================
     4. MODAL NOTIFICATIONS
========================================================= -->

<div class="settings-modal-overlay" id="notificationsModal">

    <div class="settings-modal settings-modal-small">

        <div class="settings-modal-header">

            <h2>⚙️ Configurer — notifications</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('notificationsModal')">
                ×
            </button>

        </div>


        <form method="POST" action="/admin/parametres/notifications">


