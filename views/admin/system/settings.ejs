            </div>


            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>

<style>
    /* =====================================================
   PARAMETRES SYSTEME
   VERSION COMPACTE
===================================================== */

.settings-page {
    padding: 18px 20px 20px;
}


/* =====================================================
   TITRE DE PAGE
===================================================== */

/* Votre HTML utilise .admin-heading et non .settings-heading */
.admin-heading {
    margin: 0 0 22px;
    padding: 0 20px;
}

.admin-heading > div {
    width: 100%;
}

.admin-badge {
    display: inline-flex;
    align-items: center;

    padding: 7px 14px;
    margin-bottom: 10px;

    background: #fff0df;
    color: #ff7900;

    border-radius: 999px;

    font-size: 13px;
    line-height: 1;
    font-weight: 800;
}

.admin-heading h1 {
    display: flex;
    align-items: center;
    gap: 10px;

    margin: 0;

    color: #111;

    font-size: 38px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.5px;
}


/* =====================================================
   GRILLE
===================================================== */

.settings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 18px;

    width: 100%;
}


/* =====================================================
   CARTES
===================================================== */

.setting-card {
    box-sizing: border-box;

    display: flex;
    align-items: flex-start;

    gap: 16px;

    min-width: 0;
    min-height: 155px;

    padding: 24px 20px;

    background: #fff;

    border-radius: 24px;

    box-shadow:
        0 12px 35px rgba(0, 0, 0, .04);
}


.setting-icon {
    display: flex;
    justify-content: center;
    align-items: center;

    flex: 0 0 52px;

    width: 52px;
    height: 52px;

    background: #fff0df;

    border-radius: 16px;

    font-size: 24px;
}


.setting-content {
    flex: 1;
    min-width: 0;
}


.setting-content h2 {
    margin: 8px 0 18px;

    color: #111;

    font-size: 20px;
    line-height: 1.2;
    font-weight: 800;
}


.setting-content p {
    margin: 0 0 18px;

    color: #777;

    font-size: 16px;
    line-height: 1.4;
}


.setting-config-btn {
    border: none;

    padding: 11px 17px;

    background: #fff;
    color: #111;

    border-radius: 999px;

    font-family: inherit;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;

    box-shadow:
        0 7px 25px rgba(0, 0, 0, .07);

    transition:
        background .15s ease,
        transform .15s ease;
}


.setting-config-btn:hover {
    background: #fff7ef;
}


.setting-config-btn:active {
    transform: scale(.97);
}


/* =====================================================
   OVERLAY MODAL
===================================================== */

.settings-modal-overlay {
    position: fixed;
    inset: 0;

    z-index: 9999;

    display: none;
    justify-content: center;
    align-items: center;

    box-sizing: border-box;

    padding: 20px;

    background: rgba(0, 0, 0, .52);
}


.settings-modal-overlay.show {
    display: flex;
}


/* =====================================================
   MODAL
   IMPORTANT :
   on passe de 1500px à 900px
===================================================== */

.settings-modal {
    box-sizing: border-box;

    width: min(900px, 92vw);
    max-height: 88vh;

    overflow-y: auto;

    padding: 28px 32px 30px;

    background: #fff;

    border-radius: 28px;

    box-shadow:
        0 25px 65px rgba(0, 0, 0, .25);
}


/*
   Les petites modales comme Paiements
   sont encore plus compactes
*/

.settings-modal-small {
    width: min(760px, 92vw);
}


/* =====================================================
   HEADER MODAL
===================================================== */

.settings-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
}


.settings-modal-header h2 {
    margin: 0;

    color: #111;

    font-size: 28px;
    line-height: 1.2;
    font-weight: 800;
}


.settings-close {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 46px;

    width: 46px;
    height: 46px;

    padding: 0;

    border: none;
    border-radius: 50%;

    background: #f1f1f1;
    color: #111;

    font-family: inherit;

    font-size: 21px;
    line-height: 1;

    cursor: pointer;

    transition:
        background .15s ease,
        transform .15s ease;
}


.settings-close:hover {
    background: #e7e7e7;
}


.settings-close:active {
    transform: scale(.94);
}


/* =====================================================
   CHAMPS
===================================================== */

.settings-field {
    margin-bottom: 18px;
}


.settings-field label {
    display: block;

    margin-bottom: 6px;

    color: #111;

    font-size: 15px;
    line-height: 1.2;
    font-weight: 800;
}


.settings-field input,
.settings-field select,
.settings-field textarea {
    box-sizing: border-box;

    width: 100%;

    border: 1px solid #dedede;

    border-radius: 14px;

    background: #fff;
    color: #111;

    outline: none;

    font-family: inherit;

    font-size: 16px;
    font-weight: 600;

    transition:
        border-color .15s ease,
        box-shadow .15s ease;
}


.settings-field input,
.settings-field select {
    height: 52px;

    padding: 0 16px;
}


.settings-field textarea {
    min-height: 95px;

    padding: 14px 16px;

    line-height: 1.5;

    resize: vertical;
}


.settings-field input:focus,
.settings-field select:focus,
.settings-field textarea:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255, 121, 0, .08);
}


/* =====================================================
   DEUX COLONNES
===================================================== */

.settings-row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 16px;
}


/* =====================================================
   CHECKBOX ROW
===================================================== */

.settings-check-row {
    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 58px;

    margin-bottom: 12px;

    padding: 13px 18px;

    border-radius: 16px;

    background: #faf7f3;

    cursor: pointer;

    transition:
        background .15s ease,
        transform .15s ease;
}


.settings-check-row:hover {
    background: #fff4e9;
}


.settings-check-row strong {
    color: #111;

    font-size: 16px;
    font-weight: 800;
}


.settings-check-row input[type="checkbox"] {
    flex: 0 0 auto;

    width: 20px;
    height: 20px;

    margin: 0;

    accent-color: #147bf3;

    cursor: pointer;
}


/* =====================================================
   BOUTON ENREGISTRER
===================================================== */

.settings-save-btn {
    width: 100%;
    height: 54px;

    margin-top: 4px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-family: inherit;

    font-size: 17px;
    font-weight: 800;

    cursor: pointer;

    transition:
        background .15s ease,
        transform .15s ease;
}


.settings-save-btn:hover {
    background: #e96f00;
}


.settings-save-btn:active {
    transform: scale(.99);
}


/* =====================================================
   TABLETTE
===================================================== */

@media (max-width: 1100px) {

    .settings-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 750px) {

    .settings-page {
        padding: 10px 12px 18px;
    }


    .admin-heading {
        padding: 0 12px;
        margin-bottom: 18px;
    }


    .admin-badge {
        padding: 6px 11px;

        margin-bottom: 9px;

        font-size: 11px;
    }


    .admin-heading h1 {
        gap: 8px;

        font-size: 27px;
    }


    .settings-grid {
        grid-template-columns: 1fr;

        gap: 13px;
    }


    .setting-card {
        min-height: auto;

        padding: 18px 16px;

        border-radius: 20px;
    }


    .setting-icon {
        flex-basis: 46px;

        width: 46px;
        height: 46px;

        border-radius: 14px;

        font-size: 21px;
    }


    .setting-content h2 {
        margin: 5px 0 10px;

        font-size: 18px;
    }


    .setting-content p {
        margin-bottom: 13px;

        font-size: 14px;
    }


    .setting-config-btn {
        padding: 9px 14px;

        font-size: 14px;
    }


    /* MODAL */

    .settings-modal-overlay {
        padding: 12px;
    }


    .settings-modal,
    .settings-modal-small {
        width: 100%;
        max-height: 92vh;

        padding: 22px 18px;

        border-radius: 22px;
    }


    .settings-modal-header {
        gap: 12px;

        margin-bottom: 20px;
    }


    .settings-modal-header h2 {
        font-size: 21px;
    }


    .settings-close {
        flex-basis: 40px;

        width: 40px;
        height: 40px;

        font-size: 18px;
    }


    .settings-row {
        grid-template-columns: 1fr;

        gap: 0;
    }


    .settings-field {
        margin-bottom: 15px;
    }


    .settings-field label {
        font-size: 14px;
    }


    .settings-field input,
    .settings-field select {
        height: 48px;

        font-size: 15px;
    }


    .settings-field textarea {
        min-height: 85px;

        font-size: 15px;
    }


    .settings-check-row {
        min-height: 52px;

        padding: 11px 14px;

        border-radius: 14px;
    }


    .settings-check-row strong {
        font-size: 15px;
    }


    .settings-check-row input[type="checkbox"] {
        width: 19px;
        height: 19px;
    }


    .settings-save-btn {
        height: 50px;

        font-size: 16px;
    }

}


/* =====================================================
   PETIT MOBILE
===================================================== */

@media (max-width: 450px) {

    .admin-heading h1 {
        font-size: 24px;
    }


    .setting-card {
        gap: 12px;

        padding: 16px 14px;
    }


    .settings-modal-overlay {
        padding: 8px;
    }


    .settings-modal,
    .settings-modal-small {
        padding: 18px 14px;

        border-radius: 19px;
    }


    .settings-modal-header h2 {
        font-size: 18px;
    }

}
</style>

<script>

function openSettingModal(modalId) {

    const modal = document.getElementById(modalId);

    if (!modal) {
        return;
    }

    modal.classList.add("show");

    document.body.style.overflow = "hidden";
}


function closeSettingModal(modalId) {

    const modal = document.getElementById(modalId);

    if (!modal) {
        return;
    }

    modal.classList.remove("show");

    document.body.style.overflow = "";
}


/*
 * Fermeture lorsqu'on clique
 * sur le fond gris.
 */

document
    .querySelectorAll(".settings-modal-overlay")
    .forEach(function(modal) {

        modal.addEventListener("click", function(event) {

            if (event.target === modal) {

                modal.classList.remove("show");

                document.body.style.overflow = "";

            }

        });

    });


/*
 * Fermeture avec ESC
 */

document.addEventListener("keydown", function(event) {

    if (event.key !== "Escape") {
        return;
    }

    document
        .querySelectorAll(".settings-modal-overlay.show")
        .forEach(function(modal) {

            modal.classList.remove("show");

        });

    document.body.style.overflow = "";

});

</script>
