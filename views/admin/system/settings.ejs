<section class="admin-heading">
  <div>
    <span class="admin-badge">Administration</span>
    <h1>⚙️ Paramètres système</h1>
  </div>
</section>

<section class="settings-page">

    <div class="settings-grid">

        <!-- RESTAURANT -->
        <article class="setting-card">
            <div class="setting-icon">🏪</div>

            <div class="setting-content">
                <h2>Restaurant</h2>
                <p>Nom, pays, horaires.</p>

                <button
                    type="button"
                    class="setting-config-btn"
                    onclick="openSettingModal('restaurantModal')">
                    Configurer
                </button>
            </div>
        </article>


        <!-- PAIEMENTS -->
        <article class="setting-card">
            <div class="setting-icon">💳</div>

            <div class="setting-content">
                <h2>Paiements</h2>
                <p>Carte, Mobile Money, espèces.</p>

                <button
                    type="button"
                    class="setting-config-btn"
                    onclick="openSettingModal('paymentsModal')">
                    Configurer
                </button>
            </div>
        </article>


        <!-- LIVRAISON -->
        <article class="setting-card">
            <div class="setting-icon">🛵</div>

            <div class="setting-content">
                <h2>Livraison</h2>
                <p>Frais, seuil gratuit, GPS.</p>

                <button
                    type="button"
                    class="setting-config-btn"
                    onclick="openSettingModal('deliveryModal')">
                    Configurer
                </button>
            </div>
        </article>


        <!-- NOTIFICATIONS -->
        <article class="setting-card">
            <div class="setting-icon">🔔</div>

            <div class="setting-content">
                <h2>Notifications</h2>
                <p>Email, push, SMS.</p>

                <button
                    type="button"
                    class="setting-config-btn"
                    onclick="openSettingModal('notificationsModal')">
                    Configurer
                </button>
            </div>
        </article>


        <!-- LANGUE -->
        <article class="setting-card">
            <div class="setting-icon">🌍</div>

            <div class="setting-content">
                <h2>Langue & devise</h2>
                <p>Français · FCFA</p>

                <button
                    type="button"
                    class="setting-config-btn"
                    onclick="openSettingModal('localeModal')">
                    Configurer
                </button>
            </div>
        </article>


        <!-- FACTURATION -->
        <article class="setting-card">
            <div class="setting-icon">🧾</div>

            <div class="setting-content">
                <h2>Facturation</h2>
                <p>Préfixe TIOP, mentions du reçu.</p>

                <button
                    type="button"
                    class="setting-config-btn"
                    onclick="openSettingModal('invoiceModal')">
                    Configurer
                </button>
            </div>
        </article>

    </div>

</section>


<!-- =========================================================
     1. MODAL RESTAURANT
========================================================= -->

<div class="settings-modal-overlay" id="restaurantModal">

    <div class="settings-modal">

        <div class="settings-modal-header">
            <h2>⚙️ Configurer — restaurant</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('restaurantModal')">
                ×
            </button>
        </div>

        <form method="POST" action="/admin/parametres/restaurant">

            <div class="settings-field">
                <label>Nom</label>

                <input
                    type="text"
                    name="restaurant_name"
                    value="TiopTiop"
                    required>
            </div>


            <div class="settings-field">
                <label>Pays</label>

                <input
                    type="text"
                    name="country"
                    value="Congo-Brazzaville"
                    required>
            </div>


            <div class="settings-row">

                <div class="settings-field">
                    <label>Ouverture</label>

                    <input
                        type="time"
                        name="opening_time"
                        value="06:00">
                </div>

                <div class="settings-field">
                    <label>Fermeture</label>

                    <input
                        type="time"
                        name="closing_time"
                        value="23:00">
                </div>

            </div>

            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>



<!-- =========================================================
     2. MODAL PAIEMENTS
========================================================= -->

<div class="settings-modal-overlay" id="paymentsModal">

    <div class="settings-modal settings-modal-small">

        <div class="settings-modal-header">

            <h2>⚙️ Configurer — payments</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('paymentsModal')">
                ×
            </button>

        </div>


        <form method="POST" action="/admin/parametres/paiements">

            <label class="settings-check-row">

                <strong>Espèces</strong>

                <input
                    type="checkbox"
                    name="cash"
                    value="1"
                    checked>

            </label>


            <label class="settings-check-row">

                <strong>Mobile Money</strong>

                <input
                    type="checkbox"
                    name="mobile_money"
                    value="1"
                    checked>

            </label>


            <label class="settings-check-row">

                <strong>Carte</strong>

                <input
                    type="checkbox"
                    name="card"
                    value="1"
                    checked>

            </label>


            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>



<!-- =========================================================
     3. MODAL LIVRAISON
========================================================= -->

<div class="settings-modal-overlay" id="deliveryModal">

    <div class="settings-modal">

        <div class="settings-modal-header">

            <h2>⚙️ Configurer — delivery</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('deliveryModal')">
                ×
            </button>

        </div>


        <form method="POST" action="/admin/parametres/livraison">


            <div class="settings-field">

                <label>Frais de livraison</label>

                <input
                    type="number"
                    name="delivery_fee"
                    value="1500"
                    min="0">

            </div>


            <div class="settings-field">

                <label>Livraison offerte dès</label>

                <input
                    type="number"
                    name="free_delivery_from"
                    value="20000"
                    min="0">

            </div>


            <label class="settings-check-row">

                <strong>Suivi GPS</strong>

                <input
                    type="checkbox"
                    name="gps_tracking"
                    value="1"
                    checked>

            </label>


            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>



<!-- =========================================================
     4. MODAL NOTIFICATIONS
========================================================= -->

<div class="settings-modal-overlay" id="notificationsModal">

    <div class="settings-modal settings-modal-small">

        <div class="settings-modal-header">

            <h2>⚙️ Configurer — notifications</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('notificationsModal')">
                ×
            </button>

        </div>


        <form method="POST" action="/admin/parametres/notifications">


            <label class="settings-check-row">

                <strong>Email</strong>

                <input
                    type="checkbox"
                    name="email_notifications"
                    value="1"
                    checked>

            </label>


            <label class="settings-check-row">

                <strong>Push</strong>

                <input
                    type="checkbox"
                    name="push_notifications"
                    value="1"
                    checked>

            </label>


            <label class="settings-check-row">

                <strong>SMS</strong>

                <input
                    type="checkbox"
                    name="sms_notifications"
                    value="1">

            </label>


            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>



<!-- =========================================================
     5. MODAL LANGUE / DEVISE
========================================================= -->

<div class="settings-modal-overlay" id="localeModal">

    <div class="settings-modal">

        <div class="settings-modal-header">

            <h2>⚙️ Configurer — locale</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('localeModal')">
                ×
            </button>

        </div>


        <form method="POST" action="/admin/parametres/locale">


            <div class="settings-field">

                <label>Langue</label>

                <select name="language">

                    <option value="fr" selected>
                        Français
                    </option>

                    <option value="en">
                        English
                    </option>

                    <option value="ln">
                        Lingala
                    </option>

                </select>

            </div>


            <div class="settings-field">

                <label>Devise</label>

                <select name="currency">

                    <option value="XAF" selected>
                        FCFA
                    </option>

                    <option value="EUR">
                        Euro (€)
                    </option>

                    <option value="USD">
                        Dollar ($)
                    </option>

                </select>

            </div>


            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>



<!-- =========================================================
     6. MODAL FACTURATION
========================================================= -->

<div class="settings-modal-overlay" id="invoiceModal">

    <div class="settings-modal">

        <div class="settings-modal-header">

            <h2>⚙️ Configurer — invoice</h2>

            <button
                type="button"
                class="settings-close"
                onclick="closeSettingModal('invoiceModal')">
                ×
            </button>

        </div>


        <form method="POST" action="/admin/parametres/facturation">


            <div class="settings-field">

                <label>Préfixe facture</label>

                <input
                    type="text"
                    name="invoice_prefix"
                    value="TIOP">

            </div>


            <div class="settings-field">

                <label>Pied de facture</label>

                <textarea
                    name="invoice_footer"
                    rows="4">Merci et bon appétit !</textarea>

            </div>


            <button type="submit" class="settings-save-btn">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>

<style>
  /* =====================================================
   PARAMETRES SYSTEME
===================================================== */

.settings-page {
    padding: 20px;
}

.settings-heading {
    margin-bottom: 28px;
}

.settings-heading h1 {
    margin: 12px 0 0;
    font-size: 38px;
    font-weight: 800;
}

.admin-badge {
    display: inline-flex;
    align-items: center;
    background: #fff0df;
    color: #ff7900;
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 800;
}


/* =====================================================
   CARTES
===================================================== */

.settings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.setting-card {
    display: flex;
    gap: 18px;

    min-height: 155px;

    padding: 25px 20px;

    background: #fff;
    border-radius: 24px;

    box-shadow: 0 12px 35px rgba(0,0,0,.04);
}

.setting-icon {
    display: flex;
    justify-content: center;
    align-items: center;

    flex: 0 0 52px;

    width: 52px;
    height: 52px;

    background: #fff0df;
    border-radius: 16px;

    font-size: 25px;
}

.setting-content {
    flex: 1;
}

.setting-content h2 {
    margin: 8px 0 20px;
    font-size: 20px;
}

.setting-content p {
    margin: 0 0 20px;
    color: #777;
    font-size: 16px;
}

.setting-config-btn {
    border: none;
    background: white;

    padding: 12px 18px;

    border-radius: 999px;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;

    box-shadow: 0 7px 25px rgba(0,0,0,.07);
}

.setting-config-btn:hover {
    background: #fff7ef;
}


/* =====================================================
   MODAL
===================================================== */

.settings-modal-overlay {
    position: fixed;
    inset: 0;

    z-index: 9999;

    display: none;
    justify-content: center;
    align-items: center;

    padding: 25px;

    background: rgba(0,0,0,.52);
}

.settings-modal-overlay.show {
    display: flex;
}

.settings-modal {
    box-sizing: border-box;

    width: min(1500px, 96vw);
    max-height: 94vh;

    overflow-y: auto;

    padding: 42px;

    background: #fff;

    border-radius: 42px;

    box-shadow:
        0 35px 80px
        rgba(0,0,0,.30);
}

.settings-modal-small {
    width: min(1500px, 96vw);
}


/* =====================================================
   HEADER MODAL
===================================================== */

.settings-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 35px;
}

.settings-modal-header h2 {
    margin: 0;

    font-size: 44px;
    font-weight: 800;
}

.settings-close {
    flex: 0 0 72px;

    width: 72px;
    height: 72px;

    border: none;
    border-radius: 50%;

    background: #f1f1f1;

    font-size: 27px;

    cursor: pointer;
}

.settings-close:hover {
    background: #e8e8e8;
}


/* =====================================================
   CHAMPS
===================================================== */

.settings-field {
    margin-bottom: 25px;
}

.settings-field label {
    display: block;

    margin-bottom: 5px;

    font-size: 25px;
    font-weight: 800;
}

.settings-field input,
.settings-field select,
.settings-field textarea {
    box-sizing: border-box;

    width: 100%;

    border: 2px solid #e4e4e4;

    border-radius: 24px;

    background: white;

    outline: none;

    font-family: inherit;
    font-size: 25px;
    font-weight: 700;
}

.settings-field input,
.settings-field select {
    height: 82px;

    padding: 0 24px;
}

.settings-field textarea {
    min-height: 115px;

    padding: 25px;

    resize: vertical;
}

.settings-field input:focus,
.settings-field select:focus,
.settings-field textarea:focus {
    border-color: #ff7900;
}


/* =====================================================
   DEUX COLONNES
===================================================== */

.settings-row {
    display: grid;

    grid-template-columns: 2fr 1fr;

    gap: 30px;
}


/* =====================================================
   CHECKBOX ROW
===================================================== */

.settings-check-row {
    box-sizing: border-box;

    display: flex;

    align-items: center;
    justify-content: space-between;

    min-height: 85px;

    margin-bottom: 20px;

    padding: 20px 25px;

    border-radius: 26px;

    background: #faf7f3;

    cursor: pointer;
}

.settings-check-row strong {
    font-size: 25px;
}

.settings-check-row input[type="checkbox"] {
    width: 26px;
    height: 26px;

    accent-color: #147bf3;

    cursor: pointer;
}


/* =====================================================
   ENREGISTRER
===================================================== */

.settings-save-btn {
    width: 100%;
    height: 87px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: white;

    font-size: 28px;
    font-weight: 800;

    cursor: pointer;

    transition: background .15s ease;
}

.settings-save-btn:hover {
    background: #e96f00;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 1100px) {

    .settings-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 750px) {

    .settings-page {
        padding: 12px;
    }

    .settings-grid {
        grid-template-columns: 1fr;
    }

    .settings-heading h1 {
        font-size: 30px;
    }

    .settings-modal {
        width: 96vw;
        padding: 25px;
        border-radius: 28px;
    }

    .settings-modal-header {
        margin-bottom: 25px;
    }

    .settings-modal-header h2 {
        font-size: 27px;
    }

    .settings-close {
        width: 48px;
        height: 48px;
        flex-basis: 48px;

        font-size: 20px;
    }

    .settings-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .settings-field label,
    .settings-check-row strong {
        font-size: 18px;
    }

    .settings-field input,
    .settings-field select {
        height: 60px;
        font-size: 17px;
    }

    .settings-field textarea {
        font-size: 17px;
    }

    .settings-save-btn {
        height: 60px;
        font-size: 18px;
    }

}


@media (max-width: 450px) {

    .setting-card {
        padding: 18px 15px;
    }

    .setting-icon {
        width: 45px;
        height: 45px;
        flex-basis: 45px;
    }

    .settings-modal-overlay {
        padding: 10px;
    }

    .settings-modal {
        padding: 20px 15px;
    }

}
</style>

<script>

function openSettingModal(modalId) {

    const modal = document.getElementById(modalId);

    if (!modal) {
        return;
    }

    modal.classList.add("show");

    document.body.style.overflow = "hidden";
}


function closeSettingModal(modalId) {

    const modal = document.getElementById(modalId);

    if (!modal) {
        return;
    }

    modal.classList.remove("show");

    document.body.style.overflow = "";
}


/*
 * Fermeture lorsqu'on clique
 * sur le fond gris.
 */

document
    .querySelectorAll(".settings-modal-overlay")
    .forEach(function(modal) {

        modal.addEventListener("click", function(event) {

            if (event.target === modal) {

                modal.classList.remove("show");

                document.body.style.overflow = "";

            }

        });

    });


/*
 * Fermeture avec ESC
 */

document.addEventListener("keydown", function(event) {

    if (event.key !== "Escape") {
        return;
    }

    document
        .querySelectorAll(".settings-modal-overlay.show")
        .forEach(function(modal) {

            modal.classList.remove("show");

        });

    document.body.style.overflow = "";

});

</script>
