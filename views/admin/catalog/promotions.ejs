<% const fmt=d=>d?new Date(d).toLocaleDateString('fr-FR'):'—'; const dt=d=>d?new Date(d).toISOString().slice(0,16):''; const types={PERCENT:'Pourcentage',FIXED:'Prix fixe',FREE_DELIVERY:'Livraison',POINTS_MULTIPLIER:'Bonus points'}; const audiences={ALL:'Tous',TIOP_PLUS:'Tiop+',NEW_CUSTOMERS:'Nouveaux clients',SELECTED:'Sélection'}; %>
<section class="pa">
<div class="pa-head"><div><span class="pa-badge">Administration　›　Promotions</span><h1>🎁 Promotions</h1><p>Créez et gérez vos promotions et bons plans. Elles sont visibles sur le site et dans l’application.</p></div><button class="orange" onclick="openPromo()">+ Nouvelle promotion</button></div>
<div class="pa-stats"><div><b><%=stats.total||0%></b><span>Total</span></div><div><b class="green"><%=stats.active||0%></b><span>Actives</span></div><div><b class="amber"><%=stats.upcoming||0%></b><span>Programmées</span></div><div><b class="red"><%=stats.expired||0%></b><span>Expirées</span></div></div>
<form class="pa-filter" method="get"><input name="q" value="<%=filters.q%>" placeholder="⌕  Rechercher (nom, code...)"><select name="type"><option value="">Type — Tous</option><%Object.entries(types).forEach(([v,l])=>{%><option value="<%=v%>" <%=filters.type===v?'selected':''%>><%=l%></option><%})%></select><select name="status"><option value="">Statut — Tous</option><option value="ACTIVE" <%=filters.status==='ACTIVE'?'selected':''%>>Actif</option><option value="UPCOMING" <%=filters.status==='UPCOMING'?'selected':''%>>À venir</option><option value="EXPIRED" <%=filters.status==='EXPIRED'?'selected':''%>>Expiré</option></select><select name="category"><option value="">Catégorie — Toutes</option><%categories.forEach(c=>{%><option value="<%=c.id%>" <%=String(filters.category)===String(c.id)?'selected':''%>><%=c.name%></option><%})%></select><select name="audience"><option value="">Audience — Toutes</option><%Object.entries(audiences).forEach(([v,l])=>{%><option value="<%=v%>" <%=filters.audience===v?'selected':''%>><%=l%></option><%})%></select><button class="orange">Filtrer</button><a href="/admin/promotions">Réinitialiser</a></form>
<div class="pa-table"><table><thead><tr><th>Image</th><th>Nom</th><th>Code</th><th>Type</th><th>Catégorie</th><th>Période</th><th>Statut</th><th>Actions</th></tr></thead><tbody>
<%promotions.forEach(p=>{%><tr><td><img src="<%=p.image_url||'/assets/img/logo.svg'%>"></td><td><strong><%=p.name%></strong></td><td><%=p.code||'—'%></td><td><%=types[p.discount_type]||p.discount_type%></td><td><%=p.category_names||'Toutes'%></td><td><%=fmt(p.starts_at)%> → <%=fmt(p.ends_at)%></td><td><span class="st <%=String(p.computed_status).toLowerCase()%>"><%=p.computed_status==='ACTIVE'?'Actif':p.computed_status==='UPCOMING'?'À venir':p.computed_status==='EXPIRED'?'Expiré':'Inactif'%></span></td><td><button class="edit" onclick='openPromo(<%-JSON.stringify({...p,starts_at:dt(p.starts_at),ends_at:dt(p.ends_at)})%>)'>Modifier</button><form method="post" action="/admin/promotions/<%=p.id%>/supprimer" class="inline" onsubmit="return confirm('Supprimer cette promotion ?')"><button class="del">Supprimer</button></form></td></tr><%})%>
<%if(!promotions.length){%><tr><td colspan="8" class="empty">Aucune promotion trouvée.</td></tr><%}%></tbody></table></div>
</section>
<div class="pmask" id="promoModal"><div class="pmodal"><button class="x" type="button" onclick="closePromo()">×</button><h2 id="pmTitle">🎁 Nouvelle promotion</h2><form id="promoForm" method="post" enctype="multipart/form-data"><div class="formgrid"><label class="upload"><span>Image de la promotion</span><div id="imagePreview">🖼️<small>Cliquer pour ajouter une image<br>(JPG, PNG, WEBP)</small></div><input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif"></label><div class="fields"><label>Nom de la promotion *<input name="name" required placeholder="Ex : -20% Poulet Braisé"></label><label>Code promo (optionnel)<input name="code" placeholder="Ex : BRAISE20"></label><label>Type *<select name="discount_type"><%Object.entries(types).forEach(([v,l])=>{%><option value="<%=v%>"><%=l%></option><%})%></select></label><label>Valeur *<input type="number" step="0.01" min="0" name="discount_value" required value="0"></label><label>Catégorie<select name="category_ids"><option value="">Toutes</option><%categories.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select></label><label>Audience<select name="audience"><%Object.entries(audiences).forEach(([v,l])=>{%><option value="<%=v%>"><%=l%></option><%})%></select></label><label>Montant minimum<input type="number" step="0.01" min="0" name="minimum_order" placeholder="Ex : 20000"></label><label>Date de début *<input type="datetime-local" name="starts_at" required></label><label>Date de fin *<input type="datetime-local" name="ends_at" required></label><label class="wide">Description *<textarea name="description" required placeholder="Décrivez la promotion..."></textarea></label><label class="switch wide"><input type="checkbox" name="is_active" value="1" checked> Activer la promotion</label></div></div><div class="actions"><button type="button" onclick="closePromo()">Annuler</button><button class="orange">Enregistrer</button></div></form></div></div>
<style>
.pa{padding:22px 28px;color:#171310}.pa *{box-sizing:border-box}.pa-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.pa-head h1{font-size:34px;margin:10px 0 4px}.pa-head p{margin:0;color:#766e67}.pa-badge{background:#fff0df;color:#f17100;border-radius:20px;padding:7px 11px;font-size:11px;font-weight:900}.orange{background:#ff7900!important;color:#fff!important;border:0!important;border-radius:999px!important;padding:12px 20px!important;font-weight:900!important;cursor:pointer}.pa-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:24px 0}.pa-stats div{background:#fff;border:1px solid #eee3d9;border-radius:18px;padding:18px}.pa-stats b{font-size:28px;display:block}.pa-stats span{font-size:12px}.green{color:#16a33a}.amber{color:#efa900}.red{color:#e5182b}.pa-filter{background:#fff;border-radius:16px;padding:12px;display:grid;grid-template-columns:1.5fr repeat(4,1fr) auto auto;gap:9px;margin-bottom:16px}.pa-filter input,.pa-filter select,.fields input,.fields select,.fields textarea{width:100%;border:1px solid #ddd5cf;border-radius:10px;padding:11px;background:#fff}.pa-filter a{align-self:center;color:#777;text-decoration:none}.pa-table{overflow:auto;background:#fff;border-radius:17px;border:1px solid #eee3d9}.pa-table table{width:100%;border-collapse:collapse;min-width:950px}.pa-table th,.pa-table td{padding:12px;text-align:left;border-bottom:1px solid #eee6df;font-size:12px}.pa-table th{background:#fffaf5;color:#54483e}.pa-table img{width:52px;height:38px;object-fit:cover;border-radius:8px}.st{padding:7px 10px;border-radius:20px;font-weight:900}.st.active{background:#d9f5df;color:#08752d}.st.upcoming{background:#fff0c9;color:#8a5900}.st.expired,.st.inactive{background:#ffe0df;color:#b51e17}.edit,.del{border:0;border-radius:20px;padding:8px 12px;font-weight:800;cursor:pointer}.edit{background:#fff6ec}.del{background:#ffe2e0;color:#d42a20}.inline{display:inline}.empty{text-align:center!important;padding:40px!important}.pmask{display:none;position:fixed;inset:0;background:#0007;z-index:9999;align-items:center;justify-content:center;padding:18px}.pmask.show{display:flex}.pmodal{width:min(920px,96vw);max-height:94vh;overflow:auto;background:#fff;border-radius:24px;padding:24px;position:relative}.pmodal h2{font-size:24px;margin:0 0 20px}.x{position:absolute;right:18px;top:14px;border:0;border-radius:50%;width:38px;height:38px;font-size:24px}.formgrid{display:grid;grid-template-columns:230px 1fr;gap:20px}.upload span,.fields label{font-size:12px;font-weight:800}.upload div{height:220px;margin-top:8px;border:1px dashed #cfc6be;border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:36px;background-size:cover;background-position:center}.upload small{font-size:10px;text-align:center;margin-top:10px}.upload input{display:none}.fields{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}.fields label{display:flex;flex-direction:column;gap:6px}.fields textarea{height:90px;resize:vertical}.wide{grid-column:1/-1}.switch{flex-direction:row!important;align-items:center}.switch input{width:auto}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}.actions>button:first-child{border:0;border-radius:22px;padding:11px 20px}.modal-open{overflow:hidden}@media(max-width:900px){.pa-stats{grid-template-columns:repeat(2,1fr)}.pa-filter{grid-template-columns:1fr 1fr}.formgrid{grid-template-columns:1fr}.upload div{height:150px}}@media(max-width:600px){.pa{padding:15px}.pa-head{align-items:flex-start;flex-direction:column}.pa-stats,.pa-filter,.fields{grid-template-columns:1fr}.wide{grid-column:auto}}
</style>
<script>
const modal=document.getElementById('promoModal'),form=document.getElementById('promoForm');function closePromo(){modal.classList.remove('show');document.body.classList.remove('modal-open')}function openPromo(p=null){form.reset();form.action=p?'/admin/promotions/'+p.id:'/admin/promotions';document.getElementById('pmTitle').textContent=p?'🎁 Modifier la promotion':'🎁 Nouvelle promotion';const set=(n,v)=>{const e=form.elements[n];if(e)e.value=v??''};if(p){['name','code','discount_type','discount_value','minimum_order','audience','starts_at','ends_at','description'].forEach(n=>set(n,p[n]));form.elements.is_active.checked=!!p.is_active;if(p.category_ids?.length)set('category_ids',p.category_ids[0]);const pv=document.getElementById('imagePreview');if(p.image_url){pv.style.backgroundImage=`url('${p.image_url}')`;pv.textContent=''}}else{form.elements.is_active.checked=true;document.getElementById('imagePreview').style.backgroundImage='';document.getElementById('imagePreview').innerHTML='🖼️<small>Cliquer pour ajouter une image<br>(JPG, PNG, WEBP)</small>'}modal.classList.add('show');document.body.classList.add('modal-open')}document.querySelector('.upload input').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader;r.onload=()=>{const p=document.getElementById('imagePreview');p.style.backgroundImage=`url('${r.result}')`;p.textContent=''};r.readAsDataURL(f)});modal.addEventListener('click',e=>{if(e.target===modal)closePromo()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closePromo()});
</script>
