<section class="admin-heading">
  <div>
      <span class="admin-badge">Administration</span>
      <h1>📂 Catégories</h1>
    </div>
  <button
      type="button"
      class="btn-category-add"
      onclick="openAddCategoryModal()">
      + Ajouter une catégorie
    </button>
</section>

<section class="admin-categories-page">



  <div class="categories-table-wrapper">
    <table class="categories-table">

      <thead>
        <tr>
          <th>Libelle</th>
          <th>Statut</th>
          <th>Position</th>
          <th>Slug</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>

    <% if (!categories || categories.length === 0) { %>

        <tr>
            <td colspan="5">
                Aucune catégorie enregistrée.
            </td>
        </tr>

    <% } else { %>

        <% categories.forEach(category => { %>

            <tr>

                <td>
                    <strong><%= category.name %></strong>

                    <% if (category.description) { %>
                        <div class="category-description">
                            <%= category.description %>
                        </div>
                    <% } %>
                </td>


                <td>

                    <form
                        method="POST"
                        action="/admin/categories/<%= category.id %>/toggle">

                        <button
                            type="submit"
                            class="category-status <%= category.is_active ? 'active' : 'inactive' %>">

                            <%= category.is_active ? 'Oui' : 'Non' %>

                        </button>

                    </form>

                </td>


                <td>
                    <%= category.position %>
                </td>


                <td>
                    <%= category.slug %>
                </td>


                <td>

                    <div class="category-actions">

                        <button
                            type="button"
                            class="btn-category-edit"
                            data-id="<%= category.id %>"
                            data-name="<%= category.name %>"
                            data-description="<%= category.description || '' %>"
                            data-position="<%= category.position %>"
                            onclick="openEditCategoryModalFromButton(this)">
                            Modifier
                        </button>


                        <button
                            type="button"
                            class="btn-category-delete"
                            onclick='deleteCategory(
                                <%- JSON.stringify(category.id) %>,
                                <%- JSON.stringify(category.name) %>
                            )'>
                            Supprimer
                        </button>

                    </div>

                </td>

            </tr>

        <% }) %>

    <% } %>

</tbody>
    </table>
  </div>

</section>


<!-- ======================================================
     MODAL AJOUTER
====================================================== -->

<div id="addCategoryModal" class="category-modal-overlay">

  <div class="category-modal">

    <div class="category-modal-header">
      <h2>Ajouter</h2>

      <button
        type="button"
        class="category-modal-close"
        onclick="closeAddCategoryModal()">
        ×
      </button>
    </div>

    <form
      method="POST"
      action="/admin/categories">

      <input
        type="text"
        name="name"
        class="category-field"
        placeholder="Nom / titre"
        required>

      <input
        type="text"
        name="description"
        class="category-field"
        placeholder="Information complémentaire">

      <input
        type="number"
        name="position"
        class="category-field"
        value="0"
        min="0"
        placeholder="Ordre">

      <button
        type="submit"
        class="btn-category-save">
        Enregistrer
      </button>

    </form>

  </div>
</div>


<!-- ======================================================
     MODAL MODIFIER
====================================================== -->

<div id="editCategoryModal" class="category-modal-overlay">

  <div class="category-modal">

    <div class="category-modal-header">
      <h2>Modifier</h2>

      <button
        type="button"
        class="category-modal-close"
        onclick="closeEditCategoryModal()">
        ×
      </button>
    </div>

    <form
      id="editCategoryForm"
      method="POST">

      <input
        type="text"
        id="editCategoryName"
        name="name"
        class="category-field"
        required>

      <input
        type="text"
        id="editCategoryDescription"
        name="description"
        class="category-field"
        placeholder="Information complémentaire">

      <input
        type="number"
        id="editCategoryPosition"
        name="position"
        class="category-field"
        min="0"
        value="0">

      <button
        type="submit"
        class="btn-category-save">
        Enregistrer
      </button>

    </form>

  </div>
</div>


<!-- Formulaire invisible suppression -->
<form
  id="deleteCategoryForm"
  method="POST"
  style="display:none;">
</form>

<style>
  /* =====================================================
   CATEGORIES
===================================================== */

.admin-categories-page {
    padding: 12px;
}

.categories-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    gap: 20px;

    margin-bottom: 22px;
}

.categories-header h1 {
    margin: 8px 0 0;

    font-size: 32px;
    line-height: 1;

    color: #171310;
}

.admin-badge {
    display: inline-flex;

    padding: 5px 10px;

    border-radius: 999px;

    background: #fff0df;
    color: #ff7900;

    font-size: 12px;
    font-weight: 800;
}


/* AJOUTER */

.btn-category-add {
    border: 0;

    padding: 12px 18px;

    border-radius: 999px;

    background: #ff7900;
    color: white;

    font-weight: 800;

    cursor: pointer;
}

.btn-category-add:hover {
    background: #e86e00;
}


/* =====================================================
   TABLEAU
===================================================== */

.categories-table-wrapper {
    overflow-x: auto;

    background: white;

    border-radius: 16px;
}

.categories-table {
    width: 100%;

    border-collapse: collapse;

    font-size: 14px;
}

.categories-table th {
    padding: 15px;

    text-align: left;

    background: #faf8f5;

    color: #171310;

    font-weight: 800;

    border-bottom: 1px solid #ddd;
}

.categories-table td {
    padding: 16px 15px;

    border-bottom: 1px solid #ddd;

    vertical-align: middle;
}

.categories-table tbody tr:last-child td {
    border-bottom: 0;
}


/* ACTIONS */

.category-actions {
    display: flex;

    align-items: center;

    gap: 8px;
}

.btn-category-edit,
.btn-category-delete {
    border: 0;

    padding: 9px 14px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 800;

    cursor: pointer;
}

.btn-category-edit {
    background: white;
    color: #171310;

    box-shadow: 0 4px 18px rgba(0,0,0,.05);
}

.btn-category-delete {
    background: #ffe4df;
    color: #c73927;
}


/* =====================================================
   MODAL
===================================================== */

.category-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,.52);
}

.category-modal-overlay.show {
    display: flex;
}

body.modal-open {
    overflow: hidden;
}

.category-modal {
    width: 100%;
    max-width: 760px;

    padding: 22px;

    background: #fff;

    border-radius: 24px;

    box-shadow:
        0 25px 80px rgba(0,0,0,.25);
}

.category-modal-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 20px;
}

.category-modal-header h2 {
    margin: 0;

    color: #171310;

    font-size: 26px;
    font-weight: 800;
}

.category-modal-close {
    width: 38px;
    height: 38px;

    display: flex;

    align-items: center;
    justify-content: center;

    border: 0;

    border-radius: 50%;

    background: #f2f2f2;
    color: #171310;

    font-size: 18px;

    cursor: pointer;
}


/* FORM */

.category-modal form {
    display: flex;

    flex-direction: column;

    gap: 10px;
}

.category-field {
    width: 100%;

    min-height: 46px;

    padding: 12px;

    box-sizing: border-box;

    border: 1px solid #ddd;

    border-radius: 12px;

    background: #fff;

    color: #171310;

    font-size: 15px;

    outline: none;
}

.category-field:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255,121,0,.08);
}


/* ENREGISTRER */

.btn-category-save {
    width: 100%;

    min-height: 45px;

    border: 0;

    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;
}

.btn-category-save:hover {
    background: #e86e00;
}


/* RESPONSIVE */

@media (max-width: 700px) {

    .categories-header {
        flex-direction: column;
    }

    .btn-category-add {
        width: 100%;
    }

    .categories-table {
        min-width: 750px;
    }

    .category-modal {
        max-width: 100%;
    }
}

.category-status {
    border: 0;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
}

.category-status.active {
    background: #e5f8ea;
    color: #238636;
}

.category-status.inactive {
    background: #f1f1f1;
    color: #777;
}

.category-description {
    margin-top: 4px;
    font-size: 12px;
    color: #777;
}

</style>
<script src="/js/categories.js" defer></script>
