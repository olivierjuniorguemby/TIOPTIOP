<section class="admin-heading">
  <div><span class="admin-badge">Administration</span><h1>⭐ Tiop+</h1><p class="muted">Catalogue des récompenses visible automatiquement côté client.</p></div>
  <button type="button" class="btn-tiop-add" onclick="openReward()">+ Nouvelle récompense</button>
</section>

<% if (saved) { %><div class="tp-alert ok">✅ Récompense enregistrée.</div><% } %>
<% if (deleted) { %><div class="tp-alert">🗑️ Récompense supprimée.</div><% } %>

<section class="admin-tiopplus-page">
  <div class="tiopplus-table-wrapper">
    <table class="tiopplus-table">
      <thead><tr><th>Récompense</th><th>Type</th><th>Points</th><th>Valeur</th><th>Actif</th><th>Actions</th></tr></thead>
      <tbody>
      <% if (!rewards || !rewards.length) { %>
        <tr><td colspan="6" class="empty">Aucune récompense. Créez la première récompense Tiop+.</td></tr>
      <% } %>
      <% (rewards || []).forEach(function(r){ %>
        <tr>
          <td><div class="reward-name"><div class="thumb"><% if(r.image_url){ %><img src="<%= r.image_url %>" alt=""><% } else { %>🎁<% } %></div><div><strong><%= r.name %></strong><small><%= r.description || '—' %></small></div></div></td>
          <td><span class="pill"><%= r.reward_type %></span></td>
          <td><strong><%= Number(r.points_cost).toLocaleString('fr-FR') %></strong> pts</td>
          <td><%= r.reward_value == null ? '—' : Number(r.reward_value).toLocaleString('fr-FR') %></td>
          <td><span class="status <%= r.is_active ? 'on':'off' %>"><%= r.is_active ? 'Oui':'Non' %></span></td>
          <td><div class="reward-actions">
            <button type="button" class="btn-reward-edit" onclick='openReward(<%- JSON.stringify(r) %>)'>Modifier</button>
            <form action="/admin/tiopplus/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Supprimer cette récompense ?')"><button class="btn-reward-delete">Supprimer</button></form>
          </div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</section>

<div id="rewardModal" class="reward-modal-overlay">
  <div class="reward-modal">
    <div class="reward-modal-header"><h2 id="rewardTitle">➕ Nouvelle récompense</h2><button type="button" class="reward-modal-close" onclick="closeReward()">×</button></div>
    <form id="rewardForm" action="/admin/tiopplus" method="POST" enctype="multipart/form-data">
      <label>Nom</label><input id="rwName" type="text" name="name" class="reward-field" required>
      <label>Description</label><textarea id="rwDescription" name="description" class="reward-field" rows="3" placeholder="Ex. Une livraison offerte sur votre prochaine commande"></textarea>
      <div class="grid2">
        <div><label>Coût en points</label><input id="rwPoints" type="number" name="points_cost" class="reward-field" min="1" required></div>
        <div><label>Type</label><select id="rwType" name="reward_type" class="reward-field"><option value="PRODUCT">Produit offert</option><option value="DISCOUNT">Réduction</option><option value="FREE_DELIVERY">Livraison offerte</option><option value="COUPON">Coupon</option></select></div>
      </div>
      <div id="rwProductWrap" style="display:none"><label>Produit réellement offert</label><select id="rwProduct" name="reward_product_id" class="reward-field"><option value="">— Choisir le produit —</option><% (products || []).forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %> — <%= Number(p.price||0).toLocaleString('fr-FR') %> XAF</option><% }) %></select></div>
      <div class="grid2">
        <div><label id="rwValueLabel">Valeur (facultatif)</label><input id="rwValue" type="number" step="0.01" name="reward_value" class="reward-field" placeholder="Ex. 20 pour -20%"></div>
        <div><label>Statut</label><select id="rwActive" name="is_active" class="reward-field"><option value="1">Actif</option><option value="0">Inactif</option></select></div>
      </div>
      <label>Image</label><input type="file" name="image" class="reward-field" accept="image/png,image/jpeg,image/webp,image/avif">
      <div id="currentImage"></div>
      <button type="submit" class="btn-reward-save">💾 Enregistrer</button>
    </form>
  </div>
</div>

<style>
.admin-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px}.admin-heading h1{margin:7px 0 3px;font-size:30px}.muted{margin:0;color:#756d65}.admin-badge{display:inline-flex;padding:5px 10px;border-radius:999px;background:#fff0df;color:#ff7900;font-size:12px;font-weight:800}.btn-tiop-add,.btn-reward-save{border:0;border-radius:999px;background:#ff7900;color:#fff;font-weight:900;padding:12px 18px;cursor:pointer}.admin-tiopplus-page{padding:18px 0}.tiopplus-table-wrapper{background:#fff;border:1px solid #eadfd3;border-radius:18px;overflow:auto}.tiopplus-table{width:100%;border-collapse:collapse}.tiopplus-table th,.tiopplus-table td{padding:14px;border-bottom:1px solid #eee6de;text-align:left;vertical-align:middle}.tiopplus-table th{font-size:12px;text-transform:uppercase;color:#756d65}.reward-name{display:flex;align-items:center;gap:12px;min-width:300px}.reward-name small{display:block;color:#756d65;margin-top:4px}.thumb{width:56px;height:56px;border-radius:14px;background:#fff3e3;display:grid;place-items:center;overflow:hidden;font-size:24px}.thumb img{width:100%;height:100%;object-fit:cover}.pill,.status{padding:5px 9px;border-radius:999px;font-size:11px;font-weight:800;background:#f4f0ec}.status.on{background:#e3f7e9;color:#18753b}.status.off{background:#f3eded;color:#8a5555}.reward-actions{display:flex;gap:8px}.reward-actions form{margin:0}.btn-reward-edit,.btn-reward-delete{border:0;border-radius:999px;padding:8px 12px;font-weight:800;cursor:pointer}.btn-reward-edit{background:#fff4e8}.btn-reward-delete{background:#ffe9e8;color:#b62d26}.empty{text-align:center!important;color:#756d65;padding:32px!important}.tp-alert{margin-top:15px;padding:10px 14px;border-radius:12px;background:#fff4e8}.tp-alert.ok{background:#e8f8ed}.reward-modal-overlay{position:fixed;inset:0;background:rgba(20,16,13,.62);display:none;align-items:center;justify-content:center;z-index:9999;padding:20px}.reward-modal-overlay.open{display:flex}.reward-modal{width:min(620px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:20px;padding:20px}.reward-modal-header{display:flex;justify-content:space-between;align-items:center}.reward-modal-close{border:0;background:#f3f0ed;width:34px;height:34px;border-radius:50%;font-size:21px;cursor:pointer}.reward-modal label{display:block;font-weight:800;font-size:12px;margin:12px 0 6px}.reward-field{width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #ddd3ca;border-radius:10px;background:#fff}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.btn-reward-save{width:100%;margin-top:16px}.current-img{width:92px;height:70px;object-fit:cover;border-radius:12px;margin-top:10px}@media(max-width:700px){.admin-heading{align-items:flex-start;flex-direction:column}.grid2{grid-template-columns:1fr}}
</style>
<script>
function openReward(r){const m=document.getElementById('rewardModal');const f=document.getElementById('rewardForm');r=r||null;document.getElementById('rewardTitle').textContent=r?'📝 Modifier la récompense':'➕ Nouvelle récompense';f.action=r?('/admin/tiopplus/'+r.id):'/admin/tiopplus';document.getElementById('rwName').value=r?.name||'';document.getElementById('rwDescription').value=r?.description||'';document.getElementById('rwPoints').value=r?.points_cost||100;document.getElementById('rwType').value=r?.reward_type||'PRODUCT';document.getElementById('rwValue').value=r?.reward_value??'';document.getElementById('rwProduct').value=r?.reward_product_id||'';refreshRewardFields();document.getElementById('rwActive').value=r?String(Number(r.is_active)): '1';document.getElementById('currentImage').innerHTML=r?.image_url?`<img class="current-img" src="${r.image_url}" alt="">`:'';m.classList.add('open')}
function closeReward(){document.getElementById('rewardModal').classList.remove('open')}
document.getElementById('rewardModal').addEventListener('click',e=>{if(e.target.id==='rewardModal')closeReward()});

function refreshRewardFields(){const t=document.getElementById('rwType').value;document.getElementById('rwProductWrap').style.display=t==='PRODUCT'?'block':'none';const l=document.getElementById('rwValueLabel');const v=document.getElementById('rwValue');if(t==='DISCOUNT'){l.textContent='Réduction (%)';v.placeholder='Ex. 20 pour -20%';}else if(t==='COUPON'){l.textContent='Valeur du coupon (XAF)';v.placeholder='Ex. 2000';}else{l.textContent='Valeur (facultatif)';v.placeholder='';}}
document.getElementById('rwType').addEventListener('change',refreshRewardFields);refreshRewardFields();
</script>
