<section class="admin-heading">
  <div>
      <span class="admin-badge">Administration</span>
      <h1>🍛 Produits</h1>
    </div>

    <button type="button"
            class="btn-product-add"
            onclick="openAddProductModal()">
      + Ajouter un produit
    </button>
</section>

<section class="admin-products-page">



  <!-- ==========================
       TABLEAU PRODUITS
  =========================== -->
  <div class="admin-products-table-wrapper">

    <table class="admin-products-table">

      <thead>
        <tr>
          <th>Produit</th>
          <th>Catégorie</th>
          <th>Prix</th>
          <th>Images</th>
          <th>Actif</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>

        <% if (!products || products.length === 0) { %>

            <tr>
                <td colspan="6">
                    Aucun produit enregistré.
                </td>
            </tr>

        <% } else { %>

            <% products.forEach(product => { %>

                <tr>

                    <!-- PRODUIT -->
                    <td>

                        <% if (product.primary_image) { %>

                            <img
                                src="<%= product.primary_image %>"
                                alt="<%= product.name %>"
                                style="
                                    width:42px;
                                    height:42px;
                                    border-radius:10px;
                                    object-fit:cover;
                                    vertical-align:middle;
                                    margin-right:8px;
                                "
                            >

                        <% } else { %>

                            <span>
                                <%= product.icon || "🍽️" %>
                            </span>

                        <% } %>

                        <strong>
                            <%= product.name %>
                        </strong>

                    </td>


                    <!-- CATEGORIE -->
                    <td>
                        <%= product.category_name %>
                    </td>


                    <!-- PRIX -->
                    <td>

                        <%= Number(product.price).toLocaleString("fr-FR") %>
                        FCFA

                    </td>


                    <!-- IMAGES -->
                    <td>
                        <%= product.image_count %> image(s)
                    </td>


                    <!-- ACTIF -->
                    <td>

                        <form
                            method="POST"
                            action="/admin/produits/<%= product.id %>/toggle"
                        >

                            <button
                                type="submit"
                                class="category-status <%= product.is_active ? 'active' : 'inactive' %>"
                            >

                                <%= product.is_active ? "Actif" : "Inactif" %>

                            </button>

                        </form>

                    </td>


                    <!-- ACTIONS -->
                    <td>

                        <div class="product-actions">

                            <button
                              type="button"
                              class="btn-product-edit"

                              data-id="<%= product.id %>"
                              data-name="<%= product.name %>"
                              data-sku="<%= product.sku || '' %>"
                              data-icon="<%= product.icon || '' %>"

                              data-category-id="<%= product.category_id %>"

                              data-short-description="<%= product.short_description || '' %>"
                              data-description="<%= product.description || '' %>"

                              data-price="<%= product.price %>"
                              data-compare-at-price="<%= product.compare_at_price || '' %>"

                              data-preparation-minutes="<%= product.preparation_minutes %>"
                              data-spice-level="<%= product.spice_level %>"

                              data-allergens="<%= product.allergens || '' %>"
                              data-ingredients="<%= product.ingredients || '' %>"
                              data-calories="<%= product.calories || '' %>"

                              data-halal="<%= product.is_halal %>"
                              data-vegetarian="<%= product.is_vegetarian %>"

                              data-breakfast="<%= product.is_breakfast %>"
                              data-breakfast-start="<%= product.breakfast_start || '' %>"
                              data-breakfast-end="<%= product.breakfast_end || '' %>"

                              data-featured="<%= product.is_featured %>"
                              data-position="<%= product.position %>"

                              onclick="openEditProductModalFromButton(this)"
                          >
                              Modifier
                          </button>


                            <button
                                type="button"
                                class="btn-product-delete"

                                onclick='deleteProduct(
                                    <%- JSON.stringify(product.id) %>,
                                    <%- JSON.stringify(product.name) %>
                                )'
                            >
                                Supprimer
                            </button>

                        </div>

                    </td>

                </tr>

            <% }) %>

        <% } %>

        </tbody>

    </table>

  </div>
</section>


<!-- =====================================================
     MODAL : AJOUTER PRODUIT
===================================================== -->

<div id="addProductModal"
     class="product-modal-overlay">

  <div class="product-modal">

    <div class="product-modal-header">

      <h2>
        <span>➕</span>
        Ajouter un produit
      </h2>

      <button type="button"
              class="product-modal-close"
              onclick="closeAddProductModal()">
        ×
      </button>

    </div>


    <form
          method="POST"
          action="/admin/produits"
          enctype="multipart/form-data"
      >

          <!-- =========================
              IDENTITE
          ========================== -->

          <div class="product-form-section">
              <h3>Informations générales</h3>

              <div class="product-form-grid">

                  <div class="product-form-group product-form-full">
                      <label>Nom du produit *</label>

                      <input
                          class="product-modal-field"
                          type="text"
                          name="name"
                          placeholder="Ex : Poulet Braisé Tiop"
                          required
                      >
                  </div>


                  <div class="product-form-group">
                      <label>SKU</label>

                      <input
                          class="product-modal-field"
                          type="text"
                          name="sku"
                          placeholder="Ex : POULET-001"
                      >
                  </div>


                  <div class="product-form-group">
                      <label>Icône</label>

                      <input
                          class="product-modal-field"
                          type="text"
                          name="icon"
                          placeholder="🍗"
                      >
                  </div>


                  <div class="product-form-group product-form-full">
                      <label>Catégorie *</label>

                      <select
                          class="product-modal-field"
                          name="category_id"
                          required
                      >

                          <option value="">
                              Sélectionner une catégorie
                          </option>

                          <% categories.forEach(category => { %>

                              <% if (category.is_active) { %>

                                  <option value="<%= category.id %>">
                                      <%= category.icon || "" %>
                                      <%= category.name %>
                                  </option>

                              <% } %>

                          <% }) %>

                      </select>
                  </div>

              </div>
          </div>


          <!-- =========================
              DESCRIPTIONS
          ========================== -->

          <div class="product-form-section">

              <h3>Description</h3>

              <div class="product-form-group">

                  <label>Description courte</label>

                  <input
                      class="product-modal-field"
                      type="text"
                      name="short_description"
                      maxlength="300"
                      placeholder="Résumé affiché sur la carte produit"
                  >

              </div>


              <div class="product-form-group">

                  <label>Description complète</label>

                  <textarea
                      class="product-modal-field product-description"
                      name="description"
                      placeholder="Description détaillée du produit"
                  ></textarea>

              </div>

          </div>


          <!-- =========================
              TARIFICATION
          ========================== -->

          <div class="product-form-section">

              <h3>Prix</h3>

              <div class="product-form-grid">

                  <div class="product-form-group">

                      <label>Prix *</label>

                      <input
                          class="product-modal-field"
                          type="number"
                          step="0.01"
                          min="0"
                          name="price"
                          placeholder="8900"
                          required
                      >

                  </div>


                  <div class="product-form-group">

                      <label>Ancien prix / prix comparé</label>

                      <input
                          class="product-modal-field"
                          type="number"
                          step="0.01"
                          min="0"
                          name="compare_at_price"
                          placeholder="10000"
                      >

                  </div>

              </div>

              <small class="product-form-help">
                  L'ancien prix permet par exemple d'afficher :
                  <del>10 000 FCFA</del> 8 900 FCFA.
              </small>

          </div>


          <!-- =========================
              PREPARATION
          ========================== -->

          <div class="product-form-section">

              <h3>Préparation</h3>

              <div class="product-form-grid">

                  <div class="product-form-group">

                      <label>Temps de préparation</label>

                      <input
                          class="product-modal-field"
                          type="number"
                          name="preparation_minutes"
                          min="0"
                          value="15"
                      >

                  </div>


                  <div class="product-form-group">

                      <label>Niveau épicé</label>

                      <select
                          class="product-modal-field"
                          name="spice_level"
                      >
                          <option value="0">0 — Non épicé</option>
                          <option value="1">1 — Très léger</option>
                          <option value="2">2 — Léger</option>
                          <option value="3">3 — Moyen</option>
                          <option value="4">4 — Épicé</option>
                          <option value="5">5 — Très épicé</option>
                      </select>

                  </div>

              </div>

          </div>


          <!-- =========================
              COMPOSITION
          ========================== -->

          <div class="product-form-section">

              <h3>Composition & nutrition</h3>


              <div class="product-form-group">

                  <label>Ingrédients</label>

                  <textarea
                      class="product-modal-field"
                      name="ingredients"
                      placeholder="Poulet, épices, oignons, ail..."
                  ></textarea>

              </div>


              <div class="product-form-group">

                  <label>Allergènes</label>

                  <textarea
                      class="product-modal-field"
                      name="allergens"
                      placeholder="Arachides, lait, gluten..."
                  ></textarea>

              </div>


              <div class="product-form-group">

                  <label>Calories</label>

                  <input
                      class="product-modal-field"
                      type="number"
                      name="calories"
                      min="0"
                      placeholder="Ex : 650"
                  >

              </div>

          </div>


          <!-- =========================
              REGIMES
          ========================== -->

          <div class="product-form-section">

              <h3>Caractéristiques</h3>

              <div class="product-checkbox-grid">

                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_halal"
                          value="1"
                      >
                      <span>Halal</span>
                  </label>


                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_vegetarian"
                          value="1"
                      >
                      <span>Végétarien</span>
                  </label>


                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_featured"
                          value="1"
                      >
                      <span>Produit vedette</span>
                  </label>


                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_breakfast"
                          value="1"
                          onchange="toggleBreakfastFields(this, 'addBreakfastFields')"
                      >
                      <span>Petit-déjeuner</span>
                  </label>

              </div>

          </div>


          <!-- =========================
              PETIT DEJEUNER
          ========================== -->

          <div
              id="addBreakfastFields"
              class="product-form-section breakfast-fields"
              style="display:none;"
          >

              <h3>Horaires petit-déjeuner</h3>

              <div class="product-form-grid">

                  <div class="product-form-group">

                      <label>Disponible à partir de</label>

                      <input
                          class="product-modal-field"
                          type="time"
                          name="breakfast_start"
                      >

                  </div>


                  <div class="product-form-group">

                      <label>Disponible jusqu'à</label>

                      <input
                          class="product-modal-field"
                          type="time"
                          name="breakfast_end"
                      >

                  </div>

              </div>

          </div>


          <!-- =========================
              POSITION
          ========================== -->

          <div class="product-form-section">

              <h3>Affichage</h3>

              <div class="product-form-group">

                  <label>Position</label>

                  <input
                      class="product-modal-field"
                      type="number"
                      name="position"
                      value="0"
                      min="0"
                  >

                  <small class="product-form-help">
                      Plus le nombre est petit, plus le produit apparaît haut.
                  </small>

              </div>

          </div>


          <!-- =========================
              IMAGES
          ========================== -->

          <div class="product-form-section">

              <h3>Images</h3>

              <label class="product-images-label">
                  🖼️ Images du produit — maximum 6
              </label>


              <input
                  class="product-modal-field"
                  type="file"
                  name="images"
                  accept="image/*"
                  multiple
                  onchange="previewProductImages(this, 'addImagesPreview')"
              >


              <div
                  id="addImagesPreview"
                  class="product-images-preview">
              </div>

          </div>


          <button
              type="submit"
              class="btn-product-save"
          >
              💾 Enregistrer le produit
          </button>

      </form>

  </div>

</div>


<!-- =====================================================
     MODAL : MODIFIER PRODUIT
===================================================== -->

<div id="editProductModal"
     class="product-modal-overlay">

  <div class="product-modal">

    <div class="product-modal-header">

      <h2>
        <span>📝</span>
        Modifier le produit
      </h2>

      <button type="button"
              class="product-modal-close"
              onclick="closeEditProductModal()">
        ×
      </button>

    </div>


    <form
      id="editProductForm"
      method="POST"
      enctype="multipart/form-data"
    >

      <input
        type="hidden"
        id="editProductId"
        name="id"
      >


      <input
        id="editProductName"
        class="product-modal-field"
        type="text"
        name="name"
        required
      >


      <input
        id="editProductIcon"
        class="product-modal-field"
        type="text"
        name="icon"
      >


      <select
          id="editProductCategory"
          class="product-modal-field"
          name="category_id"
          required
      >

          <% categories.forEach(category => { %>

              <option value="<%= category.id %>">

                  <%= category.icon || "" %>
                  <%= category.name %>

              </option>

          <% }) %>

      </select>


      <input
        id="editProductPrice"
        class="product-modal-field"
        type="number"
        step="0.01"
        min="0"
        name="price"
        required
      >

      


      <input type="text"
       id="editProductSku"
       name="sku"
       class="product-modal-field">

      <input type="text"
            id="editProductShortDescription"
            name="short_description"
            maxlength="300"
            class="product-modal-field">

      <input type="number"
            id="editProductCompareAtPrice"
            name="compare_at_price"
            step="0.01"
            min="0"
            class="product-modal-field">

      <select id="editProductSpiceLevel"
              name="spice_level"
              class="product-modal-field">

          <option value="0">0 — Non épicé</option>
          <option value="1">1 — Très léger</option>
          <option value="2">2 — Léger</option>
          <option value="3">3 — Moyen</option>
          <option value="4">4 — Épicé</option>
          <option value="5">5 — Très épicé</option>

      </select>

      <textarea id="editProductIngredients"
                name="ingredients"
                class="product-modal-field"></textarea>

      <textarea id="editProductAllergens"
                name="allergens"
                class="product-modal-field"></textarea>

      <input type="number"
            id="editProductCalories"
            name="calories"
            min="0"
            class="product-modal-field">

      <input type="number"
            id="editProductPreparationMinutes"
            name="preparation_minutes"
            min="0"
            class="product-modal-field">

      <input type="number"
            id="editProductPosition"
            name="position"
            min="0"
            class="product-modal-field">


      <label class="product-checkbox">
          <input type="checkbox"
                id="editProductHalal"
                name="is_halal"
                value="1">

          Halal
      </label>


      <label class="product-checkbox">
          <input type="checkbox"
                id="editProductVegetarian"
                name="is_vegetarian"
                value="1">

          Végétarien
      </label>


      <label class="product-checkbox">
          <input type="checkbox"
                id="editProductFeatured"
                name="is_featured"
                value="1">

          Produit vedette
      </label>


      <label class="product-checkbox">

          <input type="checkbox"
                id="editProductBreakfast"
                name="is_breakfast"
                value="1"
                onchange="toggleBreakfastFields(this, 'editBreakfastFields')">

          Petit-déjeuner

      </label>


      <div id="editBreakfastFields"
          class="product-form-grid"
          style="display:none;">

          <div class="product-form-group">

              <label>Disponible à partir de</label>

              <input type="time"
                    id="editProductBreakfastStart"
                    name="breakfast_start"
                    class="product-modal-field">

          </div>


          <div class="product-form-group">

              <label>Disponible jusqu'à</label>

              <input type="time"
                    id="editProductBreakfastEnd"
                    name="breakfast_end"
                    class="product-modal-field">

          </div>

      </div>

      <textarea
        id="editProductDescription"
        class="product-modal-field product-description"
        name="description"
      ></textarea>


      <label class="product-images-label">
        🖼️ Images du produit (jusqu'à 6)
      </label>


      <input
        class="product-modal-field"
        type="file"
        name="images"
        accept="image/*"
        multiple
        onchange="previewProductImages(this, 'editImagesPreview')"
      >


      <div
        id="editImagesPreview"
        class="product-images-preview">
      </div>


      <button
        type="submit"
        class="btn-product-save">
        💾 Enregistrer
      </button>

    </form>

  </div>

</div>

<form
    id="deleteProductForm"
    method="POST"
    style="display:none;">
</form>

<style>
  /* =====================================================
   ADMIN PRODUITS
===================================================== */

.admin-products-page {
    padding: 12px;
}

.admin-products-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
}

.admin-badge {
    display: inline-flex;

    padding: 5px 10px;

    background: #fff0df;
    color: #ff7900;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 800;
}

.admin-products-header h1 {
    margin: 8px 0 0;

    font-size: 32px;
    line-height: 1;

    color: #171310;
}

.btn-product-add {
    border: 0;

    padding: 12px 18px;

    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-weight: 800;

    cursor: pointer;
}


/* =====================================================
   TABLE
===================================================== */

.admin-products-table-wrapper {
    overflow-x: auto;

    background: #fff;

    border-radius: 16px;
}

.admin-products-table {
    width: 100%;

    border-collapse: collapse;

    font-size: 14px;
}

.admin-products-table th {
    padding: 15px;

    background: #faf8f5;

    text-align: left;

    font-weight: 800;

    border-bottom: 1px solid #ddd;
}

.admin-products-table td {
    padding: 14px 15px;

    border-bottom: 1px solid #ddd;

    vertical-align: middle;
}

.product-actions {
    display: flex;

    align-items: center;

    gap: 8px;
}

.btn-product-edit,
.btn-product-delete {
    border: 0;

    padding: 9px 14px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 800;

    cursor: pointer;
}

.btn-product-edit {
    background: #fff;
    color: #171310;

    box-shadow: 0 4px 18px rgba(0,0,0,.05);
}

.btn-product-delete {
    background: #ffe4df;
    color: #c73927;
}


/* =====================================================
   MODAL
===================================================== */

.product-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,.50);
}

.product-modal-overlay.show {
    display: flex;
}

body.modal-open {
    overflow: hidden;
}

.product-modal {
    width: 100%;
    max-width: 560px;

    max-height: 90vh;

    overflow-y: auto;

    padding: 20px;

    background: #fff;

    border-radius: 22px;

    box-shadow:
        0 25px 70px rgba(0,0,0,.25);
}

.product-modal-header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin-bottom: 15px;
}

.product-modal-header h2 {
    margin: 0;

    font-size: 21px;

    color: #171310;
}

.product-modal-close {
    width: 34px;
    height: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    border: 0;

    border-radius: 50%;

    background: #f4f4f4;

    color: #333;

    font-size: 20px;

    cursor: pointer;
}


/* =====================================================
   FORM
===================================================== */

.product-modal form {
    display: flex;

    flex-direction: column;

    gap: 9px;
}

.product-modal-field {
    width: 100%;

    min-height: 42px;

    padding: 10px 12px;

    box-sizing: border-box;

    border: 1px solid #ddd;

    border-radius: 10px;

    background: #fff;

    color: #171310;

    outline: none;
}

.product-modal-field:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255,121,0,.08);
}

.product-description {
    min-height: 70px;

    resize: vertical;
}

.product-images-label {
    margin-top: 2px;

    font-size: 13px;

    font-weight: 800;
}


/* =====================================================
   PREVIEW IMAGES
===================================================== */

.product-images-preview {
    display: grid;

    grid-template-columns:
        repeat(6, 1fr);

    gap: 7px;
}

.product-preview-item {
    overflow: hidden;

    aspect-ratio: 1;

    border: 1px solid #ddd;

    border-radius: 9px;

    background: #f5f5f5;
}

.product-preview-item img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =====================================================
   ENREGISTRER
===================================================== */

.btn-product-save {
    width: 100%;

    margin-top: 4px;

    padding: 13px 20px;

    border: 0;

    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-weight: 800;

    cursor: pointer;
}

.btn-product-save:hover,
.btn-product-add:hover {
    background: #e86e00;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 700px) {

    .admin-products-header {
        flex-direction: column;
    }

    .btn-product-add {
        width: 100%;
    }

    .admin-products-table {
        min-width: 800px;
    }

    .product-modal {
        max-width: 100%;
    }

    .product-images-preview {
        grid-template-columns:
            repeat(3, 1fr);
    }

}
</style>
<script src="/js/products.js" defer></script>