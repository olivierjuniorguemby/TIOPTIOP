<!-- =====================================================
     MODAL : AJOUTER PRODUIT
===================================================== -->

<div id="addProductModal"
     class="product-modal-overlay">

  <div class="product-modal">

    <div class="product-modal-header">

      <h2>
        <span>➕</span>
        Ajouter un produit
      </h2>

      <button type="button"
              class="product-modal-close"
              onclick="closeAddProductModal()">
        ×
      </button>

    </div>


    <form method="POST"
          action="/admin/produits"
          enctype="multipart/form-data">

      <input
        class="product-modal-field"
        type="text"
        name="name"
        placeholder="Nom du produit"
        required
      >


      <input
        class="product-modal-field"
        type="text"
        name="icon"
        placeholder="🍽️"
      >


      <select
        class="product-modal-field"
        name="category"
        required
      >

        <option value="Tradition">Tradition</option>
        <option value="Grillades">Grillades</option>
        <option value="Petit déjeuner">Petit déjeuner</option>
        <option value="Boissons">Boissons</option>
        <option value="Douceurs">Douceurs</option>
        <option value="Accompagnement">Accompagnement</option>

      </select>


      <input
        class="product-modal-field"
        type="number"
        step="0.01"
        min="0"
        name="price"
        placeholder="Prix"
        required
      >


      <textarea
        class="product-modal-field product-description"
        name="description"
        placeholder="Description"
      ></textarea>


      <label class="product-images-label">
        🖼️ Images du produit (jusqu'à 6)
      </label>


      <input
        class="product-modal-field"
        type="file"
        name="images"
        accept="image/*"
        multiple
        onchange="previewProductImages(this, 'addImagesPreview')"
      >


      <div
        id="addImagesPreview"
        class="product-images-preview">
      </div>


      <button
        type="submit"
        class="btn-product-save">
        💾 Enregistrer
      </button>

    </form>

  </div>

</div>


<!-- =====================================================
     MODAL : MODIFIER PRODUIT
===================================================== -->

<div id="editProductModal"
     class="product-modal-overlay">

  <div class="product-modal">

    <div class="product-modal-header">

      <h2>
        <span>📝</span>
        Modifier le produit
      </h2>

      <button type="button"
              class="product-modal-close"
              onclick="closeEditProductModal()">
        ×
      </button>

    </div>


    <form
      id="editProductForm"
      method="POST"
      enctype="multipart/form-data"
    >

      <input
        type="hidden"
        id="editProductId"
        name="id"
      >


      <input
        id="editProductName"
        class="product-modal-field"
        type="text"
        name="name"
        required
      >


      <input
        id="editProductIcon"
        class="product-modal-field"
        type="text"
        name="icon"
      >


      <select
        id="editProductCategory"
        class="product-modal-field"
        name="category"
      >

        <option value="Tradition">Tradition</option>
        <option value="Grillades">Grillades</option>
        <option value="Petit déjeuner">Petit déjeuner</option>
        <option value="Boissons">Boissons</option>
        <option value="Douceurs">Douceurs</option>
        <option value="Accompagnement">Accompagnement</option>

      </select>


      <input
        id="editProductPrice"
        class="product-modal-field"
        type="number"
        step="0.01"
        min="0"
        name="price"
        required
      >


      <textarea
        id="editProductDescription"
        class="product-modal-field product-description"
        name="description"
      ></textarea>


      <label class="product-images-label">
        🖼️ Images du produit (jusqu'à 6)
      </label>


      <input
        class="product-modal-field"
        type="file"
        name="images"
        accept="image/*"
        multiple
        onchange="previewProductImages(this, 'editImagesPreview')"
      >


      <div
        id="editImagesPreview"
        class="product-images-preview">
      </div>


      <button
        type="submit"
        class="btn-product-save">
        💾 Enregistrer
      </button>

    </form>

  </div>

</div>

<style>
  /* =====================================================
   ADMIN PRODUITS
===================================================== */

.admin-products-page {
    padding: 12px;
}

.admin-products-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
}

.admin-badge {
    display: inline-flex;

    padding: 5px 10px;

    background: #fff0df;
    color: #ff7900;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 800;
}

.admin-products-header h1 {
    margin: 8px 0 0;

    font-size: 32px;
    line-height: 1;

    color: #171310;
}

.btn-product-add {
    border: 0;

    padding: 12px 18px;

    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-weight: 800;

    cursor: pointer;
}


/* =====================================================
   TABLE
===================================================== */

.admin-products-table-wrapper {
    overflow-x: auto;

    background: #fff;

    border-radius: 16px;
}

.admin-products-table {
    width: 100%;

    border-collapse: collapse;

    font-size: 14px;
}

.admin-products-table th {
    padding: 15px;

    background: #faf8f5;

    text-align: left;

    font-weight: 800;

    border-bottom: 1px solid #ddd;
}

.admin-products-table td {
    padding: 14px 15px;

    border-bottom: 1px solid #ddd;

    vertical-align: middle;
}

.product-actions {
    display: flex;

    align-items: center;

    gap: 8px;
}

.btn-product-edit,
.btn-product-delete {
    border: 0;

    padding: 9px 14px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 800;

    cursor: pointer;
}

.btn-product-edit {
    background: #fff;
    color: #171310;

    box-shadow: 0 4px 18px rgba(0,0,0,.05);
}

.btn-product-delete {
    background: #ffe4df;
    color: #c73927;
}


/* =====================================================
   MODAL
===================================================== */

.product-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,.50);
}

.product-modal-overlay.show {
    display: flex;
}

body.modal-open {
    overflow: hidden;
}

.product-modal {
    width: 100%;
    max-width: 560px;

    max-height: 90vh;

    overflow-y: auto;

    padding: 20px;

    background: #fff;

    border-radius: 22px;

    box-shadow:
        0 25px 70px rgba(0,0,0,.25);
}

.product-modal-header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin-bottom: 15px;
}

.product-modal-header h2 {
    margin: 0;

    font-size: 21px;

    color: #171310;
}

.product-modal-close {
    width: 34px;
    height: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    border: 0;

    border-radius: 50%;

    background: #f4f4f4;

    color: #333;

    font-size: 20px;

    cursor: pointer;
}


/* =====================================================
   FORM
===================================================== */

.product-modal form {
    display: flex;

    flex-direction: column;

    gap: 9px;
}

.product-modal-field {
    width: 100%;

    min-height: 42px;

    padding: 10px 12px;

    box-sizing: border-box;

    border: 1px solid #ddd;

    border-radius: 10px;

    background: #fff;

    color: #171310;

    outline: none;
}

.product-modal-field:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255,121,0,.08);
}

.product-description {
    min-height: 70px;

    resize: vertical;
}

.product-images-label {
    margin-top: 2px;

    font-size: 13px;

    font-weight: 800;
}


/* =====================================================
   PREVIEW IMAGES
===================================================== */

.product-images-preview {
    display: grid;

    grid-template-columns:
        repeat(6, 1fr);

    gap: 7px;
}

.product-preview-item {
    overflow: hidden;

    aspect-ratio: 1;

    border: 1px solid #ddd;

    border-radius: 9px;

    background: #f5f5f5;
}

.product-preview-item img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =====================================================
   ENREGISTRER
===================================================== */

.btn-product-save {
    width: 100%;

    margin-top: 4px;

    padding: 13px 20px;

    border: 0;

    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-weight: 800;

    cursor: pointer;
}

.btn-product-save:hover,
.btn-product-add:hover {
    background: #e86e00;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 700px) {

    .admin-products-header {
        flex-direction: column;
    }

    .btn-product-add {
        width: 100%;
    }

    .admin-products-table {
        min-width: 800px;
    }

    .product-modal {
        max-width: 100%;
    }

    .product-images-preview {
        grid-template-columns:
            repeat(3, 1fr);
    }

}
</style>
<script src="/js/products.js" defer></script>