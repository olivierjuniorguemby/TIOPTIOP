<section class="admin-heading">
  <div>
      <span class="admin-badge">Administration</span>
      <h1>🍛 Produits</h1>
    </div>

    <button type="button"
            class="btn-product-add"
            onclick="openAddProductModal()">
      + Ajouter un produit
    </button>
</section>

<section class="admin-products-page">



  <!-- ==========================
       TABLEAU PRODUITS
  =========================== -->
  <div class="admin-products-table-wrapper">

    <table class="admin-products-table">

      <thead>
        <tr>
          <th>Produit</th>
          <th>Catégorie</th>
          <th>Prix</th>
          <th>Images</th>
          <th>Actif</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>

        <% if (!products || products.length === 0) { %>

            <tr>
                <td colspan="6">
                    Aucun produit enregistré.
                </td>
            </tr>

        <% } else { %>

            <% products.forEach(product => { %>

                <tr>

                    <!-- PRODUIT -->
                    <td>

                        <% if (product.primary_image) { %>

                            <img
                                src="<%= product.primary_image %>"
                                alt="<%= product.name %>"
                                style="
                                    width:42px;
                                    height:42px;
                                    border-radius:10px;
                                    object-fit:cover;
                                    vertical-align:middle;
                                    margin-right:8px;
                                "
                            >

                        <% } else { %>

                            <span>
                                <%= product.icon || "🍽️" %>
                            </span>

                        <% } %>

                        <strong>
                            <%= product.name %>
                        </strong>

                    </td>


                    <!-- CATEGORIE -->
                    <td>
                        <%= product.category_name %>
                    </td>


                    <!-- PRIX -->
                    <td>

                        <%= Number(product.price).toLocaleString("fr-FR") %>
                        FCFA

                    </td>


                    <!-- IMAGES -->
                    <td>
                        <%= product.image_count %> image(s)
                    </td>


                    <!-- ACTIF -->
                    <td>

                        <form
                            method="POST"
                            action="/admin/produits/<%= product.id %>/toggle"
                        >

                            <button
                                type="submit"
                                class="category-status <%= product.is_active ? 'active' : 'inactive' %>"
                            >

                                <%= product.is_active ? "Actif" : "Inactif" %>

                            </button>

                        </form>

                    </td>


                    <!-- ACTIONS -->
                    <td>

                        <div class="product-actions">

                            <button
                              type="button"
                              class="btn-product-edit"

                              data-id="<%= product.id %>"
                              data-name="<%= product.name %>"
                              data-sku="<%= product.sku || '' %>"
                              data-icon="<%= product.icon || '' %>"

                              data-category-id="<%= product.category_id %>"

                              data-short-description="<%= product.short_description || '' %>"
                              data-description="<%= product.description || '' %>"

                              data-price="<%= product.price %>"
                              data-compare-at-price="<%= product.compare_at_price || '' %>"

                              data-preparation-minutes="<%= product.preparation_minutes %>"
                              data-spice-level="<%= product.spice_level %>"

                              data-allergens="<%= product.allergens || '' %>"
                              data-ingredients="<%= product.ingredients || '' %>"
                              data-calories="<%= product.calories || '' %>"

                              data-halal="<%= product.is_halal %>"
                              data-vegetarian="<%= product.is_vegetarian %>"

                              data-breakfast="<%= product.is_breakfast %>"
                              data-breakfast-start="<%= product.breakfast_start || '' %>"
                              data-breakfast-end="<%= product.breakfast_end || '' %>"

                              data-featured="<%= product.is_featured %>"
                              data-position="<%= product.position %>"

                              onclick="openEditProductModalFromButton(this)"
                          >
                              Modifier
                          </button>

                          <button
                              type="button"
                              class="button"
                              onclick="openProductOptions(
                                  <%= product.id %>,
                                  '<%= String(product.name).replace(/'/g, "\\'") %>'
                              )"
                          >
                              ⚙️ Options & suppléments
                          </button>

                            <button
                                type="button"
                                class="btn-product-delete"

                                onclick='deleteProduct(
                                    <%- JSON.stringify(product.id) %>,
                                    <%- JSON.stringify(product.name) %>
                                )'
                            >
                                Supprimer
                            </button>

                        </div>

                    </td>

                </tr>

            <% }) %>

        <% } %>

        </tbody>

    </table>

  </div>
</section>


<!-- =====================================================
     MODAL : AJOUTER PRODUIT
===================================================== -->

<div id="addProductModal"
     class="product-modal-overlay">

  <div class="product-modal">

    <div class="product-modal-header">

      <h2>
        <span>➕</span>
        Ajouter un produit
      </h2>

      <button type="button"
              class="product-modal-close"
              onclick="closeAddProductModal()">
        ×
      </button>

    </div>


    <form
          method="POST"
          action="/admin/produits"
          enctype="multipart/form-data"
      >

          <!-- =========================
              IDENTITE
          ========================== -->

          <div class="product-form-section">
              <h3>Informations générales</h3>

              <div class="product-form-grid">

                  <div class="product-form-group product-form-full">
                      <label>Nom du produit *</label>

                      <input
                          class="product-modal-field"
                          type="text"
                          name="name"
                          placeholder="Ex : Poulet Braisé Tiop"
                          required
                      >
                  </div>


                  <div class="product-form-group">
                      <label>SKU</label>

                      <input
                          class="product-modal-field"
                          type="text"
                          name="sku"
                          placeholder="Ex : POULET-001"
                      >
                  </div>


                  <div class="product-form-group">
                      <label>Icône</label>

                      <input
                          class="product-modal-field"
                          type="text"
                          name="icon"
                          placeholder="🍗"
                      >
                  </div>


                  <div class="product-form-group product-form-full">
                      <label>Catégorie *</label>

                      <select
                          class="product-modal-field"
                          name="category_id"
                          required
                      >

                          <option value="">
                              Sélectionner une catégorie
                          </option>

                          <% categories.forEach(category => { %>

                              <% if (category.is_active) { %>

                                  <option value="<%= category.id %>">
                                      <%= category.icon || "" %>
                                      <%= category.name %>
                                  </option>

                              <% } %>

                          <% }) %>

                      </select>
                  </div>

              </div>
          </div>


          <!-- =========================
              DESCRIPTIONS
          ========================== -->

          <div class="product-form-section">

              <h3>Description</h3>

              <div class="product-form-group">

                  <label>Description courte</label>

                  <input
                      class="product-modal-field"
                      type="text"
                      name="short_description"
                      maxlength="300"
                      placeholder="Résumé affiché sur la carte produit"
                  >

              </div>


              <div class="product-form-group">

                  <label>Description complète</label>

                  <textarea
                      class="product-modal-field product-description"
                      name="description"
                      placeholder="Description détaillée du produit"
                  ></textarea>

              </div>

          </div>


          <!-- =========================
              TARIFICATION
          ========================== -->

          <div class="product-form-section">

              <h3>Prix</h3>

              <div class="product-form-grid">

                  <div class="product-form-group">

                      <label>Prix *</label>

                      <input
                          class="product-modal-field"
                          type="number"
                          step="0.01"
                          min="0"
                          name="price"
                          placeholder="8900"
                          required
                      >

                  </div>


                  <div class="product-form-group">

                      <label>Ancien prix / prix comparé</label>

                      <input
                          class="product-modal-field"
                          type="number"
                          step="0.01"
                          min="0"
                          name="compare_at_price"
                          placeholder="10000"
                      >

                  </div>

              </div>

              <small class="product-form-help">
                  L'ancien prix permet par exemple d'afficher :
                  <del>10 000 FCFA</del> 8 900 FCFA.
              </small>

          </div>


          <!-- =========================
              PREPARATION
          ========================== -->

          <div class="product-form-section">

              <h3>Préparation</h3>

              <div class="product-form-grid">

                  <div class="product-form-group">

                      <label>Temps de préparation</label>

                      <input
                          class="product-modal-field"
                          type="number"
                          name="preparation_minutes"
                          min="0"
                          value="15"
                      >

                  </div>


                  <div class="product-form-group">

                      <label>Niveau épicé</label>

                      <select
                          class="product-modal-field"
                          name="spice_level"
                      >
                          <option value="0">0 — Non épicé</option>
                          <option value="1">1 — Très léger</option>
                          <option value="2">2 — Léger</option>
                          <option value="3">3 — Moyen</option>
                          <option value="4">4 — Épicé</option>
                          <option value="5">5 — Très épicé</option>
                      </select>

                  </div>

              </div>

          </div>


          <!-- =========================
              COMPOSITION
          ========================== -->

          <div class="product-form-section">

              <h3>Composition & nutrition</h3>


              <div class="product-form-group">

                  <label>Ingrédients</label>

                  <textarea
                      class="product-modal-field"
                      name="ingredients"
                      placeholder="Poulet, épices, oignons, ail..."
                  ></textarea>

              </div>


              <div class="product-form-group">

                  <label>Allergènes</label>

                  <textarea
                      class="product-modal-field"
                      name="allergens"
                      placeholder="Arachides, lait, gluten..."
                  ></textarea>

              </div>


              <div class="product-form-group">

                  <label>Calories</label>

                  <input
                      class="product-modal-field"
                      type="number"
                      name="calories"
                      min="0"
                      placeholder="Ex : 650"
                  >

              </div>

          </div>


          <!-- =========================
              REGIMES
          ========================== -->

          <div class="product-form-section">

              <h3>Caractéristiques</h3>

              <div class="product-checkbox-grid">

                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_halal"
                          value="1"
                      >
                      <span>Halal</span>
                  </label>


                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_vegetarian"
                          value="1"
                      >
                      <span>Végétarien</span>
                  </label>


                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_featured"
                          value="1"
                      >
                      <span>Produit vedette</span>
                  </label>


                  <label class="product-checkbox">
                      <input
                          type="checkbox"
                          name="is_breakfast"
                          value="1"
                          onchange="toggleBreakfastFields(this, 'addBreakfastFields')"
                      >
                      <span>Petit-déjeuner</span>
                  </label>

              </div>

          </div>


          <!-- =========================
              PETIT DEJEUNER
          ========================== -->

          <div
              id="addBreakfastFields"
              class="product-form-section breakfast-fields"
              style="display:none;"
          >

              <h3>Horaires petit-déjeuner</h3>

              <div class="product-form-grid">

                  <div class="product-form-group">

                      <label>Disponible à partir de</label>

                      <input
                          class="product-modal-field"
                          type="time"
                          name="breakfast_start"
                      >

                  </div>


                  <div class="product-form-group">

                      <label>Disponible jusqu'à</label>

                      <input
                          class="product-modal-field"
                          type="time"
                          name="breakfast_end"
                      >

                  </div>

              </div>

          </div>


          <!-- =========================
              POSITION
          ========================== -->

          <div class="product-form-section">

              <h3>Affichage</h3>

              <div class="product-form-group">

                  <label>Position</label>

                  <input
                      class="product-modal-field"
                      type="number"
                      name="position"
                      value="0"
                      min="0"
                  >

                  <small class="product-form-help">
                      Plus le nombre est petit, plus le produit apparaît haut.
                  </small>

              </div>

          </div>


          <!-- =========================
              IMAGES
          ========================== -->

          <div class="product-form-section">

              <h3>Images</h3>

              <label class="product-images-label">
                  🖼️ Images du produit — maximum 6
              </label>


              <input
                  class="product-modal-field"
                  type="file"
                  name="images"
                  accept="image/*"
                  multiple
                  onchange="previewProductImages(this, 'addImagesPreview')"
              >


              <div
                  id="addImagesPreview"
                  class="product-images-preview">
              </div>

          </div>


          <button
              type="submit"
              class="btn-product-save"
          >
              💾 Enregistrer le produit
          </button>

      </form>

  </div>

</div>


<!-- =====================================================
     MODAL : MODIFIER PRODUIT
===================================================== -->

<div id="editProductModal"
     class="product-modal-overlay">

  <div class="product-modal">

    <div class="product-modal-header">

      <h2>
        <span>📝</span>
        Modifier le produit
      </h2>

      <button type="button"
              class="product-modal-close"
              onclick="closeEditProductModal()">
        ×
      </button>

    </div>


    <form
      id="editProductForm"
      method="POST"
      enctype="multipart/form-data"
    >

      <input
        type="hidden"
        id="editProductId"
        name="id"
      >


      <input
        id="editProductName"
        class="product-modal-field"
        type="text"
        name="name"
        required
      >


      <input
        id="editProductIcon"
        class="product-modal-field"
        type="text"
        name="icon"
      >


      <select
          id="editProductCategory"
          class="product-modal-field"
          name="category_id"
          required
      >

          <% categories.forEach(category => { %>

              <option value="<%= category.id %>">

                  <%= category.icon || "" %>
                  <%= category.name %>

              </option>

          <% }) %>

      </select>


      <input
        id="editProductPrice"
        class="product-modal-field"
        type="number"
        step="0.01"
        min="0"
        name="price"
        required
      >

      


      <input type="text"
       id="editProductSku"
       name="sku"
       class="product-modal-field">

      <input type="text"
            id="editProductShortDescription"
            name="short_description"
            maxlength="300"
            class="product-modal-field">

      <input type="number"
            id="editProductCompareAtPrice"
            name="compare_at_price"
            step="0.01"
            min="0"
            class="product-modal-field">

      <select id="editProductSpiceLevel"
              name="spice_level"
              class="product-modal-field">

          <option value="0">0 — Non épicé</option>
          <option value="1">1 — Très léger</option>
          <option value="2">2 — Léger</option>
          <option value="3">3 — Moyen</option>
          <option value="4">4 — Épicé</option>
          <option value="5">5 — Très épicé</option>

      </select>

      <textarea id="editProductIngredients"
                name="ingredients"
                class="product-modal-field"></textarea>

      <textarea id="editProductAllergens"
                name="allergens"
                class="product-modal-field"></textarea>

      <input type="number"
            id="editProductCalories"
            name="calories"
            min="0"
            class="product-modal-field">

      <input type="number"
            id="editProductPreparationMinutes"
            name="preparation_minutes"
            min="0"
            class="product-modal-field">

      <input type="number"
            id="editProductPosition"
            name="position"
            min="0"
            class="product-modal-field">


      <label class="product-checkbox">
          <input type="checkbox"
                id="editProductHalal"
                name="is_halal"
                value="1">

          Halal
      </label>


      <label class="product-checkbox">
          <input type="checkbox"
                id="editProductVegetarian"
                name="is_vegetarian"
                value="1">

          Végétarien
      </label>


      <label class="product-checkbox">
          <input type="checkbox"
                id="editProductFeatured"
                name="is_featured"
                value="1">

          Produit vedette
      </label>


      <label class="product-checkbox">

          <input type="checkbox"
                id="editProductBreakfast"
                name="is_breakfast"
                value="1"
                onchange="toggleBreakfastFields(this, 'editBreakfastFields')">

          Petit-déjeuner

      </label>


      <div id="editBreakfastFields"
          class="product-form-grid"
          style="display:none;">

          <div class="product-form-group">

              <label>Disponible à partir de</label>

              <input type="time"
                    id="editProductBreakfastStart"
                    name="breakfast_start"
                    class="product-modal-field">

          </div>


          <div class="product-form-group">

              <label>Disponible jusqu'à</label>

              <input type="time"
                    id="editProductBreakfastEnd"
                    name="breakfast_end"
                    class="product-modal-field">

          </div>

      </div>

      <textarea
        id="editProductDescription"
        class="product-modal-field product-description"
        name="description"
      ></textarea>

      <div class="product-form-section">

          <h3>Images actuelles</h3>

          <p class="product-form-help">
              Vous pouvez conserver jusqu'à 6 images.
              Cliquez sur « Principale » pour choisir
              l'image affichée par défaut.
          </p>


          <div
              id="editExistingImages"
              class="existing-product-images"
          >
              <!-- injecté en JavaScript -->
          </div>


          <div
              id="editImagesCounter"
              class="product-images-counter"
          >
              0 / 6 images
          </div>

      </div>


      <div class="product-form-section">

          <h3>🖼️ Ajouter de nouvelles images (jusqu'à 6)</h3>

          <input
              id="editProductImages"
              class="product-modal-field"
              type="file"
              name="images"
              accept="image/*"
              multiple
              onchange="previewEditProductImages(this)"
          >


          <div
              id="editNewImagesPreview"
              class="product-images-preview"
          ></div>

      </div>



      <div
        id="editImagesPreview"
        class="product-images-preview">
      </div>


      <button
        type="submit"
        class="btn-product-save">
        💾 Enregistrer
      </button>

    </form>

  </div>

</div>

<!-- =========================================================
     OPTIONS / SUPPLÉMENTS PRODUIT
========================================================= -->

<div
    id="productOptionsModal"
    class="product-options-modal"
    aria-hidden="true"
>
    <div class="product-options-modal-box">

        <div class="product-options-modal-header">

            <div>
                <span class="admin-badge">
                    Produit
                </span>

                <h2 id="productOptionsTitle">
                    ⚙️ Options & suppléments
                </h2>

                <p id="productOptionsSubtitle">
                    Gérez les accompagnements et suppléments.
                </p>
            </div>

            <button
                type="button"
                class="product-options-close"
                onclick="closeProductOptions()"
            >
                ×
            </button>

        </div>


        <!-- =================================================
             ACTION PRINCIPALE
        ================================================== -->

        <div class="product-options-toolbar">

            <div>
                <strong>
                    Groupes d'options
                </strong>

                <small>
                    Accompagnements, suppléments, sauces, cuisson...
                </small>
            </div>

            <button
                type="button"
                class="button primary"
                onclick="openGroupForm()"
            >
                + Ajouter un groupe
            </button>

        </div>


        <!-- =================================================
             FORMULAIRE GROUPE
        ================================================== -->

        <form
            id="optionGroupForm"
            class="option-admin-form"
            style="display:none;"
        >

            <input
                type="hidden"
                id="optionGroupId"
            >


            <div class="option-admin-form-title">

                <strong id="optionGroupFormTitle">
                    Nouveau groupe
                </strong>

                <button
                    type="button"
                    onclick="closeGroupForm()"
                >
                    ×
                </button>

            </div>


            <div class="option-admin-grid">

                <label>
                    <span>Nom du groupe *</span>

                    <input
                        type="text"
                        id="optionGroupName"
                        required
                        placeholder="Ex : Accompagnement"
                    >
                </label>


                <label>
                    <span>Type de sélection</span>

                    <select id="optionGroupType">
                        <option value="single">
                            Choix unique
                        </option>

                        <option value="multiple">
                            Choix multiples
                        </option>
                    </select>
                </label>


                <label>
                    <span>Minimum de choix</span>

                    <input
                        type="number"
                        id="optionGroupMin"
                        value="0"
                        min="0"
                    >
                </label>


                <label>
                    <span>Maximum de choix</span>

                    <input
                        type="number"
                        id="optionGroupMax"
                        min="1"
                        placeholder="Illimité"
                    >
                </label>


                <label>
                    <span>Position</span>

                    <input
                        type="number"
                        id="optionGroupPosition"
                        value="0"
                    >
                </label>

            </div>


            <div class="option-admin-checks">

                <label>
                    <input
                        type="checkbox"
                        id="optionGroupRequired"
                    >

                    Groupe obligatoire
                </label>


                <label>
                    <input
                        type="checkbox"
                        id="optionGroupActive"
                        checked
                    >

                    Groupe actif
                </label>

            </div>


            <div class="option-admin-form-actions">

                <button
                    type="button"
                    class="button"
                    onclick="closeGroupForm()"
                >
                    Annuler
                </button>

                <button
                    type="submit"
                    class="button primary"
                >
                    💾 Enregistrer le groupe
                </button>

            </div>

        </form>


        <!-- =================================================
             LISTE DES GROUPES
        ================================================== -->

        <div id="productOptionsLoading">
            Chargement...
        </div>

        <div id="productOptionsEmpty" style="display:none;">

            <div class="product-options-empty-icon">
                ⚙️
            </div>

            <strong>
                Aucune option pour ce produit
            </strong>

            <p>
                Commencez par créer un groupe comme
                « Accompagnement » ou « Suppléments ».
            </p>

        </div>


        <div id="productOptionsGroups"></div>

    </div>
</div>

<!-- =========================================================
     MODALE OPTION
========================================================= -->

<div
    id="productOptionFormModal"
    class="product-option-form-modal"
    aria-hidden="true"
>
    <div class="product-option-form-box">

        <div class="product-options-modal-header">

            <div>
                <span class="admin-badge">
                    Option
                </span>

                <h2 id="productOptionFormTitle">
                    Ajouter une option
                </h2>
            </div>

            <button
                type="button"
                class="product-options-close"
                onclick="closeOptionForm()"
            >
                ×
            </button>

        </div>


        <form id="productOptionForm">

            <input
                type="hidden"
                id="productOptionId"
            >

            <input
                type="hidden"
                id="productOptionGroupId"
            >


            <div class="option-admin-grid">

                <label>
                    <span>Nom *</span>

                    <input
                        type="text"
                        id="productOptionName"
                        required
                        placeholder="Ex : Plantain"
                    >
                </label>


                <label>
                    <span>Supplément prix</span>

                    <input
                        type="number"
                        id="productOptionPrice"
                        value="0"
                        min="0"
                        step="0.01"
                    >
                </label>


                <label>
                    <span>Position</span>

                    <input
                        type="number"
                        id="productOptionPosition"
                        value="0"
                    >
                </label>

            </div>


            <div class="option-admin-checks">

                <label>
                    <input
                        type="checkbox"
