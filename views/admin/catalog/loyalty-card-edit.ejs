<section class="ce-wrap"><div class="ce-head"><div><span>Tiop+</span><h1><%= card.card_number %></h1><p>Carte nominative sans compte • <strong><%= card.status %></strong></p></div><div><a class="btn ghost" href="/admin/tiopplus/cartes">← Cartes</a> <a class="btn" target="_blank" href="/admin/tiopplus/cartes/<%= card.id %>/imprimer">🖨 Imprimer</a></div></div><% if(created){ %><div class="ok">Carte créée avec succès.</div><% } %><% if(updated){ %><div class="ok">Carte mise à jour.</div><% } %>
<div class="ce-grid"><form method="post" class="box"><h2>Informations</h2><div class="fields"><label>Prénom<input name="first_name" value="<%= card.first_name||'' %>"></label><label>Nom<input name="last_name" value="<%= card.last_name||'' %>"></label><label class="wide">Nom affiché<input name="display_name" value="<%= card.display_name||'' %>"></label><label>Téléphone<input name="phone" value="<%= card.phone||'' %>"></label><label>Email<input name="email" type="email" value="<%= card.email||'' %>"></label><label>Type<select name="card_type"><% ['VIP','FAMILY','PARTNER','CELEBRITY','COURTESY'].forEach(x=>{ %><option <%= card.card_type===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Statut<select name="status"><% ['ACTIVE','SUSPENDED','EXPIRED','REVOKED'].forEach(x=>{ %><option <%= card.status===x?'selected':'' %>><%= x %></option><% }) %></select></label><label>Expiration<input name="expires_at" type="datetime-local" value="<%= card.expires_at ? new Date(new Date(card.expires_at).getTime()-new Date(card.expires_at).getTimezoneOffset()*60000).toISOString().slice(0,16) : '' %>"></label><label>Solde actuel<input name="points_balance" type="number" value="<%= card.points_balance %>"></label><label class="wide">Motif si points modifiés<input name="adjustment_reason" placeholder="Ex. geste commercial, correction..."></label></div><button class="btn">Enregistrer</button></form>
<div class="box"><h2>Historique des points</h2><div class="balance">⭐ <%= card.points_balance %> points</div><table><thead><tr><th>Date</th><th>Type</th><th>Points</th><th>Motif</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><%= new Date(t.created_at).toLocaleString('fr-FR') %></td><td><%= t.transaction_type %></td><td class="<%= t.points>=0?'plus':'minus' %>"><%= t.points>=0?'+':'' %><%= t.points %></td><td><%= t.description||'—' %></td></tr><% }) %></tbody></table></div></div></section>
<style>.ce-wrap{padding:22px}.ce-head{display:flex;justify-content:space-between;gap:15px;margin-bottom:18px}.ce-head span{color:#ff7900;font-weight:900}.ce-head h1{margin:4px 0}.ce-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.box{background:#fff;border:1px solid #eee;border-radius:18px;padding:18px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fields label{font-size:12px;font-weight:800}.wide{grid-column:1/-1}.fields input,.fields select{width:100%;box-sizing:border-box;margin-top:6px;padding:11px;border:1px solid #ddd;border-radius:10px}.btn{display:inline-block;background:#ff7900;color:white;border:0;border-radius:10px;padding:11px 14px;text-decoration:none;font-weight:900}.ghost{background:#fff;color:#222;border:1px solid #ddd}.ok{background:#e9f8ee;padding:12px;border-radius:10px;margin-bottom:15px}.balance{font-size:28px;font-weight:900;margin:15px 0}table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #eee;text-align:left}.plus{color:#16763b;font-weight:900}.minus{color:#b23b2d;font-weight:900}@media(max-width:900px){.ce-grid{grid-template-columns:1fr}.ce-head{flex-direction:column}}</style>
