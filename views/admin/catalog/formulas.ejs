<section class="admin-heading">
    <div>
        <span class="admin-badge">Administration</span>
        <h1>🍱 Formules</h1>
        <p class="admin-subtitle">
            Gérez les formules, leurs produits, leurs prix et leurs images.
        </p>
    </div>

    <button
        type="button"
        class="formula-add-btn"
        onclick="openAddFormulaModal()"
    >
        + Ajouter une formule
    </button>
</section>


<!-- =========================================================
     LISTE DES FORMULES
========================================================= -->

<section class="admin-formulas-page">

    <div class="formulas-panel">

        <div class="formulas-table-wrapper">

            <table class="formulas-table">

                <thead>
                    <tr>
                        <th>Formule</th>
                        <th>Prix</th>
                        <th>Description</th>
                        <th>Produits</th>
                        <th>Images</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                <% if (!formulas || formulas.length === 0) { %>

                    <tr>
                        <td colspan="7">

                            <div class="formulas-empty">

                                <div class="formulas-empty-icon">
                                    🍱
                                </div>

                                <strong>
                                    Aucune formule enregistrée
                                </strong>

                                <span>
                                    Créez votre première formule.
                                </span>

                            </div>

                        </td>
                    </tr>

                <% } %>


                <% (formulas || []).forEach(formula => { %>

                    <tr>

                        <!-- FORMULE -->
                        <td>

                            <div class="formula-product">

                                <% if (formula.primary_image) { %>

                                    <img
                                        src="<%= formula.primary_image %>"
                                        alt="<%= formula.name %>"
                                        class="formula-thumbnail"
                                    >

                                <% } else { %>

                                    <div class="formula-thumbnail formula-thumbnail-empty">
                                        🍱
                                    </div>

                                <% } %>


                                <div class="formula-product-info">

                                    <strong>
                                        <%= formula.name %>
                                    </strong>

                                    <% if (Number(formula.is_featured) === 1) { %>

                                        <span class="featured-badge">
                                            ⭐ Mise en avant
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </td>


                        <!-- PRIX -->
                        <td>

                            <div class="formula-price">

                                <strong>

                                    <%= Number(formula.price || 0)
                                        .toLocaleString("fr-FR") %>

                                    <%= formula.currency || "XAF" %>

                                </strong>


                                <% if (formula.compare_at_price) { %>

                                    <span class="formula-old-price">

                                        <%= Number(formula.compare_at_price)
                                            .toLocaleString("fr-FR") %>

                                        <%= formula.currency || "XAF" %>

                                    </span>

                                <% } %>

                            </div>

                        </td>


                        <!-- DESCRIPTION -->
                        <td>

                            <div class="formula-description">

                                <%= formula.short_description
                                    || formula.description
                                    || "-" %>

                            </div>

                        </td>


                        <!-- PRODUITS -->
                        <td>

                            <span class="formula-count-badge">

                                🍽

                                <strong>
                                    <%= Number(formula.products_count || 0) %>
                                </strong>

                            </span>

                        </td>


                        <!-- IMAGES -->
                        <td>

                            <span class="formula-count-badge">

                                🖼

                                <strong>
                                    <%= Number(formula.images_count || 0) %>
                                </strong>

                                / 6

                            </span>

                        </td>


                        <!-- STATUT -->
                        <td>

                            <% if (Number(formula.is_active) === 1) { %>

                                <span class="formula-status active">
                                    ● Active
                                </span>

                            <% } else { %>

                                <span class="formula-status inactive">
                                    ● Inactive
                                </span>

                            <% } %>

                        </td>


                        <!-- ACTIONS -->
                        <td>

                            <div class="formula-actions">

                                <button
                                    type="button"
                                    class="formula-action-btn edit"
                                    onclick='openEditFormulaModal(
                                        <%- JSON.stringify(formula) %>
                                    )'
                                >
                                    ✏️ Modifier
                                </button>


                                <button
                                    type="button"
                                    class="formula-action-btn products"
                                    onclick='openFormulaProductsModal(
                                        <%= formula.id %>,
                                        <%- JSON.stringify(formula.name) %>
                                    )'
                                >
                                    🍽 Produits
                                </button>


                                <button
                                    type="button"
                                    class="formula-action-btn delete"
                                    onclick='deleteFormula(
                                        <%= formula.id %>,
                                        <%- JSON.stringify(formula.name) %>
                                    )'
                                >
                                    🗑
                                </button>

                            </div>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</section>


<!-- =========================================================
     MODAL AJOUT
========================================================= -->

<div
    id="addFormulaModal"
    class="formula-modal-overlay"
>

    <div class="formula-modal-box">

        <div class="formula-modal-header">

            <div>
                <span class="admin-badge">
                    Nouvelle formule
                </span>

                <h2>
                    🍱 Ajouter une formule
                </h2>
            </div>


            <button
                type="button"
                class="formula-modal-close"
                onclick="closeAddFormulaModal()"
            >
                ×
            </button>

        </div>


        <form
            method="POST"
            action="/admin/formules"
            enctype="multipart/form-data"
            class="formula-form"
        >

            <!-- INFORMATIONS -->

            <section class="formula-form-section">

                <h3>📝 Informations générales</h3>


                <div class="formula-form-grid">

                    <div class="formula-input-group">

                        <label>
                            Nom *
                        </label>

                        <input
                            type="text"
                            name="name"
                            placeholder="Ex : Menu Poulet Braisé"
                            required
                        >

                    </div>


                    <div class="formula-input-group">

                        <label>
                            Description courte
                        </label>

                        <input
                            type="text"
                            name="short_description"
                            placeholder="Poulet + plantain + boisson"
                        >

                    </div>

                </div>


                <div class="formula-input-group">

                    <label>
                        Description complète
                    </label>

                    <textarea
                        name="description"
                        placeholder="Description complète de la formule..."
                    ></textarea>

                </div>

            </section>


            <!-- PRIX -->

            <section class="formula-form-section">

                <h3>💰 Tarification</h3>


                <div class="formula-price-grid">

                    <div class="formula-input-group">

                        <label>Prix *</label>

                        <input
                            type="number"
                            name="price"
                            min="0"
                            step="0.01"
                            required
                        >

                    </div>


                    <div class="formula-input-group">

                        <label>Ancien prix</label>

                        <input
                            type="number"
                            name="compare_at_price"
                            min="0"
                            step="0.01"
                        >

                    </div>


                    <div class="formula-input-group">

                        <label>Devise</label>

                        <select name="currency">

                            <option value="XAF">
                                XAF
                            </option>

                            <option value="EUR">
                                EUR
                            </option>

                        </select>

                    </div>


                    <div class="formula-input-group">

                        <label>Position</label>

                        <input
                            type="number"
                            name="position"
                            value="0"
                        >

                    </div>

                </div>

            </section>


            <!-- PARAMETRES -->

            <section class="formula-form-section">

                <h3>⚙️ Paramètres</h3>


                <div class="formula-checkbox-row">

                    <label>

                        <input
                            type="checkbox"
                            name="is_featured"
                            value="1"
                        >

                        ⭐ Mise en avant

                    </label>


                    <label>

                        <input
                            type="checkbox"
                            name="is_active"
                            value="1"
                            checked
                        >

                        🟢 Active

                    </label>

                </div>

            </section>


            <!-- IMAGES -->

            <section class="formula-form-section">

                <h3>🖼 Images</h3>


                <label class="formula-file-upload">

                    <span class="formula-upload-icon">
                        📷
                    </span>


                    <span>

                        <strong>
                            Sélectionner des images
                        </strong>

                        <small>
                            JPG, PNG, WEBP — maximum 6
                        </small>

                    </span>


                    <input
                        type="file"
                        name="images"
                        accept="image/*"
                        multiple
                        onchange="previewAddFormulaImages(event)"
                    >

                </label>


                <div
                    id="addFormulaPreview"
                    class="formula-images-preview"
                ></div>

            </section>


            <div class="formula-modal-footer">

                <button
                    type="button"
                    class="formula-cancel-btn"
                    onclick="closeAddFormulaModal()"
                >
                    Annuler
                </button>


                <button
                    type="submit"
                    class="formula-save-btn"
                >
                    💾 Enregistrer
                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     MODAL MODIFICATION
========================================================= -->

<div
    id="editFormulaModal"
    class="formula-modal-overlay"
>

    <div class="formula-modal-box">

        <div class="formula-modal-header">

            <div>

                <span class="admin-badge">
                    Modification
                </span>

                <h2>
                    ✏️ Modifier la formule
                </h2>

            </div>


            <button
                type="button"
                class="formula-modal-close"
                onclick="closeEditFormulaModal()"
            >
                ×
            </button>

        </div>


        <form
            id="editFormulaForm"
            method="POST"
            enctype="multipart/form-data"
            class="formula-form"
        >

            <!-- INFORMATIONS -->

            <section class="formula-form-section">

                <h3>📝 Informations générales</h3>


                <div class="formula-form-grid">

                    <div class="formula-input-group">

                        <label>Nom *</label>

                        <input
                            id="editFormulaName"
                            type="text"
                            name="name"
                            required
                        >

                    </div>


                    <div class="formula-input-group">

                        <label>
                            Description courte
                        </label>

                        <input
                            id="editFormulaShortDescription"
                            type="text"
                            name="short_description"
                        >

                    </div>

                </div>


                <div class="formula-input-group">

                    <label>
                        Description complète
                    </label>

                    <textarea
                        id="editFormulaDescription"
                        name="description"
                    ></textarea>

                </div>

            </section>


            <!-- PRIX -->

            <section class="formula-form-section">

                <h3>💰 Tarification</h3>


                <div class="formula-price-grid">

                    <div class="formula-input-group">

                        <label>Prix *</label>

                        <input
                            id="editFormulaPrice"
                            type="number"
                            name="price"
                            step="0.01"
                            required
                        >

                    </div>


                    <div class="formula-input-group">

                        <label>Ancien prix</label>

                        <input
                            id="editFormulaComparePrice"
                            type="number"
                            name="compare_at_price"
                            step="0.01"
                        >

                    </div>


                    <div class="formula-input-group">

                        <label>Devise</label>

                        <select
                            id="editFormulaCurrency"
                            name="currency"
                        >

                            <option value="XAF">
                                XAF
                            </option>

                            <option value="EUR">
                                EUR
                            </option>

                        </select>

                    </div>


                    <div class="formula-input-group">

                        <label>Position</label>

                        <input
                            id="editFormulaPosition"
                            type="number"
                            name="position"
                        >

                    </div>

                </div>

            </section>


            <!-- OPTIONS -->

            <section class="formula-form-section">

                <h3>⚙️ Paramètres</h3>


                <div class="formula-checkbox-row">

                    <label>

                        <input
                            id="editFormulaFeatured"
                            type="checkbox"
                            name="is_featured"
                            value="1"
                        >

                        ⭐ Mise en avant

                    </label>


                    <label>

                        <input
                            id="editFormulaActive"
                            type="checkbox"
                            name="is_active"
                            value="1"
                        >

                        🟢 Active

                    </label>

                </div>

            </section>


            <!-- IMAGES EXISTANTES -->

            <section class="formula-form-section">

                <h3>🖼 Images enregistrées</h3>


                <div
                    id="currentFormulaImages"
                    class="formula-images-preview"
                ></div>

            </section>


            <!-- NOUVELLES IMAGES -->

            <section class="formula-form-section">

                <h3>📷 Ajouter des images</h3>


                <label class="formula-file-upload">

                    <span class="formula-upload-icon">
                        📷
                    </span>


                    <span>

                        <strong>
                            Ajouter des photos
                        </strong>

                        <small>
                            Maximum total : 6
                        </small>

                    </span>


                    <input
                        type="file"
                        name="images"
                        accept="image/*"
                        multiple
                        onchange="previewEditFormulaImages(event)"
                    >

                </label>


                <div
                    id="editFormulaPreview"
                    class="formula-images-preview"
                ></div>

            </section>


            <div class="formula-modal-footer">

                <button
                    type="button"
                    class="formula-cancel-btn"
                    onclick="closeEditFormulaModal()"
                >
                    Annuler
                </button>


                <button
                    type="submit"
                    class="formula-save-btn"
                >
                    💾 Enregistrer
                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     MODAL PRODUITS
========================================================= -->

<div
    id="formulaProductsModal"
    class="formula-modal-overlay"
>

    <div class="formula-modal-box formula-products-modal-box">

        <div class="formula-modal-header">

            <div>

                <span class="admin-badge">
                    Composition
                </span>

                <h2 id="formulaProductsTitle">
                    🍽 Produits
                </h2>

            </div>


            <button
                type="button"
                class="formula-modal-close"
                onclick="closeFormulaProductsModal()"
            >
                ×
            </button>

        </div>


        <section class="formula-form-section">

            <h3>➕ Ajouter un produit</h3>


            <form
                id="addFormulaProductForm"
                method="POST"
                class="formula-product-add-form"
            >

                <div class="formula-input-group">

                    <label>Produit</label>

                    <select
                        name="product_id"
                        required
                    >

                        <option value="">
                            -- Choisir un produit --
                        </option>


                        <% (products || []).forEach(product => { %>

                            <option value="<%= product.id %>">

                                <%= product.name %>

                                —

                                <%= Number(product.price || 0)
                                    .toLocaleString("fr-FR") %>

                                <%= product.currency || "XAF" %>

                            </option>

                        <% }) %>

                    </select>

                </div>


                <div class="formula-input-group">

                    <label>Quantité</label>

                    <input
                        type="number"
                        name="quantity"
                        min="1"
                        value="1"
                    >

                </div>


                <div class="formula-input-group">

                    <label>Position</label>

                    <input
                        type="number"
                        name="position"
                        value="0"
                    >

                </div>


                <button
                    type="submit"
                    class="formula-save-btn formula-product-add-btn"
                >
                    + Ajouter
                </button>

            </form>

        </section>


        <section class="formula-form-section">

            <h3>🍽 Produits présents</h3>

            <div id="formulaProductsList">
                Chargement...
            </div>

        </section>

    </div>

</div>


<!-- =========================================================
     FORM SUPPRESSION
========================================================= -->

<form
    id="deleteFormulaForm"
    method="POST"
    style="display:none;"
></form>


<style>

/* =========================================================
   VARIABLES
========================================================= */

.admin-formulas-page,
.formula-modal-overlay {
    --orange: #ff7900;
    --orange-dark: #e86e00;
    --dark: #17130f;
    --cream: #fff8ef;
    --soft: #faf7f3;
    --muted: #746d66;
    --line: #eadfd3;
    --danger: #b63830;
}


/* =========================================================
   HEADER
========================================================= */

.admin-heading {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:25px;
}

.admin-heading h1 {
    margin:8px 0 4px;
    font-size:38px;
    font-weight:1000;
    letter-spacing:-1.5px;
}

.admin-subtitle {
    margin:0;
    color:#746d66;
    font-size:14px;
}

.admin-badge {
    display:inline-flex;
    padding:7px 14px;
    border-radius:999px;
    background:#fff0df;
    color:#ff7900;
    font-size:12px;
    font-weight:900;
}

.formula-add-btn {
    min-height:48px;
    padding:0 20px;
    border:0;
    border-radius:999px;
    background:#ff7900;
    color:#fff;
    font-weight:900;
    cursor:pointer;
}

.formula-add-btn:hover {
    background:#e86e00;
}


/* =========================================================
   PANEL
========================================================= */

.formulas-panel {
    overflow:hidden;
    background:#fff;
    border:1px solid #eadfd3;
    border-radius:22px;
    box-shadow:0 12px 40px rgba(23,19,15,.06);
}

.formulas-table-wrapper {
    overflow-x:auto;
}

.formulas-table {
    width:100%;
    border-collapse:collapse;
}

.formulas-table thead {
    background:#faf7f3;
}

.formulas-table th {
    padding:15px;
    text-align:left;
    font-size:12px;
    font-weight:900;
    white-space:nowrap;
    border-bottom:1px solid #eadfd3;
}

.formulas-table td {
    padding:15px;
    vertical-align:middle;
    font-size:13px;
    border-bottom:1px solid #eee7e0;
}

.formulas-table tbody tr:last-child td {
    border-bottom:0;
}

.formulas-table tbody tr:hover {
    background:#fffaf5;
}


/* =========================================================
   FORMULE
========================================================= */

.formula-product {
    display:flex;
    align-items:center;
    gap:12px;
    min-width:210px;
}

.formula-thumbnail {
    width:70px;
    height:70px;
    min-width:70px;
    display:block;
    object-fit:cover;
    border-radius:14px;
    background:#fff0df;
}

.formula-thumbnail-empty {
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:27px;
}

.formula-product-info {
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:6px;
}

.formula-product-info strong {
    font-size:14px;
}

.featured-badge {
    padding:4px 8px;
    border-radius:999px;
    background:#fff0df;
    color:#b85a00;
    font-size:9px;
    font-weight:900;
}


/* =========================================================
   PRIX
========================================================= */

.formula-price {
    white-space:nowrap;
}

.formula-price strong {
    display:block;
}

.formula-old-price {
    display:block;
    margin-top:4px;
    color:#999;
    font-size:11px;
    text-decoration:line-through;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.formula-description {
    max-width:270px;
    color:#665f59;
    line-height:1.5;
}


/* =========================================================
   COUNTERS
========================================================= */

.formula-count-badge {
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:7px 10px;
    border-radius:999px;
    background:#f7f3ef;
    white-space:nowrap;
}


/* =========================================================
   STATUS
========================================================= */

.formula-status {
    display:inline-flex;
    padding:7px 11px;
    border-radius:999px;
    font-size:11px;
    font-weight:900;
    white-space:nowrap;
}

.formula-status.active {
    background:#e8f7ee;
    color:#187341;
}

.formula-status.inactive {
    background:#f3efeb;
    color:#746d66;
}


/* =========================================================
   ACTIONS
========================================================= */

.formula-actions {
    display:flex;
    align-items:center;
    gap:6px;
    flex-wrap:wrap;
    min-width:220px;
}

.formula-action-btn {
    min-height:34px;
    padding:0 11px;
    border:0;
    border-radius:999px;
    font-size:10px;
    font-weight:900;
    cursor:pointer;
}

.formula-action-btn.edit {
    background:#f3efeb;
    color:#17130f;
}

.formula-action-btn.products {
    background:#fff0df;
    color:#b95b00;
}

.formula-action-btn.delete {
    background:#fde9e7;
    color:#b63830;
}


/* =========================================================
   EMPTY
========================================================= */

.formulas-empty {
    padding:50px 20px;
    text-align:center;
    color:#746d66;
}

.formulas-empty-icon {
    margin-bottom:10px;
    font-size:38px;
}

.formulas-empty strong {
    display:block;
    margin-bottom:5px;
    color:#17130f;
    font-size:16px;
}


/* =========================================================
   MODAL OVERLAY
========================================================= */

.formula-modal-overlay {
    position:fixed;
    inset:0;
    z-index:99999;

    display:none;
    align-items:center;
    justify-content:center;

    padding:25px;

    background:rgba(20,16,13,.68);
    backdrop-filter:blur(4px);
}

.formula-modal-overlay.show {
    display:flex;
}


/* =========================================================
   MODAL BOX
========================================================= */

.formula-modal-box {
    width:min(900px,100%);
    max-height:calc(100vh - 50px);
    overflow-y:auto;

    padding:28px;

    background:#fff;

    border-radius:26px;
    border:1px solid #eadfd3;

    box-shadow:0 30px 100px rgba(0,0,0,.30);
}

.formula-products-modal-box {
    width:min(1000px,100%);
}


/* =========================================================
   MODAL HEADER
========================================================= */

.formula-modal-header {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;

    padding-bottom:20px;
    margin-bottom:20px;

    border-bottom:1px solid #eee6df;
}

.formula-modal-header h2 {
    margin:8px 0 0;
    font-size:27px;
    font-weight:900;
}

.formula-modal-close {
    width:42px;
    height:42px;
    min-width:42px;

    display:flex;
    align-items:center;
    justify-content:center;

    border:0;
    border-radius:50%;

    background:#f3efeb;

    font-size:24px;
    cursor:pointer;
}

.formula-modal-close:hover {
    background:#17130f;
    color:#fff;
}


/* =========================================================
   FORM
========================================================= */

.formula-form {
    display:flex;
    flex-direction:column;
    gap:18px;
}

.formula-form-section {
    padding:18px;
    margin-bottom:16px;

    background:#faf8f5;

    border:1px solid #eee6df;
    border-radius:18px;
}

.formula-form-section h3 {
    margin:0 0 15px;
    font-size:15px;
    font-weight:900;
}

.formula-form-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-bottom:14px;
}

.formula-price-grid {
    display:grid;
    grid-template-columns:1fr 1fr 120px 110px;
    gap:12px;
}


/* =========================================================
