.lc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:20px 0}.lc-stats div{background:#fff;border:1px solid #eadfd3;border-radius:16px;padding:16px}.lc-stats strong{display:block;font-size:25px}.lc-stats span{color:#756d65;font-size:12px}.lc-filters{display:grid;grid-template-columns:2fr repeat(3,1fr) .7fr .7fr auto;gap:10px;align-items:end;background:#fff;border:1px solid #eadfd3;border-radius:18px;padding:16px;margin-bottom:16px}.lc-filters label{font-size:11px;font-weight:850}.lc-filters input,.lc-filters select{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:10px;border:1px solid #ddd3ca;border-radius:10px;background:#fff}.lc-filter-actions{display:flex;gap:8px;align-items:center}.lc-filter-actions a{color:#756d65;font-weight:800;text-decoration:none;font-size:12px}@media(max-width:1100px){.lc-filters{grid-template-columns:repeat(3,1fr)}.lc-filters .search{grid-column:span 2}}@media(max-width:700px){.lc-stats{grid-template-columns:1fr 1fr}.lc-filters{grid-template-columns:1fr}.lc-filters .search{grid-column:auto}}

/* 16.10.3.1 — finition visuelle page Cartes Tiop+ */
.lc-page-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;margin:0 0 24px;padding:4px 2px 0}.lc-page-heading>div{min-width:0}.lc-page-heading h1{margin:8px 0 4px;font-size:34px;line-height:1.1;letter-spacing:-.7px}.lc-page-heading .muted{margin:0;color:#756d65}.admin-badge{display:inline-flex;align-items:center;padding:6px 11px;border-radius:999px;background:#fff0df;color:#ef7200;font-size:11px;font-weight:900}.btn-tiop-add,.btn-reward-save{appearance:none;border:0;border-radius:999px;background:linear-gradient(135deg,#ff7900,#f36f00);color:#fff!important;text-decoration:none;font-weight:900;cursor:pointer;box-shadow:0 8px 20px rgba(255,121,0,.16);transition:transform .15s ease,box-shadow .15s ease,filter .15s ease}.btn-tiop-add{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 19px;font-size:13px;white-space:nowrap}.btn-reward-save{min-height:44px;padding:0 20px;margin-top:16px}.btn-tiop-add:hover,.btn-reward-save:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(255,121,0,.24);filter:saturate(1.04)}.btn-tiop-add:focus-visible,.btn-reward-save:focus-visible,.lc-mini:focus-visible,.lc-filter-actions a:focus-visible{outline:3px solid rgba(255,121,0,.25);outline-offset:2px}
.lc-stats{gap:14px;margin:0 0 20px}.lc-stats div{position:relative;overflow:hidden;border:1px solid #eadfd3;border-radius:20px;padding:19px 20px;box-shadow:0 6px 18px rgba(73,49,28,.035)}.lc-stats div:before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:#ff7900;opacity:.72}.lc-stats strong{font-size:28px;line-height:1}.lc-stats span{display:block;margin-top:8px;font-size:12px;font-weight:750}
.lc-filters{gap:12px;border-radius:20px;padding:18px 20px;margin-bottom:28px;box-shadow:0 7px 22px rgba(73,49,28,.035)}.lc-filters label{color:#30271f;font-size:11px;font-weight:900}.lc-filters input,.lc-filters select{min-height:43px;margin-top:7px;padding:0 12px;border:1px solid #ded3c8;border-radius:12px;color:#28211c;font-size:13px;outline:none;transition:border-color .15s ease,box-shadow .15s ease}.lc-filters input:focus,.lc-filters select:focus{border-color:#ff9a3d;box-shadow:0 0 0 3px rgba(255,121,0,.10)}.lc-filter-actions{min-height:43px;gap:8px}.lc-filter-actions .btn-tiop-add{min-height:43px;padding:0 16px}.lc-filter-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:43px;padding:0 12px;border-radius:11px;background:#f5f1ed;color:#61574e;font-size:12px;transition:background .15s ease,color .15s ease}.lc-filter-actions a:hover{background:#ece5de;color:#241e19}
.lc-section{padding:0 0 34px}.lc-section-head{margin:0 0 15px}.lc-section-head h2{margin:8px 0 4px;font-size:25px}.lc-table-wrap{overflow:hidden;margin-top:12px;border:1px solid #eadfd3;border-radius:20px;background:#fff;box-shadow:0 8px 24px rgba(73,49,28,.035)}.tiopplus-table{width:100%;border-collapse:collapse}.tiopplus-table thead th{padding:14px 16px;background:#fbf5ef;color:#62584f;font-size:11px;font-weight:900;text-align:left;text-transform:uppercase;letter-spacing:.2px}.tiopplus-table tbody td{padding:17px 16px;border-top:1px solid #f0e8e0;vertical-align:middle}.tiopplus-table tbody tr{transition:background .15s ease}.tiopplus-table tbody tr:hover{background:#fffaf6}.pill{display:inline-flex;padding:5px 9px;border-radius:999px;background:#f2eeea;font-size:11px;font-weight:900}.lc-actions{gap:8px}.lc-mini{min-height:36px;padding:0 12px;border:1px solid transparent;background:#f4f0ec;font-size:11px;transition:transform .15s ease,background .15s ease,border-color .15s ease}.lc-mini:hover{transform:translateY(-1px);background:#ece6e0}.lc-mini.primary{border-color:#ffe1bd;background:#fff2e2;color:#c25700}.lc-mini.primary:hover{background:#ffe8ca}.lc-status{display:inline-flex;align-items:center;justify-content:center;min-height:27px;padding:0 9px}.empty{padding:30px!important;text-align:center;color:#80766d}
.lc-modal{box-shadow:0 28px 80px rgba(15,12,10,.25)}
@media(max-width:900px){.lc-page-heading{align-items:flex-start;flex-direction:column}.lc-page-heading .btn-tiop-add{width:100%}.lc-table-wrap{overflow-x:auto}.tiopplus-table{min-width:820px}}
@media(max-width:700px){.lc-page-heading h1{font-size:29px}.lc-stats{gap:10px}.lc-stats div{padding:15px}.lc-filters{padding:15px}.lc-filter-actions{display:grid;grid-template-columns:1fr 1fr}.lc-filter-actions .btn-tiop-add,.lc-filter-actions a{width:100%}}

.lc-mini.history{background:#fff8ef;color:#a54d00;border-color:#ffe1bd}.lc-mini.replace{background:#eef5ff;color:#245c9d;border-color:#d7e6fb}
.lc-history-modal{width:min(980px,100%)}
.lc-history-balance{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;margin-bottom:14px;border:1px solid #ffe0ba;background:#fff8ef;border-radius:14px}
.lc-history-balance span{font-size:12px;color:#756d65;font-weight:800}.lc-history-balance strong{font-size:22px;color:#e96d00}
.lc-history-table-wrap{overflow:auto;border:1px solid #eadfd3;border-radius:14px}.lc-history-table{width:100%;border-collapse:collapse;min-width:760px}
.lc-history-table th{padding:11px 12px;background:#fbf5ef;text-align:left;font-size:11px;color:#62584f}.lc-history-table td{padding:12px;border-top:1px solid #f0e8e0;font-size:12px;vertical-align:top}
.lc-tx-type{display:inline-flex;padding:5px 8px;border-radius:999px;background:#f2eeea;font-weight:900}.lc-tx-type.earn{background:#e7f8ed;color:#16763b}.lc-tx-type.spend{background:#fff0ed;color:#a83c2d}.lc-tx-type.reversal{background:#eef5ff;color:#245c9d}
.lc-tx-points{font-weight:900;white-space:nowrap}.lc-tx-points.plus{color:#16763b}.lc-tx-points.minus{color:#b33a28}.lc-history-empty{padding:24px;text-align:center;color:#756d65}
.lc-mini.danger{background:#fff0ed;color:#a83c2d;border-color:#ffd7d0}.lc-mini.success{background:#eaf8ef;color:#16763b;border-color:#ccebd7}.lc-status-reason{display:block;margin-top:18px;font-size:12px;font-weight:900}.lc-status-reason textarea{display:block;width:100%;box-sizing:border-box;min-height:95px;margin-top:7px;padding:12px;border:1px solid #ded3c8;border-radius:12px;resize:vertical}.lc-warning{margin-top:12px;padding:11px 13px;border-radius:12px;background:#fff8ef;color:#8a4a12;font-size:12px;font-weight:750}

.lc-mini.link-account{background:#eef8f2;color:#176b3b;border-color:#cfe9d9}.lc-mini.linked-account{background:#edf6ff;color:#245c9d;border-color:#d4e6fa}.lc-link-search{display:block;margin-top:16px;font-size:12px;font-weight:900}.lc-link-search input{display:block;width:100%;box-sizing:border-box;margin-top:7px;padding:12px;border:1px solid #ded3c8;border-radius:12px}.lc-customer-results{margin:12px 0;max-height:280px;overflow:auto;border:1px solid #eadfd3;border-radius:14px}.lc-customer{display:flex;justify-content:space-between;gap:12px;width:100%;padding:13px 14px;border:0;border-bottom:1px solid #f0e8e0;background:#fff;text-align:left;cursor:pointer}.lc-customer:last-child{border-bottom:0}.lc-customer:hover,.lc-customer.selected{background:#fff7ed}.lc-customer strong,.lc-customer span{display:block}.lc-customer small{color:#756d65}.lc-customer .pts{text-align:right;white-space:nowrap;color:#e96d00;font-weight:900}.lc-link-modal .btn-tiop-add{margin-top:14px;width:100%}.lc-link-modal .btn-tiop-add:disabled{opacity:.45;cursor:not-allowed}
</style>
<script>
function openLc(id){document.getElementById(id).classList.add('open')}function closeLc(id){document.getElementById(id).classList.remove('open')}function openCardCreate(){openLc('cardCreateModal')}
function localDateTime(v){if(!v)return '';const d=new Date(v);if(Number.isNaN(d.getTime()))return '';const z=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}T${z(d.getHours())}:${z(d.getMinutes())}`}
function editCard(c){document.getElementById('cardEditForm').action=`/admin/tiopplus/cartes/${c.id}/modifier`;document.getElementById('ceFirst').value=c.first_name||'';document.getElementById('ceLast').value=c.last_name||'';document.getElementById('ceDisplay').value=c.display_name||'';document.getElementById('cePhone').value=c.phone||'';document.getElementById('ceEmail').value=c.email||'';document.getElementById('ceType').value=c.card_type||'VIP';document.getElementById('ceStatus').value=c.status||'ACTIVE';document.getElementById('cePoints').value=c.points_balance||0;document.getElementById('ceExpiry').value=localDateTime(c.expires_at);openLc('cardEditModal')}
function previewCard(c){document.getElementById('pvNumber').textContent=c.card_number||'';document.getElementById('pvName').textContent=c.display_name||'MEMBRE TIOP+';document.getElementById('pvType').textContent=c.card_type||'VIP';document.getElementById('pvPoints').textContent=Number(c.points_balance||0).toLocaleString('fr-FR');document.getElementById('pvQr').src=c.qrDataUrl||'';document.getElementById('pvStatus').textContent='Statut : '+(c.status||'ACTIVE');document.getElementById('pvExpiry').textContent=c.expires_at?new Date(c.expires_at).toLocaleDateString('fr-FR'):'Sans expiration';document.getElementById('pvDownload').href=`/admin/tiopplus/cartes/${c.id}/telecharger`;openLc('cardPreviewModal')}
function openReplaceCard(c){document.getElementById('cardReplaceForm').action=`/admin/tiopplus/cartes/${c.id}/remplacer`;document.getElementById('replaceCardIdentity').textContent=`${c.display_name||'Carte Tiop+'} — ${c.card_number} — ${Number(c.points_balance||0).toLocaleString('fr-FR')} pts`;openLc('cardReplaceModal')}
function openStatusCard(c){const labels={SUSPENDED:'Suspendre la carte',ACTIVE:'Réactiver la carte',REVOKED:'Révoquer définitivement la carte'};document.getElementById('cardStatusForm').action=`/admin/tiopplus/cartes/${c.id}/statut`;document.getElementById('statusValue').value=c.status;document.getElementById('statusModalTitle').textContent=labels[c.status]||'Changer le statut';document.getElementById('statusCardText').textContent=`Carte ${c.card_number}`;document.getElementById('statusWarning').textContent=c.status==='REVOKED'?'Attention : une carte révoquée ne pourra pas être réactivée.':c.status==='SUSPENDED'?'La carte sera immédiatement refusée au POS et ne pourra ni gagner ni dépenser de points.':'La carte redeviendra utilisable immédiatement si elle n’est pas expirée.';openLc('cardStatusModal')}
function printCurrentCard(){window.print()}
function historyTypeLabel(t){return ({EARN:'Gain',SPEND:'Dépense',ADJUSTMENT:'Ajustement',REVERSAL:'Restitution'})[String(t||'').toUpperCase()]||String(t||'—')}
function historyDate(v){if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?'—':d.toLocaleString('fr-FR')}
function escapeHistoryHtml(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
async function openCardHistory(id){
  const loading=document.getElementById('historyLoading'),wrap=document.getElementById('historyTableWrap'),rows=document.getElementById('historyRows');
  loading.hidden=false;loading.textContent='Chargement de l’historique…';wrap.hidden=true;rows.innerHTML='';openLc('cardHistoryModal');
  try{
    const r=await fetch(`/admin/tiopplus/cartes/${Number(id)}/historique`,{headers:{Accept:'application/json'}});
    const data=await r.json().catch(()=>({}));
    if(!r.ok||!data.ok)throw new Error(data.message||'Historique indisponible.');
    const c=data.card||{},name=c.display_name||[c.first_name,c.last_name].filter(Boolean).join(' ')||'Carte Tiop+';
    document.getElementById('historyCardIdentity').textContent=`${name} — ${c.card_number||''}`;
    document.getElementById('historyCardBalance').innerHTML=`<span>Solde actuel</span><strong>${Number(c.points_balance||0).toLocaleString('fr-FR')} pts</strong>`;
    const tx=Array.isArray(data.transactions)?data.transactions:[];
    if(!tx.length){loading.textContent='Aucun mouvement enregistré pour cette carte.';return}
    rows.innerHTML=tx.map(x=>{
      const pts=Number(x.points||0),cls=pts>0?'plus':pts<0?'minus':'zero',sign=pts>0?'+':'';
      return `<tr><td>${escapeHistoryHtml(historyDate(x.created_at))}</td><td><span class="lc-tx-type ${String(x.transaction_type||'').toLowerCase()}">${escapeHistoryHtml(historyTypeLabel(x.transaction_type))}</span></td><td class="lc-tx-points ${cls}">${sign}${pts.toLocaleString('fr-FR')} pts</td><td>${x.order_id?`#${Number(x.order_id)}`:'—'}</td><td>${escapeHistoryHtml(x.description||'—')}</td></tr>`;
    }).join('');
    loading.hidden=true;wrap.hidden=false;
  }catch(e){loading.hidden=false;loading.textContent=e.message||'Impossible de charger l’historique.'}
}


let linkSearchTimer=null;
function openLinkAccount(c){document.getElementById('cardLinkForm').action=`/admin/tiopplus/cartes/${c.id}/rattacher-compte`;document.getElementById('linkCardIdentity').textContent=`${c.display_name||'Carte Tiop+'} — ${c.card_number} — ${Number(c.points_balance||0).toLocaleString('fr-FR')} pts`;document.getElementById('linkCustomerSearch').value='';document.getElementById('linkUserId').value='';document.getElementById('linkSubmit').disabled=true;document.getElementById('linkCustomerResults').innerHTML='<p class="muted" style="padding:12px">Saisissez au moins 2 caractères.</p>';openLc('cardLinkModal');setTimeout(()=>document.getElementById('linkCustomerSearch').focus(),80)}
function selectLinkCustomer(btn,id){document.querySelectorAll('#linkCustomerResults .lc-customer').forEach(x=>x.classList.remove('selected'));btn.classList.add('selected');document.getElementById('linkUserId').value=id;document.getElementById('linkSubmit').disabled=false}
async function searchLinkCustomers(q){const box=document.getElementById('linkCustomerResults');if(q.trim().length<2){box.innerHTML='<p class="muted" style="padding:12px">Saisissez au moins 2 caractères.</p>';return}box.innerHTML='<p class="muted" style="padding:12px">Recherche…</p>';try{const r=await fetch(`/admin/tiopplus/cartes/clients/recherche?q=${encodeURIComponent(q.trim())}`,{headers:{Accept:'application/json'}});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.message||'Recherche impossible.');const a=d.customers||[];box.innerHTML=a.length?a.map(u=>{const name=u.display_name||[u.first_name,u.last_name].filter(Boolean).join(' ')||'Client';const blocked=u.linked_card_id?` — déjà lié à ${u.linked_card_number}`:'';return `<button type="button" class="lc-customer" ${u.linked_card_id?'disabled':''} onclick="selectLinkCustomer(this,${Number(u.id)})"><span><strong>${escapeHistoryHtml(name)}</strong><small>${escapeHistoryHtml(u.email||'')} ${escapeHistoryHtml(u.phone||'')}${escapeHistoryHtml(blocked)}</small></span><span class="pts">${Number(u.account_points_balance||0).toLocaleString('fr-FR')} pts compte</span></button>`}).join(''):'<p class="muted" style="padding:12px">Aucun compte client Tiop+ trouvé.</p>'}catch(e){box.innerHTML=`<p class="muted" style="padding:12px">${escapeHistoryHtml(e.message)}</p>`}}
document.getElementById('linkCustomerSearch')?.addEventListener('input',e=>{clearTimeout(linkSearchTimer);linkSearchTimer=setTimeout(()=>searchLinkCustomers(e.target.value),250)});
async function showLinkedAccount(id){const box=document.getElementById('linkedAccountContent');box.textContent='Chargement…';openLc('linkedAccountModal');try{const r=await fetch(`/admin/tiopplus/cartes/${Number(id)}/compte-rattache`,{headers:{Accept:'application/json'}}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.message||'Compte indisponible.');const u=d.customer,c=d.card;if(!u){box.innerHTML='<p>Aucun compte rattaché.</p>';return}const name=u.display_name||[u.first_name,u.last_name].filter(Boolean).join(' ')||'Client';box.innerHTML=`<p><strong>${escapeHistoryHtml(name)}</strong></p><p>${escapeHistoryHtml(u.email||'—')} · ${escapeHistoryHtml(u.phone||'—')}</p><p>Carte physique : <strong>${Number(c.points_balance||0).toLocaleString('fr-FR')} pts</strong></p><p>Compte Tiop+ numérique : <strong>${Number(u.account_points_balance||0).toLocaleString('fr-FR')} pts</strong></p><p class="muted">Les deux historiques restent distincts afin d’éviter toute duplication de points.</p>`}catch(e){box.textContent=e.message||'Impossible de charger le compte.'}}

document.querySelectorAll('.lc-overlay').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')}));
</script>
