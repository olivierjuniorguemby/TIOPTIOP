.lc-loyalty-card{position:relative;overflow:hidden;max-width:760px;margin:8px auto 0;border-radius:32px;color:#fff;background:radial-gradient(circle at 92% 38%,rgba(255,125,0,.24),transparent 24%),linear-gradient(135deg,#0b0b0b 0%,#15110d 54%,#25150a 100%);box-shadow:0 24px 52px rgba(49,31,12,.2);border:1px solid rgba(255,255,255,.06)}.lc-loyalty-card:before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 24px,rgba(255,121,0,.035) 24px 25px),linear-gradient(115deg,transparent 52%,rgba(255,121,0,.08) 78%,rgba(255,121,0,.17) 100%);pointer-events:none}.lc-card-top{position:relative;z-index:2;min-height:285px;padding:30px 34px 24px;display:grid;grid-template-columns:1fr 180px;gap:20px}.lc-brand{font-size:42px;font-weight:950;letter-spacing:-2px}.lc-brand span{color:#ff7900}.lc-sub{margin-top:3px;color:#ffc15f;font-size:12px;font-weight:900;letter-spacing:1.4px}.lc-member{margin-top:38px}.lc-member span,.lc-name span,.lc-stat span{display:block;color:#d8d0c8;font-size:11px;font-weight:800;letter-spacing:.5px}.lc-member strong{display:inline-block;margin-top:7px;color:#ffb23c;font-size:25px;font-weight:950;letter-spacing:1px}.lc-contactless{display:inline-block;margin-left:12px;font-size:26px;transform:rotate(90deg);color:#ffbb4d}.lc-name{margin-top:24px}.lc-name strong{display:block;margin-top:7px;font-size:20px;font-weight:950;text-transform:uppercase}.lc-right{text-align:right}.lc-level{font-size:11px;color:#d9cec0;margin-bottom:16px}.lc-level strong{display:block;color:#ffba48;font-size:22px;margin-top:3px}.lc-qr{width:142px;height:142px;margin-left:auto;padding:9px;border-radius:18px;background:#fff;border:5px solid #ffb23c;box-shadow:0 8px 28px rgba(255,121,0,.28)}.lc-qr img{display:block;width:100%;height:100%;object-fit:contain}.lc-scan{margin-top:7px;font-size:11px;font-weight:800;color:#f7eee5}.lc-card-bottom{position:relative;z-index:3;display:grid;grid-template-columns:1fr 1fr;background:linear-gradient(90deg,#ff7900,#ef7200 52%,#d96500)}.lc-stat{display:flex;align-items:center;gap:16px;padding:22px 34px;min-height:112px}.lc-stat+.lc-stat{border-left:1px solid rgba(255,255,255,.22)}.lc-stat>b{font-size:34px}.lc-stat span{color:#fff}.lc-stat strong{display:block;margin-top:4px;font-size:35px;line-height:1;font-weight:950}.lc-stat strong small{font-size:12px}.lc-stat strong.expiry{font-size:23px}.lc-stat i{font-style:normal}.lc-stat div>small{display:block;margin-top:8px;font-size:10px;font-weight:800}.lc-preview-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:18px}.lc-download{display:inline-flex;align-items:center;padding:12px 18px;border-radius:999px;background:#211b16;color:#fff;text-decoration:none;font-weight:900}.lc-note{text-align:center;color:#756d65;font-size:12px;margin:12px auto 0;max-width:650px}
@media(max-width:700px){.lc-section-head{align-items:flex-start;flex-direction:column}.lc-fields{grid-template-columns:1fr}.lc-fields .wide{grid-column:auto}.lc-card-top{grid-template-columns:1fr;padding:24px}.lc-right{display:grid;grid-template-columns:1fr 130px;gap:10px;align-items:end}.lc-level{text-align:left}.lc-qr{width:120px;height:120px}.lc-card-bottom{grid-template-columns:1fr}.lc-stat+.lc-stat{border-left:0;border-top:1px solid rgba(255,255,255,.22)}}
