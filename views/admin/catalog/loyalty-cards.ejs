<section class="admin-heading lc-page-heading"><div><span class="admin-badge">Administration Tiop+</span><h1>🎫 Cartes Tiop+</h1><p class="muted">Cartes physiques et nominatives pour VIP, proches, partenaires, célébrités et invités sans compte.</p></div><button type="button" class="btn-tiop-add" onclick="openCardCreate()">+ Nouvelle carte</button></section>

<section class="lc-stats"><div><strong><%= stats.total %></strong><span>Total</span></div><div><strong><%= stats.active %></strong><span>Actives</span></div><div><strong><%= stats.suspended %></strong><span>Suspendues</span></div><div><strong><%= stats.expired %></strong><span>Expirées</span></div></section>
<form class="lc-filters" method="get" action="/admin/tiopplus/carte"><label class="search">Rechercher<input name="q" value="<%= filters.q %>" placeholder="Nom, téléphone, email, n° carte..."></label><label>Type<select name="type"><option value="">Tous</option><% ['VIP','FAMILY','PARTNER','CELEBRITY','COURTESY'].forEach(v=>{ %><option value="<%= v %>" <%= filters.type===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Statut<select name="status"><option value="">Tous</option><% ['ACTIVE','SUSPENDED','EXPIRED','REVOKED'].forEach(v=>{ %><option value="<%= v %>" <%= filters.status===v?'selected':'' %>><%= v %></option><% }) %></select></label><label>Expiration<select name="expiry"><option value="">Toutes</option><option value="SOON" <%= filters.expiry==='SOON'?'selected':'' %>>Expire sous 30 jours</option><option value="EXPIRED" <%= filters.expiry==='EXPIRED'?'selected':'' %>>Déjà expirée</option><option value="NONE" <%= filters.expiry==='NONE'?'selected':'' %>>Sans expiration</option></select></label><label>Points min<input type="number" name="min_points" value="<%= filters.min_points %>" min="0"></label><label>Points max<input type="number" name="max_points" value="<%= filters.max_points %>" min="0"></label><div class="lc-filter-actions"><button class="btn-tiop-add">Filtrer</button><a href="/admin/tiopplus/carte">Réinitialiser</a></div></form>

<section id="cartes" class="lc-section">
  <div class="lc-section-head">
    <div><span class="admin-badge">Cartes physiques / VIP</span><h2>🎫 Cartes avantages nominatives</h2><p class="muted">Pour les proches, partenaires, célébrités ou invités sans compte client.</p></div>
    
  </div>
  <% if (cardCreated) { %><div class="tp-alert ok">✅ Carte Tiop+ créée avec succès.</div><% } %>
  <% if (cardUpdated) { %><div class="tp-alert ok">✅ Carte Tiop+ mise à jour.</div><% } %>
  <% if (typeof cardReplaced !== 'undefined' && cardReplaced) { %><div class="tp-alert ok">✅ Carte remplacée : l’ancienne carte a été révoquée et son solde transféré vers la nouvelle.</div><% } %>
  <% if (typeof cardLinked !== 'undefined' && cardLinked) { %><div class="tp-alert ok">✅ Carte physique rattachée au compte client Tiop+. Le solde et l’historique de la carte sont conservés.</div><% } %>
  <div class="tiopplus-table-wrapper lc-table-wrap"><table class="tiopplus-table"><thead><tr><th>Carte</th><th>Personne</th><th>Type</th><th>Points</th><th>Expiration</th><th>Statut</th><th>Actions</th></tr></thead><tbody>
  <% (cards || []).forEach(function(c){ const person=c.display_name || [c.first_name,c.last_name].filter(Boolean).join(' '); %>
    <tr><td><strong><%= c.card_number %></strong></td><td><%= person %></td><td><span class="pill"><%= c.card_type %></span></td><td><strong><%= Number(c.points_balance||0).toLocaleString('fr-FR') %></strong> pts</td><td><%= c.expires_at ? new Date(c.expires_at).toLocaleDateString('fr-FR') : '—' %></td><td><span class="lc-status <%= String(c.status).toLowerCase() %>"><%= c.status %></span></td><td><div class="lc-actions">
      <button type="button" class="lc-mini primary" onclick='previewCard(<%- JSON.stringify({id:c.id,card_number:c.card_number,display_name:person,card_type:c.card_type,points_balance:c.points_balance,expires_at:c.expires_at,status:c.status,qrDataUrl:c.qrDataUrl}) %>)'>👁 Visualiser</button>
      <button type="button" class="lc-mini" onclick='editCard(<%- JSON.stringify(c) %>)'>✏ Modifier</button>
      <button type="button" class="lc-mini history" onclick="openCardHistory(<%= c.id %>)">🕘 Historique</button>
      <% if (!c.user_id && c.status !== 'REVOKED') { %><button type="button" class="lc-mini link-account" onclick='<%- `openLinkAccount(${JSON.stringify({id:c.id,card_number:c.card_number,display_name:person,points_balance:c.points_balance})})` %>'>👤 Rattacher compte</button><% } %>
      <% if (c.user_id) { %><button type="button" class="lc-mini linked-account" onclick="showLinkedAccount(<%= c.id %>)">✓ Compte #<%= c.user_id %></button><% } %>
      <% if (c.status !== 'REVOKED') { %><button type="button" class="lc-mini replace" onclick='openReplaceCard(<%- JSON.stringify({id:c.id,card_number:c.card_number,display_name:person,points_balance:c.points_balance,status:c.status}) %>)'>🔁 Remplacer</button><% } %>
      <% if (c.status === 'ACTIVE') { %><button type="button" class="lc-mini danger" onclick='openStatusCard(<%- JSON.stringify({id:c.id,card_number:c.card_number,status:"SUSPENDED"}) %>)'>⏸ Suspendre</button><% } %>
      <% if (c.status === 'SUSPENDED') { %><button type="button" class="lc-mini success" onclick='openStatusCard(<%- JSON.stringify({id:c.id,card_number:c.card_number,status:"ACTIVE"}) %>)'>▶ Réactiver</button><% } %>
      <% if (c.status !== 'REVOKED') { %><button type="button" class="lc-mini danger" onclick='openStatusCard(<%- JSON.stringify({id:c.id,card_number:c.card_number,status:"REVOKED"}) %>)'>⛔ Révoquer</button><% } %>
      <a class="lc-mini" href="/admin/tiopplus/cartes/<%= c.id %>/telecharger">⬇ Télécharger</a>
    </div></td></tr>
  <% }) %>
  <% if (!(cards||[]).length) { %><tr><td colspan="7" class="empty">Aucune carte nominative. Créez votre première carte Tiop+.</td></tr><% } %>
  </tbody></table></div>
</section>

<div id="cardCreateModal" class="lc-overlay"><div class="lc-modal"><div class="lc-modal-head"><h2>🎫 Nouvelle carte Tiop+</h2><button type="button" onclick="closeLc('cardCreateModal')">×</button></div>
<form method="post" action="/admin/tiopplus/cartes"><div class="lc-fields"><label>Prénom<input name="first_name"></label><label>Nom<input name="last_name"></label><label class="wide">Nom affiché<input name="display_name" placeholder="Ex. Jean Exemple"></label><label>Téléphone<input name="phone"></label><label>Email<input name="email" type="email"></label><label>Type<select name="card_type"><option>VIP</option><option>FAMILY</option><option>PARTNER</option><option>CELEBRITY</option><option>COURTESY</option></select></label><label>Points initiaux<input name="points" type="number" min="0" value="0"></label><label class="wide">Expiration<input name="expires_at" type="datetime-local"></label></div><button class="btn-reward-save">Créer la carte</button></form></div></div>

<div id="cardEditModal" class="lc-overlay"><div class="lc-modal"><div class="lc-modal-head"><h2>✏ Modifier la carte</h2><button type="button" onclick="closeLc('cardEditModal')">×</button></div>
<form id="cardEditForm" method="post"><div class="lc-fields"><label>Prénom<input id="ceFirst" name="first_name"></label><label>Nom<input id="ceLast" name="last_name"></label><label class="wide">Nom affiché<input id="ceDisplay" name="display_name"></label><label>Téléphone<input id="cePhone" name="phone"></label><label>Email<input id="ceEmail" name="email" type="email"></label><label>Type<select id="ceType" name="card_type"><option>VIP</option><option>FAMILY</option><option>PARTNER</option><option>CELEBRITY</option><option>COURTESY</option></select></label><label>Statut<select id="ceStatus" name="status"><option>ACTIVE</option><option>SUSPENDED</option><option>EXPIRED</option><option>REVOKED</option></select></label><label>Solde actuel<input id="cePoints" name="points_balance" type="number"></label><label>Expiration<input id="ceExpiry" name="expires_at" type="datetime-local"></label><label class="wide">Motif si les points changent<input name="adjustment_reason" placeholder="Ex. geste commercial, correction..."></label></div><button class="btn-reward-save">Enregistrer</button></form></div></div>



<div id="cardReplaceModal" class="lc-overlay"><div class="lc-modal"><div class="lc-modal-head"><div><h2>🔁 Remplacer la carte</h2><p id="replaceCardIdentity" class="muted"></p></div><button type="button" onclick="closeLc('cardReplaceModal')">×</button></div>
<form id="cardReplaceForm" method="post"><div class="lc-warning"><strong>Ce qui va se passer :</strong><br>• une nouvelle carte, un nouveau numéro et un nouveau QR seront générés ;<br>• le solde actuel sera transféré à 100 % ;<br>• l’ancienne carte passera définitivement à REVOKED avec un solde de 0 point ;<br>• l’historique du transfert restera traçable.</div><label class="lc-status-reason">Motif du remplacement<textarea name="reason" required maxlength="255" placeholder="Ex. carte perdue, détériorée, QR illisible..."></textarea></label><button class="btn-reward-save">Confirmer le remplacement</button></form></div></div>

<div id="cardStatusModal" class="lc-overlay"><div class="lc-modal"><div class="lc-modal-head"><h2 id="statusModalTitle">Cycle de vie de la carte</h2><button type="button" onclick="closeLc('cardStatusModal')">×</button></div>
<form id="cardStatusForm" method="post"><input id="statusValue" type="hidden" name="status"><p id="statusCardText" class="muted"></p><label class="lc-status-reason">Motif de l’opération<textarea name="reason" required maxlength="255" placeholder="Ex. carte perdue, suspension temporaire, remplacement..."></textarea></label><div class="lc-warning" id="statusWarning"></div><button class="btn-reward-save">Confirmer</button></form></div></div>
<div id="cardHistoryModal" class="lc-overlay"><div class="lc-modal lc-history-modal">
  <div class="lc-modal-head"><div><h2>🕘 Historique de la carte</h2><p id="historyCardIdentity" class="muted"></p></div><button type="button" onclick="closeLc('cardHistoryModal')">×</button></div>
  <div id="historyCardBalance" class="lc-history-balance"></div>
  <div id="historyLoading" class="lc-history-empty">Chargement de l’historique…</div>
  <div id="historyTableWrap" class="lc-history-table-wrap" hidden>
    <table class="lc-history-table"><thead><tr><th>Date</th><th>Type</th><th>Points</th><th>Commande</th><th>Description</th></tr></thead><tbody id="historyRows"></tbody></table>
  </div>
</div></div>

<div id="cardLinkModal" class="lc-overlay"><div class="lc-modal lc-link-modal"><div class="lc-modal-head"><div><h2>👤 Rattacher à un compte client Tiop+</h2><p id="linkCardIdentity" class="muted"></p></div><button type="button" onclick="closeLc('cardLinkModal')">×</button></div>
  <div class="lc-warning">Le rattachement associe l’identité du compte à la carte. Les points et l’historique existants de la carte restent intacts et ne sont pas dupliqués dans le solde numérique du compte.</div>
  <label class="lc-link-search">Rechercher un client Tiop+<input id="linkCustomerSearch" type="search" placeholder="Nom, email ou téléphone…" autocomplete="off"></label>
  <div id="linkCustomerResults" class="lc-customer-results"><p class="muted">Saisissez au moins 2 caractères.</p></div>
  <form id="cardLinkForm" method="post"><input id="linkUserId" type="hidden" name="user_id"><label class="lc-status-reason">Motif / note<textarea name="reason" placeholder="Ex. Le client a créé son compte et souhaite rattacher sa carte physique."></textarea></label><button id="linkSubmit" class="btn-tiop-add" type="submit" disabled>Rattacher le compte sélectionné</button></form>
</div></div>

<div id="linkedAccountModal" class="lc-overlay"><div class="lc-modal"><div class="lc-modal-head"><h2>✓ Compte client rattaché</h2><button type="button" onclick="closeLc('linkedAccountModal')">×</button></div><div id="linkedAccountContent">Chargement…</div></div></div>

<div id="cardPreviewModal" class="lc-overlay"><div class="lc-modal lc-preview-modal"><div class="lc-modal-head no-print"><div><h2>Aperçu de la carte</h2><p class="muted">Même identité visuelle que la carte Tiop+ client.</p></div><button type="button" onclick="closeLc('cardPreviewModal')">×</button></div>
<div id="printCardArea"><article class="lc-loyalty-card"><div class="lc-card-top"><div><div class="lc-brand">Tiop<span>+</span></div><div class="lc-sub">CARTE DE FIDÉLITÉ</div><div class="lc-member"><span>N° MEMBRE</span><strong id="pvNumber"></strong><b class="lc-contactless">)))</b></div><div class="lc-name"><span>NOM DU MEMBRE</span><strong id="pvName"></strong></div></div><div class="lc-right"><div class="lc-level">TYPE<strong id="pvType"></strong></div><div class="lc-qr"><img id="pvQr" alt="QR sécurisé Tiop+"></div><div class="lc-scan">🛡 Scan en caisse</div></div></div><div class="lc-card-bottom"><div class="lc-stat"><b>⭐</b><div><span>SOLDE POINTS</span><strong><i id="pvPoints"></i> <small>points</small></strong></div></div><div class="lc-stat"><b>📅</b><div><span>VALIDITÉ</span><strong class="expiry"><i id="pvExpiry"></i></strong><small id="pvStatus"></small></div></div></div></article></div>
<div class="lc-preview-actions no-print"><button type="button" class="btn-tiop-add" onclick="printCurrentCard()">🖨 Imprimer</button><a id="pvDownload" class="lc-download">⬇ Télécharger la carte</a></div><p class="lc-note no-print">Le QR sécurisé permet au POS de vérifier le solde réel, le statut et l'expiration. Les points imprimés correspondent au solde au moment de l'impression.</p></div></div>

<style>
