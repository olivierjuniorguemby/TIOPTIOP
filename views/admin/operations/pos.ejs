              🍗
            </div>

            <div>
              <strong>Poulet Moambe</strong>
              <small>11,90 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'moambe',
              'Poulet Moambe',
              11.90,
              '🍗'
            )"
          >
            Ajouter
          </button>

        </div>


        <!-- PRODUIT 7 -->
        <div
          class="pos-product"
          data-name="Banane Plantain"
        >

          <div class="pos-product-info">

            <div class="pos-product-icon">
              🍌
            </div>

            <div>
              <strong>Banane Plantain</strong>
              <small>4,00 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'plantain',
              'Banane Plantain',
              4,
