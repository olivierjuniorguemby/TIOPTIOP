          </button>

        </div>

      </div>

    </div>


    <!-- ==================================================
         PANIER POS
    =================================================== -->

    <aside class="pos-panel pos-cart-panel">

      <h3>Panier POS</h3>

      <div id="posCartEmpty" class="pos-cart-empty">
        Panier vide.
      </div>

      <div id="posCartItems"></div>


      <!-- TOTAL -->
      <div
        id="posCartSummary"
        class="pos-cart-summary"
        style="display:none;"
      >

        <div>
          <span>Sous-total</span>
          <strong id="posSubtotal">0,00 €</strong>
        </div>

        <div>
          <span>Livraison</span>
          <strong>0,00 €</strong>
        </div>

        <div class="pos-total">
          <span>Total</span>
          <strong id="posTotal">0,00 €</strong>
        </div>

      </div>


      <!-- INFORMATION PAIEMENT -->

      <div
        id="posPaymentInformation"
        class="pos-payment-information"
      >
        Espèces = EN ATTENTE jusqu'à confirmation de l'encaissement.
      </div>


      <!-- CRÉATION COMMANDE -->

      <button
        type="button"
        id="createPosOrderButton"
        class="pos-create-order"
        onclick="createPosOrder()"
      >
        Créer la commande
      </button>

    </aside>

  </div>

</section>

<style>
  /* =====================================================
   POS
===================================================== */

.pos-page {
    padding: 20px;
}

.pos-page-header {
    margin-bottom: 20px;
}

.pos-page-header h1 {
    margin: 8px 0 0;
    font-size: 32px;
}

.pos-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 12px;
    align-items: stretch;
}

.pos-panel {
    background: #fff;
    border-radius: 18px;
    padding: 18px;
    min-width: 0;
}

.pos-panel h3 {
    margin: 0 0 15px;
}


/* =========================
   CHAMPS
========================= */

.pos-fields {
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
}

.pos-field {
    width: 100%;
    min-height: 42px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
    padding: 0 12px;
    outline: none;
}

.pos-field:focus {
    border-color: #ff7900;
}


/* =========================
   PRODUITS
========================= */

.pos-products-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.pos-products-header input {
    display: none;
    max-width: 230px;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 10px 12px;
}

.pos-products-list {
    border: 1px solid #ddd;
    border-radius: 14px;

    max-height: 430px;
    overflow-y: auto;

    padding: 8px;
}

.pos-product {
    display: flex;
    align-items: center;
    justify-content: space-between;

    border: 1px solid #ddd;
    border-radius: 11px;

    padding: 10px;
    margin-bottom: 8px;

    transition: .15s;
}

.pos-product:last-child {
    margin-bottom: 0;
}

.pos-product:hover {
    border-color: #ff7900;
    background: #fffaf5;
}

.pos-product-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.pos-product-info strong,
.pos-product-info small {
    display: block;
}

.pos-product-info small {
    margin-top: 3px;
    color: #777;
}

.pos-product-icon {
    width: 42px;
    height: 42px;

    border-radius: 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #fff2df;

    font-size: 20px;
}

.pos-add-button {
    border: 0;
    background: #fff;

    padding: 9px 15px;

    border-radius: 25px;

    font-weight: 800;
    cursor: pointer;

    box-shadow: 0 4px 15px rgba(0,0,0,.05);
}

.pos-add-button:hover {
    background: #ff7900;
    color: #fff;
}


/* =========================
   PANIER
========================= */

.pos-cart-panel {
    min-height: 560px;
}

.pos-cart-empty {
    color: #777;
    margin-bottom: 12px;
}


/* ARTICLE PANIER */

.pos-cart-item {
    display: grid;

    grid-template-columns:
        minmax(0,1fr)
        auto
        auto;

    align-items: center;

    gap: 15px;

    padding: 12px 0;

    border-bottom: 1px solid #eee;
}

.pos-cart-product {
    display: flex;
    align-items: center;
    gap: 10px;
}

.pos-cart-product strong,
.pos-cart-product small {
    display: block;
}

.pos-cart-product small {
    color: #777;
    margin-top: 3px;
}


/* QUANTITÉ */

.pos-quantity {
    display: flex;
    align-items: center;
    gap: 8px;
}

.pos-quantity button {
    width: 27px;
    height: 27px;

    border: 1px solid #ddd;
    background: #fff;

    border-radius: 50%;

    cursor: pointer;
}


/* SUPPRESSION */

.pos-remove {
    border: none;
    background: transparent;

    color: #b8432c;

    cursor: pointer;
    font-weight: 700;
}


/* =========================
   RÉCAPITULATIF
========================= */

.pos-cart-summary {
    margin-top: 20px;

    border-top: 1px solid #eee;

    padding-top: 15px;
}

.pos-cart-summary > div {
    display: flex;
    justify-content: space-between;

    margin-bottom: 9px;
}

.pos-cart-summary .pos-total {
    border-top: 1px solid #ddd;

    margin-top: 12px;
    padding-top: 14px;

    font-size: 18px;
}


/* =========================
   PAIEMENT
========================= */

.pos-payment-information {
    background: #eaf8ef;
    color: #377450;

    padding: 12px;

    border-radius: 10px;

    margin-top: 12px;

    font-size: 13px;
}


/* =========================
   BOUTON COMMANDE
========================= */

.pos-create-order {
    width: 100%;

    border: none;

    margin-top: 12px;

    padding: 13px;

    border-radius: 30px;

    background: #ff7900;
    color: white;

    font-weight: 800;

    cursor: pointer;
}

.pos-create-order:hover {
    background: #e96f00;
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width: 900px) {

    .pos-layout {
        grid-template-columns: 1fr;
    }

    .pos-cart-panel {
        min-height: auto;
    }

}

@media(max-width: 600px) {

    .pos-page {
        padding: 12px;
    }

    .pos-page-header h1 {
        font-size: 25px;
    }

    .pos-product {
        gap: 10px;
    }

    .pos-cart-item {
        grid-template-columns: 1fr;
    }

}
</style>
<script src="/js/admin-pos.js"></script>
