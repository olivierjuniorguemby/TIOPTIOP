<section class="admin-heading">
  <div>
    <span class="eyebrow">Administration</span>
    <h1>➕ POS / Nouvelle commande</h1>
  </div>
</section>

<section class="pos-page">


  <div class="pos-layout">

    <!-- ==================================================
         COLONNE GAUCHE
    =================================================== -->
    <div class="pos-panel">

      <h3>Client & canal</h3>

      <div class="pos-fields">

        <!-- CLIENT -->
        <select id="posClient" class="pos-field">
          <option value="guest">Invité</option>
          <option value="client-demo">Client Démo</option>
          <option value="nouveau">+ Nouveau client</option>
        </select>

        <!-- CANAL -->
        <select id="posChannel" class="pos-field">
          <option value="pos">Téléphone/POS</option>
          <option value="restaurant">Sur place</option>
          <option value="takeaway">À emporter</option>
          <option value="whatsapp">WhatsApp</option>
        </select>

        <!-- PAIEMENT -->
        <select id="posPayment" class="pos-field">
          <option value="cash">Espèces</option>
          <option value="card">Carte bancaire</option>
          <option value="mobile">Mobile Money</option>
        </select>

      </div>


      <!-- ==================================================
           PRODUITS
      =================================================== -->

      <div class="pos-products-header">
        <h3>Produits</h3>

        <input
          type="search"
          id="posProductSearch"
          placeholder="Rechercher..."
          oninput="filterPosProducts()"
        >
      </div>


      <div class="pos-products-list" id="posProductsList">

        <!-- PRODUIT 1 -->
        <div
          class="pos-product"
          data-name="Saka-Saka Royal"
        >

          <div class="pos-product-info">

            <div class="pos-product-icon">
              🌿
            </div>

            <div>
              <strong>Saka-Saka Royal</strong>
              <small>8,90 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'saka',
              'Saka-Saka Royal',
              8.90,
              '🌿'
            )"
          >
            Ajouter
          </button>

        </div>


        <!-- PRODUIT 2 -->
        <div
          class="pos-product"
          data-name="Poulet Braisé Tiop"
        >

          <div class="pos-product-info">

            <div class="pos-product-icon">
              🔥
            </div>

            <div>
              <strong>Poulet Braisé Tiop</strong>
              <small>12,90 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'poulet',
              'Poulet Braisé Tiop',
              12.90,
              '🔥'
            )"
          >
            Ajouter
          </button>

        </div>


        <!-- PRODUIT 3 -->
        <div
          class="pos-product"
          data-name="Haricots Madesu"
        >

          <div class="pos-product-info">

            <div class="pos-product-icon">
              🍲
            </div>

            <div>
              <strong>Haricots Madesu</strong>
              <small>7,90 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'haricots',
              'Haricots Madesu',
              7.90,
              '🍲'
            )"
          >
            Ajouter
          </button>

        </div>


        <!-- PRODUIT 4 -->
        <div
          class="pos-product"
          data-name="Maboké de Poisson"
        >

          <div class="pos-product-info">

            <div class="pos-product-icon">
              🐟
            </div>

            <div>
              <strong>Maboké de Poisson</strong>
              <small>13,50 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'maboke',
              'Maboké de Poisson',
              13.50,
              '🐟'
            )"
          >
            Ajouter
          </button>

        </div>


        <!-- PRODUIT 5 -->
        <div
          class="pos-product"
          data-name="Brochettes Congo"
        >

          <div class="pos-product-info">

            <div class="pos-product-icon">
              🥩
            </div>

            <div>
              <strong>Brochettes Congo</strong>
              <small>10,00 €</small>
            </div>

          </div>

          <button
            type="button"
            class="pos-add-button"
            onclick="addPosProduct(
              'brochettes',
              'Brochettes Congo',
              10,
              '🥩'
            )"
          >
            Ajouter
          </button>

        </div>


        <!-- PRODUIT 6 -->
        <div
          class="pos-product"
          data-name="Poulet Moambe"
        >

          <div class="pos-product-info">

