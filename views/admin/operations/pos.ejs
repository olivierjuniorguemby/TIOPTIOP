<section class="admin-heading">
  <div><span class="eyebrow">Administration</span><h1>➕ POS / Nouvelle commande</h1></div>
</section>

<section class="pos-page">
  <% if (typeof posError !== "undefined" && posError) { %>
    <div class="pos-alert"><%= posError %></div>
  <% } %>

  <div class="pos-layout">
    <div class="pos-panel">
      <h3>Client & canal</h3>
      <div class="pos-fields">
        <select id="posClientMode" class="pos-field">
          <option value="GUEST">Client invité</option>
          <option value="ACCOUNT">Client avec compte</option>
          <option value="ANONYMOUS">Comptoir / anonyme</option>
        </select>
        <select id="posChannel" class="pos-field">
          <option value="POS">POS / comptoir</option>
          <option value="PHONE">Téléphone</option>
          <option value="WHATSAPP">WhatsApp</option>
        </select>
        <select id="posPayment" class="pos-field">
          <option value="CASH">Espèces</option><option value="CARD">Carte bancaire</option><option value="MOBILE_MONEY">Mobile Money</option>
        </select>
      </div>

      <div id="posGuestCustomer" class="pos-customer-box">
        <div class="pos-customer-box-title"><strong>Client invité</strong><small>Aucun compte ne sera créé.</small></div>
        <div class="pos-customer-grid">
          <input id="posGuestFirstName" class="pos-field" maxlength="100" placeholder="Prénom">
          <input id="posGuestLastName" class="pos-field" maxlength="100" placeholder="Nom">
          <input id="posGuestPhone" class="pos-field" type="tel" maxlength="40" placeholder="Téléphone">
          <input id="posGuestEmail" class="pos-field" type="email" maxlength="190" placeholder="Email (facultatif)">
        </div>
        <small class="pos-customer-help">Téléphone obligatoire pour Téléphone / WhatsApp.</small>
      </div>

      <div id="posAccountCustomer" class="pos-customer-box" style="display:none">
        <div class="pos-customer-box-title"><strong>Client avec compte</strong><small>Recherche par nom, téléphone ou email.</small></div>
        <div class="pos-client-search-row">
          <input id="posCustomerSearch" class="pos-field" type="search" autocomplete="off" placeholder="Rechercher un client...">
          <button type="button" id="posCustomerSearchButton" class="pos-client-search-button">Rechercher</button>
        </div>
        <div id="posCustomerSearchState" class="pos-customer-help"></div>
        <div id="posCustomerResults" class="pos-customer-results"></div>
        <div id="posSelectedCustomer" class="pos-selected-customer" style="display:none"></div>
      </div>

      <div id="posAccountLoyalty" class="pos-customer-box pos-loyalty-box" style="display:none">
        <div class="pos-customer-box-title"><strong>⭐ Tiop+</strong><small id="posLoyaltyBalance">—</small></div>
        <select id="posLoyaltyRedemption" class="pos-field"><option value="">Aucun avantage</option></select>
        <small id="posLoyaltyHelp" class="pos-customer-help">Sélectionnez un client avec compte.</small>
      </div>

      <div id="posAnonymousCustomer" class="pos-customer-box" style="display:none">
        <strong>Commande comptoir / anonyme</strong>
        <small>Aucune identité client ne sera associée.</small>
      </div>

      <div class="pos-customer-box pos-physical-loyalty-box">
        <div class="pos-customer-box-title"><strong>🎫 Carte Tiop+ physique / VIP</strong><small>Disponible même pour invité ou anonyme.</small></div>
        <div class="pos-card-actions">
          <label for="posScannerImageInput" class="pos-card-scan-button pos-card-import-button">🖼 Importer QR / SVG</label>
          <input id="posScannerImageInput" class="pos-card-import-input" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/*">
          <div class="pos-card-search-row"><input id="posLoyaltyCardSearch" class="pos-field" autocomplete="off" placeholder="N° carte, nom, téléphone..."><button type="button" id="posLoyaltyCardSearchButton" class="pos-card-search-button">Rechercher</button></div>
        </div>
        <div id="posLoyaltyCardState" class="pos-customer-help">🔌 Scanner USB HID / 2D prêt · 🖼 import QR/SVG disponible · recherche manuelle disponible.</div>
        <div id="posLoyaltyCardResults" class="pos-customer-results"></div>
        <div id="posSelectedLoyaltyCard" class="pos-selected-loyalty-card" style="display:none"></div>
        <div id="posPhysicalRewardBox" class="pos-physical-reward-box" style="display:none">
          <label class="pos-mini-label" for="posPhysicalLoyaltyReward">🎁 Utiliser un avantage de cette carte</label>
          <select id="posPhysicalLoyaltyReward" class="pos-field">
            <option value="">Ne pas utiliser de récompense</option>
          </select>
          <small id="posPhysicalRewardHelp" class="pos-customer-help"></small>
        </div>
      </div>

      <div class="pos-fulfillment-box">
        <div class="pos-customer-box-title">
          <strong>Mode de réception</strong>
          <small>Préparation de la livraison / du retrait avant création de la commande.</small>
        </div>

        <div class="pos-pricing-context">
          <div>
            <label class="pos-mini-label" for="posRestaurant">Restaurant</label>
            <select id="posRestaurant" class="pos-field">
              <% (restaurants || []).forEach(function(restaurant){ %>
                <option value="<%= restaurant.id %>"><%= restaurant.name %> — <%= restaurant.city %></option>
              <% }) %>
            </select>
          </div>
          <div id="posDeliveryZoneBlock">
            <label class="pos-mini-label" for="posDeliveryZone">Zone de livraison</label>
            <select id="posDeliveryZone" class="pos-field">
              <option value="">Chargement des zones...</option>
            </select>
            <small id="posDeliveryZoneHelp" class="pos-customer-help"></small>
          </div>
        </div>

        <div class="pos-fulfillment-types">
          <label><input type="radio" name="posOrderType" value="DELIVERY" checked> 🚚 Livraison</label>
          <label><input type="radio" name="posOrderType" value="PICKUP"> 🛍️ Retrait</label>
          <label><input type="radio" name="posOrderType" value="DINE_IN"> 🍽️ Sur place</label>
        </div>

        <div id="posDeliveryDetails" class="pos-delivery-details">
          <div id="posAccountAddressBlock" style="display:none">
            <label class="pos-mini-label" for="posSavedAddress">Adresse enregistrée du client</label>
            <select id="posSavedAddress" class="pos-field">
              <option value="">Choisir une adresse...</option>
            </select>
            <div id="posSavedAddressPreview" class="pos-address-preview"></div>
          </div>

          <div id="posManualAddressBlock">
            <div class="pos-customer-grid">
              <input id="posDeliveryRecipient" class="pos-field" maxlength="160" placeholder="Nom du destinataire">
              <input id="posDeliveryPhone" class="pos-field" type="tel" maxlength="40" placeholder="Téléphone livraison *">
              <input id="posDeliveryAddress1" class="pos-field" maxlength="255" placeholder="Adresse / rue *">
              <input id="posDeliveryAddress2" class="pos-field" maxlength="255" placeholder="Complément d'adresse">
              <input id="posDeliveryDistrict" class="pos-field" maxlength="120" placeholder="Quartier">
              <input id="posDeliveryCity" class="pos-field" maxlength="120" value="Brazzaville" placeholder="Ville *">
            </div>
            <textarea id="posDeliveryInstructions" class="pos-field pos-delivery-instructions" rows="2" placeholder="Instructions de livraison (facultatif)"></textarea>
          </div>
        </div>

        <div id="posPickupInformation" class="pos-fulfillment-info" style="display:none">
          Retrait : aucune adresse de livraison n'est nécessaire.
        </div>
        <div id="posDineInInformation" class="pos-fulfillment-info" style="display:none">
          Sur place : aucune adresse de livraison n'est nécessaire.
        </div>
      </div>

      <div class="pos-products-header">
        <div><h3>Catalogue réel</h3><small><%= products.length %> produit(s) · <%= formulas.length %> formule(s)</small></div>
        <input type="search" id="posProductSearch" placeholder="Rechercher un produit ou une formule...">
      </div>

      <div class="pos-filters" id="posCategoryFilters">
        <button type="button" class="active" data-category="all">Tout</button>
        <% categories.forEach(category => { %>
          <button type="button" data-category="<%= category.id %>"><%= category.icon || "" %> <%= category.name %></button>
        <% }) %>
        <% if (formulas.length) { %><button type="button" data-category="formula">🍱 Formules</button><% } %>
      </div>

      <div class="pos-products-list" id="posProductsList">
        <% if (!products.length && !formulas.length) { %><div class="pos-empty-catalog">Aucun produit ou formule actif.</div><% } %>

        <% products.forEach(item => { %>
          <article class="pos-product" data-name="<%= item.name.toLowerCase() %>" data-category="<%= item.categoryId %>">
            <div class="pos-product-info">
              <div class="pos-product-icon">
                <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>"><% } else { %><span><%= item.icon %></span><% } %>
              </div>
              <div><strong><%= item.name %></strong><small><%= item.categoryName %></small><b><%= new Intl.NumberFormat('fr-FR').format(item.price) %> <%= item.currency %></b></div>
            </div>
            <button type="button" class="pos-add-button" data-pos-item='<%- JSON.stringify(item).replace(/'/g, "&#39;") %>'>Détails / Ajouter</button>
          </article>
        <% }) %>

        <% formulas.forEach(item => { %>
          <article class="pos-product" data-name="<%= item.name.toLowerCase() %>" data-category="formula">
            <div class="pos-product-info">
              <div class="pos-product-icon formula">
                <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>"><% } else { %><span>🍱</span><% } %>
              </div>
              <div><strong><%= item.name %></strong><small>Formule</small><b><%= new Intl.NumberFormat('fr-FR').format(item.price) %> <%= item.currency %></b></div>
            </div>
            <button type="button" class="pos-add-button" data-pos-item='<%- JSON.stringify(item).replace(/'/g, "&#39;") %>'>Détails / Ajouter</button>
          </article>
        <% }) %>
      </div>
    </div>

    <aside class="pos-panel pos-cart-panel">
      <div class="pos-cart-title"><div><h3>Panier POS</h3><small id="posCartCount">0 article</small></div><button type="button" id="clearPosCartButton" class="pos-clear-cart">Vider</button></div>
      <div id="posCartEmpty" class="pos-cart-empty">Panier vide.</div>
      <div id="posCartItems"></div>
      <div id="posCartSummary" class="pos-cart-summary" style="display:none">
        <div><span>Sous-total</span><strong id="posSubtotal">0 XAF</strong></div>
        <div><span>Réduction</span><strong id="posDiscount">0 XAF</strong></div>
        <div><span>Livraison</span><strong id="posDeliveryFee">0 XAF</strong></div>
        <div><span>Taxes</span><strong id="posTaxAmount">0 XAF</strong></div>
        <div class="pos-total"><span>Total</span><strong id="posTotal">0 XAF</strong></div>
        <small id="posCalculationState" class="pos-calculation-state"></small>
      </div>
      <div id="posPaymentInformation" class="pos-payment-information">Espèces : encaissement à confirmer dans l'étape paiement.</div>
      <button type="button" id="createPosOrderButton" class="pos-create-order">Continuer la commande</button>
      <small class="pos-step-note">13.9.6.7 : après vérification, la commande et son paiement PENDING sont créés atomiquement en MySQL.</small>
    </aside>
  </div>
</section>


<div id="posItemModal" class="pos-item-modal" hidden>
  <div class="pos-item-backdrop" data-pos-item-close></div>
  <section class="pos-item-dialog" role="dialog" aria-modal="true" aria-labelledby="posItemModalTitle">
    <div class="pos-item-head">
      <div>
        <small id="posItemKind">Produit</small>
        <h2 id="posItemModalTitle">Détails</h2>
      </div>
      <button type="button" class="pos-item-close" data-pos-item-close aria-label="Fermer">×</button>
    </div>
    <div id="posItemModalError" class="pos-review-error" hidden></div>
    <div id="posItemModalLoading" class="pos-item-loading">Chargement…</div>
    <div id="posItemModalBody" hidden>
      <div class="pos-item-summary">
        <img id="posItemImage" alt="" hidden>
        <div>
          <p id="posItemDescription"></p>
          <strong id="posItemBasePrice"></strong>
        </div>
      </div>

      <div id="posItemOptions"></div>
      <div id="posFormulaComposition"></div>

      <div class="pos-item-quantity-row">
        <strong>Quantité</strong>
        <div class="pos-quantity">
          <button type="button" id="posItemQtyMinus">−</button>
          <strong id="posItemQtyValue">1</strong>
          <button type="button" id="posItemQtyPlus">+</button>
        </div>
      </div>

      <label class="pos-item-instructions-label" for="posItemInstructions">Instructions pour la cuisine</label>
      <textarea id="posItemInstructions" class="pos-field pos-item-instructions" maxlength="2000" rows="3" placeholder="Ex. sans oignon, sauce à part, bien cuit…"></textarea>

      <div class="pos-item-footer">
        <div><small>Prix unitaire estimé</small><strong id="posItemCalculatedPrice">0 XAF</strong></div>
        <button type="button" id="posItemAddButton" class="button primary">Ajouter au panier POS</button>
      </div>
    </div>
  </section>
</div>

<div id="posReviewModal" class="pos-review-modal" hidden>
  <div class="pos-review-backdrop" data-pos-review-close></div>
  <section class="pos-review-dialog" role="dialog" aria-modal="true" aria-labelledby="posReviewTitle">
    <div class="pos-review-head">
      <div><small>13.9.6.7 — Vérification avant création réelle</small><h2 id="posReviewTitle">Récapitulatif de la commande</h2></div>
      <button type="button" class="pos-review-close" data-pos-review-close aria-label="Fermer">×</button>
    </div>
    <div id="posReviewError" class="pos-review-error" hidden></div>
    <div class="pos-review-grid">
      <div class="pos-review-card"><h3>Client & canal</h3><div id="posReviewCustomer"></div></div>
      <div class="pos-review-card"><h3>Réception</h3><div id="posReviewFulfillment"></div></div>
    </div>
    <div class="pos-review-card"><h3>Articles</h3><div id="posReviewItems"></div></div>
    <div class="pos-review-card"><h3>Montants vérifiés par le serveur</h3><div id="posReviewTotals"></div><small class="pos-review-security">Prix, frais et total recalculés côté serveur/MySQL.</small></div>
    <div class="pos-review-card"><h3>Paiement prévu</h3><div id="posReviewPayment"></div><small>Le paiement réel sera traité après création de la commande.</small></div>
    <div class="pos-review-actions">
      <button type="button" class="button" data-pos-review-close>Modifier</button>
      <button type="button" id="posReviewConfirmButton" class="button primary">Créer réellement la commande</button>
    </div>
    <p class="pos-review-note">Après confirmation, la commande, les articles, les options, l’historique et le paiement PENDING seront enregistrés dans une seule transaction.</p>
  </section>
</div>


<!-- 16.10.4.9 : webcam retirée du POS. Zone technique cachée utilisée uniquement pour décoder les fichiers importés. -->
<div id="posHtml5QrcodeReader" hidden></div>

