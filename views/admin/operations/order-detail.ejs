<script>
document.addEventListener(
    "DOMContentLoaded",
    function () {

        const form =
            document.getElementById(
                "orderStatusForm"
            );

        const button =
            document.getElementById(
                "orderStatusSubmit"
            );


        if (
            !form ||
            !button
        ) {
            return;
        }


        form.addEventListener(
            "submit",
            function () {

                button.disabled =
                    true;

                button.textContent =
                    "Mise à jour...";
            }
        );
    }
);
</script>

<script>
document.addEventListener(
