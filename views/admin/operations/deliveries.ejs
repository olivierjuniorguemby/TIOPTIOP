<%
    const statusLabels = {
        WAITING: "En attente",
        ASSIGNED: "Affectée",
        PICKED_UP: "Récupérée",
        ON_THE_WAY: "En route",
        ARRIVED: "Arrivée",
        DELIVERED: "Livrée",
        FAILED: "Échec"
    };


    const formatDate = value => {

        if (!value) {
            return "—";
        }

        const date =
            new Date(value);

        if (
            Number.isNaN(
                date.getTime()
            )
        ) {
            return "—";
        }

        return date.toLocaleString(
            "fr-FR",
            {
                dateStyle: "short",
                timeStyle: "short"
            }
        );
    };
%>


<section class="admin-heading">

    <div class="deliveries-header">

        <span class="admin-section-badge">
            Administration
        </span>

        <h1>
            🛵 Livraisons
        </h1>

        <p>
            Affectations et suivi opérationnel des commandes en livraison.
        </p>

    </div>

</section>


<section class="admin-deliveries-page">


    <div class="delivery-stats">

        <article class="delivery-stat-card">
            <span>Total</span>
            <strong><%= Number(stats?.total || 0) %></strong>
        </article>

        <article class="delivery-stat-card">
            <span>En attente</span>
            <strong><%= Number(stats?.waiting || 0) %></strong>
        </article>

        <article class="delivery-stat-card">
            <span>Affectées</span>
            <strong><%= Number(stats?.assigned || 0) %></strong>
        </article>

        <article class="delivery-stat-card">
            <span>En route</span>
            <strong><%= Number(stats?.on_the_way || 0) %></strong>
        </article>

        <article class="delivery-stat-card">
            <span>Livrées</span>
            <strong><%= Number(stats?.delivered || 0) %></strong>
        </article>

    </div>


    <form
        action="/admin/livraisons"
        method="GET"
        class="delivery-filters"
    >

        <input
            type="search"
            name="search"
            placeholder="Commande, livreur, téléphone, client..."
            value="<%= filters?.search || '' %>"
        >


        <select name="status">

            <option value="">
                Tous les statuts
            </option>

            <% Object.entries(statusLabels).forEach(([value, label]) => { %>

                <option
                    value="<%= value %>"
                    <%= filters?.status === value
                        ? "selected"
                        : ""
                    %>
                >
                    <%= label %>
                </option>

            <% }) %>

        </select>


        <button type="submit">
            Filtrer
        </button>


        <a href="/admin/livraisons">
            Réinitialiser
        </a>

    </form>


    <div class="delivery-table-wrap">


        <% if (
            !deliveries ||
            deliveries.length === 0
        ) { %>

            <div class="delivery-empty">

                <div>🛵</div>

                <h2>
                    Aucune livraison
                </h2>

                <p>
                    Les commandes de type livraison apparaîtront ici après création de leur opération de livraison.
                </p>

            </div>

        <% } else { %>


            <table class="delivery-table">

                <thead>

                    <tr>
                        <th>Commande</th>
                        <th>Destination</th>
                        <th>Livreur</th>
                        <th>Statut</th>
                        <th>ETA</th>
                        <th>Dernier GPS</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    <% deliveries.forEach(delivery => { %>

                        <tr>

                            <td>

                                <strong>
                                    <%= delivery.order_reference %>
                                </strong>

                                <small>
                                    <%= delivery.restaurant_name %>
                                </small>

                            </td>


                            <td>

                                <strong>
                                    <%= delivery.recipient_name || "Client" %>
                                </strong>

                                <small>
                                    <%= [
                                        delivery.address_line1,
                                        delivery.delivery_district,
                                        delivery.delivery_city
                                    ]
                                        .filter(Boolean)
                                        .join(" · ")
                                    %>
                                </small>

                            </td>


                            <td>

                                <strong>
                                    <%= delivery.driver_name || "Non affecté" %>
                                </strong>

                                <small>
                                    <%= delivery.driver_phone || "—" %>
                                </small>

                            </td>


                            <td>

                                <span class="delivery-status status-<%= String(delivery.status).toLowerCase() %>">
                                    <%= statusLabels[delivery.status] || delivery.status %>
                                </span>

                            </td>


                            <td>
                                <%= formatDate(delivery.estimated_arrival) %>
                            </td>


                            <td>
                                <%= formatDate(delivery.last_gps_at) %>
                            </td>


                            <td>

                                <a
                                    href="/admin/commandes/<%= encodeURIComponent(delivery.order_reference) %>"
                                    class="delivery-view"
                                >
                                    Gérer
                                </a>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>


    </div>


</section>


<style>

.admin-deliveries-page {

    padding: 18px;
}


.deliveries-header p {

    margin: 8px 0 0;

    color: #776f69;
}


.admin-section-badge {

    display: inline-flex;

    padding: 6px 12px;

    border-radius: 999px;

    background: #fff0df;

    color: #ff7900;

    font-size: 11px;

    font-weight: 900;
}


.delivery-stats {

    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 10px;

    margin-bottom: 14px;
}


.delivery-stat-card {

    min-height: 110px;

    padding: 20px;

    border-radius: 18px;

    background: #fff;
}


.delivery-stat-card span {

    display: block;

    margin-bottom: 11px;

    color: #786f69;

    font-size: 11px;
}


.delivery-stat-card strong {

    font-size: 29px;
}


.delivery-filters {

    display: grid;

    grid-template-columns:
        minmax(240px, 1fr)
        180px
        auto
        auto;

    gap: 8px;

    padding: 12px;

    margin-bottom: 14px;

    border-radius: 17px;

    background: #fff;
}


.delivery-filters input,
.delivery-filters select {

    min-height: 43px;

    padding: 0 12px;

    border: 1px solid #ddd7d2;

    border-radius: 11px;

    background: #fff;
}


.delivery-filters button,
.delivery-filters a,
.delivery-view {

    min-height: 41px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0 15px;

    border-radius: 999px;

    text-decoration: none;

    font-size: 11px;

    font-weight: 900;
}


.delivery-filters button {

    border: 0;

    background: #ff7900;

    color: #fff;

    cursor: pointer;
}


.delivery-filters a,
.delivery-view {

    border: 1px solid #e1dcd7;

    background: #fff;

    color: #171310;
}


.delivery-table-wrap {

    overflow-x: auto;

    border-radius: 18px;

    background: #fff;
}


.delivery-table {

    width: 100%;

    min-width: 1050px;

    border-collapse: collapse;
}


.delivery-table th,
.delivery-table td {

    padding: 14px;

    text-align: left;

    border-bottom: 1px solid #eee8e3;

    font-size: 12px;
}


.delivery-table th {

    background: #faf7f4;

    font-size: 11px;
}


.delivery-table td strong,
.delivery-table td small {

    display: block;
}


.delivery-table td small {

    margin-top: 4px;

    color: #7b746e;

    font-size: 9px;
}


.delivery-status {

    display: inline-flex;

    min-height: 27px;

    align-items: center;

    padding: 0 10px;

    border-radius: 999px;

    background: #f3f1ee;

    font-size: 9px;

    font-weight: 900;
}


.status-assigned {

    background: #fff0df;

    color: #a65200;
}


.status-on_the_way {

    background: #edf3ff;

    color: #315ba4;
}


.status-delivered {

    background: #eaf8ef;

    color: #277347;
}


.status-failed {

    background: #fff0f0;

    color: #a73535;
}


.delivery-empty {

    padding: 60px 25px;

    text-align: center;
}


.delivery-empty > div {

    font-size: 50px;
}


@media(max-width:1000px) {

    .delivery-stats {

        grid-template-columns:
            repeat(2, 1fr);
    }


    .delivery-filters {

        grid-template-columns:
            1fr 1fr;
    }
}


@media(max-width:600px) {

    .delivery-stats,
    .delivery-filters {

        grid-template-columns:
            1fr;
    }
}

</style>
