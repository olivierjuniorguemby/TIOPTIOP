<style>
  /* =========================================================
   COMMANDES ADMIN
========================================================= */

.admin-orders-page {
    padding: 20px;
}

.admin-orders-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
}

.admin-orders-header h1 {
    margin: 7px 0 0;
    font-size: 32px;
}

.admin-badge {
    display: inline-flex;
    padding: 6px 12px;
    background: #fff0df;
    color: #ff7900;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
}


/* FILTRES */

.admin-orders-filters {
    background: #fff;
    border-radius: 18px;
    padding: 12px;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr auto;
    gap: 8px;
    margin-bottom: 16px;
}

.admin-orders-filters input,
.admin-orders-filters select {
    width: 100%;
    min-height: 44px;
    border: 1px solid #ddd8d3;
    background: white;
    border-radius: 11px;
    padding: 0 13px;
    outline: none;
}

.admin-orders-filters input:focus,
.admin-orders-filters select:focus {
    border-color: #ff7900;
}


/* BUTTON */

.btn-admin-primary {
    border: none;
    background: #ff7900;
    color: #fff;
    padding: 12px 20px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
}

.btn-admin-primary:hover {
    background: #e96f00;
}

.btn-small {
    padding: 10px 16px;
}

.btn-admin-light {
    background: #fff;
    color: #181512;
    border: 0;
    border-radius: 25px;
    padding: 10px 17px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0,0,0,.05);
}


/* TABLE */

.admin-orders-table-wrapper {
    background: #fff;
    border-radius: 18px;
    overflow-x: auto;
}

.admin-orders-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-orders-table th {
    background: #faf7f4;
    text-align: left;
    padding: 15px;
    font-size: 13px;
}

.admin-orders-table td {
    padding: 15px;
    border-top: 1px solid #eee9e5;
    vertical-align: middle;
}

.admin-orders-table td > strong,
.admin-orders-table td > small {
    display: block;
}

.admin-orders-table td small {
    margin-top: 4px;
    color: #777;
}

.order-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}


/* BADGES */

.payment-badge {
    display: block;
    width: fit-content;
    margin-top: 3px;
    padding: 4px 9px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
}

.payment-badge.waiting {
    background: #fff0df;
    color: #a75000;
}

.order-status {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
}

.order-status.route {
    background: #e8eefc;
    color: #1b4d9b;
}

.order-status.preparation {
    background: #fff0df;
    color: #ad5700;
}


/* =========================================================
   MODAL
========================================================= */

.admin-order-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.admin-order-modal.active {
    display: flex;
}

.admin-order-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .48);
}

.admin-order-modal-content {
    position: relative;
    z-index: 2;

    width: min(685px, 95vw);

    background: #fff;
    border-radius: 22px;

    padding: 30px 28px;

    box-shadow:
        0 30px 70px rgba(0,0,0,.25);

    animation: orderModalIn .18s ease-out;
}

@keyframes orderModalIn {

    from {
        opacity: 0;
        transform: translateY(12px) scale(.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


/* HEADER */

.admin-order-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
}

.admin-order-modal-header h2 {
    margin: 0;
    font-size: 25px;
}

.admin-order-modal-close {
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 50%;
    background: #f3f3f3;
    cursor: pointer;
    font-size: 18px;
}


/* BODY */

.admin-order-modal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 55px;
}

.admin-order-modal-column p {
    margin: 0 0 18px;
    line-height: 1.5;
}

.confirm-cash-button {
    margin-top: 3px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width: 1100px) {

    .admin-orders-filters {
        grid-template-columns: repeat(3, 1fr);
    }

}

@media(max-width: 750px) {

    .admin-orders-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .admin-orders-filters {
        grid-template-columns: 1fr;
    }

    .admin-order-modal-grid {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .admin-order-modal-content {
        padding: 24px 20px;
    }

    .order-actions {
        flex-direction: column;
        align-items: flex-start;
    }

}
</style>
