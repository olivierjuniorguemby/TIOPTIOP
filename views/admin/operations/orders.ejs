<%
    const money = value =>
        Number(value || 0)
            .toLocaleString(
                "fr-FR",
                {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                }
            );


    const formatDate = value => {

        if (!value) {
            return "—";
        }

        const date =
            new Date(value);

        if (
            Number.isNaN(
                date.getTime()
            )
        ) {
            return "—";
        }

        return date.toLocaleString(
            "fr-FR",
            {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }
        );
    };


    const customerName = order =>
        order.customer_display_name
        ||
        [
            order.customer_first_name,
            order.customer_last_name
        ]
            .filter(Boolean)
            .join(" ")
        ||
        order.customer_email
        ||
        "Client invité";


    const statusLabels = {
        RECEIVED: "Reçue",
        CONFIRMED: "Confirmée",
        PREPARING: "Préparation",
        READY: "Prête",
        PICKED_UP: "Retirée",
        ON_THE_WAY: "En route",
        DELIVERED: "Livrée",
        CANCELLED: "Annulée",
        REFUNDED: "Remboursée"
    };


    const paymentLabels = {
        CARD: "Carte",
        MOBILE_MONEY: "Mobile Money",
        CASH: "Espèces"
    };


    const paymentStatusLabels = {
        PENDING: "En attente",
        AUTHORIZED: "Autorisé",
        PAID: "Payé",
        FAILED: "Échoué",
        CANCELLED: "Annulé",
        PARTIAL: "Partiel",
        REFUNDED: "Remboursé"
    };
%>


<section class="admin-heading">

    <div>

        <span class="eyebrow">
            Administration
        </span>

        <h1>
            🧾 Commandes
        </h1>

        <p class="admin-orders-subtitle">
            Consultez toutes les commandes réelles enregistrées dans TiopTiop.
        </p>

    </div>


    <a
        href="/admin/pos"
        class="button primary"
    >
        + Nouvelle commande
    </a>

</section>


<section class="admin-orders-page">


    <!-- =====================================================
         KPI
    ====================================================== -->

    <div class="order-kpis">


        <article class="order-kpi">

            <span>
                Toutes
            </span>

            <strong>
                <%= Number(stats?.total_orders || 0) %>
            </strong>

        </article>


        <article class="order-kpi">

            <span>
                Nouvelles
            </span>

            <strong>
                <%= Number(stats?.received_orders || 0) %>
            </strong>

        </article>


        <article class="order-kpi">

            <span>
                En préparation
            </span>

            <strong>
                <%= Number(stats?.preparing_orders || 0) %>
            </strong>

        </article>


        <article class="order-kpi">

            <span>
                En livraison
            </span>

            <strong>
                <%= Number(stats?.on_the_way_orders || 0) %>
            </strong>

        </article>


        <article class="order-kpi revenue">

            <span>
                CA commandes
            </span>

            <strong>
                <%= money(stats?.revenue || 0) %> XAF
            </strong>

        </article>


    </div>


    <!-- =====================================================
         FILTRES SERVEUR
    ====================================================== -->

    <form
        class="admin-orders-filters"
        action="/admin/commandes"
        method="GET"
    >


        <input
            type="search"
            name="search"
            placeholder="Référence, client, produit, restaurant"
            value="<%= filters?.search || '' %>"
        >


        <select name="status">

            <option value="">
                Tous statuts
            </option>

            <% Object.entries(statusLabels).forEach(([value, label]) => { %>

                <option
                    value="<%= value %>"
                    <%= filters?.status === value
                        ? "selected"
                        : ""
                    %>
                >
                    <%= label %>
                </option>

            <% }) %>

        </select>


        <select name="payment_method">

            <option value="">
                Tous paiements
            </option>

            <option
                value="CARD"
                <%= filters?.payment_method === "CARD"
                    ? "selected"
                    : ""
                %>
            >
                Carte
            </option>

            <option
                value="MOBILE_MONEY"
                <%= filters?.payment_method === "MOBILE_MONEY"
                    ? "selected"
                    : ""
                %>
            >
                Mobile Money
            </option>

            <option
                value="CASH"
                <%= filters?.payment_method === "CASH"
                    ? "selected"
                    : ""
                %>
            >
                Espèces
            </option>

        </select>


        <select name="channel">

            <option value="">
                Tous canaux
            </option>

            <% [
                "WEB",
                "MOBILE",
                "POS",
                "PHONE",
                "WHATSAPP",
                "ADMIN"
            ].forEach(value => { %>

                <option
                    value="<%= value %>"
                    <%= filters?.channel === value
                        ? "selected"
                        : ""
                    %>
                >
                    <%= value %>
                </option>

            <% }) %>

        </select>


        <select name="restaurant_id">

            <option value="">
                Tous restaurants
            </option>

            <% (restaurants || []).forEach(restaurant => { %>

                <option
                    value="<%= restaurant.id %>"
                    <%= Number(filters?.restaurant_id)
                        === Number(restaurant.id)
                            ? "selected"
                            : ""
                    %>
                >
                    <%= restaurant.name %>
                </option>

            <% }) %>

        </select>


        <input
            type="number"
            name="min_amount"
            min="0"
            step="1"
            placeholder="Montant min."
            value="<%= filters?.min_amount || '' %>"
        >


        <button
            type="submit"
            class="btn-admin-primary"
        >
            Filtrer
        </button>


        <a
            href="/admin/commandes"
            class="btn-admin-reset"
        >
            Réinitialiser
        </a>


    </form>


    <!-- =====================================================
         RESULTATS
    ====================================================== -->

    <div class="admin-orders-result-count">

        <strong>
            <%= (orders || []).length %>
        </strong>

        commande(s) affichée(s)

    </div>


    <div class="admin-orders-table-wrapper">


        <% if (
            !orders ||
            orders.length === 0
        ) { %>


            <div class="admin-orders-empty">

                <div>
                    🧾
                </div>

                <h2>
                    Aucune commande
                </h2>

                <p>
                    Aucune commande ne correspond aux critères sélectionnés.
                </p>

            </div>


        <% } else { %>


            <table class="admin-orders-table">


                <thead>

                    <tr>
                        <th>Commande</th>
                        <th>Client</th>
                        <th>Restaurant</th>
                        <th>Canal</th>
                        <th>Total</th>
                        <th>Paiement</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>

                </thead>


                <tbody>


                    <% orders.forEach(order => { %>


                        <tr>


                            <td>

                                <a
                                    href="/admin/commandes/<%= encodeURIComponent(order.reference) %>"
                                    class="order-reference"
                                >
                                    <%= order.reference %>
                                </a>

                                <small>
                                    <%= formatDate(order.created_at) %>
                                </small>

                                <small>
                                    <%= order.order_type %>
                                    ·
                                    <%= Number(order.total_quantity || 0) %> article(s)
                                </small>

                            </td>


                            <td>

                                <strong>
                                    <%= customerName(order) %>
                                </strong>

                                <small>
                                    <%= order.customer_email || "—" %>
                                </small>

                                <% if (order.customer_phone) { %>

                                    <small>
                                        <%= order.customer_phone %>
                                    </small>

                                <% } %>

                            </td>


                            <td>

                                <strong>
                                    <%= order.restaurant_name %>
                                </strong>

                                <small>
                                    <%= [
                                        order.restaurant_district,
                                        order.restaurant_city
                                    ]
                                        .filter(Boolean)
                                        .join(" · ")
                                    %>
                                </small>

                            </td>


                            <td>

                                <span class="channel-badge">
                                    <%= order.channel %>
                                </span>

                            </td>


                            <td>

                                <strong class="order-total">
                                    <%= money(order.total_amount) %>
                                    <%= order.currency || "XAF" %>
                                </strong>

                            </td>


                            <td>

                                <span>
                                    <%= paymentLabels[order.payment_method]
                                        || order.payment_method
                                        || "—"
                                    %>
                                </span>

                                <span
                                    class="
                                        payment-badge
                                        payment-<%= String(order.payment_status || 'UNKNOWN').toLowerCase() %>
                                    "
                                >
                                    <%= paymentStatusLabels[order.payment_status]
                                        || order.payment_status
                                        || "—"
                                    %>
                                </span>

                            </td>


                            <td>

                                <span
                                    class="
                                        order-status
                                        status-<%= String(order.status).toLowerCase() %>
                                    "
                                >
                                    <%= statusLabels[order.status]
                                        || order.status
                                    %>
                                </span>

                            </td>


                            <td>

                                <div class="order-actions">

                                    <a
                                        href="/admin/commandes/<%= encodeURIComponent(order.reference) %>"
                                        class="btn-admin-light"
                                    >
                                        Voir
                                    </a>

                                </div>

                            </td>


                        </tr>


                        <% if (order.items_summary) { %>

                            <tr class="order-products-row">

                                <td colspan="8">

                                    <strong>
                                        Articles :
                                    </strong>

                                    <%= order.items_summary %>

                                </td>

                            </tr>

                        <% } %>


                    <% }) %>


                </tbody>


            </table>


        <% } %>


    </div>


</section>


<style>

.admin-orders-page {

    padding: 20px;
}


.admin-orders-subtitle {

    margin: 8px 0 0;

    color: #77706a;

    font-size: 14px;
}


.order-kpis {

    display: grid;

    grid-template-columns:
        repeat(5, minmax(0, 1fr));

    gap: 12px;

    margin-bottom: 16px;
}


.order-kpi {

    min-height: 105px;

    padding: 20px;

    border-radius: 18px;

    background: #fff;
}


.order-kpi span {

    display: block;

    margin-bottom: 12px;

    color: #776f6a;

    font-size: 12px;
}


.order-kpi strong {

    display: block;

    font-size: 27px;

    line-height: 1;

    color: #171310;
}


.order-kpi.revenue strong {

    color: #ff7900;

    font-size: 22px;
}


.admin-orders-filters {

    display: grid;

    grid-template-columns:
        minmax(220px, 1.6fr)
        repeat(5, minmax(135px, 1fr))
        auto
        auto;

    gap: 8px;

    padding: 12px;

    margin-bottom: 14px;

    border-radius: 18px;

    background: #fff;
}


.admin-orders-filters input,
.admin-orders-filters select {

    width: 100%;

    min-height: 44px;

    padding: 0 12px;

    border: 1px solid #ddd8d3;

    border-radius: 11px;

    background: #fff;

    outline: none;
}


.admin-orders-filters input:focus,
.admin-orders-filters select:focus {

    border-color: #ff7900;
}


.btn-admin-primary,
.btn-admin-reset,
.btn-admin-light {

    min-height: 42px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 0 16px;

    border-radius: 999px;

    text-decoration: none;

    font-size: 12px;
    font-weight: 900;
}


.btn-admin-primary {

    border: 0;

    background: #ff7900;

    color: #fff;

    cursor: pointer;
}


.btn-admin-reset,
.btn-admin-light {

    border: 1px solid #e2ddd8;

    background: #fff;

    color: #171310;
}


.admin-orders-result-count {

    margin:
        0 0 12px 4px;

    color: #776f6a;

    font-size: 12px;
}


.admin-orders-result-count strong {

    color: #171310;
}


.admin-orders-table-wrapper {

    overflow-x: auto;

    border-radius: 18px;

    background: #fff;
}


.admin-orders-table {

    width: 100%;

    min-width: 1150px;

    border-collapse: collapse;
}


.admin-orders-table th {

    padding: 14px;

    text-align: left;

    background: #faf7f4;

    color: #171310;

    font-size: 12px;
}


.admin-orders-table td {

    padding: 15px 14px;

    border-top: 1px solid #eee9e5;

    vertical-align: middle;

    font-size: 13px;
}


.admin-orders-table td strong,
.admin-orders-table td small {

    display: block;
}


.admin-orders-table td small {

    margin-top: 4px;

    color: #7a736d;

    font-size: 10px;
}


.order-reference {

    color: #171310;

    text-decoration: none;

    font-weight: 1000;
}


.order-reference:hover {

    color: #ff7900;
}


.channel-badge,
.order-status,
.payment-badge {

    display: inline-flex;

    align-items: center;

    min-height: 26px;

    padding: 0 9px;

    border-radius: 999px;

    font-size: 9px;
    font-weight: 900;
}


.channel-badge {

    background: #f3f1ee;

    color: #554f49;
}


.order-status {

    background: #fff0df;

    color: #a75000;
}


.status-delivered {

    background: #eaf8ef;

    color: #287649;
}


.status-cancelled,
.status-refunded {

    background: #fff0f0;

    color: #ad3434;
}


.status-on_the_way {

    background: #edf3ff;

    color: #2858a5;
}


.payment-badge {

    display: flex;

    width: fit-content;

    margin-top: 5px;

    background: #f3f1ee;

    color: #59524c;
}


.payment-paid {

    background: #eaf8ef;

    color: #287649;
}


.payment-pending {

    background: #fff0df;

    color: #a75000;
}


.order-total {

    white-space: nowrap;
}


.order-products-row td {

    padding-top: 8px;

    padding-bottom: 12px;

    background: #fffaf5;

    color: #7a6755;

    font-size: 11px;
}


.order-actions {

    display: flex;

    gap: 7px;
}


.admin-orders-empty {

    padding: 60px 25px;

    text-align: center;
}


.admin-orders-empty > div {

    margin-bottom: 12px;

    font-size: 50px;
}


.admin-orders-empty h2 {

    margin: 0 0 8px;
}


.admin-orders-empty p {

    color: #776f6a;
}


@media(max-width:1200px) {

    .order-kpis {

        grid-template-columns:
            repeat(3, 1fr);
    }


    .admin-orders-filters {

        grid-template-columns:
            repeat(3, 1fr);
    }
}


@media(max-width:750px) {

    .admin-orders-page {

        padding: 12px;
    }


    .order-kpis,
    .admin-orders-filters {

        grid-template-columns:
            1fr;
    }
}

</style>
