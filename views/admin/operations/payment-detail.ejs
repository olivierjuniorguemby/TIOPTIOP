<%
const money = (value, currency) =>
    `${Number(value || 0).toLocaleString('fr-FR')} ${currency || 'XAF'}`;

const dateTime = value =>
    value ? new Date(value).toLocaleString('fr-FR') : '—';

const customerName =
    payment.customer_display_name
    || [payment.customer_first_name, payment.customer_last_name].filter(Boolean).join(' ')
    || 'Client';

const rs = refundState || {
    eligible:false, reason:'', paymentAmount:Number(payment.amount || 0),
    refundedAmount:0, pendingAmount:0, refundableAmount:0,
    processingMode:'MANUAL', currency:payment.currency || 'XAF'
};

const methodLabels = {
    CARD: '💳 Carte bancaire',
    MOBILE_MONEY: '📱 Mobile Money',
    CASH: '💵 Espèces'
};

function prettyPayload(payload) {
    if (!payload) return null;
    try {
        const value = typeof payload === 'string' ? JSON.parse(payload) : payload;
        return JSON.stringify(value, null, 2);
    } catch (_) {
        return String(payload);
    }
}
%>

<section class="admin-heading payment-detail-heading">
    <div>
        <a class="back-link" href="/admin/paiements">← Retour aux paiements</a>
        <div class="detail-title-line">
            <div>
                <span class="payments-badge">Administration · Paiement #<%= payment.id %></span>
                <h1>Détail du paiement</h1>
                <p><%= payment.order_reference %> · créé le <%= dateTime(payment.created_at) %></p>
            </div>
            <span class="payment-status detail-status status-<%= String(payment.status || '').toLowerCase() %>">
                <%= payment.status %>
            </span>
        </div>
    </div>
</section>

<section class="payment-detail-page">

    <div class="detail-grid">
        <article class="detail-card">
            <div class="card-heading">
                <span>🧾</span>
                <div><strong>Commande</strong><small>Informations commerciales</small></div>
            </div>
            <dl>
                <div><dt>Référence</dt><dd><a href="/admin/commandes/<%= encodeURIComponent(payment.order_reference) %>"><%= payment.order_reference %></a></dd></div>
                <div><dt>Statut commande</dt><dd><%= payment.order_status || '—' %></dd></div>
                <div><dt>Type</dt><dd><%= payment.order_type || '—' %></dd></div>
                <div><dt>Sous-total</dt><dd><%= money(payment.order_subtotal_amount, payment.order_currency) %></dd></div>
                <div><dt>Livraison</dt><dd><%= money(payment.order_delivery_fee, payment.order_currency) %></dd></div>
                <div><dt>Réduction</dt><dd><%= money(payment.order_discount_amount, payment.order_currency) %></dd></div>
                <div class="important-row"><dt>Total commande</dt><dd><%= money(payment.order_total_amount, payment.order_currency) %></dd></div>
            </dl>
        </article>

        <article class="detail-card">
            <div class="card-heading">
                <span>👤</span>
                <div><strong>Client</strong><small>Compte ayant passé la commande</small></div>
            </div>
            <dl>
                <div><dt>Nom</dt><dd><%= customerName %></dd></div>
                <div><dt>Email</dt><dd><%= payment.customer_email || '—' %></dd></div>
                <div><dt>Téléphone</dt><dd><%= payment.customer_phone || '—' %></dd></div>
                <div><dt>ID client</dt><dd><%= payment.customer_id || '—' %></dd></div>
            </dl>
        </article>

        <article class="detail-card">
            <div class="card-heading">
                <span>💳</span>
                <div><strong>Paiement</strong><small>État financier TiopTiop</small></div>
            </div>
            <dl>
                <div><dt>Méthode</dt><dd><%= methodLabels[payment.method] || payment.method %></dd></div>
                <div><dt>Provider</dt><dd><span class="provider-pill"><%= payment.provider || '—' %></span></dd></div>
                <div class="important-row"><dt>Montant</dt><dd><%= money(payment.amount, payment.currency) %></dd></div>
                <div><dt>Statut</dt><dd><span class="payment-status status-<%= String(payment.status || '').toLowerCase() %>"><%= payment.status %></span></dd></div>
                <div><dt>Payé le</dt><dd><%= dateTime(payment.paid_at) %></dd></div>
                <% if (String(payment.method || '').toUpperCase() === 'CASH') { %>
                    <div><dt>Montant reçu</dt><dd><%= payment.cash_received_amount != null ? money(payment.cash_received_amount, payment.currency) : '—' %></dd></div>
                    <div><dt>Monnaie rendue</dt><dd><%= payment.cash_change_amount != null ? money(payment.cash_change_amount, payment.currency) : '—' %></dd></div>
                <% } %>
                <div><dt>Collecté par</dt><dd><%= payment.collector_name || '—' %></dd></div>
            </dl>
        </article>

        <article class="detail-card">
            <div class="card-heading">
                <span>🔗</span>
                <div><strong>Références techniques</strong><small>Traçabilité provider</small></div>
            </div>
            <dl>
                <div><dt>Payment ID</dt><dd>#<%= payment.id %></dd></div>
                <div><dt>Public ID</dt><dd><code><%= payment.public_id || '—' %></code></dd></div>
                <div><dt>Provider reference</dt><dd><code class="break-code"><%= payment.provider_reference || '—' %></code></dd></div>
                <div><dt>Créé</dt><dd><%= dateTime(payment.created_at) %></dd></div>
                <div><dt>Mis à jour</dt><dd><%= dateTime(payment.updated_at) %></dd></div>
            </dl>
        </article>
    </div>


    <article class="refund-card">
        <div class="refund-header">
            <div>
                <span class="payments-badge">13.9.4 · Remboursements</span>
                <h2>Gestion du remboursement</h2>
                <p>Stripe reste en TEST. MTN MoMo est suivi comme remboursement manuel contrôlé ; les espèces sont confirmées directement par l'administrateur.</p>
            </div>
            <% if (String(payment.method || '').toUpperCase() === 'CASH' && String(payment.status || '').toUpperCase() === 'PENDING') { %>
                <form class="cash-collect-form" method="POST" action="/admin/paiements/<%= payment.id %>/encaissement-cash" onsubmit="return confirm('Confirmer cet encaissement espèces ? La commande sera marquée payée.');">
                    <label>
                        <span>Montant reçu</span>
                        <input type="number" name="receivedAmount" min="<%= Number(payment.amount || 0) %>" step="0.01" value="<%= Number(payment.amount || 0) %>" required>
                    </label>
                    <label>
                        <span>Commentaire (optionnel)</span>
                        <input type="text" name="comment" maxlength="500" placeholder="Ex. Billet de 10 000 XAF">
                    </label>
                    <button type="submit" class="refund-open-button cash-collect-button">💵 Confirmer l’encaissement</button>
                </form>
            <% } else if (rs.canExecuteStripe) { %>
                <button type="button" class="refund-open-button" id="openRefundModal">↩ Rembourser Stripe TEST</button>
            <% } else if (rs.eligible && rs.processingMode === 'MOBILE_MONEY') { %>
                <button type="button" class="refund-open-button" data-open-modal="mtnRefundModal">↩ Préparer remboursement MTN</button>
            <% } else if (rs.eligible && rs.processingMode === 'CASH') { %>
                <button type="button" class="refund-open-button" data-open-modal="cashRefundModal">↩ Rembourser en espèces</button>
            <% } else { %>
                <button type="button" class="refund-open-button disabled" disabled>↩ Rembourser</button>
            <% } %>
        </div>

        <div class="refund-summary-grid">
            <div><span>Paiement</span><strong><%= money(rs.paymentAmount, rs.currency) %></strong></div>
            <div><span>Déjà remboursé</span><strong><%= money(rs.refundedAmount, rs.currency) %></strong></div>
            <div><span>En attente</span><strong><%= money(rs.pendingAmount, rs.currency) %></strong></div>
            <div><span>Remboursable</span><strong><%= money(rs.refundableAmount, rs.currency) %></strong></div>
        </div>

        <p class="refund-note">Traitement prévu : <strong><%= rs.processingMode %></strong><% if (!rs.eligible && rs.reason) { %> · <%= rs.reason %><% } %></p>

        <% if (refunds && refunds.length) { %>
            <div class="refund-history">
                <h3>Remboursements enregistrés</h3>
                <% refunds.forEach(refund => { %>
                    <div class="refund-history-row">
                        <div>
                            <span>#<%= refund.id %> · <%= refund.refund_type %> · <%= dateTime(refund.requested_at) %></span>
                            <small><%= refund.provider || '—' %><% if (refund.provider_reference) { %> · Réf. <%= refund.provider_reference %><% } %></small>
                        </div>

                        <div class="refund-history-status">
                            <strong><%= money(refund.amount, refund.currency) %> · <%= refund.status %></strong>

                            <% if (
                                refund.status === 'PENDING'
                                && String(refund.provider || '').toUpperCase() === 'MTN_MOMO_MANUAL'
                            ) { %>
                                <div class="mtn-pending-actions"><div class="mtn-pending-title">📱 Remboursement MTN en attente — saisissez la référence reçue après l’opération MTN</div>
                                    <form method="POST" action="/admin/paiements/<%= payment.id %>/remboursement/mtn-momo/<%= refund.id %>/confirmer">
                                        <input
                                            type="text"
                                            name="providerReference"
                                            maxlength="180"
                                            required
                                            placeholder="Référence transaction MTN"
                                        >
                                        <input
                                            type="text"
                                            name="adminNote"
                                            maxlength="500"
                                            placeholder="Note facultative"
                                        >
                                        <button type="submit" class="mini-success">Confirmer effectué</button>
                                    </form>

                                    <form
                                        method="POST"
                                        action="/admin/paiements/<%= payment.id %>/remboursement/mtn-momo/<%= refund.id %>/annuler"
                                        onsubmit="return confirm('Annuler cette demande MTN non exécutée ?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="reason"
                                            value="Demande annulée depuis l'administration"
                                        >
                                        <button type="submit" class="mini-danger">Annuler demande</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </article>

    <% if (rs.canExecuteStripe) { %>

    <div class="refund-modal-backdrop" id="refundModal" hidden>

        <form
            class="refund-modal"
            method="POST"
            action="/admin/paiements/<%= payment.id %>/remboursement/stripe"
            id="refundForm"
        >
            <input
    type="hidden"
    name="refundRequestToken"
    value="<%= refundRequestToken %>"
>
            <div class="refund-modal-top">
                <div>
                    <span class="payments-badge">
                        Stripe TEST · 13.9.4.3
                    </span>

                    <h2>Préparer un remboursement</h2>
                </div>

                <button type="button" id="closeRefundModal">×</button>
            </div>


            <p class="refund-warning">
                Un remboursement Stripe TEST sera réellement créé dans l'environnement de test. Aucun argent réel ne sera débité ni remboursé.
            </p>


            <label>
                <input
                    type="radio"
                    name="refundType"
                    value="FULL"
                    checked
                >
                Total
            </label>

            <label>
                <input
                    type="radio"
                    name="refundType"
                    value="PARTIAL"
                >
                Partiel
            </label>


            <label class="refund-field">

                Montant

                <input
                    id="refundAmountPreview"
                    name="amount"
                    type="number"
                    min="1"
                    max="<%= rs.refundableAmount %>"
                    step="1"
                    value="<%= rs.refundableAmount %>"
                    disabled
                >

            </label>


            <label class="refund-field">

                Motif

                <select
                    id="refundReasonPreview"
                    name="reasonCode"
                >

                    <option value="CUSTOMER_REQUEST">
                        Demande du client
                    </option>

                    <option value="ORDER_CANCELLED">
                        Commande annulée
                    </option>

                    <option value="PRODUCT_UNAVAILABLE">
                        Produit indisponible
                    </option>

                    <option value="DUPLICATE">
                        Paiement en double
                    </option>

                    <option value="OTHER">
                        Autre
                    </option>

                </select>

            </label>


            <label class="refund-field">

                Commentaire administrateur

                <textarea
                    name="reasonText"
                    maxlength="500"
                    rows="3"
                    placeholder="Précision facultative"
                ></textarea>

            </label>


            <div class="refund-modal-actions">

                <button
                    type="button"
                    id="cancelRefundModal"
                >
                    Annuler
                </button>

                <button
                    type="submit"
                    id="previewRefundButton"
                >
                    Confirmer le remboursement TEST
                </button>

            </div>


            <p id="refundPreviewResult"></p>

        </form>

    </div>

    <% } %>


    <% if (rs.eligible && rs.processingMode === 'MOBILE_MONEY') { %>
    <div class="refund-modal-backdrop" id="mtnRefundModal" hidden>
        <form
            class="refund-modal manual-refund-form"
            method="POST"
            action="/admin/paiements/<%= payment.id %>/remboursement/mtn-momo"
            data-provider-label="MTN MoMo"
        >
            <input
                type="hidden"
                name="refundRequestToken"
                value="<%= refundRequestToken %>"
            >

            <div class="refund-modal-top">
                <div>
                    <span class="payments-badge">MTN MoMo · 13.9.4.5</span>
                    <h2>Préparer un remboursement MTN</h2>
                </div>
                <button type="button" data-close-modal="mtnRefundModal">×</button>
            </div>

            <p class="refund-warning">
                TiopTiop enregistre d'abord la demande en PENDING.
                Effectuez ensuite réellement le remboursement via votre canal MTN autorisé,
                puis revenez saisir la référence de transaction pour le confirmer.
            </p>

            <div class="manual-radio-row">
                <label><input type="radio" name="refundType" value="FULL" checked> Total</label>
                <label><input type="radio" name="refundType" value="PARTIAL"> Partiel</label>
            </div>

            <label class="refund-field">
                Montant
                <input
                    name="amount"
                    type="number"
                    min="1"
                    max="<%= rs.refundableAmount %>"
                    step="1"
                    value="<%= rs.refundableAmount %>"
                    data-refund-amount
                    disabled
                >
            </label>

            <label class="refund-field">
                Motif
                <select name="reasonCode">
                    <option value="CUSTOMER_REQUEST">Demande du client</option>
                    <option value="ORDER_CANCELLED">Commande annulée</option>
                    <option value="PRODUCT_UNAVAILABLE">Produit indisponible</option>
                    <option value="DUPLICATE">Paiement en double</option>
                    <option value="OTHER">Autre</option>
                </select>
            </label>

            <label class="refund-field">
                Commentaire administrateur
                <textarea
                    name="reasonText"
                    maxlength="500"
                    rows="3"
                    placeholder="Précision facultative"
                ></textarea>
            </label>

            <div class="refund-modal-actions">
                <button type="button" data-close-modal="mtnRefundModal">Annuler</button>
                <button type="submit">Enregistrer la demande MTN</button>
            </div>
        </form>
    </div>
    <% } %>


    <% if (rs.eligible && rs.processingMode === 'CASH') { %>
    <div class="refund-modal-backdrop" id="cashRefundModal" hidden>
        <form
            class="refund-modal manual-refund-form"
            method="POST"
            action="/admin/paiements/<%= payment.id %>/remboursement/cash"
            data-provider-label="Espèces"
        >
            <input
                type="hidden"
                name="refundRequestToken"
                value="<%= refundRequestToken %>"
            >

            <div class="refund-modal-top">
                <div>
                    <span class="payments-badge">Espèces · 13.9.4.5</span>
                    <h2>Confirmer un remboursement espèces</h2>
                </div>
                <button type="button" data-close-modal="cashRefundModal">×</button>
            </div>

            <p class="refund-warning">
                Confirmez uniquement après avoir réellement remis l'argent au client.
                Cette confirmation fera passer immédiatement le remboursement à SUCCEEDED.
            </p>

            <div class="manual-radio-row">
                <label><input type="radio" name="refundType" value="FULL" checked> Total</label>
                <label><input type="radio" name="refundType" value="PARTIAL"> Partiel</label>
            </div>

            <label class="refund-field">
                Montant
                <input
                    name="amount"
                    type="number"
                    min="1"
                    max="<%= rs.refundableAmount %>"
                    step="1"
                    value="<%= rs.refundableAmount %>"
                    data-refund-amount
                    disabled
                >
            </label>

            <label class="refund-field">
                Référence caisse / reçu
                <input
                    name="cashReference"
                    type="text"
                    maxlength="180"
                    placeholder="Facultatif — généré automatiquement si vide"
                >
            </label>

            <label class="refund-field">
                Motif
                <select name="reasonCode">
                    <option value="CUSTOMER_REQUEST">Demande du client</option>
                    <option value="ORDER_CANCELLED">Commande annulée</option>
                    <option value="PRODUCT_UNAVAILABLE">Produit indisponible</option>
                    <option value="DUPLICATE">Paiement en double</option>
                    <option value="OTHER">Autre</option>
                </select>
            </label>

            <label class="refund-field">
                Commentaire administrateur
                <textarea
                    name="reasonText"
                    maxlength="500"
                    rows="3"
                    placeholder="Précision facultative"
                ></textarea>
            </label>

            <div class="refund-modal-actions">
                <button type="button" data-close-modal="cashRefundModal">Annuler</button>
                <button type="submit">Confirmer argent remis</button>
            </div>
        </form>
    </div>
    <% } %>

    <article class="timeline-card">
        <div class="timeline-header">
            <div>
                <span class="payments-badge">Audit</span>
                <h2>Historique du paiement</h2>
                <p><%= (events || []).length %> événement(s) enregistré(s) dans <code>payment_events</code>.</p>
            </div>
        </div>

        <% if (!events || events.length === 0) { %>
            <div class="empty-events">Aucun événement n'est encore enregistré pour ce paiement.</div>
        <% } else { %>
            <div class="payment-timeline">
                <% events.forEach((event, index) => { const payloadText = prettyPayload(event.payload); %>
                    <div class="timeline-item">
                        <div class="timeline-axis">
                            <span class="timeline-dot"></span>
                            <% if (index < events.length - 1) { %><span class="timeline-line"></span><% } %>
                        </div>

                        <div class="timeline-content">
                            <div class="timeline-top">
                                <strong><%= event.event_type %></strong>
                                <time><%= dateTime(event.created_at) %></time>
                            </div>

                            <% if (event.description) { %>
                                <p><%= event.description %></p>
                            <% } %>

                            <% if (payloadText) { %>
                                <details>
                                    <summary>Voir les données techniques</summary>
                                    <pre><%= payloadText %></pre>
                                </details>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </article>

    <div class="detail-actions">
        <a href="/admin/paiements">← Tous les paiements</a>
        <a class="primary-action" href="/admin/commandes/<%= encodeURIComponent(payment.order_reference) %>">Voir la commande →</a>
    </div>
</section>

<style>
