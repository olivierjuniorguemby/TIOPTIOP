<% if (rs.canExecuteStripe) { %>
<script>
(() => {
  const modal = document.getElementById('refundModal');
  const amount = document.getElementById('refundAmountPreview');
  const result = document.getElementById('refundPreviewResult');
  const max = Number(<%- JSON.stringify(rs.refundableAmount) %>);
  const hide = () => { modal.hidden = true; document.body.style.overflow=''; result.textContent=''; };
  document.getElementById('openRefundModal')?.addEventListener('click',()=>{modal.hidden=false;document.body.style.overflow='hidden';});
  document.getElementById('closeRefundModal')?.addEventListener('click',hide);
  document.getElementById('cancelRefundModal')?.addEventListener('click',hide);
  document.querySelectorAll('input[name="refundType"]').forEach(r => r.addEventListener('change', () => {
    const partial = document.querySelector('input[name="refundType"]:checked')?.value === 'PARTIAL';
    amount.disabled = !partial;
    amount.value = partial ? Math.max(1, Math.floor(max/2)) : max;
    result.textContent='';
  }));
  document.querySelector('#refundModal form')?.addEventListener('submit', (event) => {

    const n = Number(amount.value);

    if (!Number.isFinite(n) || n <= 0 || n > max) {
        event.preventDefault();

        result.style.color = '#a73535';
        result.textContent = 'Montant invalide.';

        return;
    }

    const type =
        document.querySelector(
            'input[name="refundType"]:checked'
        )?.value;


    if (type === 'PARTIAL' && n >= max) {

        event.preventDefault();

        result.style.color = '#a73535';

        result.textContent =
            'Pour rembourser tout le solde, choisissez Total.';

        return;
    }


    const ok = window.confirm(
        `Confirmer le remboursement Stripe TEST de ${n.toLocaleString('fr-FR')} <%= rs.currency %> ?`
    );


    if (!ok) {
        event.preventDefault();
        return;
    }


    // IMPORTANT :
    // un input disabled n'est pas envoyé par le navigateur
    if (type === 'FULL') {
        amount.disabled = false;
        amount.value = max;
    }


    const submit =
        document.getElementById('previewRefundButton');

    submit.disabled = true;

    submit.textContent =
        'Remboursement en cours...';
});
})();
</script>
<% } %>


<script>
(() => {
    const max = Number(<%- JSON.stringify(rs.refundableAmount) %>);

    document.querySelectorAll('[data-open-modal]').forEach(button => {
        button.addEventListener('click', () => {
            const modal = document.getElementById(button.dataset.openModal);
            if (!modal) return;
            modal.hidden = false;
            document.body.style.overflow = 'hidden';
        });
    });

    document.querySelectorAll('[data-close-modal]').forEach(button => {
        button.addEventListener('click', () => {
            const modal = document.getElementById(button.dataset.closeModal);
            if (!modal) return;
            modal.hidden = true;
            document.body.style.overflow = '';
        });
    });

    document.querySelectorAll('.manual-refund-form').forEach(form => {
        const amount = form.querySelector('[data-refund-amount]');
        const radios = form.querySelectorAll('input[name="refundType"]');

        radios.forEach(radio => {
            radio.addEventListener('change', () => {
                const type =
                    form.querySelector('input[name="refundType"]:checked')?.value;

                const partial =
                    type === 'PARTIAL';

                amount.disabled =
                    !partial;

                amount.value =
                    partial
                        ? Math.max(1, Math.floor(max / 2))
                        : max;
            });
        });

        form.addEventListener('submit', event => {
            const type =
                form.querySelector('input[name="refundType"]:checked')?.value;

            const n =
                Number(amount.value);

            if (
                !Number.isFinite(n)
                ||
                n <= 0
                ||
                n > max
            ) {
                event.preventDefault();
                alert(`Montant invalide. Maximum : ${max.toLocaleString('fr-FR')} <%= rs.currency %>.`);
                return;
            }

            if (
                type === 'PARTIAL'
                &&
                n >= max
            ) {
                event.preventDefault();
                alert('Pour rembourser tout le solde restant, choisissez Total.');
                return;
            }

            if (
                type === 'FULL'
            ) {
                amount.disabled =
                    false;

                amount.value =
                    max;
            }

            const label =
                form.dataset.providerLabel
                || 'ce moyen de paiement';

            const message =
                label === 'Espèces'
                    ? `Confirmer que ${n.toLocaleString('fr-FR')} <%= rs.currency %> ont réellement été remis au client ?`
                    : `Enregistrer une demande MTN MoMo de ${n.toLocaleString('fr-FR')} <%= rs.currency %> ? Le remboursement devra ensuite être effectué via MTN puis confirmé avec sa référence.`;

            if (
                !window.confirm(message)
            ) {
                event.preventDefault();
            }
        });
    });
})();
</script>
