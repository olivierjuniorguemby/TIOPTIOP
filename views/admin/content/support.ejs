<% const isImg=u=>/\.(png|jpe?g|webp|avif)$/i.test(String(u||"")); const labels={NEW:'Nouveau',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'En attente client',RESOLVED:'Résolu',CLOSED:'Fermé'}; const catLabels={ORDER:'Commande',DELIVERY:'Livraison',PAYMENT:'Paiement',REFUND:'Remboursement',TIOP_PLUS:'Tiop+',ACCOUNT:'Compte',RESTAURANT:'Restaurant',OTHER:'Autre'}; const icons={ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}; %>
<section class="as-page">
 <header class="as-head"><div class="as-title"><span>💬</span><div><h1>Support</h1><p>Gérez les demandes clients et suivez leur résolution.</p></div></div></header>
 <% if(saved){ %><div class="as-success">✓ Ticket enregistré et réponse ajoutée.</div><% } %>
 <section class="as-stats">
  <article><i class="i-red">●</i><div><span>Nouveaux</span><strong><%= Number(stats.new_count||0) %></strong><small>À traiter</small></div></article>
  <article><i class="i-orange">▣</i><div><span>En cours</span><strong><%= Number(stats.in_progress_count||0) %></strong><small>En traitement</small></div></article>
  <article><i class="i-yellow">◷</i><div><span>En attente client</span><strong><%= Number(stats.waiting_count||0) %></strong><small>En attente de réponse</small></div></article>
  <article><i class="i-green">✓</i><div><span>Résolus</span><strong><%= Number(stats.resolved_count||0) %></strong><small>Traités</small></div></article>
  <article><i class="i-gray">◉</i><div><span>Total</span><strong><%= Number(stats.total||0) %></strong><small>Toutes les demandes</small></div></article>
 </section>
 <section class="as-workspace">
  <div class="as-list-panel">
   <div class="as-filters"><label>⌕ <input id="adminTicketSearch" placeholder="Rechercher un ticket, client, commande..."></label><select id="adminStatus"><option value="ALL">Tous les statuts</option><option value="NEW">Nouveaux</option><option value="IN_PROGRESS">En cours</option><option value="WAITING_CUSTOMER">Attente client</option><option value="RESOLVED">Résolus</option><option value="CLOSED">Fermés</option></select><select id="adminCategory"><option value="ALL">Toutes les catégories</option><% Object.entries(catLabels).forEach(([k,v])=>{ %><option value="<%= k %>"><%= v %></option><% }) %></select></div>
   <div class="as-tickets" id="adminTicketList">
    <% if(!tickets.length){ %><div class="as-empty">💬<h3>Aucun ticket</h3><p>Les demandes clients apparaîtront ici.</p></div><% } %>
    <% tickets.forEach((t,i)=>{ %><button type="button" class="as-ticket <%= i===0?'selected':'' %>" data-id="<%= t.id %>" data-status="<%= t.status %>" data-category="<%= t.category %>" data-search="<%= (t.reference+' '+t.subject+' '+(t.customer_name||'')+' '+(t.customer_email||'')+' '+(t.order_reference||'')).toLowerCase() %>"><span class="as-icon"><%= icons[t.category]||'💬' %></span><span class="as-ticket-copy"><span class="as-ticket-title"><b><%= t.reference %> · <%= t.subject %></b><em><%= catLabels[t.category]||t.category %></em></span><span><%= t.customer_name||'Client' %> · <%= t.customer_email||'' %></span><small><%= t.order_reference||'Sans commande' %> · <%= new Date(t.updated_at).toLocaleString('fr-FR') %></small></span><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span><span class="arrow">›</span></button><% }) %>
   </div>
  </div>
  <div class="as-details">
   <% tickets.forEach((t,i)=>{ %><section class="as-detail <%= i===0?'active':'' %>" id="adminDetail-<%= t.id %>">
    <div class="as-detail-head"><div><h2><%= t.reference %> · <%= t.subject %></h2></div><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span></div>
    <div class="as-meta"><div><span>👤 Client</span><strong><%= t.customer_name||'Client' %></strong><small><%= t.customer_email||'' %></small></div><div><span>▣ Commande</span><strong><%= t.order_reference||'Aucune' %></strong><small><%= t.order_reference?'Commande liée':'Sans commande' %></small></div><div><span>⌘ Priorité</span><strong><%= t.priority %></strong></div><div><span>💬 Catégorie</span><strong><%= catLabels[t.category]||t.category %></strong></div></div>
    <div class="as-messages"><% (t.messages||[]).forEach(m=>{ %><div class="as-msg <%= m.sender_type==='ADMIN'?'admin':'customer' %>"><span class="as-avatar"><%= m.sender_type==='ADMIN'?'🎧':'👤' %></span><div><strong><%= m.sender_type==='ADMIN'?(m.sender_name||'Support TiopTiop'):(m.sender_name||t.customer_name||'Client') %></strong><% if(m.message){ %><p><%= m.message %></p><% } %><% if(m.attachment_url){ %><a class="as-attachment" href="<%= m.attachment_url %>" target="_blank" rel="noopener"><% if(isImg(m.attachment_url)){ %><img src="<%= m.attachment_url %>" alt="Pièce jointe"><% }else{ %>📄 Ouvrir la pièce jointe<% } %></a><% } %><small><%= new Date(m.created_at).toLocaleString('fr-FR') %></small></div></div><% }) %></div>
    <form method="POST" enctype="multipart/form-data" action="/admin/support/<%= t.id %>/reply" class="as-compose"><select name="status"><option value="NEW" <%= t.status==='NEW'?'selected':'' %>>Nouveau</option><option value="IN_PROGRESS" <%= t.status==='IN_PROGRESS'?'selected':'' %>>En cours</option><option value="WAITING_CUSTOMER" <%= t.status==='WAITING_CUSTOMER'?'selected':'' %>>Attente client</option><option value="RESOLVED" <%= t.status==='RESOLVED'?'selected':'' %>>Résolu</option><option value="CLOSED" <%= t.status==='CLOSED'?'selected':'' %>>Fermé</option></select><div class="as-actions"><button type="button" class="as-icon-btn emoji-toggle" title="Emoji">😊</button><label class="as-icon-btn" title="Pièce jointe">📎<input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt" hidden></label></div><div class="as-editor"><textarea name="response" maxlength="4000" placeholder="Écrire une réponse au client..."></textarea><div class="emoji-panel" hidden></div><div class="file-name"></div></div><button>Envoyer</button></form>
   </section><% }) %>
   <% if(!tickets.length){ %><div class="as-empty as-detail-empty">🎧<h3>Support TiopTiop</h3><p>Sélectionnez un ticket pour commencer.</p></div><% } %>
  </div>
 </section>
</section>
<style>
.as-page{padding:22px 28px 55px;color:#172039}.as-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.as-title{display:flex;align-items:center;gap:14px}.as-title>span{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#8e55dc;font-size:22px}.as-title h1{margin:0;font-size:30px}.as-title p{margin:4px 0 0;color:#7b8391}.as-success{background:#eaf9ef;color:#15703a;padding:13px 16px;border-radius:12px;font-weight:800;margin-bottom:15px}.as-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:16px}.as-stats article{background:#fff;border:1px solid #edf0f4;border-radius:17px;padding:17px;display:flex;gap:13px;align-items:flex-start;box-shadow:0 10px 28px rgba(26,35,58,.04)}.as-stats i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-style:normal;font-size:17px}.i-red{background:#ffe8ec;color:#d92449}.i-orange{background:#fff0e5;color:#ff7100}.i-yellow{background:#fff5dc;color:#d88b00}.i-green{background:#e6f7ed;color:#08793d}.i-gray{background:#eef0f4;color:#687181}.as-stats div{display:flex;flex-direction:column}.as-stats span{color:#586173}.as-stats strong{font-size:25px;margin:2px 0}.as-stats small{color:#9aa1ac}.as-workspace{display:grid;grid-template-columns:minmax(430px,.9fr) minmax(500px,1.1fr);gap:14px}.as-list-panel,.as-details{background:#fff;border:1px solid #e7ebf0;border-radius:17px;overflow:hidden;box-shadow:0 12px 35px rgba(26,35,58,.04)}.as-filters{display:grid;grid-template-columns:1.5fr .75fr .85fr;gap:8px;padding:12px}.as-filters label{display:flex;align-items:center;border:1px solid #dfe4ea;border-radius:10px;padding:0 10px;color:#777}.as-filters input,.as-filters select{border:0;outline:0;background:#fff;font:inherit;padding:10px;width:100%}.as-filters select{border:1px solid #dfe4ea;border-radius:10px}.as-tickets{padding:0 12px 12px;display:flex;flex-direction:column;gap:8px;max-height:650px;overflow:auto}.as-ticket{width:100%;border:1px solid #e2e7ed;background:#fff;border-radius:13px;padding:13px;display:flex;align-items:center;gap:11px;text-align:left;color:inherit;font:inherit;cursor:pointer;transition:.18s}.as-ticket:hover,.as-ticket.selected{border-color:#ff7900;background:#fffaf5}.as-icon{width:45px;height:45px;border-radius:12px;background:#fff0e3;display:grid;place-items:center;flex:0 0 45px}.as-ticket-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}.as-ticket-title{display:flex;gap:8px;align-items:center}.as-ticket-title b{font-size:14px}.as-ticket-title em{font-style:normal;background:#eef1f5;padding:4px 7px;border-radius:999px;font-size:10px}.as-ticket-copy>span:nth-child(2),.as-ticket-copy small{color:#697283;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.arrow{font-size:23px}.badge{padding:7px 10px;border-radius:999px;font-size:11px;font-weight:850;white-space:nowrap}.b-new{background:#ffe7eb;color:#d91f45}.b-in_progress,.b-waiting_customer{background:#fff0dc;color:#c36a00}.b-resolved{background:#e4f7ec;color:#08763b}.b-closed{background:#eceff3;color:#68707e}.as-detail{display:none;height:100%}.as-detail.active{display:flex;flex-direction:column}.as-detail-head{padding:14px 16px;border-bottom:1px solid #edf0f4;display:flex;justify-content:space-between;align-items:center}.as-detail-head h2{margin:0;font-size:17px}.as-meta{display:grid;grid-template-columns:1.25fr 1.25fr .75fr .9fr;border-bottom:1px solid #edf0f4}.as-meta>div{padding:12px;border-right:1px solid #edf0f4;display:flex;flex-direction:column;gap:3px}.as-meta span,.as-meta small{font-size:11px;color:#7f8795}.as-meta strong{font-size:12px}.as-messages{padding:16px;min-height:330px;max-height:480px;overflow:auto;background:#fcfdfe}.as-msg{display:flex;gap:8px;max-width:82%;margin-bottom:13px}.as-msg.admin{margin-left:auto;flex-direction:row-reverse}.as-avatar{width:34px;height:34px;border-radius:50%;background:#edf0f5;display:grid;place-items:center;flex:0 0 34px}.as-msg>div{background:#f1f3f6;border-radius:13px;padding:10px 12px}.as-msg.admin>div{background:#e6f2ff}.as-msg p{margin:4px 0 6px;line-height:1.45}.as-msg small{color:#8d94a0}.as-compose{margin-top:auto;border-top:1px solid #edf0f4;padding:12px;display:grid;grid-template-columns:115px 76px 1fr 100px;gap:8px;align-items:center}.as-compose select,.as-compose textarea{border:1px solid #dfe4ea;border-radius:10px;padding:10px;font:inherit;background:#fff}.as-compose textarea{resize:none;height:42px}.as-compose button{border:0;border-radius:10px;background:#ff7100;color:#fff;font-weight:850;height:43px;cursor:pointer}.as-empty{text-align:center;padding:50px 20px;color:#7d8593;font-size:25px}.as-empty h3{font-size:18px;color:#242b3a}.as-empty p{font-size:14px}.as-detail-empty{padding-top:160px}
@media(max-width:1200px){.as-stats{grid-template-columns:repeat(3,1fr)}.as-workspace{grid-template-columns:1fr}.as-details{min-height:500px}}@media(max-width:760px){.as-page{padding:14px}.as-stats{grid-template-columns:1fr 1fr}.as-filters{grid-template-columns:1fr}.as-meta{grid-template-columns:1fr 1fr}.as-compose{grid-template-columns:1fr 1fr}.as-compose textarea{grid-column:1/-1}.as-compose span{display:none}.as-ticket .badge{display:none}}@media(max-width:480px){.as-stats{grid-template-columns:1fr}.as-meta{grid-template-columns:1fr}.as-ticket-title em{display:none}}
.as-attachment{display:flex;align-items:center;gap:7px;margin:7px 0;color:#265fa7;text-decoration:none;font-weight:750;font-size:12px}.as-attachment img{display:block;max-width:220px;max-height:160px;border-radius:10px;border:1px solid #dbe3ed}.as-actions{display:flex;gap:5px}.as-icon-btn{width:34px;height:34px;border:1px solid #dfe4ea;background:#fff;border-radius:9px;display:grid;place-items:center;cursor:pointer}.as-editor{position:relative}.as-editor textarea{width:100%;box-sizing:border-box}.emoji-panel{position:absolute;bottom:58px;left:0;z-index:30;width:235px;padding:9px;border:1px solid #e0e4ea;border-radius:13px;background:#fff;box-shadow:0 12px 35px rgba(20,30,50,.14);display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.emoji-panel[hidden]{display:none}.emoji-panel button{border:0;background:transparent;font-size:19px;padding:4px;cursor:pointer;border-radius:7px}.emoji-panel button:hover{background:#f2f4f7}.file-name{font-size:10px;color:#697283;padding-top:3px;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
</style>
<script>
(()=>{const buttons=[...document.querySelectorAll('.as-ticket')],details=[...document.querySelectorAll('.as-detail')],search=document.getElementById('adminTicketSearch'),status=document.getElementById('adminStatus'),category=document.getElementById('adminCategory');function open(id){buttons.forEach(b=>b.classList.toggle('selected',b.dataset.id===String(id)));details.forEach(d=>d.classList.toggle('active',d.id==='adminDetail-'+id));}buttons.forEach(b=>b.addEventListener('click',()=>open(b.dataset.id)));function filter(){const q=(search?.value||'').toLowerCase().trim();buttons.forEach(b=>{const okS=!status||status.value==='ALL'||b.dataset.status===status.value;const okC=!category||category.value==='ALL'||b.dataset.category===category.value;const okQ=!q||b.dataset.search.includes(q);b.style.display=okS&&okC&&okQ?'flex':'none'});}search?.addEventListener('input',filter);status?.addEventListener('change',filter);category?.addEventListener('change',filter);const hash=location.hash.match(/ticket-(\d+)/);if(hash)open(hash[1]);const emojis=['😀','😂','😊','😍','🥰','😅','😢','😭','😡','👍','🙏','👏','❤️','🔥','✅','❌','🎉','🤝','📦','🚚','💳','⭐','🍽️','📞','👌','😉','🙂'];document.querySelectorAll('.as-compose').forEach(form=>{const ta=form.querySelector('textarea'),panel=form.querySelector('.emoji-panel'),toggle=form.querySelector('.emoji-toggle'),file=form.querySelector('input[type=file]'),name=form.querySelector('.file-name');if(panel){emojis.forEach(e=>{const b=document.createElement('button');b.type='button';b.textContent=e;b.onclick=()=>{const a=ta.selectionStart||ta.value.length,c=ta.selectionEnd||a;ta.value=ta.value.slice(0,a)+e+ta.value.slice(c);ta.focus();ta.selectionStart=ta.selectionEnd=a+e.length;panel.hidden=true};panel.appendChild(b)});}toggle?.addEventListener('click',()=>panel.hidden=!panel.hidden);file?.addEventListener('change',()=>name.textContent=file.files?.[0]?`📎 ${file.files[0].name}`:'');});})();
</script>
