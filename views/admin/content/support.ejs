        <article class="support-ticket">

            <div class="ticket-left">

                <div class="ticket-icon">
                    💬
                </div>

                <div class="ticket-info">
                    <h3>SUP-1043 · Commande</h3>
                    <p>TEST2 · CM23 · À l’instant</p>
                </div>

            </div>

