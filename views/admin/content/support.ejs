    font-size: 16px;
    line-height: 1.5;
}


/* =========================================================
   SELECT
========================================================= */

.support-status-select {
    box-sizing: border-box;

    width: 100%;
    height: 54px;

    padding: 0 17px;

    border: 1px solid #e2e2e2;
