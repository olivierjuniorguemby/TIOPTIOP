.as-head{display:flex;justify-content:space-between;align-items:center}.as-init-btn{border:0;background:#ff7900;color:#fff;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer}.as-filters{display:grid!important;grid-template-columns:1.4fr repeat(5,minmax(115px,1fr));gap:7px}.as-meta{grid-template-columns:1.2fr 1.2fr .8fr 1fr .8fr!important}.as-meta select{max-width:180px;border:1px solid #e3e7ee;border-radius:8px;padding:6px;background:#fff}.as-modal[hidden]{display:none}.as-modal{position:fixed;inset:0;background:rgba(15,23,42,.48);z-index:9999;display:grid;place-items:center;padding:20px}.as-modal-card{background:#fff;width:min(620px,96vw);border-radius:18px;padding:24px;position:relative;box-shadow:0 24px 70px rgba(0,0,0,.25)}.as-modal-close{position:absolute;right:15px;top:12px;border:0;background:#f1f3f5;border-radius:50%;width:34px;height:34px;font-size:22px;cursor:pointer}.as-modal-card form{display:grid;gap:13px;margin-top:18px}.as-modal-card label{display:grid;gap:6px;font-weight:700}.as-modal-card input,.as-modal-card textarea{border:1px solid #dfe3e8;border-radius:10px;padding:11px;font:inherit}.as-modal-card textarea{min-height:100px}.as-upload-video{border:1px dashed #ff7900;padding:12px;border-radius:10px}.init-files{font-size:12px;color:#667085;display:flex;gap:8px;flex-wrap:wrap}.init-file{border:1px solid #e3e7ed;border-radius:10px;padding:6px;display:flex;gap:6px;align-items:center;background:#f8fafc}.init-file video,.init-file img{width:92px;height:62px;object-fit:cover;border-radius:7px;background:#111}.init-file button{border:0;background:#fff;border-radius:50%;cursor:pointer}.typing-indicator{position:absolute;left:150px;bottom:100%;z-index:8;font-size:12px;color:#8e55dc;font-weight:800;padding:4px 9px;margin-bottom:5px;background:#fff;border:1px solid #eee5fb;border-radius:12px;box-shadow:0 3px 10px rgba(0,0,0,.08);white-space:nowrap;pointer-events:none}.as-compose{position:relative}.as-list-typing{display:block;color:#8e55dc!important;font-weight:800!important;font-size:11px!important}.as-no-selection{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:35px;color:#667085}.as-chat-illustration{width:120px;height:92px;margin:0 auto 18px;position:relative}.as-chat-illustration i{position:absolute;width:78px;height:52px;border-radius:18px;background:#efe6fb;left:5px;top:5px}.as-chat-illustration i:after{content:"";position:absolute;left:12px;bottom:-9px;border:10px solid transparent;border-top-color:#efe6fb;transform:rotate(18deg)}.as-chat-illustration i:nth-child(2){left:38px;top:32px;background:#fff0e4}.as-chat-illustration i:nth-child(2):after{left:auto;right:12px;border-top-color:#fff0e4;transform:rotate(-18deg)}.as-chat-illustration b{position:absolute;z-index:2;left:50px;top:46px;color:#ff7900;letter-spacing:4px;font-size:20px}.as-no-selection h3{margin:0 0 7px;color:#172033}.as-no-selection p{margin:0;line-height:1.5}.as-messages-wrap{position:relative;min-height:0}.as-jump-latest{position:absolute;right:22px;bottom:14px;z-index:20;width:44px;height:44px;border:0;border-radius:50%;background:#fff;color:#ff7100;box-shadow:0 5px 18px rgba(15,23,42,.22);font-size:22px;cursor:pointer;display:none}.as-jump-latest.show{display:grid;place-items:center}.as-jump-latest .jump-count{position:absolute;right:-5px;top:-7px;min-width:21px;height:21px;padding:0 5px;border-radius:999px;background:#e51d3f;color:#fff;font-size:11px;font-weight:900;display:grid;place-items:center}.as-jump-latest .jump-count:empty{display:none}@media(max-width:1200px){.as-filters{grid-template-columns:1fr 1fr!important}.as-meta{grid-template-columns:1fr 1fr!important}}
.as-lifecycle{border-bottom:1px solid #edf0f4;padding:9px 14px;background:#fff}.as-lifecycle summary{cursor:pointer;font-weight:800;color:#596273}.as-history{padding:9px 4px 2px}.as-history>div{display:flex;gap:9px;margin:7px 0}.as-history>div>span{color:#ff7900}.as-history p{margin:0;display:flex;flex-direction:column}.as-history small{color:#8a929f}.as-reopen-zone{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-top:1px solid #edf0f4;background:#f8fafc}.as-reopen-zone button{border:0;background:#ff7900;color:#fff;padding:10px 14px;border-radius:10px;font-weight:850;cursor:pointer}</style>
<style>.as-attachment video{display:block;max-width:260px;max-height:180px;border-radius:10px;background:#000}.file-preview{display:flex;gap:6px;flex-wrap:wrap;padding-top:4px}.file-chip{display:flex;align-items:center;gap:5px;background:#f4f6f8;border:1px solid #e1e5ea;border-radius:8px;padding:4px 6px;font-size:10px}.file-chip img,.file-chip video{width:38px;height:28px;object-fit:cover;border-radius:5px}.file-chip button{border:0;background:#fff;border-radius:50%;cursor:pointer}.as-unread{background:#e32636!important}.as-archive{border:1px solid #e1e5ea;background:#fff;border-radius:9px;padding:8px;cursor:pointer}</style>

<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{
  const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; const labels={NEW:'Nouveau',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'En attente client',RESOLVED:'Résolu',CLOSED:'Fermé'};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const fr=d=>{try{return new Date(d).toLocaleString('fr-FR')}catch{return ''}};
  const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||''));
  let activeId=Number(document.querySelector('.as-detail.active .as-messages')?.dataset.ticket||0),socket=null,syncing=false,queued=false;
  const nearBottom=el=>!el||el.scrollHeight-el.scrollTop-el.clientHeight<110;
  const unseenByTicket=new Map();
  function jumpButton(id){return document.querySelector(`#adminDetail-${id} .as-jump-latest`)}
  function ensureJumpButton(id){const box=document.querySelector(`#adminDetail-${id} .as-messages`);if(!box)return null;let wrap=box.parentElement;if(!wrap.classList.contains('as-messages-wrap')){const w=document.createElement('div');w.className='as-messages-wrap';box.parentNode.insertBefore(w,box);w.appendChild(box);wrap=w}let b=wrap.querySelector('.as-jump-latest');if(!b){b=document.createElement('button');b.type='button';b.className='as-jump-latest';b.setAttribute('aria-label','Revenir aux nouveaux messages');b.innerHTML='<span class="jump-arrow">↓</span><span class="jump-count"></span>';b.addEventListener('click',()=>scrollAdminBottom(id,true));wrap.appendChild(b)}return b}
  function updateJump(id){const b=ensureJumpButton(id);if(!b)return;const n=Number(unseenByTicket.get(Number(id))||0),c=b.querySelector('.jump-count');c.textContent=n?String(n):'';b.classList.toggle('show',n>0)}
  function scrollAdminBottom(id,clear=true){const box=document.querySelector(`#adminDetail-${id} .as-messages`);if(!box)return;const go=()=>{box.scrollTop=box.scrollHeight;if(clear){unseenByTicket.set(Number(id),0);updateJump(id)}};requestAnimationFrame(()=>requestAnimationFrame(go));setTimeout(go,80);setTimeout(go,260)}
  function settleAdminBottom(id){scrollAdminBottom(id,true);const box=document.querySelector(`#adminDetail-${id} .as-messages`);box?.querySelectorAll('img,video').forEach(m=>{if(!m.complete&&m.readyState<1){m.addEventListener('load',()=>scrollAdminBottom(id,true),{once:true});m.addEventListener('loadedmetadata',()=>scrollAdminBottom(id,true),{once:true})}});setTimeout(()=>scrollAdminBottom(id,true),650)}
  const sound={muted:localStorage.getItem('tiop-support-sound')==='0',ctx:null,play(kind){if(this.muted)return;try{this.ctx=this.ctx||new (window.AudioContext||window.webkitAudioContext)();const c=this.ctx,n=c.currentTime,o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);const cfg=kind==='send'?[620,0.16]:kind==='reaction'?[760,0.18]:kind==='status'?[520,0.20]:[880,0.24];o.frequency.setValueAtTime(cfg[0],n);if(kind==='receive')o.frequency.exponentialRampToValueAtTime(1180,n+.11);if(kind==='send')o.frequency.exponentialRampToValueAtTime(820,n+.08);g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.10,n+.012);g.gain.exponentialRampToValueAtTime(.0001,n+cfg[1]);o.start(n);o.stop(n+cfg[1]+.02);}catch(_){}}};
  function updateSoundButton(){document.querySelectorAll('.as-sound-toggle').forEach(b=>b.textContent=sound.muted?'🔇':'🔊')} document.querySelectorAll('.as-sound-toggle').forEach(b=>b.addEventListener('click',()=>{sound.muted=!sound.muted;localStorage.setItem('tiop-support-sound',sound.muted?'0':'1');updateSoundButton();if(!sound.muted)sound.play('send')}));updateSoundButton();
  function updateStats(stats){const a=document.querySelectorAll('.as-stats article strong');if(a.length>=5){a[0].textContent=Number(stats?.new_count||0);a[1].textContent=Number(stats?.in_progress_count||0);a[2].textContent=Number(stats?.waiting_count||0);a[3].textContent=Number(stats?.resolved_count||0);a[4].textContent=Number(stats?.total||0);}}
  function historyHtml(h){return `<div><span>●</span><p><b>${esc(labels[h.from_status]||h.from_status)} → ${esc(labels[h.to_status]||h.to_status)}</b><small>${esc(h.actor_name||'Système')} · ${esc(fr(h.created_at))}${h.note?' · '+esc(h.note):''}</small></p></div>`;}
  function updateLifecycle(id,ticket,history){if(!ticket)return;const root=document.getElementById('adminDetail-'+id);if(!root)return;const status=ticket.status;const head=root.querySelector('.as-detail-head .badge');if(head){head.className='badge b-'+status.toLowerCase();head.textContent=labels[status]||status;}const sel=root.querySelector('.ticket-status-live');if(sel&&sel.value!==status)sel.value=status;const compose=root.querySelector('[data-lifecycle-compose]'),reopen=root.querySelector('[data-lifecycle-reopen]');const closed=['RESOLVED','CLOSED'].includes(status);if(compose)compose.style.display=closed?'none':'';if(reopen){reopen.style.display=closed?'':'none';const l=reopen.querySelector('.as-closed-label');if(l)l.textContent=status==='RESOLVED'?'résolu':'fermé';}const box=root.querySelector('.as-history');if(box){box.innerHTML=(history||[]).length?(history||[]).slice().reverse().map(historyHtml).join(''):'<small>Aucun changement de statut enregistré.</small>';const n=root.querySelector('.as-lifecycle summary b');if(n)n.textContent=(history||[]).length;}}

  function attachmentHtml(a){const href=a.id?('/admin/support/fichier/'+a.id):(a.legacy_url||'#');if(isImg(a))return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener"><img src="${esc(href)}" alt="Pièce jointe"></a>`;if(isVideo(a))return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener"><video controls preload="metadata" src="${esc(href)}"></video><span>🎬 ${esc(a.original_name||'Vidéo de préparation')}</span></a>`;return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener">📄 ${esc(a.original_name||'Ouvrir la pièce jointe')}</a>`;}
  function messageHtml(m){const mine=m.sender_type==='ADMIN';const actions=mine&&!m.deleted_at?`<span class="as-msg-actions"><button type="button" class="msg-edit" data-ticket="${m.ticket_id}" data-id="${m.id}" data-text="${esc(m.message||'')}">✎</button><button type="button" class="msg-delete" data-ticket="${m.ticket_id}" data-id="${m.id}">🗑</button></span>`:'';const content=m.deleted_at?'<p class="as-deleted">Message supprimé</p>':`${m.message?`<p>${esc(m.message)}</p>`:''}${(m.attachments||[]).map(attachmentHtml).join('')}`;const reactions=(m.reactions||[]).map(r=>`<span>${esc(r.emoji)}</span>`).join('');const menu=!m.deleted_at?`<div class="as-react-bar"><button type="button" class="react-open">☺</button><div class="react-menu" hidden>${reactionSet.map(e=>`<button type="button" data-ticket="${m.ticket_id}" data-id="${m.id}" data-emoji="${e}">${e}</button>`).join('')}</div></div>`:'';return `<div class="as-msg ${mine?'admin':'customer'}" data-message-id="${m.id}"><span class="as-avatar">${mine?'🎧':'👤'}</span><div><div class="as-msg-head"><strong>${esc(m.sender_name||(mine?'Support TiopTiop':'Client'))}</strong>${actions}</div>${content}<div class="as-reactions">${reactions}</div><div class="as-msg-foot"><small>${esc(fr(m.created_at))}${m.edited_at?' · Modifié':''}</small>${mine?`<span class="read-state">${m.read_at?'✓✓':'✓'}</span>`:''}</div>${menu}</div></div>`;}
  function updateTicketList(tickets){const list=document.getElementById('adminTicketList');if(!list)return;const existing=new Map([...list.querySelectorAll('.as-ticket')].map(x=>[x.dataset.id,x]));(tickets||[]).forEach(t=>{let el=existing.get(String(t.id));if(!el){el=document.createElement('button');el.type='button';el.className='as-ticket';el.dataset.id=t.id;el.innerHTML=`<span class="as-icon">💬</span><span class="as-ticket-copy"><span class="as-ticket-title"><b>${esc(t.reference)} · ${esc(t.subject)}</b></span><span></span><small></small></span><span class="badge"></span><span class="arrow">›</span>`;list.prepend(el);el.addEventListener('click',()=>location.href='/admin/support?ticket='+t.id);}el.dataset.unread=Number(t.unread_count||0);el.dataset.status=t.status;el.dataset.category=t.category||'';el.dataset.priority=t.priority||'NORMAL';el.dataset.agent=t.assigned_admin_user_id||'';el.classList.toggle('unread',Number(t.unread_count||0)>0);const lines=el.querySelectorAll('.as-ticket-copy>span');if(lines[1])lines[1].textContent=(t.customer_name||'Client')+' · '+(t.last_message||'Demande support')+(Number(t.last_attachment_count||0)?' · 📎 '+t.last_attachment_count:'');let cb=el.querySelector('.as-cat-live');if(!cb){cb=document.createElement('small');cb.className='as-cat-live';el.querySelector('.as-ticket-copy')?.appendChild(cb)}if(cb)cb.textContent=({ORDER:'Commande',DELIVERY:'Livraison',PAYMENT:'Paiement',REFUND:'Remboursement',TIOP_PLUS:'Tiop+',ACCOUNT:'Compte',RESTAURANT:'Restaurant',OTHER:'Autre'}[t.category]||t.category||'');const sm=el.querySelector('.as-ticket-copy small');if(sm)sm.textContent=(t.order_reference||'Sans commande')+' · '+fr(t.last_message_at||t.updated_at);let u=el.querySelector('.as-unread');if(Number(t.unread_count||0)>0){if(!u){u=document.createElement('span');u.className='as-unread';el.insertBefore(u,el.querySelector('.badge'));}u.textContent=t.unread_count;}else u?.remove();const b=el.querySelector('.badge');if(b){b.className='badge b-'+String(t.status||'').toLowerCase();b.textContent=labels[t.status]||t.status;}});(tickets||[]).map(t=>list.querySelector(`.as-ticket[data-id="${t.id}"]`)).filter(Boolean).forEach(el=>list.appendChild(el));}
  async function syncSupport(reason='socket',id=activeId){if(syncing){queued=true;return;}syncing=true;try{const r=await fetch(`/admin/support-poll?ticket=${Number(id||0)}`,{headers:{Accept:'application/json'},cache:'no-store'});if(!r.ok)return;const data=await r.json();updateTicketList(data.tickets||[]);updateStats(data.stats||{});if(id){updateLifecycle(id,data.selectedTicket,data.history||[]);const msgBox=document.querySelector(`#adminDetail-${id} .as-messages`);if(msgBox){const stick=nearBottom(msgBox),oldLast=Number(msgBox.dataset.lastId||0),incoming=(data.messages||[]).filter(m=>Number(m.id)>oldLast&&m.sender_type!=='ADMIN').length;msgBox.innerHTML=(data.messages||[]).map(messageHtml).join('');msgBox.dataset.lastId=String((data.messages||[]).at(-1)?.id||0);ensureJumpButton(id);if(reason==='open'||reason==='initial'){settleAdminBottom(id)}else if(stick||reason==='send'){scrollAdminBottom(id,true)}else if(incoming>0){unseenByTicket.set(Number(id),Number(unseenByTicket.get(Number(id))||0)+incoming);updateJump(id)}}}}finally{syncing=false;if(queued){queued=false;syncSupport('queued',activeId);}}}
  function open(id){id=Number(id);document.querySelectorAll('.as-ticket').forEach(b=>b.classList.toggle('selected',Number(b.dataset.id)===id));document.querySelectorAll('.as-detail').forEach(d=>d.classList.toggle('active',d.id==='adminDetail-'+id));if(socket&&activeId)socket.emit('support:leave',{ticketId:activeId});activeId=id;if(socket&&activeId)socket.emit('support:join',{ticketId:activeId});history.replaceState(null,'',`/admin/support?ticket=${id}`);syncSupport('open',id);}
  document.querySelectorAll('.as-ticket').forEach(b=>b.addEventListener('click',()=>{ const id=Number(b.dataset.id||0); if(id) window.location.assign('/admin/support?ticket='+id); }));
  const search=document.getElementById('adminTicketSearch'),status=document.getElementById('adminStatus'),category=document.getElementById('adminCategory'),priority=document.getElementById('adminPriority'),agent=document.getElementById('adminAgent'),unread=document.getElementById('adminUnread'),currentAdminId=Number(<%- JSON.stringify(currentAdminId||0) %>);function filter(){const q=(search?.value||'').toLowerCase().trim();document.querySelectorAll('.as-ticket').forEach(b=>{const av=agent?.value||'ALL',okA=av==='ALL'||(av==='MINE'&&Number(b.dataset.agent)===currentAdminId)||(av==='UNASSIGNED'&&!b.dataset.agent)||b.dataset.agent===av;const okP=!priority||priority.value==='ALL'||b.dataset.priority===priority.value,okU=!unread||unread.value==='ALL'||Number(b.dataset.unread||0)>0,okS=!status||status.value==='ALL'||b.dataset.status===status.value,okC=!category||category.value==='ALL'||b.dataset.category===category.value,okQ=!q||(b.textContent||'').toLowerCase().includes(q);b.style.display=okS&&okC&&okQ&&okP&&okA&&okU?'flex':'none'});}[search,status,category,priority,agent,unread].forEach((x,i)=>x?.addEventListener(i===0?'input':'change',filter));
  async function post(url,data){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:new URLSearchParams(data)});if(!r.ok)throw new Error('Action impossible');return r.json();}
  document.querySelectorAll('.ticket-agent').forEach(x=>x.addEventListener('change',async()=>{await post(`/admin/support/${x.dataset.ticket}/assign`,{adminId:x.value});await syncSupport('assign',Number(x.dataset.ticket));}));document.querySelectorAll('.ticket-priority').forEach(x=>x.addEventListener('change',async()=>{await post(`/admin/support/${x.dataset.ticket}/priority`,{priority:x.value});await syncSupport('priority',Number(x.dataset.ticket));}));document.querySelectorAll('.ticket-status-live').forEach(x=>x.addEventListener('change',async()=>{const previous=x.dataset.previous||'',form=x.closest('.as-compose'),hasDraft=!!form?.querySelector('textarea')?.value.trim()||!!form?.querySelector('input[type=file]')?.files?.length;if(hasDraft)return;try{await post(`/admin/support/${x.dataset.ticket}/status`,{status:x.value});x.dataset.previous=x.value;}catch(e){if(previous)x.value=previous;alert(e.message);}}));document.querySelectorAll('.ticket-status-live').forEach(x=>x.dataset.previous=x.value);
  const im=document.getElementById('initiateModal'),of=document.getElementById('openInitiate'),cf=document.getElementById('closeInitiate'),iff=document.querySelector('#initiateForm input[type=file]'),ifl=document.querySelector('.init-files');let initChosen=[];const syncInitFiles=()=>{const dt=new DataTransfer();initChosen.forEach(f=>dt.items.add(f));iff.files=dt.files;if(ifl){ifl.innerHTML='';initChosen.forEach((f,i)=>{const c=document.createElement('div');c.className='init-file';let m;if(f.type==='video/mp4'){m=document.createElement('video');m.controls=true;m.muted=true}else if(f.type.startsWith('image/'))m=document.createElement('img');if(m){m.src=URL.createObjectURL(f);c.appendChild(m)}const n=document.createElement('span');n.textContent=f.name;c.appendChild(n);const x=document.createElement('button');x.type='button';x.textContent='×';x.title='Retirer avant envoi';x.onclick=()=>{initChosen.splice(i,1);syncInitFiles()};c.appendChild(x);ifl.appendChild(c)})}};of?.addEventListener('click',()=>im.hidden=false);cf?.addEventListener('click',()=>im.hidden=true);im?.addEventListener('click',e=>{if(e.target===im)im.hidden=true});iff?.addEventListener('change',()=>{initChosen=[...iff.files];syncInitFiles()});const initTa=document.querySelector('#initiateForm textarea'),initEp=document.querySelector('.init-emoji-panel'),initEt=document.querySelector('.init-emoji-toggle');['😀','😂','😊','😍','🥰','🙏','👏','❤️','🔥','✅','🎉','📦','🚚','🍽️','👌','😉'].forEach(em=>{const b=document.createElement('button');b.type='button';b.textContent=em;b.onclick=()=>{initTa.value+=em;initTa.focus();initEp.hidden=true};initEp?.appendChild(b)});initEt?.addEventListener('click',()=>initEp.hidden=!initEp.hidden);document.getElementById('initiateForm')?.addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,b=f.querySelector('button[type=submit]');b.disabled=true;try{const r=await fetch(f.action,{method:'POST',body:new FormData(f),headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||'Envoi impossible');im.hidden=true;location.href='/admin/support?ticket='+d.ticketId;}catch(err){alert(err.message)}finally{b.disabled=false}});
  document.addEventListener('click',async e=>{const edit=e.target.closest('.msg-edit');if(edit){const text=prompt('Modifier votre message :',edit.dataset.text||'');if(text===null)return;await post(`/admin/support/${edit.dataset.ticket}/messages/${edit.dataset.id}/edit`,{message:text});await syncSupport('edit',Number(edit.dataset.ticket));return;}const del=e.target.closest('.msg-delete');if(del){if(!confirm('Supprimer ce message ?'))return;await post(`/admin/support/${del.dataset.ticket}/messages/${del.dataset.id}/delete`,{});await syncSupport('delete',Number(del.dataset.ticket));return;}const ro=e.target.closest('.react-open');if(ro){const m=ro.parentElement.querySelector('.react-menu');if(m)m.hidden=!m.hidden;return;}const rb=e.target.closest('.react-menu button');if(rb){await post(`/admin/support/${rb.dataset.ticket}/messages/${rb.dataset.id}/react`,{emoji:rb.dataset.emoji});await syncSupport('reaction',Number(rb.dataset.ticket));}});
  const emojis=['😀','😂','😊','😍','🥰','😅','😢','😭','😡','👍','🙏','👏','❤️','🔥','✅','❌','🎉','🤝','📦','🚚','💳','⭐','🍽️','📞','👌','😉','🙂'];
  document.querySelectorAll('.as-compose').forEach(form=>{const ta=form.querySelector('textarea'),panel=form.querySelector('.emoji-panel'),toggle=form.querySelector('.emoji-toggle'),input=form.querySelector('input[type=file]'),preview=form.querySelector('.file-preview'),name=form.querySelector('.file-name');let chosen=[];emojis.forEach(em=>{const b=document.createElement('button');b.type='button';b.textContent=em;b.onclick=()=>{const a=ta.selectionStart||ta.value.length,c=ta.selectionEnd||a;ta.value=ta.value.slice(0,a)+em+ta.value.slice(c);ta.focus();ta.selectionStart=ta.selectionEnd=a+em.length;panel.hidden=true};panel.appendChild(b)});toggle?.addEventListener('click',()=>panel.hidden=!panel.hidden);let typingTimer;ta?.addEventListener('input',()=>{if(!socket)return;const tid=Number(form.action.match(/\/support\/(\d+)\/reply/)?.[1]||activeId);socket.emit('support:typing',{ticketId:tid,typing:true});clearTimeout(typingTimer);typingTimer=setTimeout(()=>socket.emit('support:typing',{ticketId:tid,typing:false}),900)});const render=()=>{if(!preview)return;preview.innerHTML='';chosen.forEach((f,i)=>{const c=document.createElement('div');c.className='file-chip';let media=null;if(f.type.startsWith('image/'))media=document.createElement('img');else if(f.type==='video/mp4'){media=document.createElement('video');media.muted=true}if(media){media.src=URL.createObjectURL(f);c.appendChild(media)}const n=document.createElement('span');n.textContent=f.name;c.appendChild(n);const x=document.createElement('button');x.type='button';x.textContent='×';x.onclick=()=>{chosen.splice(i,1);syncFiles()};c.appendChild(x);preview.appendChild(c)});if(name)name.textContent=chosen.length?`📎 ${chosen.length} fichier(s)`:'';};const syncFiles=()=>{const dt=new DataTransfer();chosen.forEach(f=>dt.items.add(f));input.files=dt.files;render()};input?.addEventListener('change',()=>{chosen=[...input.files];render()});form.addEventListener('submit',async ev=>{ev.preventDefault();const btn=form.querySelector('button:not([type=button])');if(btn)btn.disabled=true;try{const r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});if(!r.ok)throw new Error('Envoi impossible');ta.value='';chosen=[];syncFiles();await syncSupport('send',Number(form.action.match(/\/support\/(\d+)\/reply/)?.[1]||activeId));}catch(err){alert(err.message||'Envoi impossible');}finally{if(btn)btn.disabled=false;}});});
  document.addEventListener('click',async e=>{const b=e.target.closest('.ticket-reopen');if(!b)return;if(!confirm('Réouvrir ce ticket et le remettre En cours ?'))return;try{const r=await fetch(`/admin/support/${b.dataset.ticket}/reopen`,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});if(!r.ok)throw new Error('Réouverture impossible');await syncSupport('ticket:status',Number(b.dataset.ticket));}catch(err){alert(err.message)}});
  document.querySelectorAll('.as-messages').forEach(box=>{const id=Number(box.dataset.ticket||0);ensureJumpButton(id);box.addEventListener('scroll',()=>{if(nearBottom(box)){unseenByTicket.set(id,0);updateJump(id)}})});
  if(activeId)settleAdminBottom(activeId);
  if(window.io){socket=io();if(activeId)socket.emit('support:join',{ticketId:activeId});socket.on('support:typing',e=>{const id=Number(e?.ticketId||0);const row=document.querySelector(`.as-ticket[data-id="${id}"]`);let li=row?.querySelector('.as-list-typing');if(e.typing){if(row&&!li){li=document.createElement('small');li.className='as-list-typing';row.querySelector('.as-ticket-copy')?.appendChild(li)}if(li)li.textContent=(e.actorName||'Le client')+' écrit…';}else li?.remove();if(id!==activeId)return;let x=document.querySelector(`#adminDetail-${activeId} .typing-indicator`);if(!x&&e.typing){x=document.createElement('div');x.className='typing-indicator';document.querySelector(`#adminDetail-${activeId} .as-compose`)?.appendChild(x)}if(x){x.textContent=e.typing?(e.actorName||'Le client')+' écrit…':'';x.style.display=e.typing?'block':'none'}});socket.on('support:changed',e=>{const id=Number(e?.ticketId||0),type=String(e?.type||'');if(type==='message:new')sound.play(e?.actorType==='ADMIN'?'send':'receive');else if(type==='reaction')sound.play(e?.actorType==='ADMIN'?'send':'reaction');else if(type==='ticket:status')sound.play('status');if(id===activeId)syncSupport(type||'socket',activeId);else syncSupport('list',0);});}
  if(activeId)syncSupport('initial',activeId);
})();
