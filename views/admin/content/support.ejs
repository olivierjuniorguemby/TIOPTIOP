.as-head{display:flex;justify-content:space-between;align-items:center}.as-init-btn{border:0;background:#ff7900;color:#fff;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer}.as-filters{display:grid!important;grid-template-columns:1.4fr repeat(5,minmax(115px,1fr));gap:7px}.as-meta{grid-template-columns:1.2fr 1.2fr .8fr 1fr .8fr!important}.as-meta select{max-width:180px;border:1px solid #e3e7ee;border-radius:8px;padding:6px;background:#fff}.as-modal[hidden]{display:none}.as-modal{position:fixed;inset:0;background:rgba(15,23,42,.48);z-index:9999;display:grid;place-items:center;padding:20px}.as-modal-card{background:#fff;width:min(620px,96vw);border-radius:18px;padding:24px;position:relative;box-shadow:0 24px 70px rgba(0,0,0,.25)}.as-modal-close{position:absolute;right:15px;top:12px;border:0;background:#f1f3f5;border-radius:50%;width:34px;height:34px;font-size:22px;cursor:pointer}.as-modal-card form{display:grid;gap:13px;margin-top:18px}.as-modal-card label{display:grid;gap:6px;font-weight:700}.as-modal-card input,.as-modal-card textarea{border:1px solid #dfe3e8;border-radius:10px;padding:11px;font:inherit}.as-modal-card textarea{min-height:100px}.as-upload-video{border:1px dashed #ff7900;padding:12px;border-radius:10px}.init-files{font-size:12px;color:#667085;display:flex;gap:8px;flex-wrap:wrap}.init-file{border:1px solid #e3e7ed;border-radius:10px;padding:6px;display:flex;gap:6px;align-items:center;background:#f8fafc}.init-file video,.init-file img{width:92px;height:62px;object-fit:cover;border-radius:7px;background:#111}.init-file button{border:0;background:#fff;border-radius:50%;cursor:pointer}.typing-indicator{position:absolute;left:150px;bottom:100%;z-index:8;font-size:12px;color:#8e55dc;font-weight:800;padding:4px 9px;margin-bottom:5px;background:#fff;border:1px solid #eee5fb;border-radius:12px;box-shadow:0 3px 10px rgba(0,0,0,.08);white-space:nowrap;pointer-events:none}.as-compose{position:relative}.as-list-typing{display:block;color:#8e55dc!important;font-weight:800!important;font-size:11px!important}.as-no-selection{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:35px;color:#667085}.as-chat-illustration{width:120px;height:92px;margin:0 auto 18px;position:relative}.as-chat-illustration i{position:absolute;width:78px;height:52px;border-radius:18px;background:#efe6fb;left:5px;top:5px}.as-chat-illustration i:after{content:"";position:absolute;left:12px;bottom:-9px;border:10px solid transparent;border-top-color:#efe6fb;transform:rotate(18deg)}.as-chat-illustration i:nth-child(2){left:38px;top:32px;background:#fff0e4}.as-chat-illustration i:nth-child(2):after{left:auto;right:12px;border-top-color:#fff0e4;transform:rotate(-18deg)}.as-chat-illustration b{position:absolute;z-index:2;left:50px;top:46px;color:#ff7900;letter-spacing:4px;font-size:20px}.as-no-selection h3{margin:0 0 7px;color:#172033}.as-no-selection p{margin:0;line-height:1.5}.as-messages-wrap{position:relative;min-height:0}.as-jump-latest{position:absolute;right:22px;bottom:14px;z-index:20;width:44px;height:44px;border:0;border-radius:50%;background:#fff;color:#ff7100;box-shadow:0 5px 18px rgba(15,23,42,.22);font-size:22px;cursor:pointer;display:none}.as-jump-latest.show{display:grid;place-items:center}.as-jump-latest .jump-count{position:absolute;right:-5px;top:-7px;min-width:21px;height:21px;padding:0 5px;border-radius:999px;background:#e51d3f;color:#fff;font-size:11px;font-weight:900;display:grid;place-items:center}.as-jump-latest .jump-count:empty{display:none}@media(max-width:1200px){.as-filters{grid-template-columns:1fr 1fr!important}.as-meta{grid-template-columns:1fr 1fr!important}}
.as-lifecycle{border-bottom:1px solid #edf0f4;padding:9px 14px;background:#fff}.as-lifecycle summary{cursor:pointer;font-weight:800;color:#596273}.as-history{padding:9px 4px 2px}.as-history>div{display:flex;gap:9px;margin:7px 0}.as-history>div>span{color:#ff7900}.as-history p{margin:0;display:flex;flex-direction:column}.as-history small{color:#8a929f}.as-reopen-zone{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-top:1px solid #edf0f4;background:#f8fafc}.as-reopen-zone button{border:0;background:#ff7900;color:#fff;padding:10px 14px;border-radius:10px;font-weight:850;cursor:pointer}
.as-activity{border-bottom:1px solid #edf0f4;padding:9px 14px;background:#fffaf5}.as-activity summary{cursor:pointer;font-weight:850;color:#596273}.as-activity-list{padding:8px 4px;max-height:230px;overflow:auto}.as-activity-row{display:flex;gap:9px;padding:7px 0;border-bottom:1px dashed #eceff3}.as-activity-row:last-child{border-bottom:0}.as-activity-row>span{width:24px}.as-activity-row p{margin:0;display:flex;flex-direction:column;gap:2px;min-width:0}.as-activity-row small{color:#8a929f}.as-activity-row em{font-style:normal;color:#4b5563;white-space:pre-wrap}.as-activity-row.note em{background:#fff;border:1px solid #ffe0c7;padding:7px 9px;border-radius:9px;margin-top:3px}.as-note-form{display:flex;gap:8px;padding:8px 0 2px}.as-note-form textarea{flex:1;min-height:56px;resize:vertical;border:1px solid #dfe4ea;border-radius:10px;padding:9px;font:inherit}.as-note-form button{align-self:flex-end;border:0;background:#ff7900;color:#fff;border-radius:10px;padding:10px 13px;font-weight:850;cursor:pointer}

