}


/* =========================================================
   TABLETTE
========================================================= */

@media (max-width: 1100px) {

    .support-stats {
        grid-template-columns: repeat(2, 1fr);
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

    .support-admin {
        padding: 12px;
    }

    .support-header h1 {
        font-size: 34px;
    }


    /* STATS */

    .support-stats {
        grid-template-columns: 1fr 1fr;

        gap: 12px;
    }

    .support-stat-card {
        min-height: 110px;

        padding: 20px;

        border-radius: 20px;
    }

    .support-stat-label {
        font-size: 15px;
    }

