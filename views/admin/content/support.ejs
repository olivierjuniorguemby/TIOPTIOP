        font-size: 30px;
    }


    /* TICKET */

    .support-ticket {
        align-items: flex-start;
        flex-direction: column;

        padding: 18px;

        border-radius: 20px;
    }

    .ticket-icon {
        width: 55px;
        height: 55px;

        flex-basis: 55px;
    }

    .ticket-info h3 {
        font-size: 17px;
    }

    .ticket-info p {
        font-size: 15px;
    }

    .ticket-actions {
        width: 100%;

        justify-content: space-between;
    }


    /* MODAL */

    .support-modal-overlay {
        padding: 12px;
    }

    .support-modal {
        width: 100%;

        padding: 25px 18px;

        border-radius: 28px;
    }

    .support-modal-header {
        margin-bottom: 35px;
    }

    .support-modal-header h2 {
        font-size: 25px;
    }

    .support-modal-close {
        width: 48px;
        height: 48px;

        flex-basis: 48px;

        font-size: 21px;
    }

    .support-ticket-details p {
        margin-bottom: 20px;

        font-size: 18px;
    }

    .support-message {
        font-size: 18px;
    }

    .support-status-select {
        height: 65px;

        border-radius: 18px;

        font-size: 17px;
    }

    .support-response {
        min-height: 120px;

        padding: 18px;

