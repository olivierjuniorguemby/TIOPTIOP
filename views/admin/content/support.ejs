.as-day-separator,.as-unread-separator{display:flex;align-items:center;justify-content:center;margin:14px 0;clear:both}.as-day-separator span{background:#f1f3f6;color:#626b78;border-radius:999px;padding:5px 12px;font-size:12px;font-weight:800;box-shadow:0 1px 3px rgba(0,0,0,.05)}.as-unread-separator{position:relative;color:#d95f00;font-size:12px;font-weight:900}.as-unread-separator:before,.as-unread-separator:after{content:'';height:1px;background:#ffd4b2;flex:1}.as-unread-separator span{padding:0 10px;background:#fff}.as-msg[data-unread="1"]>div{box-shadow:0 0 0 1px rgba(255,113,0,.08)}
