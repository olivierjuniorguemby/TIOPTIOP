    overflow-y: auto;

    padding: 28px 30px 30px;

    border-radius: 26px;

    background: #fff;

    box-shadow: 0 25px 65px rgba(0, 0, 0, .28);
}


/* HEADER MODAL */

.support-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 22px;
}

.support-modal-header h2 {
    margin: 0;

    font-size: 28px;
    line-height: 1.2;
    font-weight: 800;
}

.support-modal-close {
    flex: 0 0 45px;

    width: 45px;
    height: 45px;

    padding: 0;

