<% const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||'')); const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; const labels={NEW:'Nouveau',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'En attente client',RESOLVED:'Résolu',CLOSED:'Fermé'}; const catLabels={ORDER:'Commande',DELIVERY:'Livraison',PAYMENT:'Paiement',REFUND:'Remboursement',TIOP_PLUS:'Tiop+',ACCOUNT:'Compte',RESTAURANT:'Restaurant',OTHER:'Autre'}; const icons={ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}; %>
<section class="as-page">
 <header class="as-head"><div class="as-title"><span>💬</span><div><h1>Support</h1><p>Gérez les demandes clients et suivez leur résolution.</p></div></div><div style="display:flex;gap:8px"><button type="button" class="as-sound-toggle as-init-btn" title="Activer/désactiver les sons">🔊</button><button type="button" class="as-init-btn" id="openInitiate">🎥 Contacter depuis une commande</button></div></header>
 <% if(saved){ %><div class="as-success">✓ Ticket enregistré et réponse ajoutée.</div><% } %>
 <section class="as-stats">
  <article><i class="i-red">●</i><div><span>Nouveaux</span><strong><%= Number(stats.new_count||0) %></strong><small>À traiter</small></div></article>
  <article><i class="i-orange">▣</i><div><span>En cours</span><strong><%= Number(stats.in_progress_count||0) %></strong><small>En traitement</small></div></article>
  <article><i class="i-yellow">◷</i><div><span>En attente client</span><strong><%= Number(stats.waiting_count||0) %></strong><small>En attente de réponse</small></div></article>
  <article><i class="i-green">✓</i><div><span>Résolus</span><strong><%= Number(stats.resolved_count||0) %></strong><small>Traités</small></div></article>
  <article><i class="i-gray">◉</i><div><span>Total</span><strong><%= Number(stats.total||0) %></strong><small>Toutes les demandes</small></div></article>
 </section>
 <section class="as-workspace">
  <div class="as-list-panel">
   <div class="as-filters"><label>⌕ <input id="adminTicketSearch" placeholder="Rechercher un ticket, client, commande..."></label><select id="adminStatus"><option value="ALL">Tous les statuts</option><option value="NEW">Nouveaux</option><option value="IN_PROGRESS">En cours</option><option value="WAITING_CUSTOMER">Attente client</option><option value="RESOLVED">Résolus</option><option value="CLOSED">Fermés</option></select><select id="adminCategory"><option value="ALL">Toutes les catégories</option><% Object.entries(catLabels).forEach(([k,v])=>{ %><option value="<%= k %>"><%= v %></option><% }) %></select><select id="adminPriority"><option value="ALL">Toutes les priorités</option><option value="URGENT">🔴 Urgente</option><option value="HIGH">🟠 Haute</option><option value="NORMAL">🟢 Normale</option><option value="LOW">⚪ Basse</option></select><select id="adminAgent"><option value="ALL">Tous les agents</option><option value="MINE">Mes tickets</option><option value="UNASSIGNED">Non assignés</option><% (agents||[]).forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select><select id="adminUnread"><option value="ALL">Tous</option><option value="UNREAD">🔴 Non lus</option></select></div>
   <div class="as-tickets" id="adminTicketList">
    <% if(!tickets.length){ %><div class="as-empty">💬<h3>Aucun ticket</h3><p>Les demandes clients apparaîtront ici.</p></div><% } %>
    <% tickets.forEach((t,i)=>{ const time=t.last_message_at||t.updated_at; %><button type="button" class="as-ticket <%= Number(t.id)===Number(selectedId)?'selected':'' %> <%= Number(t.unread_count||0)>0?'unread':'' %>" data-id="<%= t.id %>" data-unread="<%= Number(t.unread_count||0) %>" data-status="<%= t.status %>" data-category="<%= t.category %>" data-priority="<%= t.priority %>" data-agent="<%= t.assigned_admin_user_id||'' %>" data-search="<%= (t.reference+' '+t.subject+' '+(t.customer_name||'')+' '+(t.customer_email||'')+' '+(t.order_reference||'')).toLowerCase() %>"><span class="as-icon"><%= icons[t.category]||'💬' %></span><span class="as-ticket-copy"><span class="as-ticket-title"><b><%= t.reference %> · <%= t.subject %></b><em><%= catLabels[t.category]||t.category %></em></span><span><%= t.customer_name||'Client' %> · <%= t.last_message||'Demande support' %></span><small><%= t.order_reference||'Sans commande' %> · <%= new Date(time).toLocaleString('fr-FR') %></small></span><% if(Number(t.unread_count||0)>0){ %><span class="as-unread"><%= t.unread_count %></span><% } %><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span><span class="arrow">›</span></button><% }) %>
   </div>
  </div>
  <div class="as-details">
   <% if(!selectedId){ %><div class="as-no-selection"><div><div class="as-chat-illustration" aria-hidden="true"><i></i><i></i><b>•••</b></div><h3>Centre de conversations</h3><p>Cliquez sur un ticket à gauche pour visualiser la conversation et répondre au client.</p></div></div><% } %>
   <% tickets.forEach((t,i)=>{ const lastId=(t.messages||[]).length?(t.messages||[])[(t.messages||[]).length-1].id:0; %><section class="as-detail <%= Number(t.id)===Number(selectedId)?'active':'' %>" id="adminDetail-<%= t.id %>">
    <div class="as-detail-head"><div><h2><%= t.reference %> · <%= t.subject %></h2></div><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span></div>
    <div class="as-meta"><div><span>👤 Client</span><strong><%= t.customer_name||'Client' %></strong><small><%= t.customer_email||'' %></small></div><div><span>▣ Commande</span><strong><%= t.order_reference||'Aucune' %></strong><small><%= t.order_reference?'Commande liée':'Sans commande' %></small></div><div><span>⌘ Priorité</span><select class="ticket-priority" data-ticket="<%= t.id %>"><option value="LOW" <%= t.priority==='LOW'?'selected':'' %>>⚪ Basse</option><option value="NORMAL" <%= t.priority==='NORMAL'?'selected':'' %>>🟢 Normale</option><option value="HIGH" <%= t.priority==='HIGH'?'selected':'' %>>🟠 Haute</option><option value="URGENT" <%= t.priority==='URGENT'?'selected':'' %>>🔴 Urgente</option></select></div><div><span>🎧 Agent</span><select class="ticket-agent" data-ticket="<%= t.id %>"><option value="">Non assigné</option><% (agents||[]).forEach(a=>{ %><option value="<%= a.id %>" <%= Number(t.assigned_admin_user_id)===Number(a.id)?'selected':'' %>><%= a.name %></option><% }) %></select><small><%= t.assigned_admin_name||'À affecter' %></small></div><div><span>💬 Catégorie</span><strong><%= catLabels[t.category]||t.category %></strong></div></div>
    <details class="as-lifecycle"><summary>🕘 Historique du cycle de vie <b><%= (t.history||[]).length %></b></summary><div class="as-history"><% if(!(t.history||[]).length){ %><small>Aucun changement de statut enregistré depuis l’activation de 18.7.</small><% } %><% (t.history||[]).slice().reverse().forEach(h=>{ %><div><span>●</span><p><b><%= labels[h.from_status]||h.from_status %> → <%= labels[h.to_status]||h.to_status %></b><small><%= h.actor_name||'Système' %> · <%= new Date(h.created_at).toLocaleString('fr-FR') %><%= h.note?' · '+h.note:'' %></small></p></div><% }) %></div></details>
    <details class="as-activity" open><summary>📝 Notes internes & activité <b><%= (t.activity||[]).length %></b></summary><div class="as-activity-list"><% if(!(t.activity||[]).length){ %><small>Aucune activité interne enregistrée.</small><% } %><% (t.activity||[]).forEach(a=>{ const oldAgent=(agents||[]).find(x=>String(x.id)===String(a.old_value)); const newAgent=(agents||[]).find(x=>String(x.id)===String(a.new_value)); %><div class="as-activity-row <%= a.activity_type==='INTERNAL_NOTE'?'note':'' %>"><span><%= a.activity_type==='INTERNAL_NOTE'?'📝':a.activity_type==='ASSIGNMENT'?'🎧':'⚑' %></span><p><b><%= a.activity_type==='INTERNAL_NOTE'?'Note interne':a.activity_type==='ASSIGNMENT'?'Affectation modifiée':'Priorité modifiée' %></b><small><%= a.admin_name||'Support' %> · <%= new Date(a.created_at).toLocaleString('fr-FR') %></small><% if(a.activity_type==='INTERNAL_NOTE'){ %><em><%= a.note %></em><% }else if(a.activity_type==='ASSIGNMENT'){ %><em><%= oldAgent?oldAgent.name:(a.old_value?'Agent #'+a.old_value:'Non assigné') %> → <%= newAgent?newAgent.name:(a.new_value?'Agent #'+a.new_value:'Non assigné') %></em><% }else{ %><em><%= a.old_value||'—' %> → <%= a.new_value||'—' %></em><% } %></p></div><% }) %></div><form class="as-note-form" data-ticket="<%= t.id %>"><textarea maxlength="2000" placeholder="Ajouter une note interne (invisible pour le client)…"></textarea><button type="submit">Ajouter la note</button></form></details>
    <div class="as-messages" data-ticket="<%= t.id %>" data-last-id="<%= lastId %>"><% (t.messages||[]).forEach(m=>{ const mine=m.sender_type==='ADMIN'; %><div class="as-msg <%= mine?'admin':'customer' %>" data-message-id="<%= m.id %>" data-sender="<%= m.sender_type %>"><span class="as-avatar"><%= mine?'🎧':'👤' %></span><div><div class="as-msg-head"><strong><%= mine?(m.sender_name||'Support TiopTiop'):(m.sender_name||t.customer_name||'Client') %></strong><% if(!(m.deleted_at||m.hidden_for_me)){ %><span class="as-msg-actions"><button type="button" class="msg-reply" data-id="<%= m.id %>" data-author="<%= mine?'Support TiopTiop':(m.sender_name||t.customer_name||'Client') %>" data-text="<%= String(m.message||((m.attachments||[]).length?'Pièce jointe':'Message')).replace(/"/g,'&quot;') %>">↩</button><% if(mine){ %><button type="button" class="msg-edit" data-ticket="<%= t.id %>" data-id="<%= m.id %>" data-text="<%= String(m.message||'').replace(/"/g,'&quot;') %>">✎</button><button type="button" class="msg-delete" data-ticket="<%= t.id %>" data-id="<%= m.id %>">🗑</button><% } %></span><% } %></div><% if(m.deleted_at||m.hidden_for_me){ %><p class="as-deleted">Message supprimé</p><% }else{ %><% if(m.message){ %><p><%= m.message %></p><% } %><% (m.attachments||[]).forEach(a=>{ const href=a.id?('/admin/support/fichier/'+a.id):(a.legacy_url||'#'); %><a class="as-attachment" href="<%= href %>" target="_blank" rel="noopener"><% if(isImg(a)){ %><img src="<%= href %>" alt="Pièce jointe"><% }else if(isVideo(a)){ %><video controls preload="metadata" src="<%= href %>"></video><span>🎬 <%= a.original_name||'Vidéo de préparation' %></span><% }else{ %>📄 <%= a.original_name||'Ouvrir la pièce jointe' %><% } %></a><% }) %><% } %><div class="as-reactions"><% (m.reactions||[]).forEach(r=>{ %><span><%= r.emoji %></span><% }) %></div><div class="as-msg-foot"><small><%= new Date(m.created_at).toLocaleString('fr-FR') %><%= m.edited_at?' · Modifié':'' %></small><% if(mine){ %><span class="read-state"><%= m.read_at?'✓✓':'✓' %></span><% } %></div><% if(!(m.deleted_at||m.hidden_for_me)){ %><div class="as-react-bar"><button type="button" class="react-open">☺</button><div class="react-menu" hidden><% reactionSet.forEach(e=>{ %><button type="button" data-ticket="<%= t.id %>" data-id="<%= m.id %>" data-emoji="<%= e %>"><%= e %></button><% }) %></div></div><% } %></div></div><% }) %></div>
    <div class="as-reopen-zone" data-lifecycle-reopen="<%= t.id %>" style="<%= ['RESOLVED','CLOSED'].includes(t.status)?'':'display:none' %>"><span>🔒 Ticket <b class="as-closed-label"><%= t.status==='RESOLVED'?'résolu':'fermé' %></b>.</span><button type="button" class="ticket-reopen" data-ticket="<%= t.id %>">↻ Réouvrir en cours</button></div><form method="POST" enctype="multipart/form-data" action="/admin/support/<%= t.id %>/reply" class="as-compose" data-lifecycle-compose="<%= t.id %>" style="<%= ['RESOLVED','CLOSED'].includes(t.status)?'display:none':'' %>"><select name="status" data-ticket="<%= t.id %>" class="ticket-status-live"><option value="NEW" <%= t.status==='NEW'?'selected':'' %>>Nouveau</option><option value="IN_PROGRESS" <%= t.status==='IN_PROGRESS'?'selected':'' %>>En cours</option><option value="WAITING_CUSTOMER" <%= t.status==='WAITING_CUSTOMER'?'selected':'' %>>Attente client</option><option value="RESOLVED" <%= t.status==='RESOLVED'?'selected':'' %>>Résolu</option><option value="CLOSED" <%= t.status==='CLOSED'?'selected':'' %>>Fermé</option></select><div class="as-actions"><button type="button" class="as-icon-btn emoji-toggle" title="Emoji">😊</button><label class="as-icon-btn" title="Pièce jointe">📎<input type="file" name="attachments" multiple accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt,video/mp4" hidden></label></div><div class="as-editor"><textarea name="response" maxlength="4000" placeholder="Écrire une réponse au client..."></textarea><div class="emoji-panel" hidden></div><div class="file-name"></div><div class="file-preview"></div></div><button>Envoyer</button></form><form method="POST" action="/admin/support/<%= t.id %>/archiver" onsubmit="return confirm('Archiver cette demande côté administration ?')"><button class="as-archive" title="Archiver">🗄 Archiver</button></form>
   </section><% }) %>
   <% if(!tickets.length){ %><div class="as-empty as-detail-empty">🎧<h3>Support TiopTiop</h3><p>Sélectionnez un ticket pour commencer.</p></div><% } %>
  </div>
 </section>
</section>
<div class="as-modal" id="initiateModal" hidden><div class="as-modal-card"><button type="button" class="as-modal-close" id="closeInitiate">×</button><h2>🎥 Contacter un client depuis sa commande</h2><p>Le client n'a pas besoin d'avoir créé une demande. Saisissez sa référence de commande : TiopTiop créera la conversation dans <b>Mes demandes</b> au premier envoi.</p><form id="initiateForm" action="/admin/support/initier-commande" method="POST" enctype="multipart/form-data"><label>Référence de commande<input name="orderReference" required placeholder="TIOP-20260911-55331B23"></label><label>Message<div style="display:flex;gap:6px;align-items:flex-start"><textarea name="message" maxlength="4000" placeholder="Votre commande est en préparation. Voici une vidéo de transparence..." style="flex:1"></textarea><button type="button" class="init-emoji-toggle" style="border:1px solid #ddd;background:#fff;border-radius:9px;padding:9px">😊</button></div><div class="init-emoji-panel emoji-panel" hidden></div></label><label class="as-upload-video">🎬 Ajouter une vidéo MP4 ou des pièces jointes<input type="file" name="attachments" multiple accept="video/mp4,image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt"></label><div class="init-files"></div><button type="submit" class="as-init-btn">Envoyer au client</button></form></div></div>
<style>
.as-page{padding:22px 28px 55px;color:#172039}.as-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.as-title{display:flex;align-items:center;gap:14px}.as-title>span{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#8e55dc;font-size:22px}.as-title h1{margin:0;font-size:30px}.as-title p{margin:4px 0 0;color:#7b8391}.as-success{background:#eaf9ef;color:#15703a;padding:13px 16px;border-radius:12px;font-weight:800;margin-bottom:15px}.as-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:16px}.as-stats article{background:#fff;border:1px solid #edf0f4;border-radius:17px;padding:17px;display:flex;gap:13px;align-items:flex-start;box-shadow:0 10px 28px rgba(26,35,58,.04)}.as-stats i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-style:normal;font-size:17px}.i-red{background:#ffe8ec;color:#d92449}.i-orange{background:#fff0e5;color:#ff7100}.i-yellow{background:#fff5dc;color:#d88b00}.i-green{background:#e6f7ed;color:#08793d}.i-gray{background:#eef0f4;color:#687181}.as-stats div{display:flex;flex-direction:column}.as-stats span{color:#586173}.as-stats strong{font-size:25px;margin:2px 0}.as-stats small{color:#9aa1ac}.as-workspace{display:grid;grid-template-columns:minmax(430px,.9fr) minmax(500px,1.1fr);gap:14px}.as-list-panel,.as-details{background:#fff;border:1px solid #e7ebf0;border-radius:17px;overflow:hidden;box-shadow:0 12px 35px rgba(26,35,58,.04)}.as-filters{display:grid;grid-template-columns:1.5fr .75fr .85fr;gap:8px;padding:12px}.as-filters label{display:flex;align-items:center;border:1px solid #dfe4ea;border-radius:10px;padding:0 10px;color:#777}.as-filters input,.as-filters select{border:0;outline:0;background:#fff;font:inherit;padding:10px;width:100%}.as-filters select{border:1px solid #dfe4ea;border-radius:10px}.as-tickets{padding:0 12px 12px;display:flex;flex-direction:column;gap:8px;max-height:650px;overflow:auto}.as-ticket{width:100%;border:1px solid #e2e7ed;background:#fff;border-radius:13px;padding:13px;display:flex;align-items:center;gap:11px;text-align:left;color:inherit;font:inherit;cursor:pointer;transition:.18s}.as-ticket:hover,.as-ticket.selected{border-color:#ff7900;background:#fffaf5}.as-icon{width:45px;height:45px;border-radius:12px;background:#fff0e3;display:grid;place-items:center;flex:0 0 45px}.as-ticket-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}.as-ticket-title{display:flex;gap:8px;align-items:center}.as-ticket-title b{font-size:14px}.as-ticket-title em{font-style:normal;background:#eef1f5;padding:4px 7px;border-radius:999px;font-size:10px}.as-ticket-copy>span:nth-child(2),.as-ticket-copy small{color:#697283;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.arrow{font-size:23px}.badge{padding:7px 10px;border-radius:999px;font-size:11px;font-weight:850;white-space:nowrap}.b-new{background:#ffe7eb;color:#d91f45}.b-in_progress,.b-waiting_customer{background:#fff0dc;color:#c36a00}.b-resolved{background:#e4f7ec;color:#08763b}.b-closed{background:#eceff3;color:#68707e}.as-detail{display:none;height:100%}.as-detail.active{display:flex;flex-direction:column}.as-detail-head{padding:14px 16px;border-bottom:1px solid #edf0f4;display:flex;justify-content:space-between;align-items:center}.as-detail-head h2{margin:0;font-size:17px}.as-meta{display:grid;grid-template-columns:1.25fr 1.25fr .75fr .9fr;border-bottom:1px solid #edf0f4}.as-meta>div{padding:12px;border-right:1px solid #edf0f4;display:flex;flex-direction:column;gap:3px}.as-meta span,.as-meta small{font-size:11px;color:#7f8795}.as-meta strong{font-size:12px}.as-messages{padding:16px;min-height:330px;max-height:480px;overflow:auto;background:#fcfdfe}.as-msg{display:flex;gap:8px;max-width:82%;margin-bottom:13px}.as-msg.admin{margin-left:auto;flex-direction:row-reverse}.as-avatar{width:34px;height:34px;border-radius:50%;background:#edf0f5;display:grid;place-items:center;flex:0 0 34px}.as-msg>div{background:#f1f3f6;border-radius:13px;padding:10px 12px}.as-msg.admin>div{background:#e6f2ff}.as-msg p{margin:4px 0 6px;line-height:1.45}.as-msg small{color:#8d94a0}.as-compose{margin-top:auto;border-top:1px solid #edf0f4;padding:12px;display:grid;grid-template-columns:115px 76px 1fr 100px;gap:8px;align-items:center}.as-compose select,.as-compose textarea{border:1px solid #dfe4ea;border-radius:10px;padding:10px;font:inherit;background:#fff}.as-compose textarea{resize:none;height:42px}.as-compose button{border:0;border-radius:10px;background:#ff7100;color:#fff;font-weight:850;height:43px;cursor:pointer}.as-empty{text-align:center;padding:50px 20px;color:#7d8593;font-size:25px}.as-empty h3{font-size:18px;color:#242b3a}.as-empty p{font-size:14px}.as-detail-empty{padding-top:160px}
@media(max-width:1200px){.as-stats{grid-template-columns:repeat(3,1fr)}.as-workspace{grid-template-columns:1fr}.as-details{min-height:500px}}@media(max-width:760px){.as-page{padding:14px}.as-stats{grid-template-columns:1fr 1fr}.as-filters{grid-template-columns:1fr}.as-meta{grid-template-columns:1fr 1fr}.as-compose{grid-template-columns:1fr 1fr}.as-compose textarea{grid-column:1/-1}.as-compose span{display:none}.as-ticket .badge{display:none}}@media(max-width:480px){.as-stats{grid-template-columns:1fr}.as-meta{grid-template-columns:1fr}.as-ticket-title em{display:none}}
