</section>


<!-- =====================================================
     MODAL TICKET
====================================================== -->

<div
    class="support-modal-overlay"
    id="supportTicketModal"
    onclick="closeSupportTicketOutside(event)"
>

    <div class="support-modal">

        <div class="support-modal-header">

            <h2>SUP-1043 · Commande</h2>

            <button
                type="button"
                class="support-modal-close"
                onclick="closeSupportTicket()"
            >
                ×
            </button>

        </div>


        <div class="support-ticket-details">

            <p>
                <strong>Client :</strong>
                TEST2 · TEST@gmail.com
            </p>

            <p>
                <strong>Commande :</strong>
                CM23
            </p>

            <div class="support-message">
                TEST
            </div>

        </div>


        <form id="supportResponseForm">

            <select
                name="status"
                class="support-status-select"
            >
                <option value="nouveau">Nouveau</option>
                <option value="en-cours" selected>En cours</option>
                <option value="resolu">Résolu</option>
            </select>


            <textarea
                name="response"
                class="support-response"
                placeholder="Réponse au client"
            ></textarea>


            <button
                type="submit"
                class="support-save-btn"
            >
                Enregistrer / Répondre
            </button>

        </form>

    </div>

</div>

<style>
  /* =========================================================
   SUPPORT CLIENT
========================================================= */

.support-admin {
    padding: 20px;
}

.support-header {
    margin-bottom: 35px;
}

.support-badge {
    display: inline-block;
    padding: 10px 18px;

    border-radius: 999px;

    background: #fff0df;
    color: #ff7900;

    font-size: 14px;
    font-weight: 800;
}

.support-header h1 {
    margin: 20px 0 0;

    font-size: 50px;
    line-height: 1.1;
    font-weight: 800;
}


/* =========================================================
   STATISTIQUES
========================================================= */

.support-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 25px;

    margin-bottom: 30px;
}

.support-stat-card {
    min-height: 140px;

    padding: 32px;

    border-radius: 30px;

    background: #fff;

    box-shadow:
        0 15px 40px rgba(0, 0, 0, .04);

    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.support-stat-label {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #6d6863;

    font-size: 20px;
}

/*Diminuer la taille du tableau de bord*/
.support-stat-card strong {
    display: block;

    margin-top: 20px;

    font-size: 38px;
    font-weight: 800;
    color: #171411;
}

.dot {
    display: inline-block;

    width: 18px;
    height: 18px;

    border-radius: 50%;
}

.dot-red {
    background: linear-gradient(
        135deg,
        #ff667c,
        #bf1640
    );
}

.dot-orange {
    background: linear-gradient(
        135deg,
        #ff9b5c,
        #ff4e3e
    );
}

.resolved-icon {
    font-size: 20px;
}


/* =========================================================
   LISTE TICKETS
========================================================= */

.support-ticket-list {
    width: 100%;
}

.support-ticket {
    min-height: 100px;

    padding: 20px 25px;

    border: 1px solid #ddd;
    border-radius: 25px;

    background: #fff;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 25px;

    box-shadow:
        0 5px 15px rgba(0, 0, 0, .02);
}

.ticket-left {
    display: flex;
    align-items: center;

    gap: 18px;

    min-width: 0;
}

.ticket-icon {
    flex: 0 0 65px;

    width: 65px;
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 20px;

    background: #fff0df;

    font-size: 27px;
}

.ticket-info {
    min-width: 0;
}

.ticket-info h3 {
    margin: 0 0 5px;

    font-size: 22px;
