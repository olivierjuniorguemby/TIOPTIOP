@media (max-width: 450px) {

    .support-stats {
        grid-template-columns: 1fr;
    }

}
</style>

<script>

    /* =====================================================
       OUVRIR LE TICKET
    ===================================================== */

    function openSupportTicket() {

        document
            .getElementById('supportTicketModal')
            .classList.add('active');

        document.body.style.overflow = 'hidden';
    }


    /* =====================================================
       FERMER
    ===================================================== */

    function closeSupportTicket() {

        document
            .getElementById('supportTicketModal')
            .classList.remove('active');

        document.body.style.overflow = '';
    }


    /* CLIC SUR LE FOND */

    function closeSupportTicketOutside(event) {

        if (event.target.id === 'supportTicketModal') {
            closeSupportTicket();
        }

    }


    /* TOUCHE ESC */

    document.addEventListener('keydown', function(event) {

        if (event.key === 'Escape') {
            closeSupportTicket();
        }

    });


    /* =====================================================
       ENREGISTRER / REPONDRE
       Version statique pour le moment
    ===================================================== */

    document
        .getElementById('supportResponseForm')
        .addEventListener('submit', function(event) {

            event.preventDefault();

            const status =
                this.querySelector('[name="status"]').value;

            const response =
                this.querySelector('[name="response"]').value.trim();


            if (!response) {

                alert(
                    'Veuillez saisir une réponse pour le client.'
                );

                return;
            }


            alert(
                'Ticket enregistré.\n' +
                'Statut : ' + status + '\n' +
                'Réponse : ' + response
            );


            closeSupportTicket();

        });

</script>