}


/* =========================================================
   INFORMATIONS TICKET
========================================================= */

.support-ticket-details {
    margin-bottom: 16px;
}

.support-ticket-details p {
    margin: 0 0 12px;

    font-size: 17px;
    line-height: 1.4;
}

.support-ticket-details strong {
    font-weight: 800;
}

.support-message {
    margin: 12px 0 18px;

    padding: 12px 15px;

    border-radius: 12px;

