<% const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||'')); const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; const labels={NEW:'Nouveau',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'En attente client',RESOLVED:'Résolu',CLOSED:'Fermé'}; const catLabels={ORDER:'Commande',DELIVERY:'Livraison',PAYMENT:'Paiement',REFUND:'Remboursement',TIOP_PLUS:'Tiop+',ACCOUNT:'Compte',RESTAURANT:'Restaurant',OTHER:'Autre'}; const icons={ORDER:'📦',DELIVERY:'🚚',PAYMENT:'💳',REFUND:'↩️',TIOP_PLUS:'⭐',ACCOUNT:'👤',RESTAURANT:'🍽️',OTHER:'💬'}; %>
<section class="as-page">
 <header class="as-head"><div class="as-title"><span>💬</span><div><h1>Support</h1><p>Gérez les demandes clients et suivez leur résolution.</p></div></div></header>
 <% if(saved){ %><div class="as-success">✓ Ticket enregistré et réponse ajoutée.</div><% } %>
 <section class="as-stats">
  <article><i class="i-red">●</i><div><span>Nouveaux</span><strong><%= Number(stats.new_count||0) %></strong><small>À traiter</small></div></article>
  <article><i class="i-orange">▣</i><div><span>En cours</span><strong><%= Number(stats.in_progress_count||0) %></strong><small>En traitement</small></div></article>
  <article><i class="i-yellow">◷</i><div><span>En attente client</span><strong><%= Number(stats.waiting_count||0) %></strong><small>En attente de réponse</small></div></article>
  <article><i class="i-green">✓</i><div><span>Résolus</span><strong><%= Number(stats.resolved_count||0) %></strong><small>Traités</small></div></article>
  <article><i class="i-gray">◉</i><div><span>Total</span><strong><%= Number(stats.total||0) %></strong><small>Toutes les demandes</small></div></article>
 </section>
 <section class="as-workspace">
  <div class="as-list-panel">
   <div class="as-filters"><label>⌕ <input id="adminTicketSearch" placeholder="Rechercher un ticket, client, commande..."></label><select id="adminStatus"><option value="ALL">Tous les statuts</option><option value="NEW">Nouveaux</option><option value="IN_PROGRESS">En cours</option><option value="WAITING_CUSTOMER">Attente client</option><option value="RESOLVED">Résolus</option><option value="CLOSED">Fermés</option></select><select id="adminCategory"><option value="ALL">Toutes les catégories</option><% Object.entries(catLabels).forEach(([k,v])=>{ %><option value="<%= k %>"><%= v %></option><% }) %></select></div>
   <div class="as-tickets" id="adminTicketList">
    <% if(!tickets.length){ %><div class="as-empty">💬<h3>Aucun ticket</h3><p>Les demandes clients apparaîtront ici.</p></div><% } %>
    <% tickets.forEach((t,i)=>{ const time=t.last_message_at||t.updated_at; %><button type="button" class="as-ticket <%= Number(t.id)===Number(selectedId)?'selected':'' %> <%= Number(t.unread_count||0)>0?'unread':'' %>" data-id="<%= t.id %>" data-unread="<%= Number(t.unread_count||0) %>" data-status="<%= t.status %>" data-category="<%= t.category %>" data-search="<%= (t.reference+' '+t.subject+' '+(t.customer_name||'')+' '+(t.customer_email||'')+' '+(t.order_reference||'')).toLowerCase() %>"><span class="as-icon"><%= icons[t.category]||'💬' %></span><span class="as-ticket-copy"><span class="as-ticket-title"><b><%= t.reference %> · <%= t.subject %></b><em><%= catLabels[t.category]||t.category %></em></span><span><%= t.customer_name||'Client' %> · <%= t.last_message||'Demande support' %></span><small><%= t.order_reference||'Sans commande' %> · <%= new Date(time).toLocaleString('fr-FR') %></small></span><% if(Number(t.unread_count||0)>0){ %><span class="as-unread"><%= t.unread_count %></span><% } %><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span><span class="arrow">›</span></button><% }) %>
   </div>
  </div>
  <div class="as-details">
   <% tickets.forEach((t,i)=>{ const lastId=(t.messages||[]).length?(t.messages||[])[(t.messages||[]).length-1].id:0; %><section class="as-detail <%= Number(t.id)===Number(selectedId)?'active':'' %>" id="adminDetail-<%= t.id %>">
    <div class="as-detail-head"><div><h2><%= t.reference %> · <%= t.subject %></h2></div><span class="badge b-<%= t.status.toLowerCase() %>"><%= labels[t.status]||t.status %></span></div>
    <div class="as-meta"><div><span>👤 Client</span><strong><%= t.customer_name||'Client' %></strong><small><%= t.customer_email||'' %></small></div><div><span>▣ Commande</span><strong><%= t.order_reference||'Aucune' %></strong><small><%= t.order_reference?'Commande liée':'Sans commande' %></small></div><div><span>⌘ Priorité</span><strong><%= t.priority %></strong></div><div><span>💬 Catégorie</span><strong><%= catLabels[t.category]||t.category %></strong></div></div>
    <div class="as-messages" data-ticket="<%= t.id %>" data-last-id="<%= lastId %>"><% (t.messages||[]).forEach(m=>{ const mine=m.sender_type==='ADMIN'; %><div class="as-msg <%= mine?'admin':'customer' %>" data-message-id="<%= m.id %>"><span class="as-avatar"><%= mine?'🎧':'👤' %></span><div><div class="as-msg-head"><strong><%= mine?(m.sender_name||'Support TiopTiop'):(m.sender_name||t.customer_name||'Client') %></strong><% if(mine&&!m.deleted_at){ %><span class="as-msg-actions"><button type="button" class="msg-edit" data-ticket="<%= t.id %>" data-id="<%= m.id %>" data-text="<%= String(m.message||'').replace(/"/g,'&quot;') %>">✎</button><button type="button" class="msg-delete" data-ticket="<%= t.id %>" data-id="<%= m.id %>">🗑</button></span><% } %></div><% if(m.deleted_at){ %><p class="as-deleted">Message supprimé</p><% }else{ %><% if(m.message){ %><p><%= m.message %></p><% } %><% (m.attachments||[]).forEach(a=>{ const href=a.id?('/admin/support/fichier/'+a.id):(a.legacy_url||'#'); %><a class="as-attachment" href="<%= href %>" target="_blank" rel="noopener"><% if(isImg(a)){ %><img src="<%= href %>" alt="Pièce jointe"><% }else if(isVideo(a)){ %><video controls preload="metadata" src="<%= href %>"></video><span>🎬 <%= a.original_name||'Vidéo de préparation' %></span><% }else{ %>📄 <%= a.original_name||'Ouvrir la pièce jointe' %><% } %></a><% }) %><% } %><div class="as-reactions"><% (m.reactions||[]).forEach(r=>{ %><span><%= r.emoji %></span><% }) %></div><div class="as-msg-foot"><small><%= new Date(m.created_at).toLocaleString('fr-FR') %><%= m.edited_at?' · Modifié':'' %></small><% if(mine){ %><span class="read-state"><%= m.read_at?'✓✓':'✓' %></span><% } %></div><% if(!m.deleted_at){ %><div class="as-react-bar"><button type="button" class="react-open">☺</button><div class="react-menu" hidden><% reactionSet.forEach(e=>{ %><button type="button" data-ticket="<%= t.id %>" data-id="<%= m.id %>" data-emoji="<%= e %>"><%= e %></button><% }) %></div></div><% } %></div></div><% }) %></div>
    <form method="POST" enctype="multipart/form-data" action="/admin/support/<%= t.id %>/reply" class="as-compose"><select name="status"><option value="NEW" <%= t.status==='NEW'?'selected':'' %>>Nouveau</option><option value="IN_PROGRESS" <%= t.status==='IN_PROGRESS'?'selected':'' %>>En cours</option><option value="WAITING_CUSTOMER" <%= t.status==='WAITING_CUSTOMER'?'selected':'' %>>Attente client</option><option value="RESOLVED" <%= t.status==='RESOLVED'?'selected':'' %>>Résolu</option><option value="CLOSED" <%= t.status==='CLOSED'?'selected':'' %>>Fermé</option></select><div class="as-actions"><button type="button" class="as-icon-btn emoji-toggle" title="Emoji">😊</button><label class="as-icon-btn" title="Pièce jointe">📎<input type="file" name="attachments" multiple accept="image/jpeg,image/png,image/webp,image/avif,application/pdf,.doc,.docx,.txt,video/mp4" hidden></label></div><div class="as-editor"><textarea name="response" maxlength="4000" placeholder="Écrire une réponse au client..."></textarea><div class="emoji-panel" hidden></div><div class="file-name"></div><div class="file-preview"></div></div><button>Envoyer</button></form><form method="POST" action="/admin/support/<%= t.id %>/archiver" onsubmit="return confirm('Archiver cette demande côté administration ?')"><button class="as-archive" title="Archiver">🗄 Archiver</button></form>
   </section><% }) %>
   <% if(!tickets.length){ %><div class="as-empty as-detail-empty">🎧<h3>Support TiopTiop</h3><p>Sélectionnez un ticket pour commencer.</p></div><% } %>
  </div>
 </section>
</section>
<style>
.as-page{padding:22px 28px 55px;color:#172039}.as-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.as-title{display:flex;align-items:center;gap:14px}.as-title>span{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#8e55dc;font-size:22px}.as-title h1{margin:0;font-size:30px}.as-title p{margin:4px 0 0;color:#7b8391}.as-success{background:#eaf9ef;color:#15703a;padding:13px 16px;border-radius:12px;font-weight:800;margin-bottom:15px}.as-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:16px}.as-stats article{background:#fff;border:1px solid #edf0f4;border-radius:17px;padding:17px;display:flex;gap:13px;align-items:flex-start;box-shadow:0 10px 28px rgba(26,35,58,.04)}.as-stats i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-style:normal;font-size:17px}.i-red{background:#ffe8ec;color:#d92449}.i-orange{background:#fff0e5;color:#ff7100}.i-yellow{background:#fff5dc;color:#d88b00}.i-green{background:#e6f7ed;color:#08793d}.i-gray{background:#eef0f4;color:#687181}.as-stats div{display:flex;flex-direction:column}.as-stats span{color:#586173}.as-stats strong{font-size:25px;margin:2px 0}.as-stats small{color:#9aa1ac}.as-workspace{display:grid;grid-template-columns:minmax(430px,.9fr) minmax(500px,1.1fr);gap:14px}.as-list-panel,.as-details{background:#fff;border:1px solid #e7ebf0;border-radius:17px;overflow:hidden;box-shadow:0 12px 35px rgba(26,35,58,.04)}.as-filters{display:grid;grid-template-columns:1.5fr .75fr .85fr;gap:8px;padding:12px}.as-filters label{display:flex;align-items:center;border:1px solid #dfe4ea;border-radius:10px;padding:0 10px;color:#777}.as-filters input,.as-filters select{border:0;outline:0;background:#fff;font:inherit;padding:10px;width:100%}.as-filters select{border:1px solid #dfe4ea;border-radius:10px}.as-tickets{padding:0 12px 12px;display:flex;flex-direction:column;gap:8px;max-height:650px;overflow:auto}.as-ticket{width:100%;border:1px solid #e2e7ed;background:#fff;border-radius:13px;padding:13px;display:flex;align-items:center;gap:11px;text-align:left;color:inherit;font:inherit;cursor:pointer;transition:.18s}.as-ticket:hover,.as-ticket.selected{border-color:#ff7900;background:#fffaf5}.as-icon{width:45px;height:45px;border-radius:12px;background:#fff0e3;display:grid;place-items:center;flex:0 0 45px}.as-ticket-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}.as-ticket-title{display:flex;gap:8px;align-items:center}.as-ticket-title b{font-size:14px}.as-ticket-title em{font-style:normal;background:#eef1f5;padding:4px 7px;border-radius:999px;font-size:10px}.as-ticket-copy>span:nth-child(2),.as-ticket-copy small{color:#697283;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.arrow{font-size:23px}.badge{padding:7px 10px;border-radius:999px;font-size:11px;font-weight:850;white-space:nowrap}.b-new{background:#ffe7eb;color:#d91f45}.b-in_progress,.b-waiting_customer{background:#fff0dc;color:#c36a00}.b-resolved{background:#e4f7ec;color:#08763b}.b-closed{background:#eceff3;color:#68707e}.as-detail{display:none;height:100%}.as-detail.active{display:flex;flex-direction:column}.as-detail-head{padding:14px 16px;border-bottom:1px solid #edf0f4;display:flex;justify-content:space-between;align-items:center}.as-detail-head h2{margin:0;font-size:17px}.as-meta{display:grid;grid-template-columns:1.25fr 1.25fr .75fr .9fr;border-bottom:1px solid #edf0f4}.as-meta>div{padding:12px;border-right:1px solid #edf0f4;display:flex;flex-direction:column;gap:3px}.as-meta span,.as-meta small{font-size:11px;color:#7f8795}.as-meta strong{font-size:12px}.as-messages{padding:16px;min-height:330px;max-height:480px;overflow:auto;background:#fcfdfe}.as-msg{display:flex;gap:8px;max-width:82%;margin-bottom:13px}.as-msg.admin{margin-left:auto;flex-direction:row-reverse}.as-avatar{width:34px;height:34px;border-radius:50%;background:#edf0f5;display:grid;place-items:center;flex:0 0 34px}.as-msg>div{background:#f1f3f6;border-radius:13px;padding:10px 12px}.as-msg.admin>div{background:#e6f2ff}.as-msg p{margin:4px 0 6px;line-height:1.45}.as-msg small{color:#8d94a0}.as-compose{margin-top:auto;border-top:1px solid #edf0f4;padding:12px;display:grid;grid-template-columns:115px 76px 1fr 100px;gap:8px;align-items:center}.as-compose select,.as-compose textarea{border:1px solid #dfe4ea;border-radius:10px;padding:10px;font:inherit;background:#fff}.as-compose textarea{resize:none;height:42px}.as-compose button{border:0;border-radius:10px;background:#ff7100;color:#fff;font-weight:850;height:43px;cursor:pointer}.as-empty{text-align:center;padding:50px 20px;color:#7d8593;font-size:25px}.as-empty h3{font-size:18px;color:#242b3a}.as-empty p{font-size:14px}.as-detail-empty{padding-top:160px}
@media(max-width:1200px){.as-stats{grid-template-columns:repeat(3,1fr)}.as-workspace{grid-template-columns:1fr}.as-details{min-height:500px}}@media(max-width:760px){.as-page{padding:14px}.as-stats{grid-template-columns:1fr 1fr}.as-filters{grid-template-columns:1fr}.as-meta{grid-template-columns:1fr 1fr}.as-compose{grid-template-columns:1fr 1fr}.as-compose textarea{grid-column:1/-1}.as-compose span{display:none}.as-ticket .badge{display:none}}@media(max-width:480px){.as-stats{grid-template-columns:1fr}.as-meta{grid-template-columns:1fr}.as-ticket-title em{display:none}}
.as-attachment{display:flex;align-items:center;gap:7px;margin:7px 0;color:#265fa7;text-decoration:none;font-weight:750;font-size:12px}.as-attachment img{display:block;max-width:220px;max-height:160px;border-radius:10px;border:1px solid #dbe3ed}.as-actions{display:flex;gap:5px}.as-icon-btn{width:34px;height:34px;border:1px solid #dfe4ea;background:#fff;border-radius:9px;display:grid;place-items:center;cursor:pointer}.as-editor{position:relative}.as-editor textarea{width:100%;box-sizing:border-box}.emoji-panel{position:absolute;bottom:58px;left:0;z-index:30;width:235px;padding:9px;border:1px solid #e0e4ea;border-radius:13px;background:#fff;box-shadow:0 12px 35px rgba(20,30,50,.14);display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.emoji-panel[hidden]{display:none}.emoji-panel button{border:0;background:transparent;font-size:19px;padding:4px;cursor:pointer;border-radius:7px}.emoji-panel button:hover{background:#f2f4f7}.file-name{font-size:10px;color:#697283;padding-top:3px;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.as-ticket.unread .as-ticket-title b,.as-ticket.unread .as-ticket-copy>span:nth-child(2){font-weight:900;color:#111827}.as-unread{display:grid;place-items:center;min-width:22px;height:22px;border-radius:999px;background:#ff7100;color:#fff;font-size:11px;font-weight:900}.as-msg-head,.as-msg-foot{display:flex;align-items:center;justify-content:space-between;gap:10px}.as-msg-actions{opacity:0}.as-msg>div:hover .as-msg-actions{opacity:1}.as-msg-actions button,.as-react-bar button,.react-menu button{border:0;background:transparent;cursor:pointer}.as-deleted{font-style:italic;color:#8d94a0}.read-state{color:#4a8cca;font-weight:900}.as-reactions{display:flex;gap:4px;flex-wrap:wrap}.as-reactions span{background:#fff;border:1px solid #e5e8ec;border-radius:999px;padding:2px 6px}.as-react-bar{position:relative;margin-top:3px}.react-menu{position:absolute;z-index:40;bottom:25px;right:0;display:flex;gap:2px;padding:6px;border:1px solid #dfe4ea;background:#fff;border-radius:999px;box-shadow:0 10px 28px rgba(20,30,50,.15)}.react-menu[hidden]{display:none}.as-messages{scroll-behavior:smooth}
</style>
<style>.as-attachment video{display:block;max-width:260px;max-height:180px;border-radius:10px;background:#000}.file-preview{display:flex;gap:6px;flex-wrap:wrap;padding-top:4px}.file-chip{display:flex;align-items:center;gap:5px;background:#f4f6f8;border:1px solid #e1e5ea;border-radius:8px;padding:4px 6px;font-size:10px}.file-chip img,.file-chip video{width:38px;height:28px;object-fit:cover;border-radius:5px}.file-chip button{border:0;background:#fff;border-radius:50%;cursor:pointer}.as-unread{background:#e32636!important}.as-archive{border:1px solid #e1e5ea;background:#fff;border-radius:9px;padding:8px;cursor:pointer}</style>

<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{
  const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; const labels={NEW:'Nouveau',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'En attente client',RESOLVED:'Résolu',CLOSED:'Fermé'};
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const fr=d=>{try{return new Date(d).toLocaleString('fr-FR')}catch{return ''}};
  const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||''));
  let activeId=Number(document.querySelector('.as-detail.active .as-messages')?.dataset.ticket||0),socket=null,syncing=false,queued=false;
  const nearBottom=el=>!el||el.scrollHeight-el.scrollTop-el.clientHeight<110;
  function attachmentHtml(a){const href=a.id?('/admin/support/fichier/'+a.id):(a.legacy_url||'#');if(isImg(a))return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener"><img src="${esc(href)}" alt="Pièce jointe"></a>`;if(isVideo(a))return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener"><video controls preload="metadata" src="${esc(href)}"></video><span>🎬 ${esc(a.original_name||'Vidéo de préparation')}</span></a>`;return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener">📄 ${esc(a.original_name||'Ouvrir la pièce jointe')}</a>`;}
  function messageHtml(m){const mine=m.sender_type==='ADMIN';const actions=mine&&!m.deleted_at?`<span class="as-msg-actions"><button type="button" class="msg-edit" data-ticket="${m.ticket_id}" data-id="${m.id}" data-text="${esc(m.message||'')}">✎</button><button type="button" class="msg-delete" data-ticket="${m.ticket_id}" data-id="${m.id}">🗑</button></span>`:'';const content=m.deleted_at?'<p class="as-deleted">Message supprimé</p>':`${m.message?`<p>${esc(m.message)}</p>`:''}${(m.attachments||[]).map(attachmentHtml).join('')}`;const reactions=(m.reactions||[]).map(r=>`<span>${esc(r.emoji)}</span>`).join('');const menu=!m.deleted_at?`<div class="as-react-bar"><button type="button" class="react-open">☺</button><div class="react-menu" hidden>${reactionSet.map(e=>`<button type="button" data-ticket="${m.ticket_id}" data-id="${m.id}" data-emoji="${e}">${e}</button>`).join('')}</div></div>`:'';return `<div class="as-msg ${mine?'admin':'customer'}" data-message-id="${m.id}"><span class="as-avatar">${mine?'🎧':'👤'}</span><div><div class="as-msg-head"><strong>${esc(m.sender_name||(mine?'Support TiopTiop':'Client'))}</strong>${actions}</div>${content}<div class="as-reactions">${reactions}</div><div class="as-msg-foot"><small>${esc(fr(m.created_at))}${m.edited_at?' · Modifié':''}</small>${mine?`<span class="read-state">${m.read_at?'✓✓':'✓'}</span>`:''}</div>${menu}</div></div>`;}
  function updateTicketList(tickets){const list=document.getElementById('adminTicketList');if(!list)return;const existing=new Map([...list.querySelectorAll('.as-ticket')].map(x=>[x.dataset.id,x]));(tickets||[]).forEach(t=>{let el=existing.get(String(t.id));if(!el){el=document.createElement('button');el.type='button';el.className='as-ticket';el.dataset.id=t.id;el.innerHTML=`<span class="as-icon">💬</span><span class="as-ticket-copy"><span class="as-ticket-title"><b>${esc(t.reference)} · ${esc(t.subject)}</b></span><span></span><small></small></span><span class="badge"></span><span class="arrow">›</span>`;list.prepend(el);el.addEventListener('click',()=>location.href='/admin/support?ticket='+t.id);}el.dataset.unread=Number(t.unread_count||0);el.dataset.status=t.status;el.dataset.category=t.category||'';el.classList.toggle('unread',Number(t.unread_count||0)>0);const lines=el.querySelectorAll('.as-ticket-copy>span');if(lines[1])lines[1].textContent=(t.customer_name||'Client')+' · '+(t.last_message||'Demande support');const sm=el.querySelector('.as-ticket-copy small');if(sm)sm.textContent=(t.order_reference||'Sans commande')+' · '+fr(t.last_message_at||t.updated_at);let u=el.querySelector('.as-unread');if(Number(t.unread_count||0)>0){if(!u){u=document.createElement('span');u.className='as-unread';el.insertBefore(u,el.querySelector('.badge'));}u.textContent=t.unread_count;}else u?.remove();const b=el.querySelector('.badge');if(b){b.className='badge b-'+String(t.status||'').toLowerCase();b.textContent=labels[t.status]||t.status;}});(tickets||[]).map(t=>list.querySelector(`.as-ticket[data-id="${t.id}"]`)).filter(Boolean).forEach(el=>list.appendChild(el));}
  async function syncSupport(reason='socket',id=activeId){if(syncing){queued=true;return;}syncing=true;try{const r=await fetch(`/admin/support-poll?ticket=${Number(id||0)}`,{headers:{Accept:'application/json'},cache:'no-store'});if(!r.ok)return;const data=await r.json();updateTicketList(data.tickets||[]);if(id){const msgBox=document.querySelector(`#adminDetail-${id} .as-messages`);if(msgBox){const stick=nearBottom(msgBox);msgBox.innerHTML=(data.messages||[]).map(messageHtml).join('');msgBox.dataset.lastId=String((data.messages||[]).at(-1)?.id||0);if(stick||reason==='message:new'||reason==='send'||reason==='open')requestAnimationFrame(()=>msgBox.scrollTop=msgBox.scrollHeight);}}}finally{syncing=false;if(queued){queued=false;syncSupport('queued',activeId);}}}
  function open(id){id=Number(id);document.querySelectorAll('.as-ticket').forEach(b=>b.classList.toggle('selected',Number(b.dataset.id)===id));document.querySelectorAll('.as-detail').forEach(d=>d.classList.toggle('active',d.id==='adminDetail-'+id));if(socket&&activeId)socket.emit('support:leave',{ticketId:activeId});activeId=id;if(socket&&activeId)socket.emit('support:join',{ticketId:activeId});history.replaceState(null,'',`/admin/support?ticket=${id}`);syncSupport('open',id);}
  document.querySelectorAll('.as-ticket').forEach(b=>b.addEventListener('click',()=>open(b.dataset.id)));
  const search=document.getElementById('adminTicketSearch'),status=document.getElementById('adminStatus'),category=document.getElementById('adminCategory');function filter(){const q=(search?.value||'').toLowerCase().trim();document.querySelectorAll('.as-ticket').forEach(b=>{const okS=!status||status.value==='ALL'||b.dataset.status===status.value,okC=!category||category.value==='ALL'||b.dataset.category===category.value,okQ=!q||(b.textContent||'').toLowerCase().includes(q);b.style.display=okS&&okC&&okQ?'flex':'none'});}search?.addEventListener('input',filter);status?.addEventListener('change',filter);category?.addEventListener('change',filter);
  async function post(url,data){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:new URLSearchParams(data)});if(!r.ok)throw new Error('Action impossible');return r.json();}
  document.addEventListener('click',async e=>{const edit=e.target.closest('.msg-edit');if(edit){const text=prompt('Modifier votre message :',edit.dataset.text||'');if(text===null)return;await post(`/admin/support/${edit.dataset.ticket}/messages/${edit.dataset.id}/edit`,{message:text});await syncSupport('edit',Number(edit.dataset.ticket));return;}const del=e.target.closest('.msg-delete');if(del){if(!confirm('Supprimer ce message ?'))return;await post(`/admin/support/${del.dataset.ticket}/messages/${del.dataset.id}/delete`,{});await syncSupport('delete',Number(del.dataset.ticket));return;}const ro=e.target.closest('.react-open');if(ro){const m=ro.parentElement.querySelector('.react-menu');if(m)m.hidden=!m.hidden;return;}const rb=e.target.closest('.react-menu button');if(rb){await post(`/admin/support/${rb.dataset.ticket}/messages/${rb.dataset.id}/react`,{emoji:rb.dataset.emoji});await syncSupport('reaction',Number(rb.dataset.ticket));}});
  const emojis=['😀','😂','😊','😍','🥰','😅','😢','😭','😡','👍','🙏','👏','❤️','🔥','✅','❌','🎉','🤝','📦','🚚','💳','⭐','🍽️','📞','👌','😉','🙂'];
  document.querySelectorAll('.as-compose').forEach(form=>{const ta=form.querySelector('textarea'),panel=form.querySelector('.emoji-panel'),toggle=form.querySelector('.emoji-toggle'),input=form.querySelector('input[type=file]'),preview=form.querySelector('.file-preview'),name=form.querySelector('.file-name');let chosen=[];emojis.forEach(em=>{const b=document.createElement('button');b.type='button';b.textContent=em;b.onclick=()=>{const a=ta.selectionStart||ta.value.length,c=ta.selectionEnd||a;ta.value=ta.value.slice(0,a)+em+ta.value.slice(c);ta.focus();ta.selectionStart=ta.selectionEnd=a+em.length;panel.hidden=true};panel.appendChild(b)});toggle?.addEventListener('click',()=>panel.hidden=!panel.hidden);const render=()=>{if(!preview)return;preview.innerHTML='';chosen.forEach((f,i)=>{const c=document.createElement('div');c.className='file-chip';let media=null;if(f.type.startsWith('image/'))media=document.createElement('img');else if(f.type==='video/mp4'){media=document.createElement('video');media.muted=true}if(media){media.src=URL.createObjectURL(f);c.appendChild(media)}const n=document.createElement('span');n.textContent=f.name;c.appendChild(n);const x=document.createElement('button');x.type='button';x.textContent='×';x.onclick=()=>{chosen.splice(i,1);syncFiles()};c.appendChild(x);preview.appendChild(c)});if(name)name.textContent=chosen.length?`📎 ${chosen.length} fichier(s)`:'';};const syncFiles=()=>{const dt=new DataTransfer();chosen.forEach(f=>dt.items.add(f));input.files=dt.files;render()};input?.addEventListener('change',()=>{chosen=[...input.files];render()});form.addEventListener('submit',async ev=>{ev.preventDefault();const btn=form.querySelector('button:not([type=button])');if(btn)btn.disabled=true;try{const r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{'X-Requested-With':'XMLHttpRequest',Accept:'application/json'}});if(!r.ok)throw new Error('Envoi impossible');ta.value='';chosen=[];syncFiles();await syncSupport('send',Number(form.action.match(/\/support\/(\d+)\/reply/)?.[1]||activeId));}catch(err){alert(err.message||'Envoi impossible');}finally{if(btn)btn.disabled=false;}});});
  if(window.io){socket=io();if(activeId)socket.emit('support:join',{ticketId:activeId});socket.on('support:changed',e=>{const id=Number(e?.ticketId||0);if(id===activeId)syncSupport(e?.type||'socket',activeId);else syncSupport('list',0);});}
  if(activeId)syncSupport('initial',activeId);
})();
</script>
