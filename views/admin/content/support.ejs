            <div class="support-stat-label">
                <span class="dot dot-red"></span>
                Nouveaux
            </div>
            <strong>1</strong>
        </div>

        <div class="support-stat-card">
            <div class="support-stat-label">
                <span class="dot dot-orange"></span>
                En cours
            </div>
            <strong>0</strong>
        </div>

        <div class="support-stat-card">
            <div class="support-stat-label">
                <span class="resolved-icon">☑️</span>
                Résolus
            </div>
            <strong>0</strong>
        </div>

        <div class="support-stat-card">
            <div class="support-stat-label">
