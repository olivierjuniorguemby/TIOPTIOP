  const typeOf=(url,name,el)=>{const n=(name||url||'').toLowerCase();if(el?.querySelector('video')||/\.mp4(?:$|\?)/.test(n))return'video';if(el?.querySelector('img')||/\.(png|jpe?g|webp|avif|gif)(?:$|\?)/.test(n))return'image';if(/\.pdf(?:$|\?)/.test(n))return'pdf';return'doc';};
  function ensure(){if(viewer)return viewer;viewer=document.createElement('div');viewer.className='support-media-viewer';viewer.hidden=true;viewer.innerHTML=`<div class="smv-top"><button class="smv-btn smv-close">✕</button><div class="smv-title"><b>Pièce jointe</b><small></small></div><button class="smv-btn smv-download">⬇ Télécharger</button><button class="smv-btn smv-transfer">↪ Transférer</button><button class="smv-btn smv-share">↗ Partager</button><div class="smv-share-menu" hidden><button data-share="native">📱 Partager…</button><button data-share="copy">🔗 Copier le lien</button></div></div><div class="smv-stage"><button class="smv-nav smv-prev">‹</button><div class="smv-content"></div><button class="smv-nav smv-next">›</button></div><div class="smv-strip"></div>`;document.body.appendChild(viewer);
    viewer.querySelector('.smv-close').onclick=close;viewer.querySelector('.smv-prev').onclick=()=>show(index-1);viewer.querySelector('.smv-next').onclick=()=>show(index+1);viewer.querySelector('.smv-download').onclick=downloadCurrent;viewer.querySelector('.smv-transfer').onclick=openTransfer;viewer.querySelector('.smv-share').onclick=()=>{const m=viewer.querySelector('.smv-share-menu');m.hidden=!m.hidden};viewer.querySelector('[data-share="native"]').onclick=shareCurrent;viewer.querySelector('[data-share="copy"]').onclick=copyCurrent;viewer.addEventListener('click',e=>{if(e.target===viewer)close()});document.addEventListener('keydown',e=>{if(viewer.hidden)return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')show(index-1);if(e.key==='ArrowRight')show(index+1)});return viewer;}
  function collect(root){root=root||document.querySelector('.sd-messages,.as-messages');if(!root)return[];return [...root.querySelectorAll('.sd-attachment,.as-attachment')].map((a,i)=>{const raw=a.getAttribute('href')||a.querySelector('img,video')?.getAttribute('src')||'#';const name=(a.querySelector('span:last-child')?.textContent||a.textContent||`Fichier ${i+1}`).trim();const aid=Number(a.dataset.attachmentId||raw.match(/fichier\/(\d+)/)?.[1]||0);const mid=Number(a.dataset.messageId||a.closest('[data-message-id]')?.dataset.messageId||0);return{url:raw+(raw.includes('?')?'&':'?')+'preview=1',download:raw,name,type:typeOf(raw,name,a),attachmentId:aid,messageId:mid};});}
  function openFrom(el){const root=el.closest('.sd-messages,.as-messages');items=collect(root);let i=[...(root?.querySelectorAll('.sd-attachment,.as-attachment')||[])].indexOf(el);if(i<0)i=0;localMode=false;ensure().hidden=false;document.body.style.overflow='hidden';show(i);}
  function openLocal(el){const chip=el.closest('.file-chip,.init-file');if(!chip)return;const holder=chip.parentElement,form=chip.closest('form'),input=form?.querySelector('input[type=file]');const chips=[...(holder?.querySelectorAll('.file-chip,.init-file')||[])];const files=[...(input?.files||[])];items=chips.map((c,i)=>{const f=files[i],m=c.querySelector('img,video');const url=m?.src||(f?URL.createObjectURL(f):'');const name=f?.name||c.querySelector('span')?.textContent||`Fichier ${i+1}`;return{url,download:url,name,type:typeOf(url,name,c),local:true};}).filter(x=>x.url);index=Math.max(0,chips.indexOf(chip));localMode=true;ensure().hidden=false;document.body.style.overflow='hidden';show(index);}
  function show(i){if(!items.length)return;index=(i+items.length)%items.length;const it=items[index],v=ensure(),c=v.querySelector('.smv-content');v.querySelector('.smv-title b').textContent=it.name||'Pièce jointe';v.querySelector('.smv-title small').textContent=`${index+1} / ${items.length}${it.local?' · avant envoi':''}`;c.innerHTML=it.type==='image'?`<img src="${esc(it.url)}" alt="${esc(it.name)}">`:it.type==='video'?`<video src="${esc(it.url)}" controls autoplay></video>`:it.type==='pdf'?`<iframe src="${esc(it.url)}" title="${esc(it.name)}"></iframe>`:`<div class="smv-doc"><i>📄</i><h3>${esc(it.name)}</h3><p>${it.local?'Aperçu non disponible avant envoi.':'Ce type de document ne possède pas de prévisualisation intégrée.'}</p></div>`;renderStrip();v.querySelector('.smv-download').style.display=it.local?'none':'';v.querySelector('.smv-share').style.display=it.local?'none':'';v.querySelector('.smv-transfer').style.display=it.local?'none':'';}
  function renderStrip(){const s=ensure().querySelector('.smv-strip');s.innerHTML='';items.forEach((it,i)=>{const b=document.createElement('button');b.type='button';b.className='smv-thumb'+(i===index?' active':'');b.title=it.name;if(it.type==='image')b.innerHTML=`<img src="${esc(it.url)}" alt="">`;else if(it.type==='video')b.innerHTML=`<video src="${esc(it.url)}" muted preload="metadata"></video>`;else b.innerHTML=`<span>${it.type==='pdf'?'📕':'📄'}</span>`;b.onclick=()=>show(i);s.appendChild(b)});}
  function close(){if(!viewer)return;viewer.hidden=true;viewer.querySelectorAll('video').forEach(v=>v.pause());viewer.querySelector('.smv-share-menu').hidden=true;document.body.style.overflow='';}
  function current(){return items[index]||null}function downloadCurrent(){const it=current();if(!it||it.local)return;const a=document.createElement('a');a.href=it.download;a.download=it.name||'';document.body.appendChild(a);a.click();a.remove();}
  async function shareCurrent(){const it=current();if(!it)return;const url=new URL(it.download,location.origin).href;try{if(navigator.share)await navigator.share({title:it.name,text:'Pièce jointe TiopTiop (connexion requise)',url});else await navigator.clipboard.writeText(url);}catch(_){}ensure().querySelector('.smv-share-menu').hidden=true;}
  async function copyCurrent(){const it=current();if(!it)return;try{await navigator.clipboard.writeText(new URL(it.download,location.origin).href);alert('Lien copié. Le destinataire doit être autorisé à accéder à la demande.');}catch(_){alert('Copie du lien impossible.')}ensure().querySelector('.smv-share-menu').hidden=true;}
  function transferTargets(){const selector=".as-ticket[data-id]";return [...document.querySelectorAll(selector)].map(a=>({id:Number(a.dataset.id||new URL(a.href,location.origin).searchParams.get('ticket')),label:(a.querySelector('strong')?.textContent||a.textContent||'Conversation').trim().replace(/\s+/g,' ')})).filter(x=>x.id);}
  function openTransfer(){const it=current();if(!it||it.local||!it.attachmentId)return;const sourceId=Number(document.querySelector('.as-messages,.sd-messages')?.dataset.ticket||new URL(location.href).searchParams.get('ticket')||0);const targets=transferTargets().filter(x=>x.id!==sourceId);if(!targets.length){alert('Aucune autre conversation disponible pour le transfert.');return;}let modal=document.querySelector('.smv-transfer-modal');if(modal)modal.remove();modal=document.createElement('div');modal.className='smv-transfer-modal';modal.innerHTML=`<div class="smv-transfer-card"><h3>↪ Transférer</h3><p><b>${esc(it.name)}</b><br>Choisissez la conversation destinataire.</p><input class="smv-transfer-search" placeholder="Rechercher une demande..."><div class="smv-transfer-modes"><label><input type="radio" name="smvMode" value="media" checked> Ce média</label><label><input type="radio" name="smvMode" value="message"> Message complet + fichiers</label></div><div class="smv-transfer-list"></div><div class="smv-transfer-actions"><button class="smv-transfer-cancel">Annuler</button><button class="smv-transfer-confirm" disabled>Transférer</button></div></div>`;document.body.appendChild(modal);let selectedId=0;const list=modal.querySelector('.smv-transfer-list'),render=(q='')=>{list.innerHTML='';targets.filter(t=>t.label.toLowerCase().includes(q.toLowerCase())).forEach(t=>{const b=document.createElement('button');b.type='button';b.className='smv-transfer-target'+(selectedId===t.id?' selected':'');b.innerHTML=`<span>💬</span><span>${esc(t.label)}</span>`;b.onclick=()=>{selectedId=t.id;render(modal.querySelector('.smv-transfer-search').value);modal.querySelector('.smv-transfer-confirm').disabled=false};list.appendChild(b)})};render();modal.querySelector('.smv-transfer-search').oninput=e=>render(e.target.value);modal.querySelector('.smv-transfer-cancel').onclick=()=>modal.remove();modal.onclick=e=>{if(e.target===modal)modal.remove()};modal.querySelector('.smv-transfer-confirm').onclick=async()=>{if(!selectedId)return;const btn=modal.querySelector('.smv-transfer-confirm');btn.disabled=true;btn.textContent='Transfert…';try{const mode=modal.querySelector('input[name=smvMode]:checked').value;const endpoint=`/admin/support/${sourceId}/transfer`;const r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:new URLSearchParams({targetTicketId:String(selectedId),messageId:String(it.messageId||''),attachmentId:String(it.attachmentId),mode})});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||'Transfert impossible');modal.remove();close();alert('Transfert effectué vers la conversation sélectionnée.');}catch(e){alert(e.message||'Transfert impossible');btn.disabled=false;btn.textContent='Transférer';}};}
  document.addEventListener('click',e=>{const a=e.target.closest('.sd-attachment,.as-attachment');if(a){e.preventDefault();openFrom(a);return}const m=e.target.closest('.file-chip,.init-file');if(m&&!e.target.closest('button')){e.preventDefault();openLocal(m)}});
})();
</script>


<style>
/* 18.7.2.4.1 — sélection multiple */
.support-bulk-select{position:absolute;top:7px;right:-28px;width:24px;height:24px;border:1px solid #d8dee8;border-radius:50%;background:#fff;cursor:pointer;display:grid;place-items:center;font-size:12px;z-index:5}.support-bulk-select.active{background:#ff7900;color:#fff;border-color:#ff7900}.as-msg{position:relative}.as-msg.bulk-selected>div{outline:2px solid #ff7900;border-radius:14px}.support-bulk-toolbar{position:sticky;bottom:8px;z-index:70;margin:8px auto;width:max-content;max-width:94%;display:flex;gap:7px;align-items:center;padding:7px 9px;border-radius:14px;background:#172033;color:#fff;box-shadow:0 10px 30px rgba(0,0,0,.22)}.support-bulk-toolbar[hidden]{display:none}.support-bulk-toolbar button{border:0;border-radius:9px;padding:8px 10px;cursor:pointer;font-weight:800}.support-bulk-toolbar .bulk-forward{background:#ff7900;color:#fff}.support-bulk-toolbar .bulk-delete{background:#fff;color:#c62828}
.delete-choice-actions{display:grid;gap:8px}.delete-choice-actions button{padding:11px;border:1px solid #dfe3ea;border-radius:10px;background:#fff;font-weight:800;cursor:pointer}.delete-choice-actions .danger{color:#c62828}
</style>
<script>
/* 18.7.2.4.1 — sélection multiple / transfert / suppression */
(()=>{
 const ROLE='ADMIN', MSG='.as-msg', ROOT='.as-messages', BASE='/admin/support/', TARGET='.as-ticket[data-id]';
 let selected=new Set(), selectedSender=new Map();
 const activeRoot=()=>document.querySelector('.as-detail.active '+ROOT)||document.querySelector('#adminDetail-'+(new URL(location.href).searchParams.get('ticket')||'')+' '+ROOT)||[...document.querySelectorAll(ROOT)].find(x=>x.offsetParent!==null)||document.querySelector(ROOT);
 function toolbar(root){if(!root)return null;let b=root.querySelector('.support-bulk-toolbar');if(!b){b=document.createElement('div');b.className='support-bulk-toolbar';b.hidden=true;b.innerHTML='<b class="bulk-count">0 sélectionné</b><button type="button" class="bulk-forward">↪ Transférer</button><button type="button" class="bulk-delete">🗑 Supprimer</button><button type="button" class="bulk-cancel">✕</button>';root.appendChild(b);b.querySelector('.bulk-cancel').onclick=clear;b.querySelector('.bulk-delete').onclick=removeSelected;b.querySelector('.bulk-forward').onclick=forwardSelected;}return b;}
 function refresh(){const root=activeRoot(),b=toolbar(root);document.querySelectorAll(MSG).forEach(m=>{const mid=Number(m.dataset.messageId),on=selected.has(mid);if(on&&m.dataset.sender)selectedSender.set(mid,String(m.dataset.sender));m.classList.toggle('bulk-selected',on);m.querySelector(':scope > .support-bulk-select')?.classList.toggle('active',on);});if(b){b.hidden=!selected.size;b.querySelector('.bulk-count').textContent=selected.size+' sélectionné'+(selected.size>1?'s':'');}}
 function clear(){selected.clear();selectedSender.clear();refresh();}
 function install(){document.querySelectorAll(MSG).forEach(m=>{if(m.querySelector(':scope > .support-bulk-select'))return;const id=Number(m.dataset.messageId);if(!id)return;const b=document.createElement('button');b.type='button';b.className='support-bulk-select';b.title='Sélectionner ce message';b.textContent='✓';b.onclick=e=>{e.preventDefault();e.stopPropagation();if(selected.has(id)){selected.delete(id);selectedSender.delete(id);}else{selected.add(id);selectedSender.set(id,String(m.dataset.sender||''));}b.classList.toggle('active',selected.has(id));refresh();};m.appendChild(b);});};
 async function post(url,data){const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest',Accept:'application/json'},body:JSON.stringify(data)});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.message||'Opération impossible');return d;}
 async function removeSelected(){const root=activeRoot(),ticket=Number(root?.dataset.ticket||new URL(location.href).searchParams.get('ticket'));if(!ticket||!selected.size)return;const selectedRows=[...document.querySelectorAll(MSG)].filter(m=>selected.has(Number(m.dataset.messageId)));const senderFor=id=>String(selectedRows.find(m=>Number(m.dataset.messageId)===id)?.dataset.sender||selectedSender.get(id)||'');const allMine=[...selected].every(id=>senderFor(id)===ROLE);const scope=await deleteChoice(selected.size,allMine);if(!scope)return;try{const d=await post(BASE+ticket+'/messages/bulk-delete',{messageIds:[...selected],scope});clear();if(scope==='everyone'&&d.deleted<d.requested)alert(d.deleted+' message(s) supprimé(s) pour tout le monde. Les messages qui ne vous appartiennent pas ont été conservés.');}catch(e){alert(e.message)}}
 window.supportDeleteChoice=deleteChoice; function deleteChoice(n,allowEveryone=true){return new Promise(resolve=>{document.querySelector('.support-delete-modal')?.remove();const m=document.createElement('div');m.className='smv-transfer-modal support-delete-modal';m.innerHTML=`<div class="smv-transfer-card"><h3>🗑 Supprimer ${n} message${n>1?'s':''}</h3><p>Choisissez comme sur WhatsApp :</p><div class="delete-choice-actions"><button type="button" data-scope="me">Supprimer pour moi</button>${allowEveryone?'<button type="button" data-scope="everyone" class="danger">Supprimer pour tout le monde</button>':''}<button type="button" data-scope="cancel">Annuler</button></div></div>`;document.body.appendChild(m);m.onclick=e=>{const b=e.target.closest('[data-scope]');if(!b)return;const v=b.dataset.scope;m.remove();resolve(v==='cancel'?null:v);};});}
 function targets(){return [...document.querySelectorAll(TARGET)].map(a=>({id:Number(a.dataset.id||new URL(a.href||location.href,location.origin).searchParams.get('ticket')),label:(a.querySelector('b,strong')?.textContent||a.textContent||'Conversation').trim().replace(/\s+/g,' ')})).filter(x=>x.id);}
 function forwardSelected(){const root=activeRoot(),source=Number(root?.dataset.ticket||new URL(location.href).searchParams.get('ticket'));const list=targets().filter(x=>x.id&&x.id!==source);if(!list.length)return alert('Aucune conversation destinataire.');let m=document.querySelector('.bulk-transfer-modal');m?.remove();m=document.createElement('div');m.className='smv-transfer-modal bulk-transfer-modal';m.innerHTML='<div class="smv-transfer-card"><h3>↪ Transférer '+selected.size+' message(s)</h3><input class="smv-transfer-search" placeholder="Rechercher une conversation..."><div class="smv-transfer-list"></div><div class="smv-transfer-actions"><button class="smv-transfer-cancel">Annuler</button><button class="smv-transfer-confirm" disabled>Transférer</button></div></div>';document.body.appendChild(m);let dest=0;const box=m.querySelector('.smv-transfer-list');const render=(q='')=>{box.innerHTML='';list.filter(x=>x.label.toLowerCase().includes(q.toLowerCase())).forEach(x=>{const b=document.createElement('button');b.type='button';b.className='smv-transfer-target'+(dest===x.id?' selected':'');b.textContent='💬 '+x.label;b.onclick=()=>{dest=x.id;render(m.querySelector('input').value);m.querySelector('.smv-transfer-confirm').disabled=false;};box.appendChild(b)})};render();m.querySelector('input').oninput=e=>render(e.target.value);m.querySelector('.smv-transfer-cancel').onclick=()=>m.remove();m.querySelector('.smv-transfer-confirm').onclick=async()=>{if(!dest)return;const b=m.querySelector('.smv-transfer-confirm');b.disabled=true;try{await post(BASE+source+'/messages/bulk-transfer',{targetTicketId:dest,messageIds:[...selected]});m.remove();clear();}catch(e){alert(e.message);b.disabled=false;}};}
 document.addEventListener('support:ui-refreshed',install);new MutationObserver(()=>install()).observe(document.body,{subtree:true,childList:true});install();
})();
</script>


<style>
/* 18.7.2.4.3 — composeur média avant envoi */
.support-compose-preview[hidden]{display:none}.support-compose-preview{position:fixed;inset:0;z-index:12000;background:rgba(12,18,28,.94);display:grid;grid-template-rows:auto 1fr auto;color:#fff}.scp-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px}.scp-head button,.scp-add,.scp-remove{border:0;cursor:pointer}.scp-close{width:38px;height:38px;border-radius:50%;font-size:24px;background:#2b313b;color:#fff}.scp-stage{min-height:0;display:grid;place-items:center;padding:15px;overflow:hidden}.scp-stage img,.scp-stage video{max-width:min(900px,90vw);max-height:65vh;object-fit:contain;border-radius:8px}.scp-stage iframe{width:min(900px,90vw);height:65vh;border:0;background:#fff;border-radius:8px}.scp-doc{font-size:70px;text-align:center}.scp-doc small{display:block;font-size:15px;margin-top:12px;max-width:600px;word-break:break-word}.scp-bottom{border-top:1px solid #303744;padding:12px 18px 18px}.scp-strip{display:flex;justify-content:center;align-items:center;gap:9px;overflow:auto;padding:4px}.scp-thumb{position:relative;width:68px;height:58px;border:2px solid transparent;border-radius:8px;background:#252c36;color:#fff;display:grid;place-items:center;cursor:pointer;flex:0 0 auto}.scp-thumb.active{border-color:#ff7900}.scp-thumb img,.scp-thumb video{width:100%;height:100%;object-fit:cover;border-radius:6px}.scp-thumb .scp-x{position:absolute;right:-6px;top:-7px;width:20px;height:20px;border-radius:50%;background:#e32636;color:#fff;font-size:13px;display:grid;place-items:center}.scp-add{width:58px;height:58px;border:1px solid #687180;border-radius:8px;background:#202630;color:#fff;font-size:27px;flex:0 0 auto}.scp-count{text-align:center;font-weight:800;margin-bottom:8px}.scp-hint{text-align:center;color:#aeb7c5;font-size:12px;margin-top:8px}
</style>
<script>
/* 18.7.2.4.3 — ouverture automatique du visualiseur dès sélection de fichiers */
(()=>{
 let currentInput=null,currentIndex=0,urls=[];
 const modal=document.createElement('div');modal.className='support-compose-preview';modal.hidden=true;modal.innerHTML='<div class="scp-head"><b class="scp-title">Pièces jointes</b><button type="button" class="scp-close">×</button></div><div class="scp-stage"></div><div class="scp-bottom"><div class="scp-count"></div><div class="scp-strip"></div><div class="scp-hint">Vous pouvez visualiser, retirer ou ajouter des fichiers avant l’envoi.</div></div>';document.body.appendChild(modal);
 const files=()=>currentInput?[...currentInput.files]:[];
 function revoke(){urls.forEach(u=>URL.revokeObjectURL(u));urls=[]}
 function setFiles(arr){const dt=new DataTransfer();arr.forEach(f=>dt.items.add(f));currentInput.files=dt.files;currentInput.dataset.previewSkip='1';currentInput.dispatchEvent(new Event('change',{bubbles:true}));delete currentInput.dataset.previewSkip;}
 function type(f){if(f.type.startsWith('image/'))return'image';if(f.type==='video/mp4'||f.type.startsWith('video/'))return'video';if(f.type==='application/pdf'||/\.pdf$/i.test(f.name))return'pdf';return'doc'}
 function show(i){const fs=files();if(!fs.length){close();return}currentIndex=Math.max(0,Math.min(i,fs.length-1));revoke();const f=fs[currentIndex],u=URL.createObjectURL(f);urls.push(u);const stage=modal.querySelector('.scp-stage'),t=type(f);stage.innerHTML='';let el;if(t==='image'){el=document.createElement('img');el.src=u}else if(t==='video'){el=document.createElement('video');el.src=u;el.controls=true;el.autoplay=false}else if(t==='pdf'){el=document.createElement('iframe');el.src=u}else{el=document.createElement('div');el.className='scp-doc';el.innerHTML='📄<small></small>';el.querySelector('small').textContent=f.name}stage.appendChild(el);renderStrip();}
 function renderStrip(){const fs=files(),strip=modal.querySelector('.scp-strip');modal.querySelector('.scp-count').textContent=fs.length+' fichier'+(fs.length>1?'s':'')+' sélectionné'+(fs.length>1?'s':'')+' · '+(currentIndex+1)+' / '+fs.length;strip.innerHTML='';fs.forEach((f,i)=>{const b=document.createElement('button');b.type='button';b.className='scp-thumb'+(i===currentIndex?' active':'');const t=type(f);if(t==='image'||t==='video'){const u=URL.createObjectURL(f);urls.push(u);const m=document.createElement(t==='image'?'img':'video');m.src=u;m.muted=true;b.appendChild(m)}else b.append(t==='pdf'?'📕':'📄');const x=document.createElement('span');x.className='scp-x';x.textContent='×';x.title='Retirer ce fichier';x.onclick=e=>{e.stopPropagation();const a=files();a.splice(i,1);setFiles(a);if(a.length)show(Math.min(currentIndex,a.length-1));else close()};b.appendChild(x);b.onclick=()=>show(i);strip.appendChild(b)});const add=document.createElement('button');add.type='button';add.className='scp-add';add.textContent='+';add.title='Ajouter des fichiers';add.onclick=()=>{const extra=document.createElement('input');extra.type='file';extra.multiple=true;extra.accept=currentInput.accept;extra.onchange=()=>{const merged=[...files(),...extra.files];setFiles(merged);show(files().length-1)};extra.click()};strip.appendChild(add)}
 function open(input){if(!input.files?.length)return;currentInput=input;modal.hidden=false;document.body.style.overflow='hidden';show(0)}
 function close(){revoke();modal.hidden=true;document.body.style.overflow='';currentInput=null}
 modal.querySelector('.scp-close').onclick=close;
 document.addEventListener('change',e=>{const input=e.target.closest('form input[type=file][name="attachments"]');if(!input||input.dataset.previewSkip==='1'||!input.files.length)return;open(input)});
 window.supportOpenComposePreview=open;
})();
</script>
