<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{
  const reactionSet=['👍','❤️','😂','😮','😢','🙏','🔥','✅']; const labels={NEW:'Nouveau',IN_PROGRESS:'En cours',WAITING_CUSTOMER:'En attente client',RESOLVED:'Résolu',CLOSED:'Fermé'}; const agentsMap=<%- JSON.stringify(Object.fromEntries((agents||[]).map(a=>[String(a.id),a.name]))) %>;
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); const fr=d=>{try{return new Date(d).toLocaleString('fr-FR')}catch{return ''}}; const timeOnly=d=>{try{return new Date(d).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}catch{return ''}};
  const isImg=a=>/^image\//.test(String(a?.mime_type||''))||/\.(png|jpe?g|webp|avif)$/i.test(String(a?.stored_name||a?.legacy_url||'')); const isVideo=a=>String(a?.mime_type||'')==='video/mp4'||/\.mp4$/i.test(String(a?.stored_name||''));
  let activeId=Number(document.querySelector('.as-detail.active .as-messages')?.dataset.ticket||0),socket=null,syncing=false,queued=false;
  const nearBottom=el=>!el||el.scrollHeight-el.scrollTop-el.clientHeight<110;
  const unseenByTicket=new Map();
  function jumpButton(id){return document.querySelector(`#adminDetail-${id} .as-jump-latest`)}
  function ensureJumpButton(id){const box=document.querySelector(`#adminDetail-${id} .as-messages`);if(!box)return null;let wrap=box.parentElement;if(!wrap.classList.contains('as-messages-wrap')){const w=document.createElement('div');w.className='as-messages-wrap';box.parentNode.insertBefore(w,box);w.appendChild(box);wrap=w}let b=wrap.querySelector('.as-jump-latest');if(!b){b=document.createElement('button');b.type='button';b.className='as-jump-latest';b.setAttribute('aria-label','Revenir aux nouveaux messages');b.innerHTML='<span class="jump-arrow">↓</span><span class="jump-count"></span>';b.addEventListener('click',()=>scrollAdminBottom(id,true));wrap.appendChild(b)}return b}
  function updateJump(id){const b=ensureJumpButton(id);if(!b)return;const n=Number(unseenByTicket.get(Number(id))||0),c=b.querySelector('.jump-count');c.textContent=n?String(n):'';b.classList.toggle('show',n>0)}
  function scrollAdminBottom(id,clear=true){const box=document.querySelector(`#adminDetail-${id} .as-messages`);if(!box)return;const go=()=>{box.scrollTop=box.scrollHeight;if(clear){unseenByTicket.set(Number(id),0);updateJump(id)}};requestAnimationFrame(()=>requestAnimationFrame(go));setTimeout(go,80);setTimeout(go,260)}
  function settleAdminBottom(id){scrollAdminBottom(id,true);const box=document.querySelector(`#adminDetail-${id} .as-messages`);box?.querySelectorAll('img,video').forEach(m=>{if(!m.complete&&m.readyState<1){m.addEventListener('load',()=>scrollAdminBottom(id,true),{once:true});m.addEventListener('loadedmetadata',()=>scrollAdminBottom(id,true),{once:true})}});setTimeout(()=>scrollAdminBottom(id,true),650)}
  const sound={muted:localStorage.getItem('tiop-support-sound')==='0',ctx:null,play(kind){if(this.muted)return;try{this.ctx=this.ctx||new (window.AudioContext||window.webkitAudioContext)();const c=this.ctx,n=c.currentTime,o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);const cfg=kind==='send'?[620,0.16]:kind==='reaction'?[760,0.18]:kind==='status'?[520,0.20]:[880,0.24];o.frequency.setValueAtTime(cfg[0],n);if(kind==='receive')o.frequency.exponentialRampToValueAtTime(1180,n+.11);if(kind==='send')o.frequency.exponentialRampToValueAtTime(820,n+.08);g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.10,n+.012);g.gain.exponentialRampToValueAtTime(.0001,n+cfg[1]);o.start(n);o.stop(n+cfg[1]+.02);}catch(_){}}};
  function updateSoundButton(){document.querySelectorAll('.as-sound-toggle').forEach(b=>b.textContent=sound.muted?'🔇':'🔊')} document.querySelectorAll('.as-sound-toggle').forEach(b=>b.addEventListener('click',()=>{sound.muted=!sound.muted;localStorage.setItem('tiop-support-sound',sound.muted?'0':'1');updateSoundButton();if(!sound.muted)sound.play('send')}));updateSoundButton();
  function updateStats(stats){const a=document.querySelectorAll('.as-stats article strong');if(a.length>=5){a[0].textContent=Number(stats?.new_count||0);a[1].textContent=Number(stats?.in_progress_count||0);a[2].textContent=Number(stats?.waiting_count||0);a[3].textContent=Number(stats?.resolved_count||0);a[4].textContent=Number(stats?.total||0);}}
  function historyHtml(h){return `<div><span>●</span><p><b>${esc(labels[h.from_status]||h.from_status)} → ${esc(labels[h.to_status]||h.to_status)}</b><small>${esc(h.actor_name||'Système')} · ${esc(fr(h.created_at))}${h.note?' · '+esc(h.note):''}</small></p></div>`;}
  function updateLifecycle(id,ticket,history){if(!ticket)return;const root=document.getElementById('adminDetail-'+id);if(!root)return;const status=ticket.status;const head=root.querySelector('.as-detail-head .badge');if(head){head.className='badge b-'+status.toLowerCase();head.textContent=labels[status]||status;}const sel=root.querySelector('.ticket-status-live');if(sel&&sel.value!==status)sel.value=status;const compose=root.querySelector('[data-lifecycle-compose]'),reopen=root.querySelector('[data-lifecycle-reopen]');const closed=['RESOLVED','CLOSED'].includes(status);if(compose)compose.style.display=closed?'none':'';if(reopen){reopen.style.display=closed?'':'none';const l=reopen.querySelector('.as-closed-label');if(l)l.textContent=status==='RESOLVED'?'résolu':'fermé';}const box=root.querySelector('.as-history');if(box){box.innerHTML=(history||[]).length?(history||[]).slice().reverse().map(historyHtml).join(''):'<small>Aucun changement de statut enregistré.</small>';const n=root.querySelector('.as-lifecycle summary b');if(n)n.textContent=(history||[]).length;}}

  function activityHtml(a){const icon=a.activity_type==='INTERNAL_NOTE'?'📝':a.activity_type==='ASSIGNMENT'?'🎧':'⚑',title=a.activity_type==='INTERNAL_NOTE'?'Note interne':a.activity_type==='ASSIGNMENT'?'Affectation modifiée':'Priorité modifiée';let detail='';if(a.activity_type==='INTERNAL_NOTE')detail=a.note||'';else if(a.activity_type==='ASSIGNMENT')detail=(agentsMap[String(a.old_value)]||(a.old_value?'Agent #'+a.old_value:'Non assigné'))+' → '+(agentsMap[String(a.new_value)]||(a.new_value?'Agent #'+a.new_value:'Non assigné'));else detail=(a.old_value||'—')+' → '+(a.new_value||'—');return `<div class="as-activity-row ${a.activity_type==='INTERNAL_NOTE'?'note':''}"><span>${icon}</span><p><b>${esc(title)}</b><small>${esc(a.admin_name||'Support')} · ${esc(fr(a.created_at))}</small><em>${esc(detail)}</em></p></div>`;}
  function updateActivity(id,activity){const root=document.getElementById('adminDetail-'+id),box=root?.querySelector('.as-activity-list');if(!box)return;box.innerHTML=(activity||[]).length?(activity||[]).map(activityHtml).join(''):'<small>Aucune activité interne enregistrée.</small>';const n=root.querySelector('.as-activity summary b');if(n)n.textContent=(activity||[]).length;}


  function attachmentHtml(a){const href=a.id?('/admin/support/fichier/'+a.id):(a.legacy_url||'#');if(isImg(a))return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener"><img src="${esc(href)}" alt="Pièce jointe"></a>`;if(isVideo(a))return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener"><video controls preload="metadata" src="${esc(href)}"></video><span>🎬 ${esc(a.original_name||'Vidéo de préparation')}</span></a>`;return `<a class="as-attachment" href="${esc(href)}" target="_blank" rel="noopener">📄 ${esc(a.original_name||'Ouvrir la pièce jointe')}</a>`;}
  function reactionSummary(rs){const a=rs||[];if(!a.length)return '';const emojis=[...new Set(a.map(x=>x.emoji))].join(' ');return `<span class="as-reaction-summary">${esc(emojis)}${a.length>1?` <b>${a.length}</b>`:''}</span>`;}
  function clearReply(form){if(!form)return;form.querySelector('input[name="replyToMessageId"]')?.remove();form.querySelector('.as-replying')?.remove();}
  function setReply(id,author,text){const detail=document.querySelector('.as-detail.active')||document.querySelector('#adminDetail-'+(new URL(location.href).searchParams.get('ticket')||''));const form=detail?.querySelector('.as-compose');if(!form)return;clearReply(form);const h=document.createElement('input');h.type='hidden';h.name='replyToMessageId';h.value=String(id);form.appendChild(h);const bar=document.createElement('div');bar.className='as-replying';bar.innerHTML=`<div><b>↩ ${esc(author)}</b><span>${esc(text||'Message')}</span></div><button type="button">×</button>`;const ta=form.querySelector('textarea');(ta?.parentElement||form).prepend(bar);bar.querySelector('button').onclick=()=>clearReply(form);ta?.focus();}
  document.addEventListener('click',e=>{const r=e.target.closest('.msg-reply');if(r){e.preventDefault();setReply(r.dataset.id,r.dataset.author,r.dataset.text);return;}const q=e.target.closest('.as-reply-quote');if(q){const target=document.querySelector(`.as-msg[data-message-id="${q.dataset.target}"]`);if(target){target.scrollIntoView({behavior:'smooth',block:'center'});target.classList.add('as-message-highlight');setTimeout(()=>target.classList.remove('as-message-highlight'),1400);}}});
  function messageHtml(m){const mine=m.sender_type==='ADMIN';const actions=!(m.deleted_at||m.hidden_for_me)?`<span class="as-msg-actions"><button type="button" class="msg-reply" data-id="${m.id}" data-author="${esc(mine?'Support TiopTiop':(m.sender_name||'Client'))}" data-text="${esc(m.message||((m.attachments||[]).length?'Pièce jointe':''))}">↩</button>${mine?`<button type="button" class="msg-edit" data-ticket="${m.ticket_id}" data-id="${m.id}" data-text="${esc(m.message||'')}">✎</button><button type="button" class="msg-delete" data-ticket="${m.ticket_id}" data-id="${m.id}">🗑</button>`:''}</span>`:'';const content=(m.deleted_at||m.hidden_for_me)?'<p class="as-deleted">Message supprimé</p>':`${m.message?`<p>${esc(m.message)}</p>`:''}${(m.attachments||[]).map(attachmentHtml).join('')}`;const reactions=(m.reactions||[]).map(r=>`<span>${esc(r.emoji)}</span>`).join('');const menu=!(m.deleted_at||m.hidden_for_me)?`<div class="as-react-bar"><button type="button" class="react-open">☺</button><div class="react-menu" hidden>${reactionSet.map(e=>`<button type="button" data-ticket="${m.ticket_id}" data-id="${m.id}" data-emoji="${e}">${e}</button>`).join('')}</div></div>`:'';return `<div class="as-msg ${mine?'admin':'customer'}" data-message-id="${m.id}" data-sender="${m.sender_type}" data-unread="${!mine&&!m.read_at?'1':'0'}"><span class="as-avatar">${mine?'🎧':'👤'}</span><div><div class="as-msg-head"><strong>${esc(m.sender_name||(mine?'Support TiopTiop':'Client'))}</strong>${actions}</div>${m.reply_to_message_id?`<button type="button" class="as-reply-quote" data-target="${m.reply_to_message_id}"><b>${esc(m.reply_sender_type==='ADMIN'?'Support TiopTiop':'Client')}</b><span>${esc(m.reply_deleted_at?'Message supprimé':(m.reply_message||((m.reply_attachment_count||0)>0?'📎 Pièce jointe':'Message')))}</span></button>`:''}${content}<div class="as-reactions">${reactionSummary(m.reactions||[])}</div><div class="as-msg-foot"><small>${esc(timeOnly(m.created_at))}${m.edited_at?' · Modifié':''}</small>${mine?`<span class="read-state">${m.read_at?'✓✓':'✓'}</span>`:''}</div>${menu}</div></div>`;}
  const dayKey=d=>{const x=new Date(d);return `${x.getFullYear()}-${x.getMonth()}-${x.getDate()}`};
  const dayLabel=d=>{const x=new Date(d),n=new Date(),y=new Date();y.setDate(n.getDate()-1);if(dayKey(x)===dayKey(n))return 'Aujourd’hui';if(dayKey(x)===dayKey(y))return 'Hier';return x.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'});};
  function messagesHtml(msgs){let out='',prev='',unreadInserted=false;const unread=(msgs||[]).filter(m=>m.sender_type==='CUSTOMER'&&!m.read_at).length;(msgs||[]).forEach(m=>{const dk=dayKey(m.created_at);if(dk!==prev){out+=`<div class="as-day-separator"><span>${esc(dayLabel(m.created_at))}</span></div>`;prev=dk;}if(!unreadInserted&&m.sender_type==='CUSTOMER'&&!m.read_at){out+=`<div class="as-unread-separator" data-unread-separator><span>${unread} nouveau${unread>1?'x':''} message${unread>1?'s':''}</span></div>`;unreadInserted=true;}out+=messageHtml(m);});return out;}
