</section>


<!-- =====================================================
     MODAL AJOUT
====================================================== -->

<div class="condition-modal-overlay" id="conditionAddModal">

    <div class="condition-modal">

        <div class="condition-modal-header">

            <h2>📜 Ajouter une condition</h2>

            <button
                type="button"
                class="condition-modal-close"
                onclick="closeConditionAddModal()"
            >
                ×
            </button>

        </div>


        <form onsubmit="saveNewCondition(event)">

            <input
                type="text"
                class="condition-input"
                placeholder="Titre de la condition"
                required
            >

            <textarea
                class="condition-textarea"
                placeholder="Contenu détaillé de la condition"
                required
            ></textarea>

            <input
                type="number"
                class="condition-input"
                placeholder="Ordre d'affichage"
                value="1"
                min="1"
            >


            <label class="condition-checkbox-row">

                <span>Condition active</span>

                <input
                    type="checkbox"
                    checked
                >

            </label>


            <button type="submit" class="condition-save">
                💾 Enregistrer la condition
            </button>

        </form>

    </div>

</div>


<!-- =====================================================
     MODAL MODIFICATION
====================================================== -->

<div class="condition-modal-overlay" id="conditionEditModal">

    <div class="condition-modal">

        <div class="condition-modal-header">

            <h2>✏️ Modifier la condition</h2>

            <button
                type="button"
                class="condition-modal-close"
                onclick="closeConditionEditModal()"
            >
                ×
            </button>

        </div>


        <form onsubmit="saveConditionEdit(event)">

            <input
                type="text"
                id="editConditionTitle"
                class="condition-input"
                placeholder="Titre"
                required
            >

            <textarea
                id="editConditionContent"
                class="condition-textarea"
                placeholder="Contenu"
                required
            ></textarea>

            <input
                type="number"
                id="editConditionOrder"
                class="condition-input"
                min="1"
            >


            <label class="condition-checkbox-row">

                <span>Condition active</span>

                <input
                    type="checkbox"
                    id="editConditionActive"
                >

            </label>


            <button type="submit" class="condition-save">
                💾 Enregistrer
            </button>

        </form>

    </div>

</div>

<style>
    /* =========================================================
   CONDITIONS
========================================================= */

.admin-conditions {
    padding: 20px;
}

.conditions-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;

    margin-bottom: 60px;
}

.admin-badge {
    display: inline-flex;
    padding: 10px 18px;

    border-radius: 999px;

    background: #fff0df;
    color: #ff7900;

    font-size: 14px;
    font-weight: 800;
}

.conditions-title {
    margin: 20px 0 0;

    font-size: 48px;
    line-height: 1.1;
    font-weight: 800;
}

.btn-add-condition {
    margin-top: 20px;

    padding: 20px 30px;

    border: 0;
    border-radius: 999px;

    background: #ff7900;
    color: white;

    font-family: inherit;
    font-size: 18px;
    font-weight: 800;

    cursor: pointer;
}


/* =========================================================
   TABLE
========================================================= */

.conditions-table-wrapper {
    overflow-x: auto;

    background: white;

    border-radius: 25px;
}

.conditions-table {
    width: 100%;

    border-collapse: collapse;
}

.conditions-table th {
    padding: 25px 20px;

    background: #faf8f5;

    text-align: left;

    font-size: 16px;
    font-weight: 800;

    border-bottom: 1px solid #ddd;
}

.conditions-table td {
    padding: 20px;

    vertical-align: middle;

    border-bottom: 1px solid #ddd;

    font-size: 17px;
}

.conditions-table tbody tr:last-child td {
    border-bottom: none;
}

.conditions-table th:nth-child(1) {
    width: 25%;
}

.conditions-table th:nth-child(2) {
    width: 42%;
}

.conditions-table th:nth-child(3) {
    width: 8%;
}

.conditions-table th:nth-child(4) {
    width: 7%;
}

.conditions-table th:nth-child(5) {
    width: 18%;
}

.condition-preview {
    max-width: 600px;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =========================================================
   ACTIONS
========================================================= */

.condition-actions {
    display: flex;
    align-items: center;

    gap: 12px;
}

.btn-condition-edit,
.btn-condition-delete {
    padding: 15px 23px;

    border: 0;
    border-radius: 999px;

    font-family: inherit;
    font-size: 16px;
    font-weight: 800;

    cursor: pointer;
}

.btn-condition-edit {
    background: white;
    color: #111;

    box-shadow:
        0 8px 25px rgba(0, 0, 0, .06);
}

.btn-condition-delete {
    background: #ffe4e4;
    color: #c93d32;
}


/* =========================================================
   MODAL
========================================================= */

.condition-modal-overlay {
    position: fixed;
    inset: 0;

    z-index: 99999;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 25px;

    background: rgba(0, 0, 0, .55);
}

.condition-modal-overlay.active {
    display: flex;
}

.condition-modal {
    box-sizing: border-box;

    width: min(900px, 95vw);
    max-height: 92vh;

    overflow-y: auto;

    padding: 35px;

    border-radius: 30px;

    background: white;

    box-shadow:
        0 30px 80px rgba(0, 0, 0, .25);
}

.condition-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
}

.condition-modal-header h2 {
    margin: 0;

    font-size: 30px;
    font-weight: 800;
}

.condition-modal-close {
    width: 50px;
    height: 50px;

    flex: 0 0 50px;

    border: 0;
    border-radius: 50%;

    background: #f1f1f1;

    font-size: 22px;

    cursor: pointer;
}


/* =========================================================
   FORM
========================================================= */

.condition-input,
.condition-textarea {
    box-sizing: border-box;

    width: 100%;

    margin-bottom: 15px;

    padding: 18px;

    border: 1px solid #ddd;
    border-radius: 18px;

    background: white;

    font-family: inherit;
    font-size: 17px;

    outline: none;
}

.condition-input {
    height: 60px;
}

.condition-textarea {
    min-height: 180px;

    resize: vertical;
}

.condition-input:focus,
.condition-textarea:focus {
    border-color: #ff7900;
}

.condition-checkbox-row {
    box-sizing: border-box;

    width: 100%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 20px;

    margin-bottom: 15px;

    border-radius: 18px;

    background: #faf7f3;

    font-size: 17px;
}

.condition-checkbox-row input {
    width: 20px;
    height: 20px;
}

.condition-save {
    width: 100%;
    min-height: 60px;

    border: 0;
    border-radius: 999px;

    background: #ff7900;
    color: white;

    font-family: inherit;
    font-size: 18px;
    font-weight: 800;

    cursor: pointer;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 800px) {

    .conditions-top {
        flex-direction: column;

        margin-bottom: 30px;
    }

    .conditions-title {
        font-size: 34px;
    }

    .btn-add-condition {
        width: 100%;

        margin-top: 0;
    }

    .conditions-table {
        min-width: 900px;
    }

    .condition-modal {
        padding: 25px 18px;
    }

    .condition-modal-header h2 {
        font-size: 23px;
    }
}
</style>

<script>

function openConditionAddModal() {

    document
        .getElementById('conditionAddModal')
        .classList.add('active');

    document.body.style.overflow = 'hidden';
}


function closeConditionAddModal() {

    document
        .getElementById('conditionAddModal')
        .classList.remove('active');

    document.body.style.overflow = '';
}


function openConditionEditModal(title, content, order, active) {

    document.getElementById('editConditionTitle').value = title;

    document.getElementById('editConditionContent').value = content;

    document.getElementById('editConditionOrder').value = order;

    document.getElementById('editConditionActive').checked = active;


    document
        .getElementById('conditionEditModal')
        .classList.add('active');

    document.body.style.overflow = 'hidden';
}


function closeConditionEditModal() {

    document
        .getElementById('conditionEditModal')
        .classList.remove('active');

    document.body.style.overflow = '';
}


function saveNewCondition(event) {

    event.preventDefault();

    alert('Condition ajoutée avec succès.');

    closeConditionAddModal();
}


function saveConditionEdit(event) {

    event.preventDefault();

    alert('Condition modifiée avec succès.');

    closeConditionEditModal();
}


/* FERMETURE EN CLIQUANT SUR LE FOND */

document.querySelectorAll('.condition-modal-overlay')
    .forEach(function(modal) {

        modal.addEventListener('click', function(event) {

            if (event.target === modal) {

                modal.classList.remove('active');

                document.body.style.overflow = '';
            }

        });

    });


/* ESC */

document.addEventListener('keydown', function(event) {

    if (event.key === 'Escape') {

        document
            .querySelectorAll('.condition-modal-overlay')
            .forEach(function(modal) {
                modal.classList.remove('active');
            });

        document.body.style.overflow = '';
    }

});

</script>