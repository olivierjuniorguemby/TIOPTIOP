                    </td>

                    <td>Oui</td>

                    <td>5</td>

                    <td>
                        <div class="condition-actions">

                            <button
                                class="btn-condition-edit"
                                onclick="openConditionEditModal(
                                    'Annulation et remboursement',
                                    'Une commande peut être annulée selon son état d’avancement. Certaines commandes déjà préparées peuvent ne plus être remboursables.',
