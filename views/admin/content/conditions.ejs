                    </td>

                    <td>Oui</td>

                    <td>3</td>

                    <td>
                        <div class="condition-actions">

                            <button
                                class="btn-condition-edit"
                                onclick="openConditionEditModal(
                                    'Prix et paiement',
                                    'Les prix sont indiqués en FCFA. Les moyens de paiement disponibles peuvent inclure la carte, Mobile Money et les espèces.',
                                    3,
                                    true
                                )"
                            >
                                Modifier
                            </button>

                            <button class="btn-condition-delete">
                                Supprimer
                            </button>

                        </div>
                    </td>
                </tr>


                <tr>
                    <td>Livraison</td>

                    <td>
                        <div class="condition-preview">
                            Les délais de livraison sont donnés à titre
                            indicatif et peuvent varier selon le restaurant,
                            la distance et les conditions de circulation...
                        </div>
                    </td>

                    <td>Oui</td>

                    <td>4</td>

                    <td>
                        <div class="condition-actions">

                            <button
                                class="btn-condition-edit"
                                onclick="openConditionEditModal(
                                    'Livraison',
                                    'Les délais de livraison sont donnés à titre indicatif et peuvent varier selon le restaurant, la distance et les conditions de circulation.',
                                    4,
