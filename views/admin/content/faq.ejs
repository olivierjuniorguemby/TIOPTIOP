<!-- ======================================================
     MODAL AJOUT
====================================================== -->

<div id="faqAddModal" class="faq-modal-overlay">

  <div class="faq-modal">

    <div class="faq-modal-header">

      <h2>Ajouter</h2>

      <button
        type="button"
        class="faq-modal-close"
        onclick="closeFaqAddModal()"
      >
        ×
      </button>

    </div>


    <form action="/admin/faq" method="POST">

      <input
        type="text"
        name="question"
        class="faq-field"
        placeholder="Question"
        required
      >

      <textarea
        name="answer"
        class="faq-field faq-textarea"
        placeholder=""
        required
      ></textarea>

      <button type="submit" class="faq-save-btn">
        Enregistrer
      </button>

    </form>

  </div>

</div>


<!-- ======================================================
     MODAL MODIFICATION
====================================================== -->

<div id="faqEditModal" class="faq-modal-overlay">

  <div class="faq-modal">

    <div class="faq-modal-header">

      <h2>Modifier</h2>

      <button
        type="button"
        class="faq-modal-close"
        onclick="closeFaqEditModal()"
      >
        ×
      </button>

    </div>


    <form id="faqEditForm" method="POST">

      <input
        type="hidden"
        id="faqEditId"
        name="id"
      >

      <input
        type="text"
        id="faqEditQuestion"
        name="question"
        class="faq-field"
        required
      >

      <textarea
        id="faqEditAnswer"
        name="answer"
        class="faq-field faq-textarea"
        required
      ></textarea>

      <button type="submit" class="faq-save-btn">
        Enregistrer
      </button>

    </form>

  </div>

</div>

<style>
  /* =========================================================
   ADMIN FAQ
========================================================= */

.admin-faq {
    padding: 14px;
}


/* HEADER */

.faq-page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.admin-badge {
    display: inline-block;
    background: #fff0df;
    color: #ff7900;

    padding: 6px 11px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 800;
}

.faq-page-header h1 {
    margin: 8px 0 0;

    font-size: 35px;
    line-height: 1;

    font-weight: 800;
}

.btn-orange {
    border: 0;

    background: #ff7900;
    color: white;

    padding: 14px 20px;

    border-radius: 999px;

    font-weight: 800;
    font-size: 14px;

    cursor: pointer;
}

.btn-orange:hover {
    background: #e96e00;
}


/* =========================================================
   TABLEAU
========================================================= */

.faq-table-card {
    width: 100%;

    overflow: hidden;

    background: white;

    border-radius: 18px;
}


.faq-table-row {
    display: grid;

    grid-template-columns:
        1.5fr
        2.35fr
        .45fr
        .20fr
        1fr;

    align-items: center;

    min-height: 64px;

    border-bottom: 1px solid #ddd;
}

.faq-table-row:last-child {
    border-bottom: none;
}


.faq-table-row > div {
    padding: 13px;
}


.faq-table-head {
    min-height: 42px;

    background: #faf7f4;

    font-weight: 800;
    font-size: 13px;
}


/* réponse coupée comme capture */

.faq-answer-preview {
    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

    max-width: 100%;
}


/* =========================================================
   ACTIONS
========================================================= */

.faq-actions {
    display: flex;

    align-items: center;

    gap: 8px;
}


.faq-edit-btn,
.faq-delete-btn {
    border: 0;

    padding: 11px 17px;

    border-radius: 999px;

    font-weight: 800;

    cursor: pointer;
}


.faq-edit-btn {
    background: white;

    color: #111;

    box-shadow: 0 5px 18px rgba(0, 0, 0, .05);
}


.faq-delete-btn {
    background: #fde7e6;

    color: #c43d32;
}


.faq-edit-btn:hover {
    background: #f8f8f8;
}


.faq-delete-btn:hover {
    background: #f9d4d2;
}


/* =========================================================
   MODAL
========================================================= */

.faq-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    background: rgba(0, 0, 0, .52);
}


.faq-modal-overlay.show {
    display: flex;
}


.faq-modal {
    width: min(760px, 94vw);

    padding: 22px;

    background: white;

    border-radius: 24px;

    box-shadow:
        0 30px 80px rgba(0, 0, 0, .30);
}


.faq-modal-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 18px;
}


.faq-modal-header h2 {
    margin: 0;

    font-size: 26px;

    font-weight: 800;
}


.faq-modal-close {
    width: 38px;

    height: 38px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 0;

    border-radius: 50%;

    background: #f1f1f1;

    color: #333;

    font-size: 18px;

    cursor: pointer;
}


/* =========================================================
   FORMULAIRE
========================================================= */

.faq-modal form {
    display: flex;

    flex-direction: column;

    gap: 10px;
}


.faq-field {
    width: 100%;

    box-sizing: border-box;

    min-height: 45px;

    padding: 11px 13px;

    border: 1px solid #ddd;

    border-radius: 12px;

    background: white;

    font: inherit;

    outline: none;
}


.faq-field:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255, 121, 0, .08);
}


.faq-textarea {
    min-height: 65px;

    resize: vertical;
}


.faq-save-btn {
    width: 100%;

    min-height: 44px;

    border: 0;

    border-radius: 999px;

    background: #ff7900;

    color: white;

    font-size: 15px;

    font-weight: 800;

    cursor: pointer;
}


.faq-save-btn:hover {
    background: #e96e00;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .faq-table-card {
        overflow-x: auto;
    }

    .faq-table-row {
        min-width: 950px;
    }

}


@media (max-width: 600px) {

    .faq-page-header {
        flex-direction: column;
    }

    .btn-orange {
        width: 100%;
    }

    .faq-modal {
        padding: 17px;
    }

}
</style>

<script src="/js/faq.js" defer></script>