<section class="admin-heading">
  <div>
    <span class="admin-badge">Administration</span>
    <h1>❓ FAQ</h1>
  </div>
  <button type="button" class="btn-orange" onclick="openFaqAddModal()">
      + Ajouter une FAQ
    </button>
</section>

<section class="admin-faq">



  <!-- TABLEAU -->
