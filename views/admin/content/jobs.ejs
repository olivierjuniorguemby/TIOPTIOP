<section class="admin-heading">
  <div>
    <span class="admin-badge">Administration</span>
    <h1>💼 Carrières</h1>
  </div>
  <button class="btn-orange" type="button" onclick="openCareerAddModal()">
      + Ajouter une offre
    </button>
</section>

<section class="admin-careers">


  <!-- TABLEAU -->
  <div class="career-table-card">

    <div class="career-table-head career-table-row">
      <div>Poste</div>
      <div>Lieu</div>
      <div>Type</div>
      <div>Actif</div>
      <div>Actions</div>
    </div>

    <!-- Exemple -->
    <div class="career-table-row">

      <div class="career-job">
        <img
          src="/media/careers/cuisinier.jpg"
          alt="Cuisiné"
          class="career-thumb"
          onerror="this.style.display='none'"
        >

        <span>Cuisiné</span>
      </div>

      <div>Brazzaville</div>

      <div>Temps plein</div>

      <div>Opérations</div>

      <div class="career-actions">

        <button
          class="career-edit-btn"
          type="button"
          onclick='openCareerEditModal({
            id: 1,
            title: "Cuisiné",
            location: "Brazzaville",
            type: "Temps plein",
            department: "Opérations",
            salary: "Selon profil",
            description: "Rejoignez l’équipe TiopTiop et participez à la construction d’une restauration congolaise moderne.",
            requirements: "Sens du service, fiabilité, esprit d’équipe",
            image: "/media/careers/cuisinier.jpg"
          })'
        >
          Modifier
        </button>

        <button class="career-delete-btn" type="button">
          Supprimer
        </button>

      </div>

    </div>

  </div>

</section>


<!-- ===================================================== -->
<!-- MODAL AJOUT -->
<!-- ===================================================== -->

<div id="careerAddModal" class="career-modal-overlay">

  <div class="career-modal">

    <div class="career-modal-header">

      <h2>
        <span class="career-plus">✚</span>
        Nouvelle offre
      </h2>

      <button
        type="button"
        class="career-modal-close"
        onclick="closeCareerAddModal()"
      >
        ×
      </button>

    </div>


    <form
      action="/admin/carrieres"
      method="POST"
      enctype="multipart/form-data"
    >

      <input
        type="text"
        name="title"
        class="career-field"
        placeholder="Intitulé du poste"
        required
      >

      <input
        type="text"
        name="location"
        class="career-field"
        value="Brazzaville"
        placeholder="Lieu"
        required
      >

      <input
        type="text"
        name="type"
        class="career-field"
        value="Temps plein"
        placeholder="Type"
      >

      <input
        type="text"
        name="department"
        class="career-field"
        value="Opérations"
        placeholder="Département"
      >

      <input
        type="text"
        name="salary"
        class="career-field"
        value="Selon profil"
        placeholder="Rémunération"
      >

      <textarea
        name="description"
        class="career-field career-textarea"
        placeholder="Description détaillée"
      ></textarea>

      <textarea
        name="requirements"
        class="career-field career-textarea"
        placeholder="Compétences / prérequis"
      ></textarea>


      <label class="career-upload-label">
        🖼️ Image de l’offre
      </label>

      <div class="career-file-box">

        <input
          type="file"
          name="image"
          accept="image/jpeg,image/png,image/webp"
          onchange="previewCareerImage(this,'careerAddPreview')"
        >

      </div>


      <div id="careerAddPreview" class="career-image-preview"></div>


      <button type="submit" class="career-save-btn">
        💾 Enregistrer l’offre
      </button>

    </form>

  </div>

</div>


<!-- ===================================================== -->
<!-- MODAL MODIFICATION -->
<!-- ===================================================== -->

<div id="careerEditModal" class="career-modal-overlay">

  <div class="career-modal">

    <div class="career-modal-header">

      <h2>
        ✏️ Modifier l’offre
      </h2>

      <button
        type="button"
        class="career-modal-close"
        onclick="closeCareerEditModal()"
      >
        ×
      </button>

    </div>


    <form
      id="careerEditForm"
      method="POST"
      enctype="multipart/form-data"
    >

      <input type="hidden" id="careerEditId" name="id">


      <input
        type="text"
        id="careerEditTitle"
        name="title"
        class="career-field"
        required
      >


      <input
        type="text"
        id="careerEditLocation"
        name="location"
        class="career-field"
      >


      <input
        type="text"
        id="careerEditType"
        name="type"
        class="career-field"
      >


      <input
        type="text"
        id="careerEditDepartment"
        name="department"
        class="career-field"
      >


      <input
        type="text"
        id="careerEditSalary"
        name="salary"
        class="career-field"
      >


      <textarea
        id="careerEditDescription"
        name="description"
        class="career-field career-textarea"
      ></textarea>


      <textarea
        id="careerEditRequirements"
        name="requirements"
        class="career-field career-textarea"
      ></textarea>


      <label class="career-upload-label">
        🖼️ Image de l’offre
      </label>


      <div class="career-file-box">

        <input
          type="file"
          name="image"
          accept="image/jpeg,image/png,image/webp"
          onchange="previewCareerImage(this,'careerEditPreview')"
        >

      </div>


      <div
        id="careerEditPreview"
        class="career-image-preview"
      ></div>


      <button type="submit" class="career-save-btn">
        💾 Enregistrer l’offre
      </button>

    </form>

  </div>

</div>

<style>
  /* =========================================================
   CARRIERES
========================================================= */

.admin-careers {
    padding: 16px;
}

.career-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 28px;
}

.admin-badge {
    display: inline-block;
    padding: 6px 11px;
    border-radius: 999px;
    background: #fff0df;
    color: #ff7900;
    font-size: 12px;
    font-weight: 800;
}

.career-page-header h1 {
    margin: 8px 0 0;
    font-size: 34px;
    line-height: 1;
    font-weight: 800;
}

.btn-orange {
    border: none;
    border-radius: 999px;
    padding: 14px 20px;
    background: #ff7900;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
}


/* TABLEAU */

.career-table-card {
    overflow: hidden;
    background: #fff;
    border-radius: 18px;
}

.career-table-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.1fr 1fr 2.4fr;
    align-items: center;
    min-height: 65px;
    border-bottom: 1px solid #ddd;
}

.career-table-row:last-child {
    border-bottom: 0;
}

.career-table-row > div {
    padding: 12px 14px;
}

.career-table-head {
    min-height: 42px;
    background: #faf7f4;
    font-weight: 800;
    font-size: 13px;
}


/* POSTE */

.career-job {
    display: flex;
    align-items: center;
    gap: 12px;
}

.career-thumb {
    width: 48px;
    height: 40px;
    border-radius: 8px;
    object-fit: cover;
}


/* ACTIONS */

.career-actions {
    display: flex;
    gap: 8px;
}

.career-edit-btn,
.career-delete-btn {
    border: none;
    border-radius: 999px;
    padding: 11px 17px;
    font-weight: 800;
    cursor: pointer;
}

.career-edit-btn {
    background: #fff;
    color: #111;
    box-shadow: 0 4px 16px rgba(0,0,0,.05);
}

.career-delete-btn {
    background: #fde8e7;
    color: #c63c31;
}


/* =========================================================
   MODAL
========================================================= */

.career-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,.53);
}

.career-modal-overlay.show {
    display: flex;
}

.career-modal {
    width: min(760px, 94vw);
    max-height: 94vh;
    overflow-y: auto;

    padding: 22px;

    border-radius: 24px;

    background: #fff;

    box-shadow: 0 30px 80px rgba(0,0,0,.30);
}

.career-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 18px;
}

.career-modal-header h2 {
    margin: 0;
    font-size: 25px;
    font-weight: 800;
}

.career-plus {
    color: #7157cc;
    margin-right: 6px;
}

.career-modal-close {
    width: 38px;
    height: 38px;

    border: none;
    border-radius: 50%;

    background: #f1f1f1;

    font-size: 18px;

    cursor: pointer;
}


/* FORM */

.career-modal form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.career-field {
    width: 100%;
    min-height: 46px;

    box-sizing: border-box;

    padding: 11px 13px;

    border: 1px solid #ddd;
    border-radius: 12px;

    background: #fff;

    font: inherit;

    outline: none;
}

.career-field:focus {
    border-color: #ff7900;
    box-shadow: 0 0 0 3px rgba(255,121,0,.08);
}

.career-textarea {
    min-height: 65px;
    resize: vertical;
}


/* UPLOAD */

.career-upload-label {
    font-weight: 800;
    font-size: 14px;
}

.career-file-box {
    padding: 10px;

    border: 1px solid #ddd;
    border-radius: 12px;
}


/* IMAGE */

.career-image-preview {
    display: none;
}

.career-image-preview.has-image {
    display: block;
}

.career-image-preview img {
    width: 75px;
    height: 75px;

    object-fit: cover;

    border-radius: 11px;
}


/* ENREGISTRER */

.career-save-btn {
    width: 100%;
    min-height: 45px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-weight: 800;
    font-size: 15px;

    cursor: pointer;
}

.career-save-btn:hover,
.btn-orange:hover {
    background: #e86e00;
}


/* RESPONSIVE */

@media (max-width: 850px) {

    .career-table-card {
        overflow-x: auto;
    }

    .career-table-row {
        min-width: 850px;
    }

}

@media (max-width: 600px) {

    .career-page-header {
        flex-direction: column;
    }

    .btn-orange {
        width: 100%;
    }

    .career-modal {
        padding: 17px;
    }

}
</style>

<script src="/js/careers.js" defer></script>