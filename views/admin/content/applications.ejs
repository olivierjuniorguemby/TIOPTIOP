let currentCandidateId = null;


/* =========================================================
   OUVRIR VIEW
========================================================= */

function viewCandidate(id) {

    const candidate = candidates[id];

    if (!candidate) return;

    currentCandidateId = id;


    document.getElementById("viewCandidateTitle").textContent =
        "👁 Candidature " + candidate.reference;


    document.getElementById("viewName").textContent =
        candidate.name;

    document.getElementById("viewEmail").textContent =
        candidate.email;

    document.getElementById("viewPhone").textContent =
        candidate.phone || "—";

    document.getElementById("viewJob").textContent =
        candidate.job || "—";

    document.getElementById("viewExperience").textContent =
        candidate.experience || "—";

    document.getElementById("viewAvailability").textContent =
        candidate.availability || "—";

    document.getElementById("viewDate").textContent =
        candidate.date;

    document.getElementById("viewMotivation").textContent =
        candidate.motivation || "Aucun message.";

    document.getElementById("viewInternalNote").textContent =
        candidate.note || "Aucune note.";

    document.getElementById("viewStatus").textContent =
        candidate.status;


    const cvStatus =
        document.getElementById("viewCvStatus");

    const cvMessage =
        document.getElementById("viewCvMessage");

    const cvButton =
        document.getElementById("viewCvButton");


    if (candidate.cv) {

        cvStatus.textContent =
            "PDF disponible";

        cvMessage.textContent =
            "Le Curriculum Vitae du candidat est disponible.";

        cvButton.href =
            candidate.cv;

        cvButton.style.display =
            "inline-flex";

    } else {

        cvStatus.textContent =
            "CV non joint";

        cvMessage.textContent =
            "Ce dossier ne contient pas encore de PDF visualisable. " +
            "Les nouvelles candidatures enregistrent maintenant le PDF.";

        cvButton.style.display =
            "none";

    }


    openCandidateModal("viewCandidateModal");
}


/* =========================================================
   MODIFIER
========================================================= */

function editCandidate(id) {

    const candidate = candidates[id];

    if (!candidate) return;

    currentCandidateId = id;


    document.getElementById("editCandidateId").value =
        candidate.id;

    document.getElementById("editName").value =
        candidate.name;

    document.getElementById("editEmail").value =
        candidate.email;

    document.getElementById("editPhone").value =
        candidate.phone || "";

    document.getElementById("editJob").value =
        candidate.job;

    document.getElementById("editExperience").value =
        candidate.experience || "";

    document.getElementById("editAvailability").value =
        candidate.availability || "";

    document.getElementById("editStatus").value =
        candidate.status;

    document.getElementById("editMotivation").value =
        candidate.motivation || "";

    document.getElementById("editInternalNote").value =
        candidate.note || "";


    document.getElementById("currentCv").textContent =
        candidate.cv
            ? "Actuel : PDF disponible"
            : "Actuel : CV non joint";


    openCandidateModal("editCandidateModal");
}


/* =========================================================
   VIEW -> EDIT
========================================================= */

function editFromView() {

    if (!currentCandidateId) return;

    const id = currentCandidateId;

    closeCandidateModal("viewCandidateModal");

    editCandidate(id);
}


/* =========================================================
   MODAL
========================================================= */

function openCandidateModal(id) {

    document
        .getElementById(id)
        .classList.add("show");

    document.body.style.overflow =
        "hidden";
}


function closeCandidateModal(id) {

    document
        .getElementById(id)
        .classList.remove("show");

    document.body.style.overflow =
        "";
}


/* =========================================================
   ENREGISTREMENT
========================================================= */

document
    .getElementById("candidateEditForm")
    .addEventListener("submit", function(event) {

        event.preventDefault();


        const id =
            document.getElementById("editCandidateId").value;

        const candidate =
            candidates[id];


        if (!candidate) return;


        candidate.name =
            document.getElementById("editName").value;

        candidate.email =
            document.getElementById("editEmail").value;

        candidate.phone =
            document.getElementById("editPhone").value;

        candidate.job =
            document.getElementById("editJob").value;

        candidate.experience =
            document.getElementById("editExperience").value;

        candidate.availability =
            document.getElementById("editAvailability").value;

        candidate.status =
            document.getElementById("editStatus").value;

        candidate.motivation =
            document.getElementById("editMotivation").value;

        candidate.note =
            document.getElementById("editInternalNote").value;


        const cvInput =
            document.getElementById("editCv");


        if (cvInput.files.length > 0) {

            const file =
                cvInput.files[0];


            if (file.type !== "application/pdf") {

                alert(
                    "Le CV doit être un fichier PDF."
                );

                return;
            }


            /*
             * Pour le moment :
             * simulation statique.
             *
             * Avec Express/Multer :
             * cette valeur viendra du serveur.
             */

            candidate.cv =
                "/uploads/cv/" + file.name;
        }


        alert(
            "Candidature enregistrée avec succès."
        );


        closeCandidateModal(
            "editCandidateModal"
        );

    });


/* =========================================================
   FILTRAGE
========================================================= */

function filterCandidates() {

    const search =
        document
            .getElementById("candidateSearch")
            .value
            .toLowerCase()
            .trim();


    const status =
        document
            .getElementById("statusFilter")
            .value;


    const job =
        document
            .getElementById("jobFilter")
            .value;


    document
        .querySelectorAll("#candidateTable tr")
        .forEach(function(row) {

            const searchable =
                (
                    row.dataset.search ||
                    ""
                ).toLowerCase();


            const rowStatus =
                row.dataset.status || "";


            const rowJob =
                row.dataset.job || "";


            const searchMatch =
                !search ||
                searchable.includes(search);


            const statusMatch =
                !status ||
                status === rowStatus;


            const jobMatch =
                !job ||
                job === rowJob;


            row.style.display =
                searchMatch &&
                statusMatch &&
                jobMatch
                    ? ""
                    : "none";

        });

}


/* =========================================================
   SUPPRESSION
========================================================= */

function deleteCandidate(reference) {

    const confirmation =
        confirm(
            "Voulez-vous vraiment supprimer la candidature " +
            reference +
            " ?"
        );


    if (!confirmation) return;


    const row =
        Array.from(
            document.querySelectorAll(
                "#candidateTable tr"
            )
        ).find(function(item) {

            return item
                .innerText
                .includes(reference);

        });


    if (row) {

        row.remove();

    }

}


/* =========================================================
   FERMETURE AU CLIC SUR FOND
========================================================= */

document
    .querySelectorAll(
        ".candidate-modal-overlay"
    )
    .forEach(function(overlay) {

        overlay.addEventListener(
            "click",
            function(event) {

                if (event.target === overlay) {

                    overlay.classList.remove(
                        "show"
                    );

                    document.body.style.overflow =
                        "";

                }

            }
        );

    });


/* =========================================================
   ESCAPE
========================================================= */

document.addEventListener(
    "keydown",
    function(event) {

        if (event.key !== "Escape") {
            return;
        }


        document
            .querySelectorAll(
                ".candidate-modal-overlay.show"
            )
            .forEach(function(modal) {

                modal.classList.remove(
                    "show"
                );

            });


        document.body.style.overflow =
            "";

    }
);

</script>