                        <option value="Nouvelle">
                            Nouvelle
                        </option>

                        <option value="À étudier">
                            À étudier
                        </option>

                        <option value="Entretien">
                            Entretien
                        </option>

                        <option value="Embauchée">
                            Embauchée
                        </option>

                        <option value="Refusée">
                            Refusée
                        </option>

                    </select>

                </div>


                <div class="candidate-field">

                    <label>CV PDF</label>

                    <div class="candidate-file-field">

                        <input
                            id="editCv"
                            type="file"
                            accept="application/pdf"
                        >

                    </div>

                    <small id="currentCv">
                        Actuel : CV non joint
                    </small>

                </div>

            </div>


            <div class="candidate-field full">

                <label>Motivation</label>

