                    </label>

                    <input
                        id="editEmail"
                        type="email"
                        required
                    >
                </div>


                <div class="candidate-field">
                    <label>Téléphone</label>

                    <input
                        id="editPhone"
                        type="text"
                    >
                </div>


                <div class="candidate-field">

                    <label>Poste</label>

                    <select id="editJob">

