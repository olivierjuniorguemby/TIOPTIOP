<section class="admin-heading">

    <div>

        <span class="admin-badge">
            Administration
        </span>

        <h1>
            👥 Clients
        </h1>

    </div>

</section>


<section class="admin-clients-page">


    <!-- =====================================================
         TABLEAU CLIENTS
    ====================================================== -->

    <div class="clients-table-wrapper">

        <table class="clients-table">

            <thead>

                <tr>

                    <th>
                        Client
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Téléphone
                    </th>

                    <th>
                        Commandes
                    </th>

                    <th>
                        Dépenses
                    </th>

                    <th>
                        Statut
                    </th>

                    <th>
                        Inscription
                    </th>

                    <th>
                        Dernière connexion
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>


                <% if (
                    clients &&
                    clients.length > 0
                ) { %>


                    <% clients.forEach(
                        client => {

                            const fullName =
                                client.display_name
                                ||
                                [
                                    client.first_name,
                                    client.last_name
                                ]
                                    .filter(Boolean)
                                    .join(" ")
                                ||
                                client.email;

                    %>


                        <tr>


                            <!-- CLIENT -->

                            <td>

                                <div class="client-identity">


                                    <% if (
                                        client.avatar_url
                                    ) { %>

                                        <img
                                            src="<%= client.avatar_url %>"
                                            alt="<%= fullName %>"
                                            class="client-avatar"
                                            onerror="
                                                this.style.display='none';
                                                this.nextElementSibling.style.display='flex';
                                            "
                                        >


                                        <div
                                            class="client-avatar-fallback"
                                            style="display:none;"
                                        >

                                            <%= (
                                                fullName
                                                || "C"
                                            )
                                                .charAt(0)
                                                .toUpperCase()
                                            %>

                                        </div>


                                    <% } else { %>


                                        <div
                                            class="client-avatar-fallback"
                                        >

                                            <%= (
                                                fullName
                                                || "C"
                                            )
                                                .charAt(0)
                                                .toUpperCase()
                                            %>

                                        </div>


                                    <% } %>


                                    <div>

                                        <strong>
                                            <%= fullName %>
                                        </strong>

                                        <small class="client-reference">

                                            #<%= client.id %>

                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- EMAIL -->

                            <td>

                                <%= client.email %>

                            </td>


                            <!-- TELEPHONE -->

                            <td>

                                <%= client.phone || "—" %>

                            </td>


                            <!-- COMMANDES -->

                            <td>

                                <span class="client-count">

                                    <%= Number(
                                        client.orders_count || 0
                                    ) %>

                                </span>

                            </td>


                            <!-- DEPENSES -->

                            <td>

                                <strong class="client-spent">

                                    <%= Number(
                                        client.total_spent || 0
                                    ).toLocaleString(
                                        "fr-FR"
                                    ) %>

                                    XAF

                                </strong>

                            </td>


                            <!-- STATUT -->

                            <td>


                                <% if (
                                    client.status === "ACTIVE"
                                ) { %>

                                    <span class="client-status active">

                                        ● Actif

                                    </span>


                                <% } else { %>

                                    <span class="client-status inactive">

                                        ● <%= client.status %>

                                    </span>

                                <% } %>


                            </td>


                            <!-- DATE INSCRIPTION -->

                            <td>

                                <%= client.created_at
                                    ? new Date(
                                        client.created_at
                                    ).toLocaleDateString(
                                        "fr-FR"
                                    )
                                    : "—"
                                %>

                            </td>


                            <!-- LAST LOGIN -->

                            <td>

                                <% if (
                                    client.last_login_at
                                ) { %>

                                    <%= new Date(
                                        client.last_login_at
                                    ).toLocaleString(
                                        "fr-FR",
                                        {
                                            dateStyle:
                                                "short",

                                            timeStyle:
                                                "short"
                                        }
                                    ) %>

                                <% } else { %>

                                    Jamais

                                <% } %>

                            </td>

                            <td>

                              <div class="client-actions">

                                  <!-- CONSULTER -->

                                  <button
                                      type="button"
                                      class="btn-client-view"
                                      onclick="viewClient(<%= client.id %>)"
                                      title="Consulter"
                                  >
                                      👁
                                  </button>


                                  <!-- MODIFIER -->

                                  <button
                                      type="button"
                                      class="btn-client-edit"
                                      onclick="editClient(<%= client.id %>)"
                                      title="Modifier"
                                  >
                                      ✏️
                                  </button>


                                  <!-- BLOQUER / DEBLOQUER -->

                                  <% if (
                                      client.status === "BLOCKED"
                                  ) { %>

                                      <button
                                          type="button"
                                          class="btn-client-unblock"
                                          onclick="unblockClient(<%= client.id %>)"
                                          title="Débloquer"
                                      >
                                          🔓
                                      </button>

                                  <% } else { %>

                                      <button
                                          type="button"
                                          class="btn-client-block"
                                          onclick="blockClient(<%= client.id %>)"
                                          title="Bloquer"
                                      >
                                          🔒
                                      </button>

                                  <% } %>


                                  <!-- SUPPRIMER -->

                                  <button
                                      type="button"
                                      class="btn-client-delete"
                                      onclick="deleteClient(<%= client.id %>)"
                                      title="Supprimer"
                                  >
                                      🗑
                                  </button>

                              </div>

                          </td>

                        </tr>


                    <% }) %>


                <% } else { %>


                    <tr>

                        <td
                            colspan="8"
                        >

                            <div class="clients-empty">

                                <div class="clients-empty-icon">

                                    👥

                                </div>

                                <strong>

                                    Aucun client inscrit

                                </strong>

                                <span>

                                    Les nouveaux comptes apparaîtront ici automatiquement.

                                </span>

                            </div>

                        </td>

                    </tr>


                <% } %>


            </tbody>

        </table>

    </div>

</section>


<!-- =========================================================
     FORMULAIRE SUPPRESSION
========================================================= -->

<form
  id="deleteClientForm"
  method="POST"
  style="display:none;">
</form>

<!-- =========================================================
     MODAL ADMINISTRATION CLIENT
========================================================= -->

<div
    id="clientAdminModal"
    class="client-modal-overlay"
>

    <div class="client-modal">

        <div class="client-modal-header">

            <h2 id="clientModalTitle">
                Client
            </h2>

            <button
                type="button"
                class="client-modal-close"
                onclick="closeClientModal()"
            >
                ✕
            </button>

        </div>


        <div id="clientModalBody">

        </div>

    </div>

</div>

<style>
  /* ============================================================
   ADMIN CLIENTS
============================================================ */

.admin-clients-page {
    padding: 14px;
}

.clients-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;

    margin-bottom: 25px;
}

.clients-header h1 {
    margin: 8px 0 0;

    font-size: 34px;
    line-height: 1.1;

    color: #171310;
}

.admin-badge {
    display: inline-flex;

    padding: 5px 10px;

    border-radius: 999px;

    background: #fff0df;
    color: #ff7900;

    font-size: 12px;
    font-weight: 800;
}


/* ============================================================
   AJOUT CLIENT
============================================================ */

.btn-client-add {
    padding: 13px 20px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: white;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;

    transition: .2s ease;
}

.btn-client-add:hover {
    background: #e96f00;
    transform: translateY(-1px);
}


/* ============================================================
   TABLEAU
============================================================ */

.clients-table-wrapper {
    width: 100%;

    overflow-x: auto;

    background: white;

    border-radius: 18px;
}

.clients-table {
    width: 100%;

    border-collapse: collapse;
}

.clients-table th {
    padding: 15px;

    text-align: left;

    background: #faf8f5;

    border-bottom: 1px solid #ddd;

    color: #171310;

    font-size: 14px;
    font-weight: 800;
}

.clients-table td {
    padding: 13px 15px;

    border-bottom: 1px solid #e5e5e5;

    vertical-align: middle;

    font-size: 14px;
}

.clients-table tbody tr:last-child td {
    border-bottom: none;
}


/* ============================================================
   IDENTITÉ CLIENT
============================================================ */

.client-identity {
    display: flex;
    align-items: center;

    gap: 10px;
}

.client-avatar {
    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    border-radius: 50%;

    object-fit: cover;
}

.client-avatar-fallback {
    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #f5f1ee;

    font-size: 18px;
}


/* ============================================================
   ACTIONS
============================================================ */

.client-actions {
    display: flex;
    align-items: center;

    gap: 8px;
}

.btn-client-edit,
.btn-client-delete {
    padding: 10px 16px;

    border: none;
    border-radius: 999px;

    font-size: 13px;
    font-weight: 800;

    cursor: pointer;
}

.btn-client-edit {
    background: #fff;
    color: #171310;

    box-shadow:
        0 5px 20px rgba(0, 0, 0, .05);
}

.btn-client-edit:hover {
    background: #f5f5f5;
}

.btn-client-delete {
    background: #ffe5e2;
    color: #c63a2c;
}

.btn-client-delete:hover {
    background: #ffd6d2;
}


/* ============================================================
   MODAL
============================================================ */

.client-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0, 0, 0, .55);
}

.client-modal-overlay.show {
    display: flex;
}

body.modal-open {
    overflow: hidden;
}

.client-modal {
    width: 100%;
    max-width: 760px;

    padding: 22px;

    border-radius: 24px;

    background: #fff;

    box-shadow:
        0 25px 80px rgba(0, 0, 0, .30);
}


/* HEADER MODAL */

.client-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 18px;
}

.client-modal-header h2 {
    display: flex;
    align-items: center;

    gap: 10px;

    margin: 0;

    font-size: 26px;
    font-weight: 800;

    color: #171310;
}

.client-modal-close {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 38px;

    border: none;
    border-radius: 50%;

    background: #f1f1f1;

    font-size: 18px;

    cursor: pointer;
}


/* ============================================================
   FORMULAIRE
============================================================ */

.client-modal form {
    display: flex;
    flex-direction: column;

    gap: 10px;
}

.client-field {
    width: 100%;

    min-height: 46px;

    box-sizing: border-box;

    padding: 12px;

    border: 1px solid #ddd;
    border-radius: 12px;

    background: #fff;

    font-family: inherit;
    font-size: 15px;

    outline: none;
}

.client-field:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255, 121, 0, .08);
}


/* ============================================================
   PHOTO
============================================================ */

.client-upload-group {
    display: flex;
    flex-direction: column;

    gap: 6px;
}

.client-upload-group label {
    font-size: 15px;
}

.client-file-box {
    width: 100%;

    box-sizing: border-box;

    padding: 8px 12px;

    border: 1px solid #ddd;
    border-radius: 12px;

    background: #fff;
}

.client-file-box input {
    width: 100%;
}

.client-image-preview {
    width: 72px;
    height: 72px;

    margin-top: 4px;

    border-radius: 50%;

    object-fit: cover;

    border: 1px solid #eee;
}


/* ============================================================
   ENREGISTRER
============================================================ */

.btn-client-save {
    width: 100%;

    min-height: 45px;

    margin-top: 2px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;
}

.btn-client-save:hover {
    background: #e96f00;
}


/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 768px) {

    .clients-header {
        flex-direction: column;
    }

    .btn-client-add {
        width: 100%;
    }

    .clients-table {
        min-width: 720px;
    }

    .client-modal {
        max-height: calc(100vh - 30px);

        overflow-y: auto;

        padding: 18px;
    }

    .client-modal-header h2 {
        font-size: 21px;
    }
}

/* ============================================================
   ACTIONS CLIENT
============================================================ */

.client-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.btn-client-view,
.btn-client-edit,
.btn-client-block,
.btn-client-unblock,
.btn-client-delete {
    width: 38px;
    height: 38px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;
    border-radius: 10px;

    cursor: pointer;

    transition: .2s ease;
}

.btn-client-view {
    background: #eef5ff;
}

.btn-client-edit {
    background: #fff4e8;
}

.btn-client-block {
    background: #fff0df;
}

.btn-client-unblock {
    background: #e8f8ed;
}

.btn-client-delete {
    background: #ffe8e5;
}

.btn-client-view:hover,
.btn-client-edit:hover,
.btn-client-block:hover,
.btn-client-unblock:hover,
.btn-client-delete:hover {
    transform: translateY(-2px);
}


/* ============================================================
   DETAIL CLIENT
============================================================ */

.client-detail-header {
    display: flex;
    align-items: center;
    gap: 15px;

    padding: 16px;

    margin-bottom: 20px;

    border-radius: 18px;

    background: #faf7f3;
}

.client-detail-avatar {
    width: 65px;
    height: 65px;

    flex: 0 0 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background: #fff0df;

    color: #ff7900;

    font-size: 24px;
    font-weight: 900;
}

.client-detail-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.client-detail-header h3 {
    margin: 0 0 5px;
}

.client-detail-header p {
    margin: 0;
    color: #777;
}

.client-detail-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px;
}

.client-detail-item {
    padding: 13px;

    border: 1px solid #eee6df;
    border-radius: 13px;

    background: #fff;
}

.client-detail-item span {
    display: block;

    margin-bottom: 5px;

    color: #817a74;

    font-size: 11px;
}

.client-detail-item strong {
    font-size: 13px;

    word-break: break-word;
}


/* ============================================================
   FORMULAIRE EDIT
============================================================ */

.client-form-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 13px;
}

.client-form-group {
    display: flex;
    flex-direction: column;

    gap: 6px;
}

.client-form-full {
    grid-column: 1 / -1;
}

.client-form-group label {
    font-size: 12px;
    font-weight: 800;
}

.client-form-group input,
.client-form-group select {
    width: 100%;
    min-height: 44px;

    padding: 10px 12px;

    border: 1px solid #ddd6d0;
    border-radius: 11px;

    background: #fff;

    font: inherit;

    outline: none;
}

.client-form-group input:focus,
.client-form-group select:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px
        rgba(255, 121, 0, .08);
}


/* ============================================================
   CONSENTEMENTS
============================================================ */

.client-consents {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    margin-top: 18px;
}

.client-consents label {
    display: flex;
    align-items: center;
    gap: 7px;

    padding: 9px 12px;

    border-radius: 999px;

    background: #f7f4f1;

    font-size: 12px;
    font-weight: 700;
}


/* ============================================================
   ERREUR
============================================================ */

.client-form-error {
    margin-top: 15px;

    padding: 11px 13px;

    border-radius: 10px;

    background: #ffe9e7;

    color: #b42318;

    font-size: 12px;
    font-weight: 700;
}


/* ============================================================
   FOOTER MODAL
============================================================ */

.client-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;

    margin-top: 20px;
}

.client-primary-button,
.client-secondary-button {
    min-height: 42px;

    padding: 0 18px;

    border: none;
    border-radius: 999px;

    font-weight: 800;

    cursor: pointer;
}

.client-primary-button {
    background: #ff7900;
    color: #fff;
}

.client-secondary-button {
    background: #f3efeb;
    color: #171310;
}


@media (max-width: 650px) {

    .client-detail-grid,
    .client-form-grid {
        grid-template-columns: 1fr;
    }

    .client-form-full {
        grid-column: auto;
    }

    .client-modal-footer {
        flex-direction: column;
    }

    .client-primary-button,
    .client-secondary-button {
        width: 100%;
    }
}

</style>

<script src="/js/clients.js" defer></script>