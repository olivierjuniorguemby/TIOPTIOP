</form>

<style>
  /* ============================================================
   ADMIN CLIENTS
============================================================ */

.admin-clients-page {
    padding: 14px;
}

.clients-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;

    margin-bottom: 25px;
}

.clients-header h1 {
    margin: 8px 0 0;

    font-size: 34px;
    line-height: 1.1;

    color: #171310;
}

.admin-badge {
    display: inline-flex;

    padding: 5px 10px;

    border-radius: 999px;

    background: #fff0df;
    color: #ff7900;

    font-size: 12px;
    font-weight: 800;
}


/* ============================================================
   AJOUT CLIENT
============================================================ */

.btn-client-add {
    padding: 13px 20px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: white;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;

    transition: .2s ease;
}

.btn-client-add:hover {
    background: #e96f00;
    transform: translateY(-1px);
}


/* ============================================================
   TABLEAU
============================================================ */

.clients-table-wrapper {
    width: 100%;

    overflow-x: auto;

    background: white;

    border-radius: 18px;
}

.clients-table {
    width: 100%;

    border-collapse: collapse;
}

.clients-table th {
    padding: 15px;

    text-align: left;

    background: #faf8f5;

    border-bottom: 1px solid #ddd;

    color: #171310;

    font-size: 14px;
    font-weight: 800;
}

.clients-table td {
    padding: 13px 15px;

    border-bottom: 1px solid #e5e5e5;

    vertical-align: middle;

    font-size: 14px;
}

.clients-table tbody tr:last-child td {
    border-bottom: none;
}


/* ============================================================
   IDENTITÉ CLIENT
============================================================ */

.client-identity {
    display: flex;
    align-items: center;

    gap: 10px;
}

.client-avatar {
    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    border-radius: 50%;

    object-fit: cover;
}

.client-avatar-fallback {
    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #f5f1ee;

    font-size: 18px;
}


/* ============================================================
   ACTIONS
============================================================ */

.client-actions {
    display: flex;
    align-items: center;

    gap: 8px;
}

.btn-client-edit,
.btn-client-delete {
    padding: 10px 16px;

    border: none;
    border-radius: 999px;

    font-size: 13px;
    font-weight: 800;

    cursor: pointer;
}

.btn-client-edit {
    background: #fff;
    color: #171310;

    box-shadow:
        0 5px 20px rgba(0, 0, 0, .05);
}

.btn-client-edit:hover {
    background: #f5f5f5;
}

.btn-client-delete {
    background: #ffe5e2;
    color: #c63a2c;
}

.btn-client-delete:hover {
    background: #ffd6d2;
}


/* ============================================================
   MODAL
============================================================ */

.client-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0, 0, 0, .55);
}

.client-modal-overlay.show {
    display: flex;
}

body.modal-open {
    overflow: hidden;
}

.client-modal {
    width: 100%;
    max-width: 760px;

    padding: 22px;

    border-radius: 24px;

    background: #fff;

    box-shadow:
        0 25px 80px rgba(0, 0, 0, .30);
}


/* HEADER MODAL */

.client-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 18px;
}

.client-modal-header h2 {
    display: flex;
    align-items: center;

    gap: 10px;

    margin: 0;

    font-size: 26px;
    font-weight: 800;

    color: #171310;
}

.client-modal-close {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 38px;

    border: none;
    border-radius: 50%;

    background: #f1f1f1;

    font-size: 18px;

    cursor: pointer;
}


/* ============================================================
   FORMULAIRE
============================================================ */

.client-modal form {
    display: flex;
    flex-direction: column;

    gap: 10px;
}

.client-field {
    width: 100%;

    min-height: 46px;

    box-sizing: border-box;

    padding: 12px;

    border: 1px solid #ddd;
    border-radius: 12px;

    background: #fff;

    font-family: inherit;
    font-size: 15px;

    outline: none;
}

.client-field:focus {
    border-color: #ff7900;

    box-shadow:
        0 0 0 3px rgba(255, 121, 0, .08);
}


/* ============================================================
   PHOTO
============================================================ */

.client-upload-group {
    display: flex;
    flex-direction: column;

    gap: 6px;
}

.client-upload-group label {
    font-size: 15px;
}

.client-file-box {
    width: 100%;

    box-sizing: border-box;

    padding: 8px 12px;

    border: 1px solid #ddd;
    border-radius: 12px;

    background: #fff;
}

.client-file-box input {
    width: 100%;
}

.client-image-preview {
    width: 72px;
    height: 72px;

    margin-top: 4px;

    border-radius: 50%;

    object-fit: cover;

    border: 1px solid #eee;
}


/* ============================================================
   ENREGISTRER
============================================================ */

.btn-client-save {
    width: 100%;

    min-height: 45px;

    margin-top: 2px;

    border: none;
    border-radius: 999px;

    background: #ff7900;
    color: #fff;

    font-size: 15px;
    font-weight: 800;

    cursor: pointer;
}

.btn-client-save:hover {
    background: #e96f00;
}


/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 768px) {

    .clients-header {
        flex-direction: column;
    }

    .btn-client-add {
        width: 100%;
    }

    .clients-table {
        min-width: 720px;
    }

    .client-modal {
        max-height: calc(100vh - 30px);

        overflow-y: auto;

        padding: 18px;
    }

    .client-modal-header h2 {
        font-size: 21px;
    }
}
</style>

<script src="/js/clients.js" defer></script>