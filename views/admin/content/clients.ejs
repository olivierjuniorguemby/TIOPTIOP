<!-- =========================================================
     MODAL : AJOUTER UN CLIENT
========================================================= -->

<div
  id="addClientModal"
  class="client-modal-overlay">

  <div class="client-modal">

    <div class="client-modal-header">

      <h2>
        <span>➕</span>
        Ajouter un client
      </h2>

      <button
        type="button"
        class="client-modal-close"
        onclick="closeAddClientModal()">
        ×
      </button>

    </div>


    <form
      action="/admin/clients"
      method="POST"
      enctype="multipart/form-data">

      <!-- NOM -->
      <input
        type="text"
        name="name"
        class="client-field"
        placeholder="Nom"
        required>


      <!-- EMAIL -->
      <input
        type="email"
        name="email"
        class="client-field"
        placeholder="Email"
        required>


      <!-- TELEPHONE -->
      <input
        type="tel"
        name="phone"
        class="client-field"
        placeholder="Téléphone">


      <!-- PHOTO -->
      <div class="client-upload-group">

        <label>
          📷 <strong>Photo de profil</strong>
        </label>

        <div class="client-file-box">

          <input
            type="file"
            name="avatar"
            accept="image/png,image/jpeg,image/jpg,image/webp"
            onchange="previewAddClientImage(event)">

        </div>


        <img
          id="addClientPreview"
          class="client-image-preview"
          alt="Aperçu photo"
          style="display:none;">

      </div>


      <button
        type="submit"
        class="btn-client-save">
        💾 Enregistrer
      </button>

    </form>

  </div>

</div>



<!-- =========================================================
     MODAL : MODIFIER CLIENT
========================================================= -->

<div
  id="editClientModal"
  class="client-modal-overlay">

  <div class="client-modal">

    <div class="client-modal-header">

      <h2>
        <span>📝</span>
        Modifier le client
      </h2>

      <button
        type="button"
        class="client-modal-close"
        onclick="closeEditClientModal()">
        ×
      </button>

    </div>


    <form
      id="editClientForm"
      method="POST"
      enctype="multipart/form-data">

      <!-- NOM -->
      <input
        type="text"
        id="editClientName"
        name="name"
        class="client-field"
        required>


      <!-- EMAIL -->
      <input
        type="email"
        id="editClientEmail"
        name="email"
        class="client-field"
        required>


      <!-- TELEPHONE -->
      <input
        type="tel"
        id="editClientPhone"
        name="phone"
        class="client-field">


      <!-- PHOTO -->
      <div class="client-upload-group">

        <label>
          📷 <strong>Photo de profil</strong>
        </label>

        <div class="client-file-box">

          <input
            type="file"
            name="avatar"
            accept="image/png,image/jpeg,image/jpg,image/webp"
            onchange="previewEditClientImage(event)">

        </div>


        <!-- PHOTO EXISTANTE -->

        <div id="editClientPreviewContainer">

          <img
            id="editClientPreview"
            class="client-image-preview"
            alt="Photo du client">

        </div>

      </div>


      <button
        type="submit"
        class="btn-client-save">
        💾 Enregistrer
      </button>

    </form>

  </div>

</div>



<!-- =========================================================
